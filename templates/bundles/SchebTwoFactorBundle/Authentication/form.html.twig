{% extends 'front/base_auth.html.twig' %}
{% block title %}Verify Identity{% endblock %}

{% block extra_css %}
<style>
  :root {
    --accent-primary: #00f2fe;
    --bg-dark: #0b1220;
    --bg-surface: #162236;
    --text-muted: #9ca3af;
  }

  body {
    background-color: var(--bg-dark) !important;
    background-image: radial-gradient(circle at center, #162236 0%, #0b1220 100%) !important;
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Outfit', sans-serif;
    color: #fff;
    overflow: hidden;
  }

  /* Animated background mesh */
  .auth-bg-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 166, 237, 0.15) 0%, rgba(0, 166, 237, 0) 70%);
    top: -200px;
    right: -100px;
    filter: blur(80px);
    z-index: -1;
    animation: pulse 10s infinite alternate;
  }

  .auth-bg-glow-2 {
    position: fixed;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(114, 9, 183, 0.1) 0%, rgba(114, 9, 183, 0) 70%);
    bottom: -100px;
    left: -100px;
    filter: blur(80px);
    z-index: -1;
    animation: pulse 12s infinite alternate-reverse;
  }

  @keyframes pulse {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, 40px) scale(1.1); }
  }

  .verify-card {
    position: relative;
    z-index: 10;
    background: rgba(22, 34, 54, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    max-width: 440px;
    padding: 60px 40px;
    border-radius: 32px;
    text-align: center;
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.6);
    animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .shield-icon {
    width: 80px;
    height: 80px;
    background: rgba(0, 166, 237, 0.1);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 32px;
    color: var(--accent-primary);
    font-size: 32px;
    border: 1px solid rgba(0, 166, 237, 0.2);
    box-shadow: 0 0 30px rgba(0, 166, 237, 0.1);
  }

  h1 { font-size: 28px; margin-bottom: 12px; font-weight: 700; letter-spacing: -0.5px; }
  p.subtitle { color: var(--text-muted); font-size: 15px; margin-bottom: 40px; line-height: 1.6; }

  .code-container {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 32px;
  }

  .code-input {
    width: 54px;
    height: 64px;
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    color: #fff;
    transition: all 0.3s;
    outline: none;
  }

  .code-input:focus {
    border-color: var(--accent-primary);
    background: rgba(0, 166, 237, 0.05);
    box-shadow: 0 0 20px rgba(0, 166, 237, 0.15);
    transform: translateY(-2px);
  }

  .error-box {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #f87171;
    padding: 12px;
    border-radius: 12px;
    font-size: 13px;
    margin-bottom: 24px;
    display: none;
  }

  .btn-verify {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, #00a6ed 0%, #0077b6 100%);
    border: none;
    border-radius: 16px;
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 10px 30px -10px rgba(0, 166, 237, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .btn-verify:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px -10px rgba(0, 166, 237, 0.5);
  }

  .btn-verify:active { transform: translateY(0); }

  .back-link {
    margin-top: 32px;
    display: block;
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
    z-index: 20;
    pointer-events: auto !important;
  }

  .back-link:hover { color: #fff; }

  /* Hidden real input for the form submission */
  #auth_code_hidden { display: none; }
</style>
{% endblock %}

{% block body %}
<div class="auth-bg-glow"></div>
<div class="auth-bg-glow-2"></div>

<div class="verify-card">
  <div class="shield-icon">
    <i class="fas fa-user-shield"></i>
  </div>
  
  <h1>Verify Identity</h1>
  <p class="subtitle">Please enter the 6-digit code from your <br><strong>Google Authenticator</strong> app.</p>

  {% if authenticationError %}
    <div class="error-box" style="display: block;">
      {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
    </div>
  {% endif %}

  <form action="{{ checkPathUrl ? checkPathUrl : path('2fa_login_check') }}" method="post" id="twoFactorForm" novalidate>
    <div class="code-container">
      <input type="text" class="code-input" maxlength="1" inputmode="numeric" autofocus>
      <input type="text" class="code-input" maxlength="1" inputmode="numeric">
      <input type="text" class="code-input" maxlength="1" inputmode="numeric">
      <input type="text" class="code-input" maxlength="1" inputmode="numeric">
      <input type="text" class="code-input" maxlength="1" inputmode="numeric">
      <input type="text" class="code-input" maxlength="1" inputmode="numeric">
    </div>

    {# The real field that SchebTwoFactorBundle expects #}
    <input type="hidden" name="{{ authCodeParameterName }}" id="auth_code_hidden">

    <button type="submit" class="btn-verify" id="verifyBtn">
      <span>Verify & Secure</span>
      <i class="fas fa-arrow-right"></i>
    </button>
  </form>

  <div style="margin-top: 40px; padding: 20px; border-top: 1px solid rgba(255,255,255,0.1);">
    <a href="/emergency-exit" 
       class="back-link" 
       style="display: block; width: 100%; padding: 15px; background: rgba(255, 255, 255, 0.05); border-radius: 12px; color: #ff4d4d !important; text-decoration: none; font-weight: 700; z-index: 99999; position: relative; pointer-events: auto !important;">
      <i class="fas fa-power-off"></i> ABORT & RETURN TO LOGIN
    </a>
    <p style="font-size: 11px; color: rgba(255,255,255,0.3); margin-top: 12px;">Stuck? This button will forcefully reset your session.</p>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('.code-input');
    const hiddenInput = document.getElementById('auth_code_hidden');
    const form = document.getElementById('twoFactorForm');

    // Handle input & auto-focus
    inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            if (e.data && !/^\d+$/.test(e.data)) {
                input.value = '';
                return;
            }
            if (input.value && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            updateHiddenValue();
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !input.value && index > 0) {
                inputs[index - 1].focus();
            }
        });

        // Paste support
        input.addEventListener('paste', (e) => {
            const data = e.clipboardData.getData('text').slice(0, 6);
            if (!/^\d+$/.test(data)) return;
            
            data.split('').forEach((char, i) => {
                if (inputs[index + i]) inputs[index + i].value = char;
            });
            updateHiddenValue();
            if (inputs[index + data.length]) {
                inputs[index + data.length].focus();
            } else {
                inputs[inputs.length - 1].focus();
            }
        });
    });

    function updateHiddenValue() {
        let code = '';
        inputs.forEach(input => code += input.value);
        hiddenInput.value = code;
    }

    form.addEventListener('submit', (e) => {
        updateHiddenValue();
        if (hiddenInput.value.length < 6) {
            e.preventDefault();
            // Optional: Shake inputs
            inputs.forEach(i => i.style.borderColor = '#ef4444');
        }
    });

    // Handle Face ID redirection logic if any
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('face')) {
      // Custom visual for "Face ID verified, now need code"
      document.querySelector('.shield-icon').style.color = '#0fd850';
      document.querySelector('.shield-icon').innerHTML = '<i class="fas fa-check-circle"></i>';
    }
});
</script>
{% endblock %}