{# templates/pagination/sliding.html.twig #}
{% if pageCount > 1 %}
<div style="display:flex;justify-content:center;align-items:center;gap:6px;margin-top:28px;flex-wrap:wrap;">

  {# Previous button #}
  {% if previous is defined %}
    <a href="{{ path(route, query|merge({(pageParameterName): previous})) }}"
       style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;
              border:1px solid var(--border-color);background:var(--bg-card);
              color:var(--text-primary);text-decoration:none;font-size:13px;font-weight:600;
              transition:all 0.2s;">
      ← Prev
    </a>
  {% else %}
    <span style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;
                 border:1px solid var(--border-color);background:var(--bg-surface);
                 color:var(--text-muted);font-size:13px;font-weight:600;cursor:not-allowed;opacity:0.4;">
      ← Prev
    </span>
  {% endif %}

  {# Page numbers #}
  {% for page in pagesInRange %}
    {% if page == current %}
      <span style="display:inline-flex;align-items:center;justify-content:center;
                   width:38px;height:38px;border-radius:8px;
                   background:var(--accent-primary);color:#fff;
                   font-size:13px;font-weight:700;font-family:var(--font-mono);">
        {{ page }}
      </span>
    {% else %}
      <a href="{{ path(route, query|merge({(pageParameterName): page})) }}"
         style="display:inline-flex;align-items:center;justify-content:center;
                width:38px;height:38px;border-radius:8px;
                border:1px solid var(--border-color);background:var(--bg-card);
                color:var(--text-primary);text-decoration:none;
                font-size:13px;font-weight:600;font-family:var(--font-mono);
                transition:all 0.2s;">
        {{ page }}
      </a>
    {% endif %}
  {% endfor %}

  {# Next button #}
  {% if next is defined %}
    <a href="{{ path(route, query|merge({(pageParameterName): next})) }}"
       style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;
              border:1px solid var(--border-color);background:var(--bg-card);
              color:var(--text-primary);text-decoration:none;font-size:13px;font-weight:600;
              transition:all 0.2s;">
      Next →
    </a>
  {% else %}
    <span style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;
                 border:1px solid var(--border-color);background:var(--bg-surface);
                 color:var(--text-muted);font-size:13px;font-weight:600;cursor:not-allowed;opacity:0.4;">
      Next →
    </span>
  {% endif %}

</div>

{# Page info #}
<div style="text-align:center;margin-top:10px;font-size:12px;color:var(--text-muted);font-family:var(--font-mono);">
  Page {{ current }} of {{ pageCount }}
</div>
{% endif %}
