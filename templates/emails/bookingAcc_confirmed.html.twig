<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Booking Confirmed — TripX</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:#f0f4f8;font-family:'Inter',Arial,sans-serif;color:#1a1a2e;-webkit-font-smoothing:antialiased;}

  .wrapper{max-width:620px;margin:40px auto;background:#ffffff;border-radius:24px;overflow:hidden;
           box-shadow:0 20px 60px rgba(0,0,0,0.10);}

  /* ── Header ── */
  .header{background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);padding:40px 48px 36px;text-align:center;position:relative;overflow:hidden;}
  .header::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;
                  background:radial-gradient(circle,rgba(16,185,129,0.25) 0%,transparent 70%);border-radius:50%;}
  .header::after{content:'';position:absolute;bottom:-40px;left:-40px;width:160px;height:160px;
                 background:radial-gradient(circle,rgba(52,211,153,0.15) 0%,transparent 70%);border-radius:50%;}
  .logo{font-size:28px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;position:relative;z-index:1;}
  .logo span{color:#10b981;}
  .header-tag{display:inline-flex;align-items:center;gap:8px;margin-top:20px;padding:8px 20px;
              background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.4);
              border-radius:40px;position:relative;z-index:1;}
  .header-tag-dot{width:8px;height:8px;background:#10b981;border-radius:50%;
                  box-shadow:0 0 8px rgba(16,185,129,0.8);}
  .header-tag-text{font-size:13px;font-weight:600;color:#34d399;letter-spacing:0.5px;}

  /* ── Status Banner ── */
  .status-banner{background:linear-gradient(135deg,#ecfdf5 0%,#d1fae5 100%);
                 border-bottom:3px solid #10b981;padding:28px 48px;text-align:center;}
  .status-icon{font-size:48px;margin-bottom:12px;display:block;}
  .status-title{font-size:24px;font-weight:800;color:#065f46;margin-bottom:6px;}
  .status-sub{font-size:14px;color:#047857;font-weight:500;}

  /* ── Body ── */
  .body{padding:40px 48px;}

  .greeting{font-size:18px;font-weight:700;color:#1a1a2e;margin-bottom:8px;}
  .intro{font-size:14px;color:#64748b;line-height:1.7;margin-bottom:32px;}

  /* ── Booking Card ── */
  .booking-card{background:linear-gradient(135deg,#f8fafc 0%,#f1f5f9 100%);
                border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;margin-bottom:28px;}
  .booking-card-header{background:linear-gradient(135deg,#10b981 0%,#059669 100%);
                       padding:16px 24px;display:flex;align-items:center;gap:12px;}
  .booking-card-header-icon{font-size:20px;}
  .booking-card-header-title{font-size:14px;font-weight:700;color:#ffffff;}
  .booking-card-header-id{font-size:12px;color:rgba(255,255,255,0.75);margin-left:auto;}
  .booking-card-body{padding:24px;}

  /* ── Info Grid ── */
  .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
  .info-item{background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;}
  .info-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;
              color:#94a3b8;margin-bottom:5px;}
  .info-value{font-size:14px;font-weight:700;color:#1e293b;}
  .info-value.accent{color:#10b981;}
  .info-value.price{font-size:20px;color:#10b981;}

  /* ── Dates Row ── */
  .dates-row{display:flex;align-items:center;gap:0;margin-bottom:20px;}
  .date-box{flex:1;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:16px;text-align:center;}
  .date-box-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;margin-bottom:6px;}
  .date-box-value{font-size:16px;font-weight:800;color:#1e293b;}
  .date-box-day{font-size:11px;color:#64748b;margin-top:3px;}
  .dates-arrow{padding:0 16px;font-size:20px;color:#10b981;font-weight:700;flex-shrink:0;}
  .nights-pill{background:linear-gradient(135deg,#10b981,#059669);color:#fff;
               border-radius:20px;padding:4px 14px;font-size:12px;font-weight:700;
               text-align:center;white-space:nowrap;}

  /* ── Accommodation ── */
  .acc-section{background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;
               padding:16px 20px;margin-bottom:20px;display:flex;align-items:flex-start;gap:16px;}
  .acc-icon{font-size:32px;flex-shrink:0;}
  .acc-name{font-size:16px;font-weight:700;color:#1e293b;margin-bottom:4px;}
  .acc-stars{color:#f59e0b;font-size:14px;margin-bottom:4px;}
  .acc-meta{font-size:12px;color:#64748b;}
  .acc-meta span{margin-right:12px;}

  /* ── Special Requests ── */
  .special-box{background:#fffbeb;border:1px solid #fde68a;border-radius:12px;
               padding:16px 20px;margin-bottom:20px;}
  .special-box-label{font-size:11px;font-weight:700;text-transform:uppercase;
                     letter-spacing:0.08em;color:#92400e;margin-bottom:8px;}
  .special-box-text{font-size:13px;color:#78350f;line-height:1.6;}

  /* ── What's Next ── */
  .next-section{margin-bottom:32px;}
  .section-title{font-size:13px;font-weight:700;text-transform:uppercase;
                 letter-spacing:0.08em;color:#94a3b8;margin-bottom:16px;}
  .next-item{display:flex;align-items:flex-start;gap:14px;margin-bottom:14px;}
  .next-dot{width:32px;height:32px;background:linear-gradient(135deg,#10b981,#059669);
            border-radius:50%;display:flex;align-items:center;justify-content:center;
            font-size:14px;flex-shrink:0;color:#fff;font-weight:700;}
  .next-text{padding-top:6px;font-size:13px;color:#475569;line-height:1.6;}
  .next-text strong{color:#1e293b;}

  /* ── CTA ── */
  .cta-wrap{text-align:center;margin-bottom:32px;}
  .cta-btn{display:inline-block;padding:14px 40px;
           background:linear-gradient(135deg,#10b981 0%,#059669 100%);
           color:#ffffff;text-decoration:none;border-radius:40px;
           font-size:14px;font-weight:700;letter-spacing:0.3px;
           box-shadow:0 8px 20px rgba(16,185,129,0.35);}

  /* ── Divider ── */
  .divider{border:none;border-top:1px solid #f1f5f9;margin:28px 0;}

  /* ── Contact ── */
  .contact-row{display:flex;gap:16px;margin-bottom:28px;}
  .contact-item{flex:1;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;
                padding:14px 16px;text-align:center;}
  .contact-item-icon{font-size:20px;margin-bottom:6px;}
  .contact-item-label{font-size:10px;font-weight:700;text-transform:uppercase;
                      letter-spacing:0.06em;color:#94a3b8;margin-bottom:4px;}
  .contact-item-val{font-size:12px;font-weight:600;color:#334155;}

  /* ── Footer ── */
  .footer{background:#f8fafc;border-top:1px solid #e2e8f0;padding:28px 48px;text-align:center;}
  .footer-logo{font-size:18px;font-weight:800;color:#334155;margin-bottom:10px;}
  .footer-logo span{color:#10b981;}
  .footer-text{font-size:12px;color:#94a3b8;line-height:1.8;}
  .footer-links{margin-top:12px;}
  .footer-links a{font-size:12px;color:#7F77DD;text-decoration:none;margin:0 10px;}

  @media(max-width:600px){
    .wrapper{margin:0;border-radius:0;}
    .header,.body,.footer{padding-left:24px;padding-right:24px;}
    .info-grid{grid-template-columns:1fr;}
    .dates-row{flex-direction:column;gap:12px;}
    .dates-arrow{transform:rotate(90deg);}
    .contact-row{flex-direction:column;}
    .status-banner{padding:24px;}
  }
</style>
</head>
<body>
<div class="wrapper">

  <!-- Header -->
  <div class="header">
    <div class="logo">Trip<span>X</span></div>
    <div class="header-tag">
      <div class="header-dot" style="width:8px;height:8px;background:#10b981;border-radius:50%;box-shadow:0 0 8px rgba(16,185,129,0.8);"></div>
      <span class="header-tag-text">BOOKING CONFIRMATION</span>
    </div>
  </div>

  <!-- Status Banner -->
  <div class="status-banner">
    <span class="status-icon">✅</span>
    <div class="status-title">Your booking is confirmed!</div>
    <div class="status-sub">Everything is set. We can't wait to welcome you.</div>
  </div>

  <!-- Body -->
  <div class="body">

    <div class="greeting">Hi {{ userName }} 👋</div>
    <p class="intro">
      Great news — your reservation at <strong>{{ accName }}</strong> has been officially confirmed by our team.
      Below you'll find all the details of your upcoming stay. Please keep this email as your booking reference.
    </p>

    <!-- Booking Card -->
    <div class="booking-card">
      <div class="booking-card-header">
        <span class="booking-card-header-icon">🏨</span>
        <span class="booking-card-header-title">Booking Details</span>
        <span class="booking-card-header-id">Ref #{{ bookingId }}</span>
      </div>
      <div class="booking-card-body">

        <!-- Accommodation -->
        <div class="acc-section">
          <span class="acc-icon">🏨</span>
          <div>
            <div class="acc-name">{{ accName }}</div>
            <div class="acc-stars">
                {% for i in 1..accStars %}★{% endfor %}
                {% for i in 1..(5 - accStars) %}☆{% endfor %}
            </div>
            <div class="acc-meta">
              <span>📍 {{ accCity }}, {{ accCountry }}</span>
              {% if accAddress %}<span>{{ accAddress }}</span>{% endif %}
            </div>
          </div>
        </div>

        <!-- Dates -->
        <div class="dates-row">
          <div class="date-box">
            <div class="date-box-label">Check-in</div>
            <div class="date-box-value">{{ checkIn|date('d MMM') }}</div>
            <div class="date-box-day">{{ checkIn|date('l, Y') }}</div>
          </div>
          <div class="dates-arrow">→</div>
          <div class="date-box">
            <div class="date-box-label">Check-out</div>
            <div class="date-box-value">{{ checkOut|date('d MMM') }}</div>
            <div class="date-box-day">{{ checkOut|date('l, Y') }}</div>
          </div>
          <div class="dates-arrow" style="font-size:13px;">
            <span class="nights-pill">{{ nights }} night{{ nights != 1 ? 's' : '' }}</span>
          </div>
        </div>

        <!-- Info Grid -->
        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Room</div>
            <div class="info-value">{{ roomName }}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Room Type</div>
            <div class="info-value">{{ roomType }}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Guests</div>
            <div class="info-value">{{ guests }} guest{{ guests != 1 ? 's' : '' }}</div>
          </div>
          {% if arrivalTime %}
          <div class="info-item">
            <div class="info-label">Est. Arrival</div>
            <div class="info-value accent">{{ arrivalTime }}</div>
          </div>
          {% endif %}
          <div class="info-item" style="grid-column:span 2;">
            <div class="info-label">Total Amount</div>
            <div class="info-value price">€{{ totalPrice|number_format(2) }}</div>
          </div>
        </div>

        {% if specialRequests %}
        <div class="special-box">
          <div class="special-box-label">💬 Special Requests Noted</div>
          <div class="special-box-text">{{ specialRequests }}</div>
        </div>
        {% endif %}

      </div>
    </div>

    <!-- What's Next -->
    <div class="next-section">
      <div class="section-title">What's Next</div>
      <div class="next-item">
        <div class="next-dot">1</div>
        <div class="next-text"><strong>Save this email</strong> — Use booking reference <strong>#{{ bookingId }}</strong> for any enquiries.</div>
      </div>
      <div class="next-item">
        <div class="next-dot">2</div>
        <div class="next-text"><strong>Check-in on {{ checkIn|date('D, d M Y') }}</strong> — The property team will be ready to welcome you.</div>
      </div>
      <div class="next-item">
        <div class="next-dot">3</div>
        <div class="next-text"><strong>Need anything?</strong> — Contact the property directly or reach our support team.</div>
      </div>
    </div>

    <hr class="divider"/>

    <!-- Property Contact -->
    {% if accPhone or accEmail %}
    <div class="contact-row">
      {% if accPhone %}
      <div class="contact-item">
        <div class="contact-item-icon">📞</div>
        <div class="contact-item-label">Property Phone</div>
        <div class="contact-item-val">{{ accPhone }}</div>
      </div>
      {% endif %}
      {% if accEmail %}
      <div class="contact-item">
        <div class="contact-item-icon">✉️</div>
        <div class="contact-item-label">Property Email</div>
        <div class="contact-item-val">{{ accEmail }}</div>
      </div>
      {% endif %}
      <div class="contact-item">
        <div class="contact-item-icon">🌐</div>
        <div class="contact-item-label">Support</div>
        <div class="contact-item-val">support@tripx.com</div>
      </div>
    </div>
    {% endif %}

  </div>

  <!-- Footer -->
  <div class="footer">
    <div class="footer-logo">Trip<span>X</span></div>
    <div class="footer-text">
      This confirmation was sent to <strong>{{ userEmail }}</strong><br/>
      You're receiving this because you made a booking on TripX.<br/>
      © {{ year }} TripX. All rights reserved.
    </div>
    <div class="footer-links">
      <a href="#">My Bookings</a>
      <a href="#">Support</a>
      <a href="#">Privacy Policy</a>
    </div>
  </div>

</div>
</body>
</html>