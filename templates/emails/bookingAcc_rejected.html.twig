<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Booking Update — TripX</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:#f0f4f8;font-family:'Inter',Arial,sans-serif;color:#1a1a2e;-webkit-font-smoothing:antialiased;}

  .wrapper{max-width:620px;margin:40px auto;background:#ffffff;border-radius:24px;overflow:hidden;
           box-shadow:0 20px 60px rgba(0,0,0,0.10);}

  .header{background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);padding:40px 48px 36px;text-align:center;position:relative;overflow:hidden;}
  .header::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;
                  background:radial-gradient(circle,rgba(239,68,68,0.2) 0%,transparent 70%);border-radius:50%;}
  .logo{font-size:28px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;position:relative;z-index:1;}
  .logo span{color:#f87171;}
  .header-tag{display:inline-flex;align-items:center;gap:8px;margin-top:20px;padding:8px 20px;
              background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.35);
              border-radius:40px;position:relative;z-index:1;}
  .header-tag-text{font-size:13px;font-weight:600;color:#fca5a5;letter-spacing:0.5px;}

  .status-banner{background:linear-gradient(135deg,#fff5f5 0%,#fee2e2 100%);
                 border-bottom:3px solid #ef4444;padding:28px 48px;text-align:center;}
  .status-icon{font-size:48px;margin-bottom:12px;display:block;}
  .status-title{font-size:24px;font-weight:800;color:#991b1b;margin-bottom:6px;}
  .status-sub{font-size:14px;color:#b91c1c;font-weight:500;}

  .body{padding:40px 48px;}
  .greeting{font-size:18px;font-weight:700;color:#1a1a2e;margin-bottom:8px;}
  .intro{font-size:14px;color:#64748b;line-height:1.7;margin-bottom:32px;}

  .booking-card{background:linear-gradient(135deg,#f8fafc 0%,#f1f5f9 100%);
                border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;margin-bottom:28px;}
  .booking-card-header{background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);
                       padding:16px 24px;display:flex;align-items:center;gap:12px;}
  .booking-card-header-title{font-size:14px;font-weight:700;color:#ffffff;}
  .booking-card-header-id{font-size:12px;color:rgba(255,255,255,0.75);margin-left:auto;}
  .booking-card-body{padding:24px;}

  .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
  .info-item{background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;}
  .info-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;margin-bottom:5px;}
  .info-value{font-size:14px;font-weight:700;color:#9ca3af;text-decoration:line-through;}

  .acc-section{background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;
               padding:16px 20px;margin-bottom:20px;display:flex;align-items:flex-start;gap:16px;}
  .acc-name{font-size:16px;font-weight:700;color:#1e293b;margin-bottom:4px;}
  .acc-meta{font-size:12px;color:#64748b;}

  .reason-box{background:#fef2f2;border:1px solid #fecaca;border-left:4px solid #ef4444;
              border-radius:12px;padding:16px 20px;margin-bottom:20px;}
  .reason-box-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#991b1b;margin-bottom:8px;}
  .reason-box-text{font-size:13px;color:#7f1d1d;line-height:1.6;}

  .apology-box{background:linear-gradient(135deg,#f5f3ff 0%,#ede9fe 100%);
               border:1px solid #ddd6fe;border-radius:16px;padding:24px;margin-bottom:28px;}
  .apology-icon{font-size:32px;margin-bottom:12px;}
  .apology-title{font-size:15px;font-weight:700;color:#4c1d95;margin-bottom:8px;}
  .apology-text{font-size:13px;color:#5b21b6;line-height:1.7;margin-bottom:16px;}
  .apology-btn{display:inline-block;padding:12px 32px;
               background:linear-gradient(135deg,#7F77DD 0%,#6366f1 100%);
               color:#ffffff;text-decoration:none;border-radius:40px;
               font-size:13px;font-weight:700;box-shadow:0 8px 20px rgba(127,119,221,0.35);}

  .divider{border:none;border-top:1px solid #f1f5f9;margin:28px 0;}

  .contact-row{display:flex;gap:16px;margin-bottom:28px;}
  .contact-item{flex:1;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;text-align:center;}
  .contact-item-icon{font-size:20px;margin-bottom:6px;}
  .contact-item-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;margin-bottom:4px;}
  .contact-item-val{font-size:12px;font-weight:600;color:#334155;}

  .footer{background:#f8fafc;border-top:1px solid #e2e8f0;padding:28px 48px;text-align:center;}
  .footer-logo{font-size:18px;font-weight:800;color:#334155;margin-bottom:10px;}
  .footer-logo span{color:#f87171;}
  .footer-text{font-size:12px;color:#94a3b8;line-height:1.8;}
  .footer-links a{font-size:12px;color:#7F77DD;text-decoration:none;margin:0 10px;}

  @media(max-width:600px){
    .wrapper{margin:0;border-radius:0;}
    .header,.body,.footer{padding-left:24px;padding-right:24px;}
    .info-grid{grid-template-columns:1fr;}
    .contact-row{flex-direction:column;}
  }
</style>
</head>
<body>
<div class="wrapper">

  <div class="header">
    <div class="logo">Trip<span>X</span></div>
    <div class="header-tag">
      <span class="header-tag-text">BOOKING UPDATE</span>
    </div>
  </div>

  <div class="status-banner">
    <span class="status-icon">❌</span>
    <div class="status-title">Booking Not Approved</div>
    <div class="status-sub">We were unable to confirm your reservation at this time.</div>
  </div>

  <div class="body">

    <div class="greeting">Hi {{ userName }},</div>
    <p class="intro">
      We regret to inform you that your booking request at <strong>{{ accName }}</strong>
      (Ref <strong>#{{ bookingId }}</strong>) could not be approved.
      We sincerely apologise for any inconvenience this may cause.
    </p>

    <div class="booking-card">
      <div class="booking-card-header">
        <span style="font-size:20px;">📋</span>
        <span class="booking-card-header-title">Booking Request Details</span>
        <span class="booking-card-header-id">Ref #{{ bookingId }}</span>
      </div>
      <div class="booking-card-body">

        <div class="acc-section">
          <span style="font-size:32px;flex-shrink:0;">🏨</span>
          <div>
            <div class="acc-name">{{ accName }}</div>
            <div class="acc-meta">📍 {{ accCity }}, {{ accCountry }}</div>
          </div>
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Check-in</div>
            <div class="info-value">{{ checkIn|date('D, d M Y') }}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Check-out</div>
            <div class="info-value">{{ checkOut|date('D, d M Y') }}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Room</div>
            <div class="info-value">{{ roomName }}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Guests</div>
            <div class="info-value">{{ guests }}</div>
          </div>
        </div>

        {% if rejectionReason %}
        <div class="reason-box">
          <div class="reason-box-label">❌ Reason for Rejection</div>
          <div class="reason-box-text">{{ rejectionReason }}</div>
        </div>
        {% endif %}

      </div>
    </div>

    <!-- Apology + Rebook -->
    <div class="apology-box">
      <div class="apology-icon">💜</div>
      <div class="apology-title">We'd love to help you find an alternative</div>
      <div class="apology-text">
        Our team is committed to finding you the perfect stay.
        Browse our curated selection of verified accommodations and
        find something that fits your dates and preferences perfectly.
      </div>
      <a href="#" class="apology-btn">🔍 Find Alternative Stays</a>
    </div>

    <hr class="divider"/>

    <div class="contact-row">
      <div class="contact-item">
        <div class="contact-item-icon">💬</div>
        <div class="contact-item-label">Live Chat</div>
        <div class="contact-item-val">Available 24/7</div>
      </div>
      <div class="contact-item">
        <div class="contact-item-icon">✉️</div>
        <div class="contact-item-label">Email Support</div>
        <div class="contact-item-val">support@tripx.com</div>
      </div>
    </div>

  </div>

  <div class="footer">
    <div class="footer-logo">Trip<span>X</span></div>
    <div class="footer-text">
      Sent to <strong>{{ userEmail }}</strong><br/>
      © {{ year }} TripX. All rights reserved.
    </div>
    <div class="footer-links" style="margin-top:12px;">
      <a href="#">My Bookings</a>
      <a href="#">Support</a>
      <a href="#">Privacy Policy</a>
    </div>
  </div>

</div>
</body>
</html>
