<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f8fafc; margin: 0; padding: 20px; color: #1e293b; }
        .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .header { background: linear-gradient(135deg, #6366f1, #8b5cf6); padding: 30px 20px; text-align: center; color: white; }
        .header h1 { margin: 0; font-size: 24px; font-weight: bold; }
        .header p { margin: 8px 0 0; opacity: 0.9; font-size: 14px; }
        .content { padding: 30px; }
        .content h2 { margin-top: 0; font-size: 18px; color: #0f172a; }
        .table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table th { text-align: left; padding: 12px; border-bottom: 2px solid #e2e8f0; color: #64748b; font-size: 13px; text-transform: uppercase; }
        .table td { padding: 12px; border-bottom: 1px solid #e2e8f0; font-weight: 500; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; }
        .badge-pending { background: #fef3c7; color: #92400e; }
        .badge-confirmed { background: #d1fae5; color: #065f46; }
        .footer { background: #1f2937; color: #9ca3af; text-align: center; padding: 20px; font-size: 12px; margin-top: 30px; border-radius: 0 0 12px 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🌍 Booking Confirmation</h1>
            <p>Your destination booking has been received!</p>
        </div>
        <div class="content">
            <h2>Booking Reference: {{ booking.bookingReference }}</h2>
            <p>Thank you for booking with TripX! Here are the details of your reservation:</p>

            <table class="table">
                <tr>
                    <th>Destination</th>
                    <td>{{ destination.name }} — {{ destination.city }}, {{ destination.country }}</td>
                </tr>
                <tr>
                    <th>Destination Type</th>
                    <td>{{ destination.type|capitalize }}</td>
                </tr>
                <tr>
                    <th>Check-in</th>
                    <td>{{ booking.startAt|date('M d, Y') }}</td>
                </tr>
                <tr>
                    <th>Check-out</th>
                    <td>{{ booking.endAt ? booking.endAt|date('M d, Y') : '—' }}</td>
                </tr>
                <tr>
                    <th>Guests</th>
                    <td>{{ booking.numGuests }} Guest(s)</td>
                </tr>
                <tr>
                    <th>Total Amount</th>
                    <td><strong>{{ booking.totalAmount|number_format(2) }} {{ booking.currency }}</strong></td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>
                        <span class="badge badge-{{ booking.status }}">
                            {{ booking.status|upper }}
                        </span>
                    </td>
                </tr>
                {% if booking.notes %}
                <tr>
                    <th>Notes</th>
                    <td>{{ booking.notes }}</td>
                </tr>
                {% endif %}
            </table>

            <p style="margin-top: 25px; line-height: 1.6;">
                Your booking is currently <strong>pending</strong> and will be reviewed by our team shortly.
                You will receive another email once it is confirmed.
            </p>
            <p style="line-height: 1.6;">
                You can view and manage your bookings from the <strong>My Bookings</strong> section on the TripX portal.
            </p>
        </div>
        <div class="footer">
            TripX Destinations<br>
            contact@tripx.com | +1-800-TRIPX-88<br>
            &copy; {{ "now"|date("Y") }} TripX — All rights reserved.
        </div>
    </div>
</body>
</html>
