      const newUrl = `https://api.dicebear.com/9.x/${style}/svg?seed=user_{{ user.userId }}&size=120&radius=100`;
      
      if (img) {
        img.style.opacity = '0.3';
        setTimeout(() => {
          img.src = newUrl;
          img.style.opacity = '1';
        }, 150);
      }
      
