<script>
document.addEventListener('DOMContentLoaded', function() {
  window.__ariaChatInitialized = true;

  // ════════════════════════════════════════════
  // PASSWORD TOGGLE
  // ════════════════════════════════════════════
  const toggleBtn = document.getElementById('togglePasswordBtn');
  const pwdSection = document.getElementById('password-change-section');
  if (toggleBtn && pwdSection) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = pwdSection.style.display === 'none';
      pwdSection.style.display = isHidden ? 'block' : 'none';
      if (isHidden) pwdSection.scrollIntoView({ behavior: 'smooth' });
    });
  }

  // ════════════════════════════════════════════
  // WAVY UI CUSTOM ERRORS
  // ════════════════════════════════════════════
  function showError(input, message) {
    clearError(input);
    const err = document.createElement('div');
    err.className = 'wavy-error-msg';
    err.style.cssText = 'color: #ef4444; font-size: 11px; position: absolute; bottom: -24px; left: 0; pointer-events: none; animation: slideUp 0.3s ease;';
    err.innerText = message;
    input.parentNode.appendChild(err);
    if(input.style) input.style.borderBottomColor = '#ef4444';
    input.parentNode.classList.add('error');
  }

  function clearError(input) {
    const parent = input.parentNode;
    const msg = parent.querySelector('.wavy-error-msg');
    if (msg) msg.remove();
    if(input.style) input.style.borderBottomColor = ''; 
    input.parentNode.classList.remove('error');
  }

  // Clear errors on input
  document.querySelectorAll('input').forEach(inp => {
     inp.addEventListener('input', () => clearError(inp));
  });

  // ════════════════════════════════════════════
  // SAVE PROFILE (Upgraded for Wavy Inputs)
  // ════════════════════════════════════════════
  document.getElementById('saveProfileBtn')?.addEventListener('click', () => {
    const btn = document.getElementById('saveProfileBtn');
    
    let valid = true;
    const fName = document.getElementById('profile_first_name');
    const lName = document.getElementById('profile_last_name');
    const email = document.getElementById('profile_email');
    const phone = document.getElementById('profile_phone');
    
    if (!fName.value.trim()) { showError(fName, 'First name is required'); valid = false; }
    if (!lName.value.trim()) { showError(lName, 'Last name is required'); valid = false; }
    if (!email.value.trim() || !email.value.includes('@')) { showError(email, 'Valid email is required'); valid = false; }
    if (phone.value.trim() && !/^\d{8}$/.test(phone.value.trim())) { showError(phone, 'Phone number must be exactly 8 digits'); valid = false; }
    
    if (!valid) return;

    const origText = btn.innerText;
    
    const data = {
      firstName: fName.value.trim(),
      lastName:  lName.value.trim(),
      email:     email.value.trim(),
      phone:     phone.value.trim(),
      bio:       document.getElementById('profile_bio')?.value || ''
    };

    btn.innerText = 'Saving...';
    fetch('/profile/update', { 
      method:'POST', 
      headers:{'Content-Type':'application/json'}, 
      body:JSON.stringify(payload) 
    })
    .then(r=>r.json())
    .then(res => {
      btn.innerText = origText;
      if (res.success) {
        showToast('✅ Profile updated successfully!');
        
        // Update live theme without reload
        const dynamicEnabled = document.getElementById('profile_dynamic_theme').checked;
        document.body.setAttribute('data-dynamic-theme', dynamicEnabled ? '1' : '0');
        
        setTimeout(() => { btn.innerText = origText; btn.disabled = false; }, 2000);
      } else {
          showToast('❌ ' + (res.error || 'Update failed.'));
      }
    });
  });

  // Old collectTravelPrefs and savePreferencesBtn removed to avoid duplication with the new chip-based logic below

  document.querySelectorAll('.front-toggle-pw').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      const input = document.getElementById(targetId);
      if (!input) return;
      const isText = input.type === 'text';
      input.type = isText ? 'password' : 'text';
      btn.innerHTML = isText ? '<i class="far fa-eye"></i>' : '<i class="far fa-eye-slash"></i>';
    });
  });

  document.getElementById('confirmPasswordBtn')?.addEventListener('click', () => {
    let valid = true;
    const p1El = document.getElementById('new_password');
    const p2El = document.getElementById('confirm_password');
    const p1 = p1El.value;
    const p2 = p2El.value;
    
    if (!p1 || p1.trim() === '') {
      showError(p1El, 'Please enter a password.');
      valid = false;
    } else if (p1.length < 8) {
      showError(p1El, 'Password must contain at least 8 characters.');
      valid = false;
    }
    if (p1 !== p2) {
      showError(p2El, 'Passwords do not match.');
      valid = false;
    }
    
    if(!valid) return;

    fetch('/profile/password', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({password:p1}) })
      .then(r=>r.json()).then(res => {
        if (res.success) {
          showToast('✅ Password updated!');
          pwdSection.style.display = 'none';
          document.getElementById('new_password').value = '';
          document.getElementById('confirm_password').value = '';
        } else { showToast('❌ Error updating password.'); }
      });
  });

  document.getElementById('deleteAccountBtn')?.addEventListener('click', () => {
    if (!confirm('Delete your account? This action cannot be undone.')) return;
    fetch('/profile/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:'{}' })
      .then(r=>r.json())
      .then(res => {
        if (res.success) {
          showToast('✅ Account deleted.');
