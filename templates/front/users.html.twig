          showToast('⚠️ ' + (data.error || 'Update failed'), true);
          saveProfileBtn.textContent = origText;
          saveProfileBtn.disabled = false;
        }
      })
      .catch(() => {
        showToast('⚠️ Network error', true);
        saveProfileBtn.textContent = origText;
        saveProfileBtn.disabled = false;
      });
