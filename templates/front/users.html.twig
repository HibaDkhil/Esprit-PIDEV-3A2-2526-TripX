  const btnFiche = document.getElementById('btn-generate-fiche');
  const modalFiche = document.getElementById('modal-ai-fiche');
  const ficheArea = document.getElementById('fiche-content-area');

  if (btnFiche && modalFiche) {
    btnFiche.addEventListener('click', () => {
      modalFiche.classList.add('open');
      ficheArea.innerHTML = '<p style="text-align:center; color:#9ca3af; padding:40px;">Analyzing patterns...</p>';
      
      fetch('/profile/report/generate')
