                if (report.loyalty) {
                    html += `<div style="background:rgba(244,185,66,0.1); border: 1px solid rgba(244,185,66,0.3); padding:24px; border-radius:12px; margin-bottom:24px; text-align:center;">
                                <h5 style="color: #f4b942; text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;">Reward Unlocked!</h5>
                                <p style="color: #e5e7eb; margin-bottom: 16px; font-size: 0.95rem;">With an engagement score of <strong>${report.stats.engagement}</strong> and <strong>${report.loyalty.points}</strong> loyalty points computed from your bookings and visits, you've earned a special gift:</p>
                                <div style="font-size: 1.5rem; font-weight: bold; color: #fff; margin-bottom: 12px;">🎁 ${report.loyalty.reward}</div>
                                <p style="font-size: 0.8rem; color: rgba(255,255,255,0.5);">Print or download this PDF to claim your reward at your destination or checkout.</p>
                             </div>`;
                }

                html += `<h5 style="color:#fff;">Aria's Picks</h5><div style="display:flex; flex-direction:column; gap:10px;">`;
                report.picks.forEach(p => {
                   html += `<div style="display:flex; align-items:center; gap:12px; padding:12px; border:1px solid rgba(255,255,255,0.1); border-radius:8px; background:rgba(0,0,0,0.2);">
                              <span style="font-size: 24px;">${p.emoji}</span><div style="flex:1"><strong style="color:#fff;">${p.name}</strong><br><small style="color:#9ca3af">${p.desc}</small></div>
                              <span style="margin-left:auto; color:#00a6ed; font-weight: bold;">${p.match}%</span>
                            </div>`;
                });
                html += `</div>`;
                ficheArea.innerHTML = html;
            }
        });
    });

    document.getElementById('btn-close-fiche-backdrop')?.addEventListener('click', () => modalFiche.classList.remove('open'));
    document.getElementById('btn-close-fiche-trigger')?.addEventListener('click', () => modalFiche.classList.remove('open'));
    
    document.getElementById('btn-download-pdf')?.addEventListener('click', () => {
      window.open('/profile/report/export', '_blank');
    });
  }

});

// Disable 2FA
const disable2faBtn = document.getElementById('disable2faBtn');
if (disable2faBtn) {
  disable2faBtn.addEventListener('click', async function() {
    if (!confirm('Are you sure you want to disable Two-Factor Authentication? This will reduce your account security.')) {
      return;
    }
    
    // Fallback to manual AJAX using raw fetch since there's no pre-built endpoint
    try {
      const response = await fetch('{{ path('profile_2fa_disable') }}', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      const data = await response.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to disable 2FA');
      }
    } catch (e) {
      alert('Network error. Could not disable 2FA.');
    }
  });
}
</script>
