        .then(data => {
            if (data.success) {
                const report = data.report;
                let html = `<div style="text-align:center; margin-bottom:24px;"><div style="font-size:48px;">${report.emoji}</div><h3 style="color:#fff;">${report.persona}</h3></div>`;
