        labels: ['Pace', 'Climate Match', 'Group Fit', 'AI Affinity', 'Explorer Depth'],
        datasets: [{
          label: 'Travel DNA',
          data: radarData,
          borderColor: '#00a6ed',
          backgroundColor: 'rgba(0,166,237,0.2)',
          pointBackgroundColor: '#ff4d6d'
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          r: {
            suggestedMin: 0,
            suggestedMax: 100,
            angleLines: { color: 'rgba(255,255,255,0.08)' },
