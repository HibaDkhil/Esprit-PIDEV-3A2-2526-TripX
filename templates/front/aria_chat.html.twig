{# Generic style for orb icon image if needed #}
<style>
  #aria-orb .orb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 50% !important;
    position: relative !important;
    z-index: 10 !important;
  }
</style>

<link rel="stylesheet" href="/assets.php?f=css/Chatassis.css&v={{ 'now'|date('U') }}">

<button class="aria-orb" id="aria-orb" aria-label="Open ARIA">
  <div class="orb-core"></div>
  <div class="orb-ring"></div>  
  <div class="orb-pulse"></div>
  <img src="{{ asset('images/Aria.png') }}" class="orb-img" alt="Aria">
</button>

<div class="aria-panel" id="aria-panel">
  <div class="aria-header">
    <div class="aria-avatar">
      <div class="avatar-glow"></div>
      <img src="{{ asset('images/Aria.png') }}" style="width:100%; height:100%; object-fit:cover; border-radius:50%; position:relative; z-index:1;">
    </div>
    <div class="aria-info">
      <span class="aria-name">ARIA</span>
      <span class="aria-status">Global Intelligence</span>
    </div>
    <button class="aria-close-btn" id="aria-close">✕</button>
  </div>

  <div class="aria-messages" id="aria-messages">
    <div class="aria-msg bot">
      <div class="aria-bubble">
        {% if app.user %}
          Hi {{ app.user.firstName }}! How are you? How can I help you today? ✨
        {% else %}
          Hi there! How are you? How can I help you today? ✨
        {% endif %}
      </div>
    </div>
  </div>

  <div class="aria-img-preview" id="aria-img-preview" style="display:none; padding: 0 20px 10px; position:relative;">
    <img id="aria-preview-img" src="" alt="preview" style="width:60px;height:60px;object-fit:cover;border-radius:10px;border:2px solid rgba(0,229,255,0.4);">
    <button id="aria-remove-img" style="position:absolute;top:-8px;left:68px;width:20px;height:20px;background:#ff4d6d;color:#fff;border:none;border-radius:50%;cursor:pointer;font-size:11px;display:flex;align-items:center;justify-content:center;">✕</button>
  </div>

  <div class="aria-input-row">
    <button class="aria-upload" id="aria-attach-btn" title="Attach image">📎</button>
    <input type="file" id="aria-file-input" accept="image/*" style="display:none">
    <input class="aria-input" id="aria-input" type="text" placeholder="Ask ARIA anything...">
    <button class="aria-stop" id="aria-stop" title="Stop speaking">■</button>
    <button class="aria-mic" id="aria-mic" title="Voice input">🎤</button>
    <button class="aria-send" id="aria-send">➤</button>
  </div>
</div>

<script>
(function() {
  'use strict';
  if (window.__ariaInitDone) return;
  window.__ariaInitDone = true;

  function init() {
    var orb      = document.getElementById('aria-orb');
    var panel    = document.getElementById('aria-panel');
    var closeBtn = document.getElementById('aria-close');
    var input    = document.getElementById('aria-input');
    var sendBtn  = document.getElementById('aria-send');
    var messages = document.getElementById('aria-messages');
    var attachBtn= document.getElementById('aria-attach-btn');
    var fileInput= document.getElementById('aria-file-input');
    var imgPrev  = document.getElementById('aria-img-preview');
    var prevImg  = document.getElementById('aria-preview-img');
    var removeImg= document.getElementById('aria-remove-img');
    var micBtn   = document.getElementById('aria-mic');
    var stopBtn  = document.getElementById('aria-stop');

    if (!orb || !panel) return;

    var selectedImg  = null;
    var selectedMime = null;
    var chatHistory  = [];

    // ── open / close ──────────────────────────────
    orb.addEventListener('click', function() {
      var isOpen = panel.style.display === 'flex';
      if (isOpen) {
        panel.style.display = 'none';
      } else {
        panel.style.display = 'flex';
        scrollBottom();
      }
    });

    closeBtn && closeBtn.addEventListener('click', function() {
      panel.style.display = 'none';
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    });

    stopBtn && stopBtn.addEventListener('click', function() {
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    });

    // ── voice input ───────────────────────────────
    var isListening = false;
    var recognition = null;
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = 'en-US';

      recognition.onstart = function() {
        isListening = true;
        micBtn.classList.add('listening');
        micBtn.textContent = '🛑';
      };

      recognition.onresult = function(event) {
        var transcript = event.results[0][0].transcript;
        input.value = transcript;
      };

      recognition.onerror = function() {
        stopListening();
      };

      recognition.onend = function() {
        stopListening();
        if (input.value.trim().length > 0) {
          sendMessage();
        }
      };
    }

    function stopListening() {
      isListening = false;
      micBtn.classList.remove('listening');
      micBtn.textContent = '🎤';
    }

    micBtn && micBtn.addEventListener('click', function() {
      if (!recognition) {
        alert("Speech Recognition not supported.");
        return;
      }
      if (isListening) {
        recognition.stop();
      } else {
        recognition.start();
      }
    });

    // ── image attach ──────────────────────────────
    attachBtn && attachBtn.addEventListener('click', function() {
      fileInput && fileInput.click();
    });

    fileInput && fileInput.addEventListener('change', function() {
      var file = fileInput.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(e) {
        var dataUrl = e.target.result;
        selectedImg  = dataUrl.split(',')[1];
        selectedMime = file.type;
        prevImg.src  = dataUrl;
        imgPrev.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });

    removeImg && removeImg.addEventListener('click', function() {
      selectedImg = selectedMime = null;
      fileInput.value = '';
      imgPrev.style.display = 'none';
      prevImg.src = '';
    });

    function sendMessage() {
      var text = input.value.trim();
      if (!text && !selectedImg) return;

      addBubble('user', text, selectedImg ? prevImg.src : null);
      chatHistory.push({ role: 'user', content: text });
      if (chatHistory.length > 12) chatHistory.shift();

      input.value = '';
      var imgToSend  = selectedImg;
      var mimeToSend = selectedMime;
      selectedImg = selectedMime = null;
      fileInput.value = '';
      imgPrev.style.display = 'none';
      prevImg.src = '';

      addLoadingIndicator();

      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin',
        body: JSON.stringify({
          message: text,
          image: imgToSend,
          imageMimeType: mimeToSend,
          history: chatHistory,
          pageContext: getPageContext()
        })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        removeLoadingIndicator();
        var resp = data.response || data.error || 'No response.';
        addBubble('bot', resp);
        chatHistory.push({ role: 'bot', content: resp });
        if (window.TRIPX_ARIA && window.TRIPX_ARIA.speak) {
            window.TRIPX_ARIA.speak(resp);
        }
      })
      .catch(function() {
        removeLoadingIndicator();
        addBubble('bot', '⚠️ Connection error.');
      });
    }

    function getPageContext() {
      return { url: window.location.href, title: document.title, route: document.body.dataset.route || '' };
    }

    var typingIndicator = null;
    function addLoadingIndicator() {
      typingIndicator = document.createElement('div');
      typingIndicator.className = 'aria-msg bot';
      typingIndicator.innerHTML = '<div class="aria-bubble" style="color:#00e5ff;letter-spacing:2px;font-weight:bold">...</div>';
      messages.appendChild(typingIndicator);
      scrollBottom();
    }
    function removeLoadingIndicator() {
      if (typingIndicator) { typingIndicator.remove(); typingIndicator = null; }
    }

    sendBtn  && sendBtn.addEventListener('click', sendMessage);
    input    && input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });

    function addBubble(role, text, imgSrc) {
      var wrap = document.createElement('div');
      wrap.className = 'aria-msg ' + role;
      if (imgSrc) {
        var img = document.createElement('img');
        img.src = imgSrc;
        img.style.cssText = 'max-width:120px;border-radius:8px;margin-bottom:6px;display:block;';
        wrap.appendChild(img);
      }
      if (text) {
        var bubble = document.createElement('div');
        bubble.className = 'aria-bubble';
        bubble.textContent = text;
        wrap.appendChild(bubble);
      }
      messages.appendChild(wrap);
      scrollBottom();
    }

    function scrollBottom() {
      if (messages) messages.scrollTop = messages.scrollHeight;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>