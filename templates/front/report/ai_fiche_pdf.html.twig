<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Helvetica, sans-serif; color: #333; line-height: 1.5; padding: 40px; }
        .header { text-align: center; border-bottom: 2px solid #00a6ed; padding-bottom: 20px; margin-bottom: 30px; }
        .logo { font-size: 28px; font-weight: bold; color: #00a6ed; margin-bottom: 5px; }
        .tagline { font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 2px; }
        
        .report-title { text-align: center; margin-bottom: 40px; }
        .persona-box { background: #f0f7ff; border: 1px solid #cce3ff; border-radius: 12px; padding: 25px; margin-bottom: 30px; text-align: center; }
        .persona-emoji { font-size: 50px; margin-bottom: 10px; }
        .persona-name { font-size: 24px; font-weight: bold; color: #00a6ed; margin-bottom: 5px; }
        
        .section-title { font-size: 14px; color: #00a6ed; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 5px; }
        .content { font-size: 14px; margin-bottom: 25px; }
        
        .stats-grid { display: block; margin-bottom: 30px; }
        .stat-item { display: inline-block; width: 30%; text-align: center; padding: 15px 0; background: #fafafa; border-radius: 8px; margin-right: 2%; }
        .stat-val { font-size: 20px; font-weight: bold; display: block; }
        .stat-lbl { font-size: 10px; color: #666; text-transform: uppercase; }
        
        .pick-item { margin-bottom: 15px; padding: 15px; border: 1px solid #eee; border-radius: 8px; }
        .pick-name { font-weight: bold; font-size: 14px; }
        .pick-desc { font-size: 12px; color: #666; }
        
        .footer { position: fixed; bottom: 0; left: 0; right: 0; font-size: 10px; color: #999; text-align: center; padding-top: 10px; border-top: 1px solid #eee; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">TripX Intelligence</div>
        <div class="tagline">Behavioral DNA Report</div>
    </div>

    <div class="report-title">
        <p style="font-size: 12px; color: #999; margin: 0;">PREPARED FOR</p>
        <h2 style="margin: 5px 0 0 0;">{{ report.userName|upper }}</h2>
        <p style="font-size: 10px; color: #666;">Generated on {{ report.generatedDate }}</p>
    </div>

    <div class="persona-box">
        <div class="persona-name">{{ report.persona }}</div>
        <div style="font-size: 13px; color: #555;">Engagement Score: {{ report.stats.engagement }}/100</div>
    </div>

    <div class="section-title">Aria's Behavioral Insights</div>
    <div class="content">
        {{ report.insights }}
    </div>

    {% if report.loyalty and report.loyalty.reward %}
    <div style="background: #fff8e8; border: 1px solid #f4b942; border-radius: 12px; padding: 25px; margin-bottom: 30px; text-align: center;">
        <h4 style="color: #cc8400; margin-top: 0; text-transform: uppercase; letter-spacing: 2px;">Voucher Unlocked! 🏆</h4>
        <p style="font-size: 13px; color: #555;">With <strong>{{ report.loyalty.points }}</strong> loyalty points, you've earned a special reward from TripX Intelligence:</p>
        <div style="font-size: 18px; font-weight: bold; color: #333; margin: 15px 0; background: #fff; padding: 10px; border: 1px dashed #f4b942; border-radius: 6px;">
            {{ report.loyalty.reward }}
        </div>
        <p style="font-size: 11px; color: #888; margin-bottom: 0;">Present this official AI Fiche to our partners or use the code at checkout.</p>
    </div>
    {% endif %}

    <div class="section-title">Platform Statistics</div>
    <div class="stats-grid">
        <div class="stat-item">
            <span class="stat-val">{{ report.stats.minutes }}</span>
            <span class="stat-lbl">Min. Logged</span>
        </div>
        <div class="stat-item">
            <span class="stat-val">{{ report.stats.visits }}</span>
            <span class="stat-lbl">Page Visits</span>
        </div>
        <div class="stat-item">
            <span class="stat-val">{{ report.stats.aiChats }}</span>
            <span class="stat-lbl">AI Chats</span>
        </div>
    </div>

    <div class="section-title">Strategic Path Recommendations</div>
    {% for pick in report.picks %}
        <div class="pick-item">
            <div style="display: table; width: 100%;">
                <div style="display: table-cell; width: 80%;">
                    <div class="pick-name">{{ pick.name }}</div>
                    <div class="pick-desc">{{ pick.desc }}</div>
                </div>
                <div style="display: table-cell; width: 20%; text-align: right; vertical-align: middle;">
                    <span style="color: #00a6ed; font-weight: bold; font-size: 14px;">{{ pick.match }}%</span>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="footer">
        © 2026 TripX Personal Intelligence. This report is strictly for {{ user.email }}.
    </div>
</body>
</html>