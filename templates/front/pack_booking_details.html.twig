{% extends 'base.html.twig' %}
{% block title %}Booking #{{ booking.idBooking }} — TripX{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .details-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 28px;
    align-items: start;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    margin-bottom: 20px;
  }

  .info-card-header {
    padding: 16px 22px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .info-card-header .section-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .info-card-header h3 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
  }

  .info-card-body { padding: 22px; }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-color);
    font-size: 14px;
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-label { color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }
  .detail-value { font-weight: 600; }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .stat-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 14px 16px;
    text-align: center;
  }

  .stat-box .stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 5px; }
  .stat-box .stat-value { font-family: var(--font-display); font-size: 18px; font-weight: 800; }

  .qr-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: 28px 24px;
    text-align: center;
    position: sticky;
    top: 24px;
  }

  .qr-card .qr-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .qr-card .qr-sub {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .qr-img-wrap {
    background: #fff;
    border-radius: 12px;
    padding: 16px;
    display: inline-block;
    margin-bottom: 18px;
    border: 1px solid var(--border-color);
  }

  .ref-badge {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent-primary);
    background: rgba(0,166,237,0.1);
    border: 1px solid rgba(0,166,237,0.25);
    border-radius: 8px;
    padding: 8px 16px;
    display: inline-block;
    margin-bottom: 18px;
  }

  .price-final {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 900;
    color: var(--accent-primary);
    line-height: 1;
  }
</style>
{% endblock %}

{% block body %}
<div class="container" style="padding: 40px 20px; max-width: 1000px; margin: 0 auto;">

  {# ── Back + Title ── #}
  <div style="margin-bottom: 28px;">
    <a href="{{ path('user_packs_offers', {section: 'bookings'}) }}"
       style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;margin-bottom:14px;">
      &larr; Back to My Bookings
    </a>
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
      <div>
        <div class="section-label" style="margin-bottom:6px;"><span>Booking Details</span></div>
        <h1 class="display-sm" style="margin-bottom:0;">
          {{ pack.title }}
        </h1>
      </div>
      {% set statusColor = {
        'PENDING':   '#f59e0b',
        'CONFIRMED': '#10b981',
        'CANCELLED': '#ef4444',
        'COMPLETED': '#6366f1'
      } %}
      {% set sc = statusColor[booking.status] ?? '#9ca3af' %}
      <span style="padding:8px 20px;border-radius:999px;font-size:12px;font-weight:800;text-transform:uppercase;
                   background:{{ sc }}22;color:{{ sc }};border:1px solid {{ sc }}44;">
        {{ booking.status }}
      </span>
    </div>
  </div>

  {# ── Two column layout ── #}
  <div class="details-grid">

    {# ── LEFT: Info cards ── #}
    <div>

      {# Reference #}
      <div class="info-card">
        <div class="info-card-header">
          <span class="section-num">01 /</span>
          <h3>Booking Reference</h3>
        </div>
        <div class="info-card-body">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
            <div>
              <div class="detail-label" style="margin-bottom:4px;">Reference Number</div>
              <div style="font-family:var(--font-mono);font-size:22px;font-weight:900;color:var(--accent-primary);letter-spacing:2px;">
                TRX-{{ booking.idBooking }}
              </div>
            </div>
            <div style="text-align:right;">
              <div class="detail-label" style="margin-bottom:4px;">Booked On</div>
              <div style="font-weight:600;">{{ booking.bookingDate|date('d F Y') }}</div>
            </div>
          </div>
        </div>
      </div>

      {# Trip Details #}
      <div class="info-card">
        <div class="info-card-header">
          <span class="section-num">02 /</span>
          <h3>Trip Details</h3>
        </div>
        <div class="info-card-body">
          <div class="stat-grid" style="margin-bottom:16px;">
            <div class="stat-box" style="border-top:3px solid #00a6ed;">
              <div class="stat-label">Departure</div>
              <div class="stat-value" style="font-size:14px;">{{ booking.travelStartDate|date('d M Y') }}</div>
            </div>
            <div class="stat-box" style="border-top:3px solid #10b981;">
              <div class="stat-label">Return</div>
              <div class="stat-value" style="font-size:14px;">{{ booking.travelEndDate|date('d M Y') }}</div>
            </div>
            <div class="stat-box" style="border-top:3px solid #6366f1;">
              <div class="stat-label">Duration</div>
              <div class="stat-value">{{ durationDays }} days</div>
            </div>
            <div class="stat-box" style="border-top:3px solid #f59e0b;">
              <div class="stat-label">Travelers</div>
              <div class="stat-value">{{ booking.numTravelers }}</div>
            </div>
          </div>

          {% if booking.notes %}
          <div style="background:var(--bg-surface);border:1px solid var(--border-color);border-radius:8px;padding:12px 16px;">
            <div class="detail-label" style="margin-bottom:4px;">Travel Notes</div>
            <div style="font-size:13px;color:var(--text-muted);font-style:italic;">"{{ booking.notes }}"</div>
          </div>
          {% endif %}
        </div>
      </div>

      {# Price Breakdown #}
      <div class="info-card">
        <div class="info-card-header">
          <span class="section-num">03 /</span>
          <h3>Price Breakdown</h3>
        </div>
        <div class="info-card-body">
          <div class="detail-row">
            <span class="detail-label">Base Price (per person)</span>
            <span class="detail-value">€{{ pack.basePrice|number_format(2) }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Travelers</span>
            <span class="detail-value">x{{ booking.numTravelers }}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Subtotal</span>
            <span class="detail-value">€{{ booking.totalPrice|number_format(2) }}</span>
          </div>
          {% if booking.discountApplied > 0 %}
          <div class="detail-row">
            <span class="detail-label">Discount Applied</span>
            <span class="detail-value" style="color:#10b981;">- €{{ booking.discountApplied|number_format(2) }}</span>
          </div>
          {% endif %}
          <div class="detail-row" style="border-bottom:none;padding-top:16px;">
            <span style="font-size:15px;font-weight:700;">Total</span>
            <span class="price-final">€{{ booking.finalPrice|number_format(2) }}</span>
          </div>
        </div>
      </div>

    </div>

    {# ── RIGHT: QR card ── #}
    <div class="qr-card reveal">
      <div class="qr-title">Scan to Download</div>
      <div class="qr-sub">
        Scan this QR code with your phone to instantly download your booking confirmation as a PDF.
      </div>

      <div class="qr-img-wrap">
        <img src="{{ qrCodeDataUri }}" alt="QR Code" style="width:200px;height:200px;display:block;">
      </div>

      <div class="ref-badge">TRX-{{ booking.idBooking }}</div>

      <div style="font-size:12px;color:var(--text-muted);margin-bottom:20px;line-height:1.5;">
        Or download directly from this device:
      </div>

      <a href="{{ path('user_booking_pdf', {id: booking.idBooking}) }}"
         style="display:block;width:100%;padding:13px;border-radius:10px;
                background:linear-gradient(135deg,var(--accent-primary),#0080c0);
                color:#fff;text-decoration:none;font-weight:700;font-size:14px;
                text-align:center;margin-bottom:12px;">
        Download PDF
      </a>

      {% if booking.status == 'PENDING' %}
      <a href="{{ path('user_pack_booking_cancel', {id: booking.idBooking}) }}"
         onclick="return confirm('Cancel this booking?')"
         style="display:block;width:100%;padding:11px;border-radius:10px;
                border:1px solid #ef4444;color:#ef4444;text-decoration:none;
                font-weight:600;font-size:13px;text-align:center;">
        Cancel Booking
      </a>
      {% endif %}

      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border-color);font-size:11px;color:var(--text-muted);">
        Need help? Contact TripX support with reference <strong style="color:var(--accent-primary);">TRX-{{ booking.idBooking }}</strong>
      </div>
    </div>

  </div>
</div>
{% endblock %}
