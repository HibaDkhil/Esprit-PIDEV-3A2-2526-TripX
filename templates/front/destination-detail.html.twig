{% extends 'base.html.twig' %}

{% block title %}{{ destination.name }} — Destination Detail · TripX{% endblock %}

{% block stylesheets %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400..900&family=Montserrat:wght@100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    .detail-hero {
      height: 90vh;
      position: relative;
      display: flex;
      align-items: flex-end;
      padding-bottom: 64px;
      overflow: hidden;
      margin-top: var(--nav-height);
    }
    .detail-hero-bg {
      position: absolute; inset: 0;
      font-size: 160px;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #003049 0%, #d62828 50%, #f77f00 100%);
    }
    .detail-hero-bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.7; }
    .detail-hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(3,7,18,0.9) 0%, rgba(3,7,18,0.3) 50%, transparent 100%);
    }
    [data-theme="light"] .detail-hero-overlay {
      background: linear-gradient(to top, rgba(255,248,240,0.1) 0%, transparent 100%);
    }
    .detail-hero-content { position: relative; z-index: 1; color: #F0F4F8; }
    .detail-back {
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
      color: rgba(240,244,248,0.7); margin-bottom: 20px;
      display: inline-flex; align-items: center; gap: 8px;
      transition: color var(--transition-fast);
    }
    .detail-back:hover { color: var(--accent-primary); }
    .detail-title {
      font-family: var(--font-display);
      font-size: clamp(64px, 10vw, 128px);
      text-transform: uppercase;
      line-height: 0.88;
      margin-bottom: 20px;
    }
    .detail-meta-bar {
      display: flex; gap: 20px; flex-wrap: wrap; align-items: center;
      margin-bottom: 32px;
    }
    .detail-actions { display: flex; gap: 14px; flex-wrap: wrap; }
    .mini-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius-md);
      padding: 20px;
      display: flex; gap: 16px; align-items: center;
      transition: all var(--transition-fast);
      text-decoration: none; color: inherit;
    }
    .mini-card:hover { border-color: var(--accent-primary); transform: translateX(4px); }
    .mini-card-icon { font-size: 32px; flex-shrink: 0; }
    .mini-card-title { font-weight: 600; margin-bottom: 4px; }
    .mini-card-sub { font-size: 0.82rem; color: var(--text-muted); }

    /* ── Reviews Section ── */
    .reviews-header {
      display: flex; justify-content: space-between; align-items: flex-end;
      flex-wrap: wrap; gap: 20px; margin-bottom: 40px;
    }
    .rating-overview {
      display: flex; align-items: center; gap: 24px;
      background: var(--bg-glass); backdrop-filter: var(--bg-glass-blur);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius-lg);
      padding: 32px 40px;
    }
    .rating-big-number {
      font-family: var(--font-display);
      font-size: 64px; font-weight: 800;
      line-height: 1;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-cyan));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .rating-stars-row { display: flex; gap: 4px; margin-bottom: 4px; }
    .rating-stars-row .star { font-size: 22px; }
    .star-filled { color: #F59E0B; }
    .star-empty  { color: var(--border-color); }
    .rating-count { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); letter-spacing: 0.05em; }

    /* Review Form */
    .review-form-card {
      background: var(--bg-glass); backdrop-filter: var(--bg-glass-blur);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius-lg);
      padding: 36px; margin-bottom: 40px;
      transition: border-color var(--transition-smooth);
    }
    .review-form-card:focus-within { border-color: var(--accent-primary); }
    .review-form-title {
      font-family: var(--font-display); font-size: 20px; font-weight: 700;
      margin-bottom: 24px; text-transform: uppercase;
    }
    .star-rating-input { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 6px; margin-bottom: 20px; }
    .star-rating-input input { display: none; }
    .star-rating-input label {
      font-size: 36px; cursor: pointer; color: var(--border-color);
      transition: color 0.15s, transform 0.15s;
    }
    .star-rating-input label:hover,
    .star-rating-input label:hover ~ label,
    .star-rating-input input:checked ~ label { color: #F59E0B; }
    .star-rating-input label:hover { transform: scale(1.2); }

    .review-textarea {
      width: 100%; min-height: 120px; padding: 16px; border-radius: var(--border-radius-md);
      border: 1px solid var(--border-color); background: var(--bg-surface);
      color: var(--text-primary); font-family: var(--font-body); font-size: 0.95rem;
      resize: vertical; outline: none;
      transition: border-color var(--transition-fast);
    }
    .review-textarea:focus { border-color: var(--accent-primary); }
    .review-textarea::placeholder { color: var(--text-muted); }
    .char-counter {
      font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);
      text-align: right; margin-top: 6px;
    }
    .form-error {
      color: #ef4444; font-size: 0.85rem; margin-top: 4px;
    }

    /* Review Cards */
    .review-card {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: var(--border-radius-md); padding: 28px;
      transition: border-color var(--transition-smooth), transform var(--transition-smooth);
    }
    .review-card:hover { border-color: rgba(14,165,255,0.30); transform: translateY(-3px); }
    .review-card-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px; flex-wrap: wrap; gap: 12px;
    }
    .review-author {
      display: flex; align-items: center; gap: 12px;
    }
    .review-avatar {
      width: 42px; height: 42px; border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-indigo));
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .review-author-name { font-weight: 600; font-size: 0.95rem; }
    .review-date {
      font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);
      letter-spacing: 0.05em;
    }
    .review-stars { display: flex; gap: 3px; }
    .review-stars .star { font-size: 16px; }
    .review-comment { color: var(--text-secondary); line-height: 1.7; font-size: 0.95rem; }
    .review-delete-form { display: inline; }
    .review-delete-btn {
      padding: 6px 14px; border-radius: 8px; font-size: 12px;
      color: #ef4444; border: 1px solid rgba(239,68,68,0.3);
      background: rgba(239,68,68,0.06); cursor: pointer;
      font-family: var(--font-mono); letter-spacing: 0.05em;
      transition: all var(--transition-fast);
    }
    .review-delete-btn:hover { background: rgba(239,68,68,0.15); border-color: #ef4444; }
    .existing-review-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px; border-radius: 100px;
      background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3);
      color: #10b981; font-family: var(--font-mono); font-size: 12px;
      letter-spacing: 0.05em;
    }
  </style>
{% endblock %}

{% block body %}
<!-- Hero -->
<div class="detail-hero">
  <div class="detail-hero-bg parallax-img" data-speed="0.25">
    {% if destination.imageUrl %}
      <img src="{{ destination.imageUrl }}" alt="{{ destination.name }}">
    {% else %}
      🌍
    {% endif %}
  </div>
  <div class="detail-hero-overlay"></div>
  <div class="detail-hero-content container">
    <a href="{{ path('destinations') }}" class="detail-back">← All Destinations</a>
    <div class="detail-meta-bar">
      <span class="badge badge-teal">{{ destination.type|capitalize }}</span>
      <span class="badge badge-coral">⭐ {{ destination.averageRating }}/5</span>
      <span style="font-family:var(--font-mono);font-size:11px;color:rgba(240,244,248,0.6)">{{ destination.city }} · {{ destination.country }}</span>
    </div>
    <div class="detail-title">{{ destination.name }}</div>
    <div class="detail-actions">
      <a href="{{ path('booking_form', {destinationId: destination.destinationId}) }}" class="btn btn-primary btn-lg ripple-btn">📋 Book Now</a>
      <a href="{{ path('accommodations') }}" class="btn btn-secondary btn-lg ripple-btn" style="color:#F0F4F8;border-color:rgba(255,255,255,0.2)">🏨 Find Stays</a>
    </div>
  </div>
</div>

<!-- Overview -->
<section class="section">
  <div class="container">
    <div class="grid-2" style="gap:60px;align-items:start">
      <div>
        <div class="section-label reveal"><span>About</span></div>
        <h2 class="display-md reveal" style="margin-bottom:20px">Discover <span class="gradient-text">{{ destination.name }}</span></h2>
        <p class="reveal reveal-delay-1" style="color:var(--text-secondary);line-height:1.8;margin-bottom:20px">
          {{ destination.description|default('A beautiful destination waiting to be explored. Discover unique experiences, local culture, and unforgettable moments.') }}
        </p>
        <div class="grid-2 reveal reveal-delay-3" style="gap:16px">
          <div class="stat-card">
            <div class="stat-value">⭐ {{ destination.averageRating }}</div>
            <div class="stat-label">Rating</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{{ destination.bestSeason|capitalize }}</div>
            <div class="stat-label">Best Season</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">€{{ destination.estimatedBudget|default(0)|number_format(0) }}</div>
            <div class="stat-label">From Budget</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{{ destination.type|capitalize }}</div>
            <div class="stat-label">Type</div>
          </div>
        </div>
      </div>
      <div>
        <!-- Info Panel -->
        <div style="background:var(--bg-glass);backdrop-filter:var(--bg-glass-blur);border:1px solid var(--border-color);border-radius:var(--border-radius-lg);padding:32px" class="reveal">
          <h3 style="font-family:var(--font-display);margin-bottom:20px;">Quick Info</h3>
          <div style="display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color); align-items:center;">
              <span style="color:var(--text-muted)">Country</span>
              <div style="display:flex; align-items:center; gap:8px;">
                {% if countryData and countryData.flag %}
                  <img src="{{ countryData.flag }}" alt="{{ destination.country }} Flag" style="height:14px; width:auto; border-radius:2px; box-shadow:0 0 2px rgba(0,0,0,0.2);">
                {% endif %}
                <span style="font-weight:600">{{ destination.country }}</span>
              </div>
            </div>
            {% if countryData and countryData.localTime %}
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color);">
              <span style="color:var(--text-muted)">Local Time</span>
              <span style="font-weight:600; font-family:var(--font-mono); font-size:12px; color:var(--accent-primary);">{{ countryData.localTime }}</span>
            </div>
            {% endif %}
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color)">
              <span style="color:var(--text-muted)">City</span>
              <span style="font-weight:600">{{ destination.city|default('—') }}</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color)">
              <span style="color:var(--text-muted)">Best Season</span>
              <span style="font-weight:600">{{ destination.bestSeason|capitalize }}</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color)">
              <span style="color:var(--text-muted)">Timezone</span>
              <span style="font-weight:600">{{ destination.timezone|default('—') }}</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color)">
              <span style="color:var(--text-muted)">Popularity</span>
              <span style="font-weight:600">{{ destination.popularity }} visits</span>
            </div>
            {% if weather %}
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border-color); align-items: center;">
              <span style="color:var(--text-muted)">Current Weather</span>
              <div style="display:flex; align-items:center; gap:8px;">
                <img src="https://openweathermap.org/img/wn/{{ weather.icon }}@2x.png" alt="{{ weather.condition }}" style="width:32px; height:32px;">
                <span style="font-weight:700; font-size:1.1rem;">{{ weather.temp }}°C</span>
                <span style="font-size:12px; color:var(--text-muted); text-transform:capitalize;">{{ weather.condition }}</span>
              </div>
            </div>
            {% endif %}
            {% if destination.latitude and destination.longitude %}
            <div style="display:flex;justify-content:space-between;padding:12px 0;">
              <span style="color:var(--text-muted)">Coordinates</span>
              <span style="font-family:var(--font-mono);font-size:12px">{{ destination.latitude }}, {{ destination.longitude }}</span>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Activities for this destination -->
<section class="section" style="background:var(--bg-secondary)">
  <div class="container">
    <div class="section-label reveal"><span>Must Experience</span></div>
    <h2 class="display-md reveal" style="margin-bottom:32px">Activities in <span class="text-coral">{{ destination.name }}</span></h2>
    <div style="display:flex;flex-direction:column;gap:14px" class="stagger">
      {% for act in activities %}
        <a href="{{ path('activity_detail', {id: act.activityId}) }}" class="mini-card" style="text-decoration:none; color:inherit;">
          <div class="mini-card-icon">
            {% if act.category == 'adventure' %}🧗{% elseif act.category == 'food' %}🍜{% elseif act.category == 'cultural' %}🏛️{% elseif act.category == 'relaxation' %}🧘{% elseif act.category == 'nightlife' %}🌙{% elseif act.category == 'sports' %}⚽{% elseif act.category == 'wellness' %}💆{% else %}✨{% endif %}
          </div>
          <div style="flex:1;">
            <div class="mini-card-title">{{ act.name }}</div>
            <div class="mini-card-sub">
              {% if act.durationMinutes %}{{ act.durationMinutes }} mins · {% endif %}
              €{{ act.price|default(0)|number_format(0) }} · {{ act.category|capitalize }}
              {% if act.capacity %} · {{ act.capacity }} spots{% endif %}
            </div>
          </div>
          <span class="btn btn-secondary btn-sm" style="margin-left:auto">View</span>
        </a>
      {% else %}
        <div style="text-align:center; padding:40px; color:var(--text-muted);">
          No activities found for this destination yet.
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     REVIEWS SECTION
     ═══════════════════════════════════════════ -->
<section class="section" id="reviews-section">
  <div class="container">
    <div class="section-label reveal"><span>Traveler Reviews</span></div>
    <h2 class="display-md reveal" style="margin-bottom:12px">What People Say About <span class="gradient-text">{{ destination.name }}</span></h2>

    <!-- Rating Overview -->
    <div class="reviews-header reveal reveal-delay-1">
      <div class="rating-overview">
        <div class="rating-big-number">{{ destination.averageRating }}</div>
        <div>
          <div class="rating-stars-row">
            {% set avgFloat = destination.averageRating|round(0, 'floor') %}
            {% for i in 1..5 %}
              <span class="star {% if i <= avgFloat %}star-filled{% else %}star-empty{% endif %}">★</span>
            {% endfor %}
          </div>
          <div class="rating-count">{{ reviewCount }} review{{ reviewCount != 1 ? 's' : '' }}</div>
        </div>
      </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div style="padding:14px 20px; border-radius:var(--border-radius-sm); margin-bottom:20px; font-size:14px;
          {% if label == 'success' %}background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.3); color:#10b981;
          {% else %}background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); color:#ef4444;{% endif %}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    <!-- Review Form (only for logged-in users who haven't reviewed yet) -->
    {% if reviewForm is defined and reviewForm is not null %}
      <div class="review-form-card reveal reveal-delay-2">
        <div class="review-form-title">✍️ Write Your Review</div>
        <form method="post" action="{{ path('destination_submit_review', {id: destination.destinationId}) }}" novalidate>
          {{ form_start(reviewForm, {'attr': {'style': 'display:contents'}}) }}

          <!-- Star Rating (custom interactive stars) -->
          <div style="margin-bottom:8px">
            <label style="font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:8px; display:block;">Your Rating</label>
            <div class="star-rating-input" id="star-rating-input">
              {% for i in [5,4,3,2,1] %}
                <input type="radio" id="star{{ i }}" name="{{ reviewForm.rating.vars.full_name }}" value="{{ i }}" {% if reviewForm.rating.vars.value == i %}checked{% endif %}>
                <label for="star{{ i }}" title="{{ i }} star{{ i > 1 ? 's' : '' }}">★</label>
              {% endfor %}
            </div>
            {% if reviewForm.rating.vars.errors|length > 0 %}
              {% for error in reviewForm.rating.vars.errors %}
                <div class="form-error">{{ error.message }}</div>
              {% endfor %}
            {% endif %}
          </div>

          <!-- Comment -->
          <div style="margin-bottom:20px">
            <label for="review-comment" style="font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:8px; display:block;">Your Review</label>
            <textarea
              id="review-comment"
              name="{{ reviewForm.comment.vars.full_name }}"
              class="review-textarea"
              placeholder="Share your experience at this destination (min. 10 characters)..."
              maxlength="2000"
            >{{ reviewForm.comment.vars.value }}</textarea>
            <div class="char-counter"><span id="char-count">0</span> / 2000</div>
            {% if reviewForm.comment.vars.errors|length > 0 %}
              {% for error in reviewForm.comment.vars.errors %}
                <div class="form-error">{{ error.message }}</div>
              {% endfor %}
            {% endif %}
          </div>

          <input type="hidden" name="{{ reviewForm._token.vars.full_name }}" value="{{ reviewForm._token.vars.value }}">

          <button type="submit" class="btn btn-primary ripple-btn">
            ✦ Submit Review
          </button>
          {{ form_end(reviewForm, {'render_rest': false}) }}
        </form>
      </div>
    {% elseif existingReview is defined and existingReview is not null %}
      <div class="review-form-card reveal reveal-delay-2" style="text-align:center;">
        <div class="existing-review-badge" style="margin-bottom:12px; display:inline-flex;">
          ✅ You've already reviewed this destination
        </div>
        <p style="color:var(--text-muted); font-size:0.9rem;">Your {{ existingReview.rating }}-star review is shown below. You can delete it to submit a new one.</p>
      </div>
    {% elseif app.user is null %}
      <div class="review-form-card reveal reveal-delay-2" style="text-align:center;">
        <p style="color:var(--text-muted); margin-bottom:16px;">Log in to share your experience</p>
        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm ripple-btn">🔑 Log In to Review</a>
      </div>
    {% endif %}

    <!-- Reviews List -->
    <div style="display:flex; flex-direction:column; gap:20px; margin-top:20px;" class="stagger">
      {% for review in reviews %}
        <div class="review-card">
          <div class="review-card-header">
            <div class="review-author">
              <div class="review-avatar">{{ userNames[review.userId]|first|upper }}</div>
              <div>
                <div class="review-author-name">{{ userNames[review.userId] }}</div>
                <div class="review-date">{{ review.createdAt|date('M d, Y') }}</div>
              </div>
            </div>
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="review-stars">
                {% for i in 1..5 %}
                  <span class="star {% if i <= review.rating %}star-filled{% else %}star-empty{% endif %}">★</span>
                {% endfor %}
              </div>
              {% if app.user and app.user.userId == review.userId %}
                <form method="post" action="{{ path('destination_delete_review', {destId: destination.destinationId, id: review.reviewId}) }}" class="review-delete-form" onsubmit="return confirm('Delete your review?')">
                  <button type="submit" class="review-delete-btn">🗑️ Delete</button>
                </form>
              {% endif %}
            </div>
          </div>
          <div class="review-comment">{{ review.comment }}</div>
        </div>
      {% else %}
        <div style="text-align:center; padding:60px 20px; color:var(--text-muted);">
          <div style="font-size:48px; margin-bottom:16px;">💬</div>
          <p style="font-size:1.05rem; margin-bottom:8px;">No reviews yet</p>
          <p style="font-size:0.85rem;">Be the first to share your experience at {{ destination.name }}!</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Book CTA -->
<section class="section">
  <div class="container" style="text-align:center;">
    <div class="section-label reveal"><span>Ready?</span></div>
    <h2 class="display-md reveal" style="margin-bottom:16px">Book Your Trip to <span class="gradient-text">{{ destination.name }}</span></h2>
    <p class="text-muted reveal reveal-delay-1" style="margin-bottom:32px;">Start your adventure today — secure your spot now.</p>
    <a href="{{ path('booking_form', {destinationId: destination.destinationId}) }}" class="btn btn-primary btn-lg ripple-btn reveal reveal-delay-2">📋 Book {{ destination.name }} Now</a>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-bottom">
      <div class="footer-copy">© 2026 TripX. All rights reserved.</div>
      <a href="{{ path('destinations') }}" class="footer-copy" style="color:var(--accent-primary)">← All Destinations</a>
    </div>
  </div>
</footer>

<div class="aria-panel" id="aria-panel">
  <div class="aria-header">
    <div class="aria-avatar">✦</div>
    <div><span class="aria-name">ARIA</span><span class="aria-status">{{ destination.name }} Expert 🌍</span></div>
    <button id="aria-close" style="margin-left:auto;font-size:18px;color:var(--text-muted);cursor:none">✕</button>
  </div>
  <div class="aria-messages" id="aria-messages">
    <div class="aria-msg bot"><div class="aria-bubble">I see you're exploring {{ destination.name }}! Want me to help plan your trip? Just ask! 🌴</div></div>
  </div>
  <div class="aria-input-row">
    <input class="aria-input" id="aria-input" type="text" placeholder="Ask about {{ destination.name }}...">
    <button class="aria-send" id="aria-send">➤</button>
  </div>
</div>
{% block javascripts %}
<script>
  // ── Character counter for review textarea ──
  const textarea = document.getElementById('review-comment');
  const counter = document.getElementById('char-count');
  if (textarea && counter) {
    const update = () => { counter.textContent = textarea.value.length; };
    textarea.addEventListener('input', update);
    update();
  }
</script>
{% endblock %}
{% endblock %}
