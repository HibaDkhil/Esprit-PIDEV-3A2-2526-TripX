{% extends 'base.html.twig' %}

{% block title %}My Bookings — TripX{% endblock %}

{% block stylesheets %}
<style>
  :root {
    --ocean-teal: #00F5D4;
    --ocean-blue: #0ea5e9;
    --glass-bg: rgba(7, 20, 40, 0.65);
    --glass-border: rgba(0, 245, 212, 0.2);
  }

  .page-top { 
    padding-top: calc(var(--nav-height) + 100px); 
    padding-bottom: 80px; 
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 50% -20%, rgba(14, 165, 233, 0.15), transparent 60%);
  }
  .page-top::before {
    content: ''; position: absolute; top: 0; right: 20%; width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(0,245,212,0.15) 0%, transparent 60%);
    border-radius: 50%; filter: blur(40px); z-index: -1; animation: float-orb 15s ease-in-out infinite reverse;
  }
  
  .stats-bar {
    display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 40px;
  }
  .stat-chip {
    background: var(--glass-bg); backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-md);
    padding: 24px 20px; flex: 1; min-width: 140px; text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.05);
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .stat-chip:hover { transform: translateY(-6px); border-color: rgba(0,245,212,0.4); box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 20px rgba(0,245,212,0.1); }
  .stat-chip-val { font-family: var(--font-display); font-size: 36px; color: var(--ocean-teal); line-height: 1; text-shadow: 0 0 15px rgba(0,245,212,0.3); font-weight: 800; }
  .stat-chip-label { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 12px; }
  
  /* Tabs */
  .bookings-tabs {
    display: flex; gap: 8px; margin-bottom: 32px;
    background: var(--glass-bg); padding: 8px; border-radius: 50px;
    width: fit-content; border: 1px solid var(--glass-border);
    backdrop-filter: blur(20px);
  }
  .bookings-tab {
    padding: 10px 28px; border-radius: 50px; font-size: 13px; font-weight: 600; font-family: var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase;
    cursor: pointer; transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1); color: var(--text-muted); border: none; background: transparent;
  }
  .bookings-tab.active {
    background: linear-gradient(135deg, var(--ocean-teal), var(--ocean-blue)); color: #020816; box-shadow: 0 4px 15px rgba(0,245,212,0.4); font-weight: 700;
  }
  .bookings-tab:not(.active):hover { color: var(--text-primary); background: rgba(0,245,212,0.1); }
  
  .booking-row {
    background: var(--glass-bg); backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg); overflow: hidden; margin-bottom: 24px;
    transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
    animation: slideUp 0.6s cubic-bezier(0.19, 1, 0.22, 1) forwards; opacity: 0; transform: translateY(30px);
  }
  .booking-row:hover { transform: translateY(-4px); box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(0,245,212,0.1); border-color: rgba(0,245,212,0.4); }
  
  @keyframes slideUp { to { opacity: 1; transform: translateY(0); } }
  
  .booking-row-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 28px; border-bottom: 1px solid var(--glass-border);
    background: rgba(0,0,0,0.2);
  }
  .booking-type-icon { font-size: 28px; filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5)); }
  .booking-status {
    padding: 6px 14px; border-radius: 50px; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-family: var(--font-mono);
  }
  
  .booking-row-body { display: grid; grid-template-columns: 1fr 1fr auto; gap: 24px; padding: 28px; align-items: center; }
  @media (max-width: 768px) { .booking-row-body { grid-template-columns: 1fr; } }
  
  .booking-detail-label { font-family: var(--font-mono); font-size: 11px; color: var(--ocean-teal); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em; }
  .booking-detail-value { font-size: 15px; font-weight: 500; color: #fff; }
  
  .booking-price { text-align: right; }
  @media (max-width: 768px) { .booking-price { text-align: left; } }
  
  .booking-price-val { font-family: var(--font-display); font-size: 32px; color: var(--ocean-teal); font-weight: 800; line-height: 1; margin-bottom: 16px; text-shadow: 0 0 15px rgba(0,245,212,0.3); }
</style>
{% endblock %}

{% block body %}
<div class="page-top">
  <div class="container">
    <div class="section-label reveal"><span>Overview</span></div>
    <h1 class="display-md reveal" style="margin-bottom:8px">My <span style="background: linear-gradient(90deg, #fff 0%, var(--ocean-teal) 50%, #fff 100%); background-size: 200% auto; color: transparent; -webkit-background-clip: text; background-clip: text; animation: text-shimmer 4s linear infinite;">Bookings</span></h1>
    <p class="serif-mood text-muted reveal reveal-delay-1" style="margin-bottom:40px; font-size: 18px;">
      Manage all your destinations, accommodations, and transport reservations in one beautiful dashboard.
    </p>

    {# Stats #}
    <div class="stats-bar reveal reveal-delay-2">
      <div class="stat-chip">
        <div class="stat-chip-val">{{ totalBookings }}</div>
        <div class="stat-chip-label">Total Valid</div>
      </div>
      <div class="stat-chip">
        <div class="stat-chip-val" style="color:#27ae60;">{{ confirmedCount }}</div>
        <div class="stat-chip-label">Confirmed</div>
      </div>
      <div class="stat-chip">
        <div class="stat-chip-val" style="color:#F97316;">{{ pendingCount }}</div>
        <div class="stat-chip-label">Pending</div>
      </div>
      <div class="stat-chip">
        <div class="stat-chip-val" style="color:var(--text-primary);">{{ totalSpent|number_format(2) }}€</div>
        <div class="stat-chip-label">Total Spent</div>
      </div>
    </div>

    {# Filter Tabs #}
    <div class="bookings-tabs reveal reveal-delay-3">
      <button class="bookings-tab active" onclick="filterBookings('all', this)">All Bookings</button>
      <button class="bookings-tab" onclick="filterBookings('accommodation', this)">Accommodations</button>
      <button class="bookings-tab" onclick="filterBookings('transport', this)">Transport</button>
      <button class="bookings-tab" onclick="filterBookings('destination', this)">Destinations</button>
    </div>

    {# List #}
    <div id="bookings-list" class="reveal reveal-delay-3">
      {% for b in allBookings %}
        <div class="booking-row" data-type="{{ b.type }}" style="animation-delay: {{ loop.index0 * 50 }}ms;">
          {% set isAcc = b.type == 'accommodation' %}
          {% set isDest = b.type == 'destination' %}
          {% set statusColor = b.status == 'CONFIRMED' ? '#27ae60' : (b.status == 'CANCELLED' ? '#ef4444' : '#F97316') %}
          
          <div class="booking-row-header">
            <div style="display:flex; align-items:center; gap:12px;">
              <span class="booking-type-icon">
                {% if isAcc %}🏨{% elseif isDest %}🌍{% else %}✈️{% endif %}
              </span>
              <div>
                <div style="font-weight:600; color:var(--text-primary);">
                  {% if isAcc %}
                    {{ b.entity.room.accommodation.name }}
                  {% elseif isDest %}
                    {{ b.destName|default('Destination Booking') }}
                  {% else %}
                    Transport Booking #{{ b.id }}
                  {% endif %}
                </div>
                <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                  Booked on {{ b.date ? b.date|date('M d, Y') : 'Unknown' }}
                </div>
              </div>
            </div>
            <div class="booking-status" style="background: {{ statusColor }}20; color: {{ statusColor }}; border: 1px solid {{ statusColor }}40;">
              {{ b.status }}
            </div>
          </div>

          <div class="booking-row-body">
            <div>
              <div class="booking-detail-label">
                {% if isAcc %}Check In / Out{% elseif isDest %}Travel Dates{% else %}Details{% endif %}
              </div>
              <div class="booking-detail-value">
                {% if isAcc %}
                  {{ b.entity.checkIn|date('M d') }} - {{ b.entity.checkOut|date('M d, Y') }}
                {% elseif isDest %}
                  {{ b.entity.startAt|date('M d') }} - {{ b.entity.endAt ? b.entity.endAt|date('M d, Y') : 'Open' }}
                {% else %}
                  Route/Schedule: #{{ b.entity.scheduleId > 0 ? b.entity.scheduleId : 'Direct' }}
                  <br><span style="font-size:12px;color:var(--text-muted);">{{ b.entity.totalSeats }} Seats · Insured: {{ b.entity.insuranceIncluded ? 'Yes' : 'No' }}</span>
                {% endif %}
              </div>
            </div>

            <div>
              <div class="booking-detail-label">
                {% if isAcc %}Room{% elseif isDest %}Guests{% else %}Payment{% endif %}
              </div>
              <div class="booking-detail-value">
                {% if isAcc %}
                  {{ b.entity.room.roomType }}
                  <br><span style="font-size:12px;color:var(--text-muted);">(Guest #{{ b.entity.userId }})</span>
                {% elseif isDest %}
                  {{ b.entity.numGuests }} guest{{ b.entity.numGuests > 1 ? 's' : '' }}
                  <br><span style="font-size:12px;color:var(--text-muted);">Ref: {{ b.entity.bookingReference }}</span>
                {% else %}
                  {{ b.entity.paymentStatus }}
                {% endif %}
              </div>
            </div>

            <div class="booking-price">
              <div class="booking-price-val">{{ b.price|number_format(2) }}€</div>
              {% if isAcc %}
                <a href="{{ path('accommodation_details', {'id': b.entity.room.accommodation.id}) }}" 
                   class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; margin-bottom:8px;">
                  View Details
                </a>
              {% elseif isDest %}
                <a href="{{ path('destination_detail', {'id': b.entity.destinationId}) }}" 
                   class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; margin-bottom:8px;">
                  View Destination
                </a>
                <a href="{{ path('booking_des_invoice_pdf', {'id': b.id}) }}" 
                   class="btn btn-sm" style="width:100%; justify-content:center; background:#6366f1; color:#fff; border:none; margin-bottom:8px;">
                  📄 Download Invoice
                </a>
              {% else %}
                <a href="{{ path('user_booking_receipt_pdf', {'id': b.id}) }}" 
                   class="btn btn-secondary btn-sm" style="width:100%; justify-content:center; margin-bottom:8px;">
                  View Details
                </a>
              {% endif %}
              
              {% if b.status|lower == 'confirmed' %}
                {% if isDest and b.entity.paymentStatus is defined and b.entity.paymentStatus|lower != 'paid' %}
                  <a href="{{ path('payment_checkout', {'id': b.id}) }}" class="btn btn-sm" style="width:100%; justify-content:center; background:#10b981; color:#fff; border:none; font-weight:600;">
                    Proceed to Payment
                  </a>
                {% elseif not isDest %}
                  <a href="#" onclick="alert('Feature coming soon'); return false;" class="btn btn-sm" style="width:100%; justify-content:center; background:#10b981; color:#fff; border:none; font-weight:600;">
                    Proceed to Payment
                  </a>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <div style="text-align:center; padding:60px 0; background:var(--bg-card); border-radius:var(--border-radius-lg); border:1px solid var(--border-color);">
          <div style="font-size:48px; margin-bottom:16px;">🧳</div>
          <p class="serif-mood text-muted">You have no bookings yet.</p>
        </div>
      {% endfor %}
    </div>

    {# ── Pagination Controls ── #}
    {% if allBookings.pageCount|default(0) > 1 or currentLimit is defined %}
    <div style="display:flex; flex-direction:column; align-items:center; gap:16px; margin-top:32px;" class="reveal">
      {# Items per page selector #}
      <div style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:12px; color:var(--text-muted); font-family:var(--font-mono); letter-spacing:0.05em; text-transform:uppercase;">Show</span>
        {% for size in [5, 10, 25, 50] %}
          <a href="{{ path('my_bookings', {limit: size, page: 1}) }}"
             class="btn btn-sm {{ currentLimit == size ? 'btn-primary' : 'btn-secondary' }} ripple-btn"
             style="min-width:42px; text-align:center; font-size:12px; border-radius:50px;">{{ size }}</a>
        {% endfor %}
        <span style="font-size:12px; color:var(--text-muted); font-family:var(--font-mono); letter-spacing:0.05em; text-transform:uppercase;">per page</span>
      </div>

      {# Page navigation #}
      {% if allBookings.pageCount|default(0) > 1 %}
      <div style="display:flex; align-items:center; gap:8px;">
        {% if allBookings.currentPageNumber > 1 %}
          <a href="{{ path('my_bookings', {page: allBookings.currentPageNumber - 1, limit: currentLimit}) }}" class="btn btn-secondary ripple-btn" style="border-radius:50px; padding:10px 20px; font-size:13px;">← Previous</a>
        {% endif %}

        {% set startPage = max(1, allBookings.currentPageNumber - 2) %}
        {% set endPage = min(allBookings.pageCount, allBookings.currentPageNumber + 2) %}
        {% for p in startPage..endPage %}
          <a href="{{ path('my_bookings', {page: p, limit: currentLimit}) }}"
             class="btn {{ p == allBookings.currentPageNumber ? 'btn-primary' : 'btn-secondary' }} ripple-btn"
             style="min-width:42px; text-align:center; border-radius:50px; padding:10px 16px; font-size:13px;">{{ p }}</a>
        {% endfor %}

        {% if allBookings.currentPageNumber < allBookings.pageCount %}
          <a href="{{ path('my_bookings', {page: allBookings.currentPageNumber + 1, limit: currentLimit}) }}" class="btn btn-secondary ripple-btn" style="border-radius:50px; padding:10px 20px; font-size:13px;">Next →</a>
        {% endif %}
      </div>
      <span style="font-size:12px; color:var(--text-muted); font-family:var(--font-mono);">
        Page {{ allBookings.currentPageNumber }} of {{ allBookings.pageCount }}
      </span>
      {% endif %}
    </div>
    {% endif %}

  </div>
</div>

<script>
function filterBookings(type, btn) {
  // Update active button
  document.querySelectorAll('.bookings-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  // Filter rows
  const rows = document.querySelectorAll('.booking-row');
  let visibleCount = 0;
  rows.forEach(row => {
    if (type === 'all' || row.dataset.type === type) {
      row.style.display = 'block';
      visibleCount++;
      // reset animation
      row.style.animation = 'none';
      row.offsetHeight; /* trigger reflow */
      row.style.animation = null; 
    } else {
      row.style.display = 'none';
    }
  });

  // Handle empty state
  let emptyState = document.getElementById('empty-state');
  if (visibleCount === 0) {
    if (!emptyState) {
      emptyState = document.createElement('div');
      emptyState.id = 'empty-state';
      emptyState.style.cssText = 'text-align:center; padding:60px 0; background:var(--bg-card); border-radius:var(--border-radius-lg); border:1px solid var(--border-color);';
      emptyState.innerHTML = '<div style="font-size:48px; margin-bottom:16px;">🧳</div><p class="serif-mood text-muted">No bookings found for this category.</p>';
      document.getElementById('bookings-list').appendChild(emptyState);
    }
    emptyState.style.display = 'block';
  } else if (emptyState) {
    emptyState.style.display = 'none';
  }
}
</script>
{% endblock %}

