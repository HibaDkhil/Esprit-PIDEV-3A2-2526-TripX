<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pack.title }} — TripX</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400..900&family=Montserrat:wght@100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets.php?f=css/main.css">
  <link rel="stylesheet" href="/assets.php?f=css/animations.css">
  <style>
    .page-top { padding-top: calc(var(--nav-height) + 48px); padding-bottom: 60px; }

    .pack-hero {
      background:
        radial-gradient(900px 340px at 20% 0%, rgba(0,166,237,0.22), transparent 60%),
        radial-gradient(700px 280px at 80% 30%, rgba(255,77,109,0.16), transparent 62%),
        linear-gradient(135deg, #0d1b2a, #1a3a5c);
      border-radius: var(--border-radius-lg);
      border: 1px solid rgba(255,255,255,0.12);
      overflow: hidden;
      position: relative;
      height: 300px;
      display: flex;
      align-items: flex-end;
      padding: 22px;
      margin-bottom: 22px;
    }
    .pack-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.58) 70%, rgba(0,0,0,0.72) 100%);
      pointer-events: none;
    }
    .pack-hero-content { position: relative; z-index: 1; width: 100%; }
    .hero-topline {
      display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .hero-badges { display:flex; gap:10px; flex-wrap: wrap; align-items: center; }
    .hero-icon {
      position: absolute; top: 18px; right: 18px;
      width: 64px; height: 64px; border-radius: 18px;
      display:flex; align-items:center; justify-content:center;
      background: rgba(0,0,0,0.28); border: 1px solid rgba(255,255,255,0.14);
      backdrop-filter: blur(10px);
      font-size: 34px;
      z-index: 2;
    }
    .offer-chip {
      display: inline-flex; align-items:center; gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(0,166,237,0.18);
      border: 1px solid rgba(0,166,237,0.35);
      color: #d8f1ff;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .offer-chip strong { font-family: var(--font-display); font-size: 13px; letter-spacing: 0; text-transform: none; }
    .split-grid {
      display:grid;
      grid-template-columns: 1fr 380px;
      gap: 36px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .split-grid { grid-template-columns: 1fr; }
      .pack-sticky { position: static !important; top: auto !important; }
    }
    .info-grid {
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 18px 0 22px;
    }
    @media (max-width: 720px) { .info-grid { grid-template-columns: 1fr; } }
    .info-tile {
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 14px 14px;
      background: rgba(0,166,237,0.04);
    }
    .info-k { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; font-family: var(--font-mono); }
    .info-v { font-weight: 700; font-family: var(--font-display); font-size: 16px; }
    .subtle { font-size: 12px; color: var(--text-muted); margin-top: 6px; }

    .insight-row { display:flex; justify-content: space-between; gap: 14px; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid var(--border-color); }
    .insight-row:last-child { border-bottom: none; }
    .insight-k { color: var(--text-muted); font-size: 13px; }
    .insight-v { font-weight: 600; font-size: 13px; text-align: right; }
    .flag {
      display:inline-block;
      height: 16px;
      width: auto;
      border-radius: 3px;
      vertical-align: -3px;
      margin-right: 8px;
      border: 1px solid rgba(255,255,255,0.10);
    }
    .pill {
      display:inline-flex;
      align-items:center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-muted);
      font-size: 12px;
      margin: 6px 6px 0 0;
      white-space: nowrap;
    }
    .muted-box {
      background: rgba(0,166,237,0.06);
      border: 1px solid rgba(0,166,237,0.18);
      border-radius: 12px;
      padding: 14px;
      color: var(--text-muted);
      font-size: 13px;
      line-height: 1.6;
    }
    .mini-loader {
      display:inline-block;
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--accent-primary);
      box-shadow: 16px 0 0 rgba(0,166,237,0.35), 32px 0 0 rgba(0,166,237,0.20);
      animation: dotPulse 1.15s infinite ease-in-out;
    }
    @keyframes dotPulse {
      0% { transform: translateX(0); opacity: 0.8; }
      50% { transform: translateX(10px); opacity: 1; }
      100% { transform: translateX(0); opacity: 0.8; }
    }
  </style>
</head>
<body>
<div id="cursor-dot"></div><div id="cursor-halo"></div>

<nav class="nav">
  <div class="nav-inner">
    <a href="{{ path('index') }}" class="nav-logo">Trip<span>X</span></a>
    <div class="nav-links">
      <a href="{{ path('index') }}"          class="nav-link">Home</a>
      <a href="{{ path('destinations') }}"   class="nav-link">Destinations</a>
      <a href="{{ path('activities') }}"     class="nav-link">Activities</a>
      <a href="{{ path('accommodations') }}" class="nav-link">Accommodations</a>
      <a href="{{ path('transport') }}"      class="nav-link">Transport</a>
      <a href="{{ path('user_packs_offers') }}"    class="nav-link">Packs & Offers</a>
      <a href="{{ path('blog') }}" class="nav-link">Blog</a>
      <a href="#" class="nav-link">My Bookings</a>
    </div>
    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
        <span class="toggle-icon icon-sun">☀️</span>
        <span class="toggle-icon icon-moon">🌙</span>
      </button>
      <a href="{{ path('users') }}" class="btn-nav-primary ripple-btn">My Profile</a>
      <a href="{{ path('app_logout') }}" class="Btn-logout" style="margin-left:8px;">
        <div class="sign"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
  <path d="M16 17l5-5-5-5v3H9v4h7v3zM4 4h8v2H4v12h8v2H4z"/>
</svg></div>
        <div class="text">Logout</div>
      </a>
    </div>
  </div>
</nav>

{% for label, messages in app.flashes %}
  <div class="flash-container">
    {% for message in messages %}
      <div class="flash-message {{ label }}">{% if label == 'success' %}✅{% else %}❌{% endif %} {{ message }}</div>
    {% endfor %}
  </div>
{% endfor %}

<div class="page-top">
  <div class="container">
    <div style="margin-bottom:24px;font-size:13px;">
      <a href="{{ path('user_packs') }}" style="color:var(--accent-primary);text-decoration:none;">← Back to Packs</a>
    </div>

    <div class="split-grid">

      <!-- LEFT: Pack Info -->
      <div>
        <div class="pack-hero reveal">
          <div class="hero-icon">✈️</div>
          <div class="pack-hero-content">
            <div class="hero-topline">
              <div class="hero-badges">
                <span class="badge badge-indigo">{{ pack.durationDays }} days</span>
                <span class="badge badge-teal">ACTIVE</span>
                {% if loyalty %}
                  <span class="badge badge-gold">{{ loyalty.computeLevel() }} — {{ loyalty.loyaltyDiscountPercent }}% off</span>
                {% endif %}
              </div>
              {% if offer %}
                <div class="offer-chip">
                  Deal
                  <strong>{{ offer.title }}</strong>
                  <span>
                    {% if offer.discountType == 'PERCENTAGE' %}-{{ offer.discountValue }}%{% else %}-€{{ offer.discountValue }}{% endif %}
                  </span>
                </div>
              {% endif %}
            </div>
            <h1 class="display-sm" style="margin:0 0 6px 0;max-width: 820px;">{{ pack.title }}</h1>
            <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
              <span class="pill" id="dest-pill" style="display:none;">
                <span id="dest-flag-wrap"></span>
                <span id="dest-text">Destination</span>
              </span>
              <span class="pill" id="dest-currency-pill" style="display:none;">
                💱 <span id="dest-currency-text">Currency</span>
              </span>
              <span class="pill" id="dest-language-pill" style="display:none;">
                🗣️ <span id="dest-language-text">Language</span>
              </span>
            </div>
          </div>
        </div>

        {% if pack.description %}
          <div class="card reveal" style="margin-bottom:18px;">
            <div class="card-body">
              <div class="section-label" style="margin-bottom:8px;"><span>About this pack</span></div>
              <p style="font-size:15px;line-height:1.85;color:var(--text-muted);margin:0;">{{ pack.description }}</p>
            </div>
          </div>
        {% endif %}

        {% if offer %}
        <div class="card reveal" style="margin-bottom:18px;border-color: rgba(0,166,237,0.35); background: linear-gradient(135deg, rgba(0,166,237,0.07), rgba(0,166,237,0.02));">
          <div class="card-body">
            <div style="display:flex;justify-content:space-between;align-items:start;gap:14px;flex-wrap:wrap;">
              <div>
                <div style="font-family:var(--font-mono);font-size:11px;color:var(--accent-primary);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:6px;">Active Offer</div>
                <div style="font-family:var(--font-display);font-size:22px;margin-bottom:6px;">{{ offer.title }}</div>
                {% if offer.description %}<div style="font-size:13px;color:var(--text-muted);line-height:1.6;">{{ offer.description }}</div>{% endif %}
              </div>
              <div style="text-align:right;min-width: 140px;">
                <div style="font-family:var(--font-display);font-size:34px;color:var(--accent-primary);line-height:1;">
                  {% if offer.discountType == 'PERCENTAGE' %}{{ offer.discountValue }}%{% else %}€{{ offer.discountValue }}{% endif %}
                </div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:6px;">Valid until {{ offer.endDate|date('d M Y') }}</div>
              </div>
            </div>
          </div>
        </div>
        {% endif %}

        <div class="info-grid reveal">
          <div class="info-tile">
            <div class="info-k">Base price</div>
            <div class="info-v">€{{ pack.basePrice|number_format(2) }}</div>
            <div class="subtle">per person</div>
          </div>
          <div class="info-tile">
            <div class="info-k">Discount potential</div>
            <div class="info-v">
              {% set totalPct = (offerDiscount + loyaltyDiscount) %}
              {{ totalPct|number_format(0) }}%
            </div>
            <div class="subtle">{% if offer or loyalty %}Offer + loyalty combined{% else %}No discounts active{% endif %}</div>
          </div>
          <div class="info-tile">
            <div class="info-k">Your price</div>
            {% set finalSingle = pack.basePrice * (1 - (offerDiscount + loyaltyDiscount) / 100) %}
            <div class="info-v" style="color: var(--accent-primary);">€{{ finalSingle|number_format(2) }}</div>
            <div class="subtle">per person, after discounts</div>
          </div>
        </div>

        <div class="card reveal" style="margin-bottom:18px;">
          <div class="card-body">
            <div class="section-label" style="margin-bottom:10px;"><span>Country & Events</span></div>
            <div id="api-insights-loading" class="muted-box">
              destination insights <span class="mini-loader" aria-hidden="true"></span>
            </div>
            <div id="api-insights-empty" class="muted-box" style="display:none;">
              This pack doesn’t have a destination linked yet, so there’s no country to enrich.
            </div>

            <div id="api-insights" style="display:none;">
              <div class="insight-row">
                <div class="insight-k">Country</div>
                <div class="insight-v" id="ins-country">—</div>
              </div>
              <div class="insight-row">
                <div class="insight-k">Capital</div>
                <div class="insight-v" id="ins-capital">—</div>
              </div>
              <div class="insight-row">
                <div class="insight-k">Region</div>
                <div class="insight-v" id="ins-region">—</div>
              </div>
              <div class="insight-row">
                <div class="insight-k">Languages</div>
                <div class="insight-v" id="ins-languages">—</div>
              </div>
              <div class="insight-row">
                <div class="insight-k">Currency</div>
                <div class="insight-v" id="ins-currencies">—</div>
              </div>

              <div style="margin-top:14px;">
                <div style="font-family:var(--font-display);font-size:14px;margin-bottom:8px;">Upcoming holidays</div>
                <div id="ins-holidays-note" class="subtle" style="margin:0 0 8px 0;"></div>
                <div id="ins-holidays" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card reveal">
          <div class="card-body">
            <h3 style="font-family:var(--font-display);font-size:16px;margin-bottom:16px;">Price Breakdown (per person)</h3>
            <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-color);">
              <span style="color:var(--text-muted);">Base Price</span>
              <span style="font-weight:600;">€{{ pack.basePrice|number_format(2) }}</span>
            </div>
            {% if offer and offer.discountType == 'PERCENTAGE' %}
            <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-color);">
              <span style="color:#10b981;">Offer Discount ({{ offer.discountValue }}%)</span>
              <span style="color:#10b981;">-€{{ (pack.basePrice * offer.discountValue / 100)|number_format(2) }}</span>
            </div>
            {% endif %}
            {% if loyalty %}
            <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-color);">
              <span style="color:#f59e0b;">Loyalty Discount ({{ loyaltyDiscount }}%)</span>
              <span style="color:#f59e0b;">-€{{ (pack.basePrice * loyaltyDiscount / 100)|number_format(2) }}</span>
            </div>
            {% endif %}
            <div style="display:flex;justify-content:space-between;padding:12px 0;margin-top:4px;">
              <span style="font-weight:700;font-size:16px;">Your Price</span>
              <span style="font-family:var(--font-display);font-size:28px;color:var(--accent-primary);">€{{ finalSingle|number_format(2) }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Booking Form -->
      <div>
        <div class="card pack-sticky reveal" style="position:sticky;top:100px;">
          <div class="card-body">
            <h2 style="font-family:var(--font-display);font-size:20px;margin-bottom:20px;">Book This Pack</h2>
            <form method="post" action="{{ path('user_pack_details', {id: pack.idPack}) }}" novalidate>
              <div style="margin-bottom:16px;">
                <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px;">Travel Start Date *</label>
                <input type="date" name="travelStartDate" required min="{{ 'now'|date('Y-m-d') }}"
                  style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-primary);">
                <span class="field-error" style="color:#ef4444;font-size:12px;display:none;">Please select a start date.</span>
              </div>
              <div style="margin-bottom:16px;">
                <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px;">Travel End Date *</label>
                <input type="date" name="travelEndDate" required min="{{ 'now'|date('Y-m-d') }}"
                  style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-primary);">
                <span class="field-error" style="color:#ef4444;font-size:12px;display:none;">Please select an end date after start date.</span>
              </div>
              <div style="margin-bottom:16px;">
                <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px;">Number of Travelers *</label>
                <input type="number" name="numTravelers" min="1" max="20" value="1" required
                  style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-primary);">
                <span class="field-error" style="color:#ef4444;font-size:12px;display:none;">Must be between 1 and 20.</span>
              </div>
              <div style="margin-bottom:20px;">
                <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px;">Notes</label>
                <textarea name="notes" rows="3" placeholder="Any special requests..."
                  style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-primary);resize:vertical;"></textarea>
              </div>
              <div class="muted-box" style="margin-bottom:20px;">
                ✦ You'll earn <strong style="color:var(--accent-primary);">50 loyalty points</strong> on this booking.<br>
                ✦ Status starts as <strong>PENDING</strong> until confirmed by admin.
              </div>
              <button type="submit" class="btn btn-primary ripple-btn" style="width:100%;padding:14px;">Confirm Booking ✦</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<footer class="footer">
  <div class="container">
    <div class="footer-bottom">
      <div class="footer-copy">© 2026 TripX. All rights reserved.</div>
      <a href="{{ path('index') }}" class="footer-copy" style="color:var(--accent-primary)">← Back to Home</a>
    </div>
  </div>
</footer>

<script src="/assets.php?f=js/main.js"></script>
<script>
// Client-side validation
document.querySelector('form').addEventListener('submit', function(e) {
  let valid = true;
  const errors = this.querySelectorAll('.field-error');
  errors.forEach(el => el.style.display = 'none');

  const start = this.querySelector('[name="travelStartDate"]');
  const end   = this.querySelector('[name="travelEndDate"]');
  const num   = this.querySelector('[name="numTravelers"]');

  if (!start.value) { start.nextElementSibling.style.display='block'; valid=false; }
  if (!end.value || end.value <= start.value) { end.nextElementSibling.style.display='block'; valid=false; }
  if (!num.value || num.value < 1 || num.value > 20) { num.nextElementSibling.style.display='block'; valid=false; }

  if (!valid) e.preventDefault();
});
</script>
<script>
  // API-powered insights (RestCountries + Calendarific)
  function initPackApiInsights() {
    const destId = {{ pack.destinationId |json_encode|raw }};
    const els = {
      loading: document.getElementById('api-insights-loading'),
      empty: document.getElementById('api-insights-empty'),
      box: document.getElementById('api-insights'),
      error: null,
      country: document.getElementById('ins-country'),
      capital: document.getElementById('ins-capital'),
      region: document.getElementById('ins-region'),
      languages: document.getElementById('ins-languages'),
      currencies: document.getElementById('ins-currencies'),
      holidays: document.getElementById('ins-holidays'),
      holidaysNote: document.getElementById('ins-holidays-note'),
      destPill: document.getElementById('dest-pill'),
      destText: document.getElementById('dest-text'),
      destFlagWrap: document.getElementById('dest-flag-wrap'),
      currencyPill: document.getElementById('dest-currency-pill'),
      currencyText: document.getElementById('dest-currency-text'),
      langPill: document.getElementById('dest-language-pill'),
      langText: document.getElementById('dest-language-text'),
    };

    const show = (el) => { if (el) el.style.display = ''; };
    const hide = (el) => { if (el) el.style.display = 'none'; };

    // Create an error box lazily so we can show real diagnostics.
    const errorBox = document.createElement('div');
    errorBox.className = 'muted-box';
    errorBox.style.display = 'none';
    errorBox.style.borderColor = 'rgba(239,68,68,0.35)';
    errorBox.style.background = 'rgba(239,68,68,0.06)';
    errorBox.style.color = 'var(--text-muted)';
    errorBox.id = 'api-insights-error';
    const loadingEl = document.getElementById('api-insights-loading');
    const container = loadingEl ? loadingEl.parentElement : null;
    if (container) container.insertBefore(errorBox, container.firstChild);
    els.error = errorBox;

    if (!destId) {
      show(els.empty);
      return;
    }

    show(els.loading);
    hide(els.empty);
    hide(els.box);
    hide(els.error);

    fetch('/api/packs-offers/country?destinationId=' + encodeURIComponent(destId), { headers: { 'Accept': 'application/json' } })
      .then(function (r) {
        // If auth redirects to HTML, JSON parse will fail — show a helpful error.
        const contentType = r.headers.get('content-type') || '';
        if (contentType.indexOf('application/json') === -1) {
          return r.text().then(function (text) {
            const first = text ? String(text).slice(0, 80).replace(/\s+/g, ' ') : '';
            throw new Error('Expected JSON but got ' + (contentType || 'unknown content-type') + ' (status ' + r.status + ').' + (first ? (' First chars: ' + first) : ''));
          });
        }
        return r.json();
      })
      .then(async function (payload) {
        hide(els.loading);

        if (!payload || !payload.ok || !payload.data) {
          show(els.empty);
          return;
        }

        const c = payload.data;
        show(els.box);

        const countryLabel = c.name || payload.country || '—';
        const regionLabel = [c.region, c.subregion].filter(Boolean).join(' · ') || '—';
        const langs = Array.isArray(c.languages) && c.languages.length ? c.languages.join(', ') : '—';
        const curr = Array.isArray(c.currencies) && c.currencies.length
          ? c.currencies.map(x => (x.symbol ? `${x.code} (${x.symbol})` : x.code)).join(', ')
          : '—';

        els.country.textContent = countryLabel;
        els.capital.textContent = c.capital || '—';
        els.region.textContent = regionLabel;
        els.languages.textContent = langs;
        els.currencies.textContent = curr;

        // Hero pills
        if (els.destPill) {
          els.destText.textContent = countryLabel;
          if (c.flagPng) {
            els.destFlagWrap.innerHTML = `<img class="flag" src="${c.flagPng}" alt="${countryLabel} flag">`;
          }
          show(els.destPill);
        }
        if (Array.isArray(c.currencies) && c.currencies.length) {
          els.currencyText.textContent = c.currencies[0].code + (c.currencies[0].symbol ? ` (${c.currencies[0].symbol})` : '');
          show(els.currencyPill);
        }
        if (Array.isArray(c.languages) && c.languages.length) {
          els.langText.textContent = c.languages[0];
          show(els.langPill);
        }

        // Holidays (Calendarific) — needs API key server-side, otherwise returns 0
        const cca2 = c.cca2;
        if (!cca2) {
          els.holidaysNote.textContent = 'No country code available for holidays.';
          return;
        }

        const year = new Date().getFullYear();
        const hRes = await fetch('/api/packs-offers/holidays?countryCode=' + encodeURIComponent(cca2) + '&year=' + year, { headers: { 'Accept': 'application/json' } });
        const hPayload = await hRes.json();

        const holidays = (hPayload && Array.isArray(hPayload.holidays)) ? hPayload.holidays : [];
        const todayIso = new Date().toISOString().slice(0, 10);

        // Calendarific date shape usually: holiday.date.iso ("YYYY-MM-DD")
        const upcoming = holidays
          .map(h => ({
            name: h.name || h.description || 'Holiday',
            iso: (h.date && (h.date.iso || (h.date.datetime && h.date.datetime.date))) || null
          }))
          .filter(h => h.iso && h.iso >= todayIso)
          .sort((a, b) => a.iso.localeCompare(b.iso))
          .slice(0, 6);

        els.holidays.innerHTML = '';
        if (!upcoming.length) {
          els.holidaysNote.textContent = holidays.length
            ? 'No upcoming holidays found in the remaining year.'
            : 'No holidays data (Calendarific key may be missing).';
          return;
        }

        els.holidaysNote.textContent = `Next holidays in ${countryLabel}:`;
        upcoming.forEach(h => {
          const el = document.createElement('span');
          el.className = 'pill';
          el.textContent = `${h.iso} · ${h.name}`;
          els.holidays.appendChild(el);
        });
      })
      .catch(function (e) {
        hide(els.loading);
        hide(els.box);
        hide(els.empty);
        if (els.error) {
          els.error.style.display = '';
          const msg = (e && e.message) ? e.message : String(e);
          els.error.innerHTML = 'Could not load API insights. <strong>Tip:</strong> make sure you are logged in as a user.' +
            '<br><span style="font-family:var(--font-mono);font-size:12px;">' + msg + '</span>';
        }
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPackApiInsights);
  } else {
    initPackApiInsights();
  }
</script>
</body>
</html>
