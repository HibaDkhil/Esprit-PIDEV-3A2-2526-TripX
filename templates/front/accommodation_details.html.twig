{% extends 'base.html.twig' %}

{% block title %}{{ accommodation.name }} — TripX{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.1.0/fonts/remixicon.css" rel="stylesheet">
<style>
:root {
  --accent: #a78bfa;
  --accent2: #38bdf8;
  --gold: #fbbf24;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --glow-accent: rgba(167,139,250,0.35);
  --glow-accent2: rgba(56,189,248,0.25);
  --glass-bg: rgba(20,30,48,0.85);
  --glass-border: rgba(167,139,250,0.18);
  --gradient-text: linear-gradient(135deg, #ffffff 0%, #c4b5fd 50%, #93c5fd 100%);
}

/* ── Hero ── */
.hero-section {
  position: relative;
  height: 50vh;
  min-height: 400px;
  background: linear-gradient(135deg, #1e3a5f, #0a6587);
  overflow: hidden;
}
.hero-image { width: 100%; height: 100%; object-fit: cover; }
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7));
  z-index: 2;
}
.hero-content {
  position: absolute; bottom: 40px; left: 0; right: 0;
  padding: 0 40px; color: white; z-index: 3;
}
.hero-content h1 {
  font-size: 48px; font-weight: 800;
  font-family: 'Playfair Display', serif;
  margin-bottom: 16px;
  text-shadow: 0 2px 10px rgba(0,0,0,0.3);
}
.hero-meta { display: flex; gap: 24px; flex-wrap: wrap; font-size: 14px; opacity: 0.9; }

/* ── Layout ── */
.details-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 32px;
  max-width: 1400px;
  margin: 40px auto;
  padding: 0 24px;
}
.details-main { display: flex; flex-direction: column; gap: 40px; }

/* ── Sidebar ── */
.details-sidebar {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
  scrollbar-color: rgba(167,139,250,0.3) transparent;
}
.details-sidebar::-webkit-scrollbar { width: 4px; }
.details-sidebar::-webkit-scrollbar-track { background: transparent; }
.details-sidebar::-webkit-scrollbar-thumb { background: rgba(167,139,250,0.3); border-radius: 2px; }

/* ── Section Cards ── */
.section-card {
  background: linear-gradient(to right, rgb(20, 30, 48), rgb(36, 59, 85));
  border: 1px solid rgba(167,139,250,0.15);
  border-radius: 15px;
  overflow: hidden;
  box-shadow: rgba(0,0,0,0.7) 5px 10px 50px, rgba(0,0,0,0.4) -5px 0px 80px;
  transition: all 0.3s ease-in-out;
  color: #e2e8f0;
}
.section-card:hover {
  box-shadow: rgba(0,0,0,0.9) 5px 10px 50px, rgba(0,0,0,0.7) -5px 0px 120px;
}
.section-header {
  padding: 20px 24px;
  border-bottom: 1px solid rgba(167,139,250,0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.section-header h2 {
  font-size: 20px;
  font-weight: 700;
  font-family: 'Playfair Display', serif;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-content { padding: 24px; }

/* ── Amenities ── */
.amenities-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
.amenity-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(167,139,250,0.2);
  border-radius: 12px;
  font-size: 13px;
  color: #cbd5e1;
}

/* ── Rooms ── */
.rooms-grid { display: grid; gap: 16px; }
.room-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(167,139,250,0.2);
  border-radius: 16px;
  padding: 16px;
  transition: var(--transition);
}
.room-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
  background: rgba(167,139,250,0.08);
}
.room-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.room-name { font-size: 18px; font-weight: 700; color: #fff; }
.room-price { font-size: 20px; font-weight: 800; color: var(--accent); }
.room-price small { font-size: 12px; font-weight: normal; color: #94a3b8; }
.room-details {
  display: flex;
  gap: 16px;
  margin-bottom: 12px;
  font-size: 13px;
  color: #94a3b8;
}
.room-amenities {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.room-amenity {
  padding: 4px 10px;
  background: rgba(167,139,250,0.15);
  border-radius: 20px;
  font-size: 11px;
  color: #c4b5fd;
}

/* ── Empty state ── */
.empty-state {
  text-align: center;
  padding: 40px;
  color: #64748b;
}
.empty-state .icon {
  font-size: 48px;
  margin-bottom: 16px;
  opacity: 0.5;
}

/* ── Nearby ── */
.nearby-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
}
.nearby-card {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(167,139,250,0.15);
  border-radius: 12px;
  transition: var(--transition);
}
.nearby-card:hover {
  background: rgba(167,139,250,0.1);
  transform: translateY(-2px);
}
.nearby-icon { font-size: 32px; }
.nearby-info h4 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 4px;
  color: #e2e8f0;
}
.nearby-info p {
  font-size: 12px;
  color: #94a3b8;
}

/* ── Gallery ── */
.gallery-stack-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  padding: 20px 0 10px;
}
.gallery-card {
  display: flex;
  height: 220px;
  width: 160px;
  border-radius: 10px;
  box-shadow: -1rem 0 3rem rgba(0,0,0,0.6);
  margin-left: -60px;
  transition: 0.4s ease-out;
  position: relative;
  left: 0;
  overflow: hidden;
  cursor: pointer;
  flex-shrink: 0;
}
.gallery-card:first-child { margin-left: 0; }
.gallery-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: 0.4s ease-out;
}
.gallery-card:hover {
  transform: translateY(-20px);
  box-shadow: 0 20px 40px rgba(167,139,250,0.3);
  z-index: 10;
}
.gallery-card:hover ~ .gallery-card {
  position: relative;
  left: 50px;
  transition: 0.4s ease-out;
}
.gallery-card .gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  opacity: 0;
  transition: 0.3s ease-out;
}
.gallery-card:hover .gallery-overlay { opacity: 1; }
.gallery-card .gallery-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4px;
}
.gallery-card .gallery-bar-empty {
  background: rgba(255,255,255,0.1);
  width: 100%;
  height: 100%;
}
.gallery-card .gallery-bar-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, #6831cfab, #a777ff 100%);
  transition: 0.4s ease-out;
}
.gallery-card:hover .gallery-bar-fill { width: 100%; }

/* ── Reviews ── */
.reviews-summary {
  text-align: center;
  padding: 20px;
  background: linear-gradient(135deg, rgba(167,139,250,0.1), rgba(56,189,248,0.1));
  border-radius: 20px;
  margin-bottom: 24px;
}
.average-rating {
  font-size: 48px;
  font-weight: 800;
  color: var(--gold);
}
.stars {
  color: var(--gold);
  font-size: 20px;
  letter-spacing: 2px;
}
.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-height: 400px;
  overflow-y: auto;
}
.review-item {
  padding: 16px;
  border-bottom: 1px solid rgba(167,139,250,0.15);
}
.review-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}
.review-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: white;
}
.review-author { font-weight: 600; color: #fff; }
.review-rating { color: var(--gold); font-size: 12px; }
.review-text {
  font-size: 14px;
  line-height: 1.5;
  color: #94a3b8;
}

/* ══════════════════════════════════════════
   WEATHER CARD
══════════════════════════════════════════ */
.wx-card {
  border-radius: 15px;
  overflow: hidden;
  background: linear-gradient(135deg, #1a1040 0%, #2d1b69 50%, #1a2744 100%);
  border: 1px solid rgba(167,139,250,0.2);
  box-shadow: rgba(0,0,0,0.7) 5px 10px 50px;
  color: #fff;
  flex-shrink: 0;
}
.wx-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 16px;
  position: relative;
}
.wx-main::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 180px; height: 180px;
  border-radius: 50%;
  background: rgba(138,79,248,0.25);
  pointer-events: none;
}
.wx-main::after {
  content: '';
  position: absolute;
  top: -30px; right: -20px;
  width: 90px; height: 90px;
  border-radius: 50%;
  background: rgba(167,139,250,0.35);
  pointer-events: none;
}
.wx-left { position: relative; z-index: 1; }
.wx-location {
  font-size: 13px;
  font-weight: 700;
  color: #c4b5fd;
  margin-bottom: 4px;
}
.wx-condition {
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.wx-condition img {
  width: 28px;
  height: 28px;
}
.wx-meta {
  display: flex;
  gap: 14px;
  font-size: 11px;
  color: #94a3b8;
}
.wx-right {
  text-align: right;
  position: relative;
  z-index: 1;
}
.wx-temp {
  font-size: 52px;
  font-weight: 700;
  line-height: 1;
  color: #fff;
  letter-spacing: -2px;
}
.wx-temp sup {
  font-size: 20px;
  font-weight: 400;
  vertical-align: super;
  color: #c4b5fd;
}
.wx-range {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 4px;
}
.wx-forecast {
  display: flex;
  border-top: 1px solid rgba(167,139,250,0.15);
}
.wx-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10px 4px;
  gap: 3px;
  background: rgba(0,0,0,0.2);
  border-right: 1px solid rgba(167,139,250,0.08);
  cursor: pointer;
  transition: background 0.15s;
}
.wx-day:last-child { border-right: none; }
.wx-day:hover { background: rgba(167,139,250,0.12); }
.wx-day-label {
  font-size: 9px;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.wx-day img {
  width: 22px;
  height: 22px;
}
.wx-day-temp {
  font-size: 12px;
  font-weight: 700;
  color: #a78bfa;
}

/* ── Mini Map — sidebar card ── */
.map-sidebar-card {
  background: linear-gradient(to right, rgb(20, 30, 48), rgb(36, 59, 85));
  border: 1px solid rgba(167,139,250,0.15);
  border-radius: 15px;
  overflow: hidden;
  box-shadow: rgba(0,0,0,0.7) 5px 10px 50px, rgba(0,0,0,0.4) -5px 0px 80px;
  flex-shrink: 0;
  min-height: 260px;
}
.map-sidebar-header {
  padding: 16px 20px;
  border-bottom: 1px solid rgba(167,139,250,0.15);
  display: flex;
  align-items: center;
  gap: 10px;
}
.map-sidebar-header h2 {
  font-size: 18px;
  font-weight: 700;
  font-family: 'Playfair Display', serif;
  color: #fff;
  margin: 0;
}
.mini-map {
  height: 220px;
  width: 100%;
  display: block;
  background: rgba(0,0,0,0.2);
}
.leaflet-container {
  background: #1a2035 !important;
  width: 100% !important;
  height: 100% !important;
}
.leaflet-control-attribution {
  background: rgba(0,0,0,0.5) !important;
  color: #94a3b8 !important;
  font-size: 9px !important;
}
.leaflet-popup-content-wrapper {
  background: #1e2a3e;
  color: #e2e8f0;
  border-radius: 8px;
}
.leaflet-popup-tip { background: #1e2a3e; }

/* ── Itinerary ── */
.itinerary-content {
  font-family: monospace;
  line-height: 1.6;
  white-space: pre-wrap;
  font-size: 14px;
  color: #94a3b8;
}
.generate-itinerary {
  padding: 10px 20px;
  background: linear-gradient(135deg, #4a2f7c, #8a4ff8);
  border: none;
  border-radius: 50px;
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: 0.4s ease-out;
}
.generate-itinerary:hover {
  box-shadow: 0px 0px 20px rgba(157,71,255,0.5), inset 4px 4px 8px rgba(219,175,255,0.5), inset -4px -4px 8px rgba(137,19,216,0.35);
}
select#itinerary-days, select#nearby-category {
  padding: 8px 12px;
  border-radius: 12px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(167,139,250,0.2);
  color: #e2e8f0;
  margin-right: 8px;
}
select#itinerary-days option, select#nearby-category option { background: #1a2035; }

/* ── Skeleton ── */
.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(167,139,250,0.08) 50%, rgba(255,255,255,0.04) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 12px;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── Image Modal ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.95);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  cursor: pointer;
}
.modal-overlay.open { opacity: 1; visibility: visible; }
.modal-content { max-width: 90vw; max-height: 90vh; cursor: default; }
.modal-content img { max-width: 100%; max-height: 90vh; border-radius: 12px; }

/* ── Booking Drawer ── */
.drawer-backdrop {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0);
  backdrop-filter: blur(0px);
  z-index: 3000;
  pointer-events: none;
  transition: background 0.5s ease, backdrop-filter 0.5s ease;
}
.drawer-backdrop.open {
  background: rgba(0,0,0,0.65);
  backdrop-filter: blur(6px);
  pointer-events: all;
}
.booking-drawer {
  position: fixed; top: 0; right: 0;
  width: 520px; height: 100vh;
  z-index: 3001;
  background: linear-gradient(160deg, #0d1b2e 0%, #14243e 40%, #1a1a3e 100%);
  border-left: 1px solid rgba(167,139,250,0.2);
  box-shadow: -20px 0 80px rgba(0,0,0,0.8), -2px 0 30px rgba(167,139,250,0.05);
  transform: translateX(100%);
  transition: transform 0.55s cubic-bezier(0.32,0.72,0,1);
  display: flex; flex-direction: column; overflow: hidden;
  font-family: 'DM Sans', sans-serif; color: #e2e8f0;
}
.booking-drawer.open { transform: translateX(0); }
.drawer-close {
  position: absolute; top: 18px; right: 20px; z-index: 10;
  width: 36px; height: 36px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 50%; color: #94a3b8; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; transition: all 0.2s;
  backdrop-filter: blur(10px);
}
.drawer-close:hover {
  background: rgba(239,68,68,0.2);
  border-color: rgba(239,68,68,0.4);
  color: #fca5a5;
  transform: rotate(90deg);
}
.drawer-progress {
  display: flex; align-items: center; gap: 0;
  padding: 64px 28px 16px; position: relative; z-index: 5; flex-shrink: 0;
}
.progress-step { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }
.progress-dot {
  width: 32px; height: 32px; border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 2px solid rgba(167,139,250,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; color: #64748b;
  transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
  position: relative; z-index: 2;
}
.progress-dot.active {
  background: linear-gradient(135deg, #4a2f7c, #8a4ff8);
  border-color: #a78bfa; color: white;
  box-shadow: 0 0 20px rgba(138,79,248,0.5);
}
.progress-dot.done {
  background: linear-gradient(135deg, #065f46, #059669);
  border-color: #10b981; color: white;
  box-shadow: 0 0 12px rgba(16,185,129,0.4);
}
.progress-label {
  font-size: 10px; font-weight: 600; color: #475569;
  letter-spacing: 0.5px; text-transform: uppercase; transition: color 0.3s;
}
.progress-step.active .progress-label { color: #a78bfa; }
.progress-step.done .progress-label { color: #10b981; }
.progress-line {
  flex: 1; height: 2px;
  background: rgba(167,139,250,0.12);
  position: relative; margin-bottom: 22px; max-width: 60px;
}
.progress-line-fill {
  position: absolute; top: 0; left: 0; height: 100%; width: 0%;
  background: linear-gradient(90deg, #4a2f7c, #8a4ff8);
  transition: width 0.5s cubic-bezier(0.4,0,0.2,1);
}
.drawer-steps { flex: 1; overflow: hidden; position: relative; min-height: 0; }
.drawer-step {
  position: absolute; inset: 0; overflow-y: auto;
  padding: 24px 28px 28px;
  transform: translateX(100%); opacity: 0;
  transition: transform 0.45s cubic-bezier(0.32,0.72,0,1), opacity 0.3s ease;
  scrollbar-width: thin;
  scrollbar-color: rgba(167,139,250,0.3) transparent;
}
.drawer-step::-webkit-scrollbar { width: 4px; }
.drawer-step::-webkit-scrollbar-track { background: transparent; }
.drawer-step::-webkit-scrollbar-thumb { background: rgba(167,139,250,0.3); border-radius: 2px; }
.drawer-step.active { transform: translateX(0); opacity: 1; }
.drawer-step.exiting { transform: translateX(-40px); opacity: 0; }
.room-carousel {
  position: relative; height: 240px; border-radius: 16px;
  overflow: hidden; margin-bottom: 24px;
  background: rgba(255,255,255,0.04);
}
.carousel-slides { display: flex; height: 100%; transition: transform 0.4s cubic-bezier(0.4,0,0.2,1); }
.carousel-slide { min-width: 100%; height: 100%; object-fit: cover; flex-shrink: 0; }
.carousel-slide-placeholder {
  min-width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 80px;
  background: linear-gradient(135deg, rgba(74,47,124,0.3), rgba(56,189,248,0.1));
}
.carousel-btn {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 36px; height: 36px;
  background: rgba(0,0,0,0.6); backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.15); border-radius: 50%;
  color: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; transition: all 0.2s; z-index: 5;
}
.carousel-btn:hover { background: rgba(138,79,248,0.6); border-color: rgba(167,139,250,0.5); }
.carousel-btn.prev { left: 12px; }
.carousel-btn.next { right: 12px; }
.carousel-dots {
  position: absolute; bottom: 10px; left: 50%;
  transform: translateX(-50%);
  display: flex; gap: 6px; z-index: 5;
}
.carousel-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: rgba(255,255,255,0.4); transition: all 0.3s; cursor: pointer;
}
.carousel-dot.active { width: 20px; border-radius: 3px; background: #a78bfa; }
.room-preview-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.room-preview-name { font-size: 22px; font-weight: 700; color: #fff; font-family: 'Playfair Display', serif; }
.room-preview-badge {
  padding: 4px 12px;
  background: rgba(167,139,250,0.15);
  border: 1px solid rgba(167,139,250,0.3);
  border-radius: 20px; font-size: 11px; font-weight: 600;
  color: #c4b5fd; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;
}
.room-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 20px; }
.room-stat {
  padding: 12px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(167,139,250,0.12);
  border-radius: 12px; text-align: center;
}
.room-stat-icon { font-size: 20px; margin-bottom: 4px; }
.room-stat-value { font-size: 15px; font-weight: 700; color: #fff; }
.room-stat-label { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
.preview-price-tag { display: flex; align-items: baseline; gap: 6px; margin-bottom: 20px; }
.preview-price-amount { font-size: 36px; font-weight: 800; color: #a78bfa; }
.preview-price-per { font-size: 14px; color: #64748b; }
.drawer-amenities { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.drawer-amenity {
  padding: 6px 12px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(167,139,250,0.15);
  border-radius: 20px; font-size: 12px; color: #94a3b8;
}
.stay-section-title {
  font-size: 12px; font-weight: 700; color: #64748b;
  text-transform: uppercase; letter-spacing: 1px;
  margin-bottom: 10px; margin-top: 20px;
}
.stay-section-title:first-child { margin-top: 0; }
.date-range-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 4px; }
.date-field { display: flex; flex-direction: column; gap: 6px; }
.date-field label {
  font-size: 11px; font-weight: 600; color: #64748b;
  text-transform: uppercase; letter-spacing: 0.5px;
}
.drawer-input {
  width: 100%; padding: 12px 14px;
  background: rgba(255,255,255,0.06);
  border: 1.5px solid rgba(167,139,250,0.15);
  border-radius: 12px; color: #e2e8f0; font-size: 14px;
  transition: all 0.2s; outline: none;
  font-family: 'DM Sans', sans-serif; box-sizing: border-box;
}
.drawer-input:focus {
  border-color: rgba(167,139,250,0.6);
  background: rgba(167,139,250,0.08);
  box-shadow: 0 0 0 3px rgba(167,139,250,0.1);
}
.drawer-input option { background: #1a2035; }
.nights-pill {
  text-align: center; padding: 8px;
  background: linear-gradient(135deg, rgba(74,47,124,0.3), rgba(56,189,248,0.1));
  border: 1px solid rgba(167,139,250,0.2);
  border-radius: 30px; margin: 12px 0;
  font-size: 13px; font-weight: 600; color: #a78bfa; transition: all 0.3s;
}
.guest-stepper {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  background: rgba(255,255,255,0.04);
  border: 1.5px solid rgba(167,139,250,0.15);
  border-radius: 12px; margin-bottom: 12px;
}
.stepper-label { display: flex; flex-direction: column; gap: 2px; }
.stepper-label span:first-child { font-size: 14px; font-weight: 600; color: #e2e8f0; }
.stepper-label span:last-child { font-size: 11px; color: #64748b; }
.stepper-controls { display: flex; align-items: center; gap: 12px; }
.stepper-btn {
  width: 32px; height: 32px;
  background: rgba(167,139,250,0.12);
  border: 1px solid rgba(167,139,250,0.25);
  border-radius: 8px; color: #a78bfa; cursor: pointer;
  font-size: 18px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s; line-height: 1;
}
.stepper-btn:hover:not(:disabled) {
  background: rgba(167,139,250,0.25);
  border-color: rgba(167,139,250,0.5);
  transform: scale(1.1);
}
.stepper-btn:disabled { opacity: 0.3; cursor: not-allowed; }
.stepper-count { font-size: 18px; font-weight: 700; color: #fff; min-width: 20px; text-align: center; }
.price-breakdown {
  background: linear-gradient(135deg, rgba(74,47,124,0.2), rgba(56,189,248,0.08));
  border: 1px solid rgba(167,139,250,0.2);
  border-radius: 16px; padding: 16px; margin-top: 20px;
}
.price-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 6px 0; font-size: 14px; color: #94a3b8;
}
.price-row.total {
  border-top: 1px solid rgba(167,139,250,0.2);
  margin-top: 8px; padding-top: 14px;
  font-size: 18px; font-weight: 800; color: #fff;
}
.price-row.total span:last-child { color: #a78bfa; }
.booking-recap {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(167,139,250,0.15);
  border-radius: 14px; padding: 14px; margin-bottom: 20px;
  display: flex; justify-content: space-between; align-items: center;
}
.recap-label { font-size: 11px; color: #64748b; margin-bottom: 2px; }
.recap-value { font-size: 13px; font-weight: 600; color: #e2e8f0; }
.recap-price { font-size: 22px; font-weight: 800; color: #a78bfa; }
.wallet-section-label {
  font-size: 11px; font-weight: 700; color: #64748b;
  text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px;
}
.pay-wallet-outer { display: flex; flex-direction: column; align-items: center; margin-bottom: 24px; }
.pay-wallet {
  position: relative; width: 100%; max-width: 380px; height: 220px;
  cursor: pointer; perspective: 1000px;
  display: flex; justify-content: center; align-items: flex-end;
  transition: transform 0.4s ease;
}
.pay-wallet-back {
  position: absolute; bottom: 0; width: 100%; max-width: 380px; height: 185px;
  background: #1e2a1e; border-radius: 22px 22px 55px 55px; z-index: 5;
  box-shadow: inset 0 25px 35px rgba(0,0,0,0.5), inset 0 5px 15px rgba(0,0,0,0.6);
}
@keyframes pwSlideIn {
  0% { transform: translateY(-90px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
.pay-card {
  position: absolute; width: calc(100% - 20px); max-width: 360px; height: 130px; left: 10px;
  border-radius: 16px; padding: 16px 18px; color: white;
  box-shadow: inset 0 1px 1px rgba(255,255,255,0.25), 0 -4px 15px rgba(0,0,0,0.15);
  transition: transform 0.6s cubic-bezier(0.34,1.56,0.64,1);
  animation: pwSlideIn 0.8s cubic-bezier(0.2,0.8,0.2,1) backwards;
  cursor: pointer; user-select: none; overflow: hidden;
}
.pay-card::before {
  content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 50%);
  pointer-events: none;
}
.pay-card-inner { display: flex; flex-direction: column; justify-content: space-between; height: 100%; position: relative; z-index: 1; }
.pay-card-top { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }
.pay-chip { width: 28px; height: 21px; background: rgba(255,255,255,0.18); border-radius: 4px; border: 1px solid rgba(255,255,255,0.12); }
.pay-card-bottom { display: flex; justify-content: space-between; align-items: flex-end; }
.pay-card-label { font-size: 8px; opacity: 0.65; text-transform: uppercase; margin-bottom: 2px; display: block; letter-spacing: 0.5px; }
.pay-card-value { font-size: 10px; font-weight: 600; }
.pay-card-num-wrap { text-align: right; }
.pay-card-stars { font-size: 14px; letter-spacing: 3px; opacity: 0.8; }
.pay-visa { background: linear-gradient(135deg, #1a3a6f 0%, #1565c0 70%, #0d47a1 100%); bottom: 88px; z-index: 10; animation-delay: 0.08s; }
.pay-mc { background: linear-gradient(135deg, #6a0000 0%, #b71c1c 55%, #c62828 100%); bottom: 60px; z-index: 20; animation-delay: 0.18s; }
.pay-amex { background: linear-gradient(135deg, #1b3a20 0%, #2e7d32 55%, #388e3c 100%); bottom: 32px; z-index: 30; animation-delay: 0.28s; }
.pay-pocket { position: absolute; bottom: 0; width: 100%; max-width: 380px; height: 155px; z-index: 40; filter: drop-shadow(0 12px 22px rgba(10,20,10,0.55)); }
.pay-pocket-content { position: absolute; top: 38px; width: 100%; text-align: center; z-index: 50; display: flex; flex-direction: column; align-items: center; gap: 5px; }
.pay-balance-stars { color: #5a7a53; font-size: 20px; letter-spacing: 4px; transition: opacity 0.3s, transform 0.3s; }
.pay-balance-real { color: #8dc880; font-size: 19px; font-weight: 700; opacity: 0; position: absolute; top: 0; left: 50%; transform: translate(-50%, 8px); transition: opacity 0.3s, transform 0.3s; white-space: nowrap; }
.pay-eye-wrap { margin-top: 6px; height: 18px; width: 18px; position: relative; opacity: 0.3; transition: opacity 0.3s; }
.pay-eye { position: absolute; top: 0; left: 0; stroke: #4ade80; transition: opacity 0.3s, transform 0.3s; }
.pay-wallet:hover { transform: translateY(-4px); }
.pay-wallet:hover .pay-eye-wrap { opacity: 1; }
.pay-wallet:hover .pay-visa { transform: translateY(-72px) rotate(-3.5deg); }
.pay-wallet:hover .pay-mc { transform: translateY(-44px) rotate(2deg); }
.pay-wallet:hover .pay-amex { transform: translateY(-10px); }
.pay-card:hover { z-index: 100 !important; }
.pay-wallet:hover .pay-visa:hover { transform: translateY(-62px) scale(1.04) rotate(0deg); }
.pay-wallet:hover .pay-mc:hover { transform: translateY(-70px) scale(1.04) rotate(0deg); }
.pay-wallet:hover .pay-amex:hover { transform: translateY(-62px) scale(1.04) rotate(0deg); }
.pay-wallet:hover .pay-balance-stars { opacity: 0; transform: translateY(-4px); }
.pay-wallet:hover .pay-balance-real { opacity: 1; transform: translate(-50%, 0); }
.pay-wallet:hover .pay-eye-slash { opacity: 0; transform: scale(0.5); }
.pay-wallet:hover .pay-eye-open { opacity: 1; transform: scale(1.1); }
.pay-card.selected { outline: none; z-index: 200 !important; }
.pay-card.selected::after { content: '✓'; position: absolute; top: 8px; right: 8px; width: 20px; height: 20px; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; line-height: 20px; text-align: center; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.3); }
.pay-visa.selected { box-shadow: 0 0 0 2px #5b9bd5, 0 8px 30px rgba(21,101,192,0.5); }
.pay-mc.selected { box-shadow: 0 0 0 2px #e57373, 0 8px 30px rgba(198,40,40,0.5); }
.pay-amex.selected { box-shadow: 0 0 0 2px #81c784, 0 8px 30px rgba(56,142,60,0.5); }
.pay-wallet-hint { font-size: 11px; color: #4a5568; margin-top: 10px; font-style: italic; text-align: center; transition: color 0.3s; }
.pay-wallet-hint.selected-hint { color: #a78bfa; font-style: normal; font-weight: 600; }
.pay-format-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; background: rgba(167,139,250,0.1); border: 1px solid rgba(167,139,250,0.2); border-radius: 20px; font-size: 11px; font-weight: 600; color: #a78bfa; margin-bottom: 14px; transition: all 0.3s; }
.pay-format-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.payment-field { margin-bottom: 14px; }
.payment-field label { display: block; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
.payment-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.secure-badge { display: flex; align-items: center; gap: 8px; justify-content: center; padding: 10px 16px; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); border-radius: 30px; margin: 16px 0; font-size: 12px; font-weight: 600; color: #34d399; }
.demo-notice { text-align: center; font-size: 11px; color: #475569; margin-top: 8px; line-height: 1.5; }
.confirmation-wrapper { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px 0; }
.confirm-checkmark { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #065f46, #10b981); display: flex; align-items: center; justify-content: center; font-size: 36px; margin-bottom: 20px; animation: pulse-success 2s ease-in-out infinite; }
@keyframes pulse-success { 0%,100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); } 50% { box-shadow: 0 0 0 20px rgba(16,185,129,0); } }
@keyframes pop-in { 0% { transform: scale(0.5); opacity: 0; } 70% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
.confirm-checkmark.animate { animation: pop-in 0.6s cubic-bezier(0.175,0.885,0.32,1.275) forwards, pulse-success 2s 0.6s ease-in-out infinite; }
.confirm-title { font-size: 28px; font-weight: 800; color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 8px; }
.confirm-subtitle { font-size: 14px; color: #64748b; margin-bottom: 24px; }
.booking-reference { padding: 12px 24px; background: linear-gradient(135deg, rgba(74,47,124,0.3), rgba(56,189,248,0.1)); border: 1px solid rgba(167,139,250,0.3); border-radius: 30px; margin-bottom: 24px; font-family: monospace; font-size: 18px; font-weight: 700; color: #a78bfa; letter-spacing: 2px; }
.confirm-summary { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(167,139,250,0.12); border-radius: 16px; overflow: hidden; }
.confirm-row { display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid rgba(167,139,250,0.08); font-size: 14px; }
.confirm-row:last-child { border-bottom: none; }
.confirm-row span:first-child { color: #64748b; }
.confirm-row span:last-child { color: #e2e8f0; font-weight: 600; }
.drawer-footer { padding: 16px 28px 24px; border-top: 1px solid rgba(167,139,250,0.1); background: rgba(0,0,0,0.2); backdrop-filter: blur(10px); flex-shrink: 0; }
.drawer-cta { width: 100%; padding: 15px; background: linear-gradient(135deg, #4a2f7c, #8a4ff8); border: none; border-radius: 14px; color: white; font-weight: 700; font-size: 15px; cursor: pointer; transition: all 0.35s ease-out; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: 'DM Sans', sans-serif; letter-spacing: 0.3px; }
.drawer-cta:hover:not(:disabled) { background: linear-gradient(135deg, #8a4ff8, #38bdf8); box-shadow: 0 8px 30px rgba(138,79,248,0.4), inset 0 1px 0 rgba(255,255,255,0.2); transform: translateY(-2px); }
.drawer-cta:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
.drawer-cta.loading { pointer-events: none; }
.drawer-cta .spinner { width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; animation: spin 0.8s linear infinite; display: none; }
.drawer-cta.loading .spinner { display: block; }
.drawer-cta.loading .cta-label { display: none; }
.drawer-back { display: flex; align-items: center; gap: 6px; background: none; border: none; color: #64748b; cursor: pointer; font-size: 13px; font-weight: 500; padding: 8px 0; margin-bottom: 10px; transition: color 0.2s; font-family: 'DM Sans', sans-serif; }
.drawer-back:hover { color: #a78bfa; }
.drawer-back svg { width: 16px; height: 16px; }
@keyframes spin { to { transform: rotate(360deg); } }
#confetti-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 3500; opacity: 0; transition: opacity 0.5s; }
#confetti-canvas.active { opacity: 1; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .details-grid { grid-template-columns: 1fr; }
  .details-sidebar { position: static; max-height: none; overflow-y: visible; }
  .hero-content h1 { font-size: 32px; }
}
@media (max-width: 768px) {
  .hero-section { height: 40vh; min-height: 300px; }
  .hero-content { padding: 0 20px; bottom: 20px; }
  .hero-content h1 { font-size: 24px; }
  .details-grid { padding: 0 16px; margin: 24px auto; }
  .section-header { flex-direction: column; align-items: flex-start; }
  .nearby-grid { grid-template-columns: 1fr; }
  .gallery-card { width: 120px; height: 160px; margin-left: -40px; }
  .booking-drawer { width: 100vw; border-left: none; border-top: 1px solid rgba(167,139,250,0.2); }
  .wx-temp { font-size: 40px; }
}
/* ═══════════════════════════════════════════════════════
   PREMIUM DESIGN OVERHAUL — Animations, Glass, Glow
═══════════════════════════════════════════════════════ */

/* Keyframes */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(32px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes glowPulse {
  0%, 100% { box-shadow: rgba(0,0,0,0.7) 5px 10px 50px, 0 0 0 rgba(167,139,250,0); }
  50%      { box-shadow: rgba(0,0,0,0.7) 5px 10px 50px, 0 0 30px var(--glow-accent); }
}
@keyframes borderGlow {
  0%, 100% { border-color: var(--glass-border); }
  50%      { border-color: rgba(167,139,250,0.35); }
}
@keyframes heroFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50%      { transform: translate(-25px, 15px) scale(1.05); }
}
@keyframes shineSwipe {
  0%   { transform: translateX(-100%) skewX(-15deg); }
  100% { transform: translateX(200%) skewX(-15deg); }
}
@keyframes subtleBreathe {
  0%, 100% { opacity: 0.7; }
  50%      { opacity: 1; }
}

/* ── Icon Badges ── */
.icon-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(167,139,250,0.18), rgba(56,189,248,0.12));
  border: 1px solid rgba(167,139,250,0.22);
  box-shadow: 0 0 18px rgba(167,139,250,0.12);
  flex-shrink: 0;
  transition: all 0.3s;
}
.icon-badge i {
  font-size: 17px;
  background: linear-gradient(135deg, #c4b5fd, #7dd3fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.section-header:hover .icon-badge {
  box-shadow: 0 0 24px rgba(167,139,250,0.3);
  transform: scale(1.08);
}

/* ── Section Cards — Glass + Entrance ── */
.section-card {
  animation: fadeSlideUp 0.65s cubic-bezier(0.22,1,0.36,1) both;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  background: linear-gradient(135deg, var(--glass-bg), rgba(36,59,85,0.88)) !important;
  border: 1px solid var(--glass-border) !important;
  position: relative;
}
.section-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 5%, rgba(167,139,250,0.45) 30%, rgba(56,189,248,0.4) 70%, transparent 95%);
  z-index: 1;
}
.section-card:nth-child(1) { animation-delay: 0.05s; }
.section-card:nth-child(2) { animation-delay: 0.12s; }
.section-card:nth-child(3) { animation-delay: 0.19s; }
.section-card:nth-child(4) { animation-delay: 0.26s; }
.section-card:nth-child(5) { animation-delay: 0.33s; }
.section-card:nth-child(6) { animation-delay: 0.40s; }
.section-card:hover {
  border-color: rgba(167,139,250,0.32) !important;
  box-shadow: rgba(0,0,0,0.8) 5px 10px 50px, 0 0 40px var(--glow-accent);
}

/* ── Section Headers — Gradient Title ── */
.section-header h2 {
  background: var(--gradient-text);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 21px;
  letter-spacing: 0.3px;
}

/* ── Hero Enhancements ── */
.hero-section::after {
  content: '';
  position: absolute;
  top: -40%; right: -20%;
  width: 550px; height: 550px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(167,139,250,0.18) 0%, transparent 65%);
  z-index: 1;
  animation: heroFloat 10s ease-in-out infinite;
  pointer-events: none;
}
.hero-content h1 {
  background: linear-gradient(135deg, #ffffff 20%, #e0d4ff 60%, #c4b5fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: none !important;
  filter: drop-shadow(0 4px 15px rgba(167,139,250,0.25));
}
.hero-meta span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 16px;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 30px;
  border: 1px solid rgba(255,255,255,0.12);
  font-size: 13px;
  font-weight: 500;
  transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
}
.hero-meta span:hover {
  background: rgba(167,139,250,0.18);
  border-color: rgba(167,139,250,0.4);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
}
.hero-meta span i {
  font-size: 15px;
  color: #c4b5fd;
}

/* ── Amenity Items ── */
.amenity-item {
  backdrop-filter: blur(8px);
  transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
  position: relative;
  overflow: hidden;
}
.amenity-item:hover {
  background: rgba(167,139,250,0.1);
  border-color: rgba(167,139,250,0.35);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(167,139,250,0.12);
}

/* ── Room Cards ── */
.room-card {
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(8px);
}
.room-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(167,139,250,0.4), transparent);
  opacity: 0;
  transition: opacity 0.4s;
}
.room-card:hover::before { opacity: 1; }

/* ── Book Button ── */
.book-btn {
  width: 100%;
  background: linear-gradient(135deg, #6c3ce0, #8b5cf6);
  border: none;
  border-radius: 14px;
  color: white;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
  position: relative;
  overflow: hidden;
  letter-spacing: 0.4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: 'DM Sans', sans-serif;
}
.book-btn::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  transition: left 0.5s;
}
.book-btn:hover {
  background: linear-gradient(135deg, #8b5cf6, #a78bfa);
  box-shadow: 0 8px 32px rgba(139,92,246,0.4);
  transform: translateY(-2px);
}
.book-btn:hover::after { left: 120%; }

/* ── Generate / Action Buttons ── */
.generate-itinerary {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #6c3ce0, #8b5cf6, #a78bfa) !important;
  border-radius: 14px !important;
  letter-spacing: 0.3px;
  font-size: 13px;
  font-family: 'DM Sans', sans-serif;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.generate-itinerary::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
  transition: left 0.6s;
}
.generate-itinerary:hover::after { left: 140%; }

/* ── Nearby Cards ── */
.nearby-card {
  backdrop-filter: blur(8px);
  position: relative;
  overflow: hidden;
}
.nearby-card::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, #a78bfa, #38bdf8);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
  transform-origin: left;
}
.nearby-card:hover::after { transform: scaleX(1); }

/* ── Reviews ── */
.reviews-summary {
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(12px);
}
.reviews-summary::before {
  content: '';
  position: absolute;
  top: -80px; right: -80px;
  width: 200px; height: 200px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251,191,36,0.08) 0%, transparent 70%);
  pointer-events: none;
}
.review-avatar {
  background: linear-gradient(135deg, #a78bfa, #8b5cf6) !important;
  box-shadow: 0 0 16px rgba(167,139,250,0.25);
}
.review-item {
  transition: background 0.3s;
  border-radius: 12px;
  padding: 16px !important;
}
.review-item:hover {
  background: rgba(167,139,250,0.04);
}

/* ── Empty State ── */
.empty-state .icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  background: linear-gradient(135deg, rgba(167,139,250,0.08), rgba(56,189,248,0.06));
  border: 1px solid rgba(167,139,250,0.15);
  font-size: 28px !important;
  opacity: 0.8 !important;
}

/* ── Map Sidebar ── */
.map-sidebar-card {
  backdrop-filter: blur(12px);
  position: relative;
}
.map-sidebar-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 5%, rgba(167,139,250,0.4) 50%, transparent 95%);
  z-index: 1;
}

/* ── Weather Card ── */
.wx-card {
  backdrop-filter: blur(16px);
  animation: fadeSlideUp 0.6s cubic-bezier(0.22,1,0.36,1) 0.2s both;
}

/* ── Info Items in About ── */
.info-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 0;
}
.info-row i {
  font-size: 16px;
  background: linear-gradient(135deg, #c4b5fd, #7dd3fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  width: 20px;
  text-align: center;
  flex-shrink: 0;
}

/* ── Select Dropdowns ── */
select#itinerary-days, select#nearby-category {
  backdrop-filter: blur(8px);
  transition: all 0.3s !important;
  font-family: 'DM Sans', sans-serif;
}
select#itinerary-days:hover, select#nearby-category:hover {
  border-color: rgba(167,139,250,0.45);
  box-shadow: 0 0 18px rgba(167,139,250,0.1);
}

/* ── Sidebar Entrance ── */
.details-sidebar {
  animation: fadeSlideUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.25s both;
}

/* ── Gallery Hover Glow ── */
.gallery-card:hover {
  box-shadow: 0 20px 40px rgba(167,139,250,0.35) !important;
}

/* ── Toast Enhancement ── */
#toast {
  backdrop-filter: blur(14px) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
}

/* ── Drawer Enhancement ── */
.booking-drawer {
  backdrop-filter: blur(20px);
}

/* ── Room Stat Icons ── */
.room-stat-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(167,139,250,0.12), rgba(56,189,248,0.08));
  display: flex !important;
  align-items: center;
  justify-content: center;
  margin: 0 auto 6px;
  font-size: 18px;
}
.room-stat-icon i {
  font-size: 17px;
  background: linear-gradient(135deg, #c4b5fd, #7dd3fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
</style>
{% endblock %}

{% block body %}

{# ── Hero ── #}
<div class="hero-section">
  {% if accommodation.imagePath %}
    <img class="hero-image" src="/{{ accommodation.imagePath }}" alt="{{ accommodation.name }}">
  {% else %}
    <div class="hero-image" style="display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a2035,#243b55);font-size:64px;"><i class="ri-building-4-line" style="background:linear-gradient(135deg,#c4b5fd,#7dd3fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;"></i></div>
  {% endif %}
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>{{ accommodation.name }}</h1>
    <div class="hero-meta">
      <span><i class="ri-map-pin-2-fill"></i> {{ accommodation.city }}{% if accommodation.country %}, {{ accommodation.country }}{% endif %}</span>
      <span><i class="ri-star-fill" style="color:#fbbf24;"></i> {{ accommodation.stars }} stars</span>
      {% if accommodation.rating %}<span><i class="ri-trophy-fill" style="color:#fbbf24;"></i> {{ accommodation.rating }}/5 guest rating</span>{% endif %}
    </div>
  </div>
</div>

<div class="details-grid">
  <div class="details-main">

    {# About #}
    <div class="section-card">
      <div class="section-header"><h2><span class="icon-badge"><i class="ri-file-list-3-line"></i></span> About This Property</h2></div>
      <div class="section-content">
        <p style="line-height:1.6;margin-bottom:20px;color:#cbd5e1;">{{ accommodation.description ?: 'No description available.' }}</p>
        {% if accommodation.accommodationAmenities %}
          <h3 style="font-size:14px;margin-bottom:12px;color:#e2e8f0;">Amenities</h3>
          <div class="amenities-grid">
            {% for amenity in accommodation.accommodationAmenities|split(',') %}
              <div class="amenity-item"><span>{{ amenity|trim }}</span></div>
            {% endfor %}
          </div>
        {% endif %}
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-top:20px;color:#94a3b8;">
          {% if accommodation.phone %}<div class="info-row"><i class="ri-phone-line"></i> {{ accommodation.phone }}</div>{% endif %}
          {% if accommodation.email %}<div class="info-row"><i class="ri-mail-line"></i> {{ accommodation.email }}</div>{% endif %}
          <div class="info-row"><i class="ri-building-4-line"></i> {{ accommodation.type ?: 'Not specified' }}</div>
          <div class="info-row"><i class="ri-star-fill"></i> {{ accommodation.stars }}/5 stars</div>
          {% if accommodation.rating %}<div class="info-row"><i class="ri-trophy-line"></i> {{ accommodation.rating }}/5 guest rating</div>{% endif %}
        </div>
      </div>
    </div>

    {# Rooms #}
    <div class="section-card">
      <div class="section-header"><h2><span class="icon-badge"><i class="ri-hotel-bed-line"></i></span> Available Rooms</h2></div>
      <div class="section-content">
        <div class="rooms-grid" id="rooms-container">
          <div class="skeleton" style="height:100px;"></div>
        </div>
      </div>
    </div>

    {# Nearby - LAZY LOAD with "See Nearby Places" button #}
    <div class="section-card">
      <div class="section-header">
        <h2><span class="icon-badge"><i class="ri-compass-3-line"></i></span> What's Nearby</h2>
        <div style="display: flex; gap: 8px;">
          <select id="nearby-category" style="padding: 8px 12px; border-radius: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(167,139,250,0.2); color: #e2e8f0;">
            <option value="restaurants">Restaurants</option>
            <option value="attractions">Attractions</option>
            <option value="shopping">Shopping</option>
            <option value="transport">Transport</option>
          </select>
          <button id="load-nearby-btn" class="generate-itinerary" onclick="loadNearby()">
            <i class="ri-map-pin-line"></i> Discover Places
          </button>
        </div>
      </div>
      <div class="section-content">
        <div id="nearby-container">
          <div class="empty-state">
            <div class="icon"><i class="ri-map-pin-line" style="font-size:28px;color:#a78bfa;"></i></div>
            <p>Select a category and click "See Nearby Places" to discover attractions</p>
          </div>
        </div>
      </div>
    </div>

    {# Gallery - LAZY LOAD with "See Gallery" button #}
    <div class="section-card">
      <div class="section-header">
        <h2><span class="icon-badge"><i class="ri-camera-lens-line"></i></span> {{ accommodation.city }} Gallery</h2>
        <button id="load-gallery-btn" class="generate-itinerary" onclick="loadGallery()">
          <i class="ri-gallery-line"></i> View Gallery
        </button>
      </div>
      <div class="section-content">
        <div id="gallery-container">
          <div class="empty-state">
            <div class="icon"><i class="ri-camera-lens-line" style="font-size:28px;color:#a78bfa;"></i></div>
            <p>Click "See Gallery" to view beautiful photos of {{ accommodation.city }}</p>
          </div>
        </div>
      </div>
    </div>

    {# Reviews - LAZY LOAD with "See Reviews" button #}
    <div class="section-card">
      <div class="section-header">
        <h2><span class="icon-badge"><i class="ri-chat-smile-2-line"></i></span> Guest Reviews</h2>
        <button id="load-reviews-btn" class="generate-itinerary" onclick="loadReviews()">
          <i class="ri-chat-quote-line"></i> Read Reviews
        </button>
      </div>
      <div class="section-content">
        <div id="reviews-container">
          <div class="empty-state">
            <div class="icon"><i class="ri-star-smile-line" style="font-size:28px;color:#fbbf24;"></i></div>
            <p>Click "See Reviews" to read what guests are saying</p>
          </div>
        </div>
      </div>
    </div>

    {# Itinerary #}
    <div class="section-card">
      <div class="section-header">
        <h2><span class="icon-badge"><i class="ri-sparkling-2-fill"></i></span> AI-Powered Itinerary</h2>
        <div>
          <select id="itinerary-days">
            <option value="3">3 Days</option>
            <option value="5">5 Days</option>
            <option value="7">7 Days</option>
          </select>
          <button id="generate-itinerary-btn" class="generate-itinerary" onclick="generateItinerary()"><i class="ri-sparkling-line"></i> Generate</button>
        </div>
      </div>
      <div class="section-content">
        <div id="itinerary-container" class="itinerary-content">
          <p style="color:#64748b;text-align:center;">Click "Generate" to create your personalized itinerary</p>
        </div>
      </div>
    </div>

  </div>

  {# ── Sidebar: Weather + Map only ── #}
  <div class="details-sidebar">

    {# Weather - AUTO LOAD (fast, single API) #}
    <div id="weather-container">
      <div class="skeleton" style="height:180px;border-radius:15px;"></div>
    </div>

    {# Mini Map #}
    <div class="map-sidebar-card">
      <div class="map-sidebar-header">
        <h2><span class="icon-badge"><i class="ri-map-pin-2-fill"></i></span> Location</h2>
      </div>
      <div id="mini-map" class="mini-map"></div>
    </div>

  </div>
</div>

{# Booking Drawer #}
<div class="drawer-backdrop" id="drawer-backdrop"></div>
<canvas id="confetti-canvas"></canvas>

<div class="booking-drawer" id="booking-drawer">
  <button class="drawer-close" id="drawer-close-btn" onclick="closeDrawer()">✕</button>

  <div class="drawer-progress">
    <div class="progress-step active" id="prog-0">
      <div class="progress-dot active" id="dot-0">1</div>
      <div class="progress-label">Room</div>
    </div>
    <div class="progress-line"><div class="progress-line-fill" id="line-0"></div></div>
    <div class="progress-step" id="prog-1">
      <div class="progress-dot" id="dot-1">2</div>
      <div class="progress-label">Your Stay</div>
    </div>
    <div class="progress-line"><div class="progress-line-fill" id="line-1"></div></div>
    <div class="progress-step" id="prog-2">
      <div class="progress-dot" id="dot-2">3</div>
      <div class="progress-label">Payment</div>
    </div>
    <div class="progress-line"><div class="progress-line-fill" id="line-2"></div></div>
    <div class="progress-step" id="prog-3">
      <div class="progress-dot" id="dot-3">✓</div>
      <div class="progress-label">Confirmed</div>
    </div>
  </div>

  <div class="drawer-steps">

    {# Step 0: Room Preview #}
    <div class="drawer-step active" id="step-0">
      <div class="room-carousel">
        <div class="carousel-slides" id="carousel-slides">
          <div class="carousel-slide-placeholder"><i class="ri-building-4-line" style="background:linear-gradient(135deg,#c4b5fd,#7dd3fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;"></i></div>
        </div>
        <button class="carousel-btn prev" onclick="carouselPrev()">‹</button>
        <button class="carousel-btn next" onclick="carouselNext()">›</button>
        <div class="carousel-dots" id="carousel-dots"></div>
      </div>
      <div class="room-preview-header">
        <div class="room-preview-name" id="preview-name">Room Name</div>
        <div class="room-preview-badge" id="preview-type">Standard</div>
      </div>
      <div class="room-stats">
        <div class="room-stat">
          <div class="room-stat-icon"><i class="ri-team-line"></i></div>
          <div class="room-stat-value" id="preview-capacity">—</div>
          <div class="room-stat-label">Guests</div>
        </div>
        <div class="room-stat">
          <div class="room-stat-icon"><i class="ri-ruler-line"></i></div>
          <div class="room-stat-value" id="preview-size">—</div>
          <div class="room-stat-label">m² Size</div>
        </div>
        <div class="room-stat">
          <div class="room-stat-icon"><i class="ri-hotel-bed-line"></i></div>
          <div class="room-stat-value" id="preview-beds">1</div>
          <div class="room-stat-label">Bed(s)</div>
        </div>
      </div>
      <div class="preview-price-tag">
        <div class="preview-price-amount" id="preview-price">€—</div>
        <div class="preview-price-per">per night</div>
      </div>
      <div style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;">Included Amenities</div>
      <div class="drawer-amenities" id="preview-amenities"></div>
    </div>

    {# Step 1: Stay Details #}
    <div class="drawer-step" id="step-1">
      <button class="drawer-back" onclick="goToStep(0)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to room
      </button>
      <div class="stay-section-title">Check-in &amp; Check-out</div>
      <div class="date-range-grid">
        <div class="date-field">
          <label>Check-in</label>
          <input type="date" id="d-checkin" class="drawer-input" onchange="recalcPrice()">
        </div>
        <div class="date-field">
          <label>Check-out</label>
          <input type="date" id="d-checkout" class="drawer-input" onchange="recalcPrice()">
        </div>
      </div>
      <div class="nights-pill" id="nights-pill">Select dates to see duration</div>
      <div class="stay-section-title">Guests</div>
      <div class="guest-stepper">
        <div class="stepper-label">
          <span>Number of Guests</span>
          <span id="guest-capacity-hint">Max — guests</span>
        </div>
        <div class="stepper-controls">
          <button class="stepper-btn" id="guest-minus" onclick="adjustGuests(-1)">−</button>
          <span class="stepper-count" id="guest-count-display">1</span>
          <button class="stepper-btn" id="guest-plus" onclick="adjustGuests(1)">+</button>
        </div>
      </div>
      <div class="stay-section-title">Estimated Arrival Time</div>
      <select id="d-arrival" class="drawer-input" style="margin-bottom:12px;">
        <option value="">I'll let you know later</option>
        <option value="10:00">10:00 AM</option>
        <option value="12:00">12:00 PM</option>
        <option value="14:00">2:00 PM</option>
        <option value="15:00">3:00 PM</option>
        <option value="16:00">4:00 PM</option>
        <option value="18:00">6:00 PM</option>
        <option value="20:00">8:00 PM</option>
        <option value="22:00">10:00 PM</option>
        <option value="00:00">After midnight</option>
      </select>
      <div class="stay-section-title">Phone Number</div>
      <input type="tel" id="d-phone" class="drawer-input" placeholder="+1 234 567 8900" maxlength="16" oninput="sanitizePhone(this)" style="margin-bottom:12px;">
      <div class="stay-section-title">Special Requests <span style="color:#475569;font-weight:400;text-transform:none;">(optional)</span></div>
      <textarea id="d-requests" class="drawer-input" rows="3" placeholder="Early check-in, high floor, quiet room..." style="resize:none;line-height:1.5;"></textarea>
      <div class="price-breakdown" id="price-breakdown">
        <div class="price-row">
          <span id="price-row-label">€— × — nights</span>
          <span id="price-row-sub">€—</span>
        </div>
        <div class="price-row">
          <span>Taxes &amp; fees (10%)</span>
          <span id="price-row-tax">€—</span>
        </div>
        <div class="price-row total">
          <span>Total</span>
          <span id="price-row-total">€—</span>
        </div>
      </div>
    </div>

    {# Step 2: Payment #}
    <div class="drawer-step" id="step-2">
      <button class="drawer-back" onclick="goToStep(1)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to stay details
      </button>
      <div class="booking-recap">
        <div>
          <div class="recap-label">Room</div>
          <div class="recap-value" id="recap-room">—</div>
        </div>
        <div style="text-align:center;">
          <div class="recap-label">Nights</div>
          <div class="recap-value" id="recap-nights">—</div>
        </div>
        <div style="text-align:right;">
          <div class="recap-label">Total</div>
          <div class="recap-price" id="recap-total">€—</div>
        </div>
      </div>
      <div class="wallet-section-label">Choose your card</div>
      <div class="pay-wallet-outer">
        <div class="pay-wallet" id="pay-wallet">
          <div class="pay-wallet-back"></div>
          <div class="pay-card pay-visa" id="pw-visa" onclick="selectPayCard('visa')">
            <div class="pay-card-inner">
              <div class="pay-card-top"><span>Visa</span><div class="pay-chip"></div></div>
              <div class="pay-card-bottom">
                <div><span class="pay-card-label">Holder</span><span class="pay-card-value" id="pw-visa-name">YOUR NAME</span></div>
                <div class="pay-card-num-wrap"><span class="pay-card-stars">**** 4242</span></div>
              </div>
            </div>
          </div>
          <div class="pay-card pay-mc" id="pw-mc" onclick="selectPayCard('mc')">
            <div class="pay-card-inner">
              <div class="pay-card-top"><span>Mastercard</span><div class="pay-chip"></div></div>
              <div class="pay-card-bottom">
                <div><span class="pay-card-label">Holder</span><span class="pay-card-value" id="pw-mc-name">YOUR NAME</span></div>
                <div class="pay-card-num-wrap"><span class="pay-card-stars">**** 5500</span></div>
              </div>
            </div>
          </div>
          <div class="pay-card pay-amex" id="pw-amex" onclick="selectPayCard('amex')">
            <div class="pay-card-inner">
              <div class="pay-card-top"><span>Amex</span><div class="pay-chip"></div></div>
              <div class="pay-card-bottom">
                <div><span class="pay-card-label">Holder</span><span class="pay-card-value" id="pw-amex-name">YOUR NAME</span></div>
                <div class="pay-card-num-wrap"><span class="pay-card-stars">**** 3714</span></div>
              </div>
            </div>
          </div>
          <div class="pay-pocket">
            <svg viewBox="0 0 380 155" fill="none" style="width:100%;height:100%;">
              <path d="M 0 20 C 0 10, 5 10, 10 10 C 20 10, 25 25, 40 25 L 340 25 C 355 25, 360 10, 370 10 C 375 10, 380 10, 380 20 L 380 115 C 380 150, 360 155, 340 155 L 40 155 C 20 155, 0 150, 0 115 Z" fill="#1e2a1e"></path>
