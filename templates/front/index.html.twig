        </div>
      </div>
    </a>

    <!-- Offer 3 -->
    <a href="{{ path('user_packs_offers') }}" style="text-decoration:none; display:block; position:relative; border-radius:1.5rem; padding:2px; background:linear-gradient(135deg, #10b981, #3b82f6); transition:all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);" onmouseover="this.style.transform='scale(1.04) translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(16,185,129,0.3), 0 0 0 2px rgba(16,185,129,0.5)';" onmouseout="this.style.transform='scale(1) translateY(0)'; this.style.boxShadow='none';">
