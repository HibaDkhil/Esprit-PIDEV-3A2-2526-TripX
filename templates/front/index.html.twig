    <p style="color:rgba(255,255,255,0.7); font-size:0.9rem;">Turn the wheel for a chance to win an exclusive free trip! It's hard to win, but if you do, it's on us!</p>
    <div id="wheel-canvas-container">
      <div class="wheel-pointer"></div>
      <div class="glitter-layer"></div>
      <canvas id="wheel-canvas" width="320" height="320"></canvas>
    </div>
    <button id="spin-btn" class="btn-primary ripple-btn" style="width:100%; padding:12px; font-size:1.1rem;" onclick="spinWheel()">Spin the Wheel!</button>
    
    <div id="wheel-result" style="display:none; margin-top:20px;">
      <h4 id="wheel-result-msg" style="font-size:1.4rem; margin-bottom:15px;"></h4>
      <a id="wheel-book-btn" href="#" class="btn-primary" style="display:none; width:100%; text-align:center; padding:12px; background:linear-gradient(135deg, #10b981, #3b82f6); border:none;">Book for FREE</a>
    </div>
  </div>
</div>
<script>
  let isSpinning = false;
  let hasSpun = false;
  const segments = [
    { text: 'Try Again', color: '#1e293b' },
    { text: 'Try Again', color: '#334155' },
    { text: 'Try Again', color: '#1e293b' },
    { text: 'Exclusive Trip!', color: '#ec4899', offerId: {{ packs|length > 0 ? packs[0].idPack : 1 }} },
    { text: 'Try Again', color: '#334155' },
    { text: 'Try Again', color: '#1e293b' },
    { text: 'Try Again', color: '#334155' },
    { text: 'Try Again', color: '#1e293b' }
  ];

  const winSound = new Audio('https://assets.mixkit.co/active_storage/sfx/2013/2013-preview.mp3');
  const failSound = new Audio('https://assets.mixkit.co/active_storage/sfx/255/255-preview.mp3');
  const spinSound = new Audio('https://assets.mixkit.co/active_storage/sfx/707/707-preview.mp3');

  function drawWheel() {
    const canvas = document.getElementById('wheel-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const radius = canvas.width / 2;
    const arc = Math.PI / (segments.length / 2);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    for (let i = 0; i < segments.length; i++) {
      const angle = i * arc;
      
      // Gradient for each slice
      const grad = ctx.createRadialGradient(radius, radius, 10, radius, radius, radius);
      grad.addColorStop(0, segments[i].color);
      grad.addColorStop(1, i % 2 === 0 ? '#0f172a' : '#1e293b');
      
      ctx.beginPath();
      ctx.fillStyle = grad;
      ctx.strokeStyle = 'rgba(255,255,255,0.1)';
      ctx.lineWidth = 2;
      ctx.moveTo(radius, radius);
      ctx.arc(radius, radius, radius, angle, angle + arc, false);
      ctx.lineTo(radius, radius);
      ctx.fill();
      ctx.stroke();
      
      ctx.save();
      ctx.fillStyle = '#fff';
      ctx.shadowColor = 'rgba(0,0,0,0.5)';
      ctx.shadowBlur = 4;
      ctx.translate(radius + Math.cos(angle + arc / 2) * radius * 0.7, radius + Math.sin(angle + arc / 2) * radius * 0.7);
      ctx.rotate(angle + arc / 2 + Math.PI / 2);
      ctx.font = 'bold 14px var(--font-mono, sans-serif)';
      ctx.textAlign = 'center';
      ctx.fillText(segments[i].text, 0, 0);
      ctx.restore();
    }
    
    // Center circle
    ctx.beginPath();
    ctx.fillStyle = '#f59e0b';
    ctx.arc(radius, radius, 15, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 4;
    ctx.stroke();
  }

  function openWheelModal() {
    document.getElementById('wheel-modal').style.display = 'flex';
    drawWheel();
  }
  function closeWheelModal() {
    if (isSpinning) return;
    document.getElementById('wheel-modal').style.display = 'none';
  }

  function spinWheel() {
    if (isSpinning || hasSpun) return;
    isSpinning = true;
    hasSpun = true;
    
    spinSound.play().catch(() => {});
    
    const canvas = document.getElementById('wheel-canvas');
    const btn = document.getElementById('spin-btn');
    btn.disabled = true;
    btn.innerText = 'Good Luck...';
    
    let winChance = Math.random();
    let targetIndex = 0;
    if (winChance > 0.9) {
      targetIndex = 3;
    } else {
      const loseIndices = [0, 1, 2, 4, 5, 6, 7];
      targetIndex = loseIndices[Math.floor(Math.random() * loseIndices.length)];
    }
    
    const arc = 360 / segments.length;
    const spinDegrees = 360 * 8 - (targetIndex * arc) - (arc / 2) - 90;
    
    canvas.style.transform = `rotate(${spinDegrees}deg)`;
    
    setTimeout(() => {
      isSpinning = false;
      btn.style.display = 'none';
      const resultDiv = document.getElementById('wheel-result');
      const resultMsg = document.getElementById('wheel-result-msg');
      const bookBtn = document.getElementById('wheel-book-btn');
      
      resultDiv.style.display = 'block';
      
      if (targetIndex === 3) {
        winSound.play().catch(() => {});
        resultMsg.innerText = '🎉 UNBELIEVABLE! YOU WON! 🎉';
        resultMsg.style.color = '#10b981';
        resultMsg.style.textShadow = '0 0 10px rgba(16,185,129,0.5)';
        bookBtn.style.display = 'block';
        bookBtn.href = '/packs/' + segments[3].offerId;
      } else {
        failSound.play().catch(() => {});
        resultMsg.innerText = 'Better luck next time, explorer!';
        resultMsg.style.color = '#94a3b8';
      }
    }, 5000);
  }
</script>

