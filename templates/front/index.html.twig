{% extends 'base.html.twig' %}

{% block title %}TripX — Discover the Future of Travel{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/experience-lab.css') }}">
  <style>
    :root {
      --nav-height: 80px;
    }
    #particle-canvas {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #020816;
    }
    .hero-bg-img {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      opacity: 0;
      transition: opacity 1.5s ease;
      z-index: 1;
      pointer-events: none;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(2,8,22,0.4) 0%, rgba(2,8,22,0.85) 100%);
      z-index: 3;
    }
    .hero-content {
      position: relative;
      z-index: 5;
      max-width: var(--container-max);
      margin-inline: auto;
      padding: 40px 32px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 40px;
    }
    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(40px, 8vw, 110px);
      line-height: 0.95;
      font-weight: 800;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: -0.02em;
    }
    .hero-headline span {
      display: inline-block;
      animation: fade-in-up 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .search-bar-container {
      width: 100%;
      max-width: 900px;
      animation: fade-in-up 1s ease 0.5s both;
    }
  </style>
  <link rel="stylesheet" href="/assets.php?f=css/price-predictor.css">
  <style>
    .home-footer-premium {
      position: relative;
      margin-top: 0;
      padding: 64px 0 36px;
      background: linear-gradient(165deg, rgba(2, 8, 22, 0.92) 0%, rgba(15, 23, 42, 0.98) 45%, #020617 100%);
      border-top: 1px solid rgba(14, 165, 255, 0.18);
      overflow: hidden;
    }
    .home-footer-premium::before {
      content: '';
      position: absolute;
      top: 0;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0, 166, 237, 0.55), rgba(255, 77, 109, 0.35), transparent);
    }
    .home-footer-inner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 36px 48px;
      align-items: flex-start;
      padding-bottom: 40px;
    }
    .home-footer-col h4 {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-primary);
      margin: 0 0 12px;
    }
    .home-footer-col p,
    .home-footer-col a {
      font-size: 0.88rem;
      line-height: 1.55;
      color: rgba(148, 163, 184, 0.95);
    }
    .home-footer-col a {
      color: #e2e8f0;
      text-decoration: none;
      display: inline-block;
      margin-top: 4px;
    }
    .home-footer-col a:hover {
      color: var(--accent-primary);
    }
    .home-footer-logo {
      font-family: var(--font-display);
      font-size: 1.75rem;
      letter-spacing: 0.02em;
      color: #f0f4f8;
    }
    .home-footer-logo span {
      color: var(--accent-primary);
    }
    .home-footer-tagline {
      margin: 10px 0 0;
      max-width: 320px;
      font-size: 0.9rem;
      line-height: 1.55;
      color: rgba(148, 163, 184, 0.95);
    }
    .home-footer-contact {
      padding: 20px 24px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(148, 163, 184, 0.15);
      backdrop-filter: blur(10px);
    }
    .home-footer-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent-primary);
      margin-bottom: 8px;
    }
    .home-footer-email {
      font-size: 1rem;
      font-weight: 600;
      color: #e2e8f0;
      text-decoration: none;
      background: linear-gradient(135deg, #38bdf8, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .home-footer-email:hover {
      opacity: 0.9;
    }
    .home-footer-bottom {
      padding-top: 28px;
      border-top: 1px solid rgba(148, 163, 184, 0.12);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: rgba(100, 116, 139, 0.9);
    }
    .home-footer-dots {
      display: flex;
      gap: 6px;
    }
    .home-footer-dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent-primary);
      opacity: 0.5;
      animation: home-footer-pulse 2.4s ease-in-out infinite;
    }
    .home-footer-dots span:nth-child(2) { animation-delay: 0.3s; background: var(--accent-teal); }
    .home-footer-dots span:nth-child(3) { animation-delay: 0.6s; background: var(--accent-gold); }
    @keyframes home-footer-pulse {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.15); }
    }
  
  </style>

  <script src="{{ asset('js/aria-dashboard.js') }}"></script>
  
  <style>
    /* Aria Homepage Specific Force-Fix */
    body #aria-orb {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      position: fixed !important;
      bottom: 30px !important;
      right: 30px !important;
      z-index: 2147483647 !important;
      filter: none !important;
      background: linear-gradient(135deg, #00e5ff 0%, #0072ff 50%, #7928ca 100%) !important;
    }
    body #aria-panel {
      z-index: 2147483646 !important;
    }
  </style>
{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero">
  <canvas id="particle-canvas"></canvas>
  <div class="hero-bg-img" style="background-image: url('/images/view1.jpg'); opacity: 1;"></div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="reveal">
      <h1 class="hero-headline">Discover the<br><span class="gradient-text">Future of Travel</span></h1>
      <p class="hero-subtitle" style="color: rgba(255,255,255,0.7); font-size: 1.2rem; margin-top: 20px;">AI-Powered curated experiences for the modern explorer.</p>
    </div>

    <div class="search-bar-container">
      <form action="{{ path('search') }}" method="GET" class="search-bar">
        <input type="text" name="q" id="search-destination" class="search-input" style="flex:2;" placeholder="Where to next? (e.g. Mars, Bali, Paris)">
        <div class="search-divider"></div>
        <div class="search-field">
          <span class="search-field-label">Start</span>
          <input type="date" name="start" class="search-field-val" style="background:transparent; border:none; color:inherit; font-size:0.9rem; outline:none; max-width:110px;">
        </div>
        <div class="search-divider"></div>
        <div class="search-field">
          <span class="search-field-label">End</span>
          <input type="date" name="end" class="search-field-val" style="background:transparent; border:none; color:inherit; font-size:0.9rem; outline:none; max-width:110px;">
        </div>
        <div class="search-divider"></div>
        <div class="search-field">
          <span class="search-field-label">Guests</span>
          <select name="guests" class="search-field-val" style="background:transparent; border:none; color:inherit; font-size:0.9rem; outline:none;">
            <option value="1">1 Adult</option>
            <option value="2" selected>2 Adults</option>
            <option value="3">3 Adults</option>
            <option value="4+">4+ Adults</option>
          </select>
        </div>
        <button type="submit" class="btn-primary ripple-btn" style="padding: 12px 28px; border-radius: 12px; margin-left: 8px;">Explore</button>
      </form>
    </div>
  </div>
</section>

<!-- ARIA Picked For You Section -->
{% if ariaDestination %}
<section class="section container" style="margin-top: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
    <div>
      <div class="section-label"><span>✨ ARIA Picked For You</span></div>
      <h2 class="section-title">Your Perfect Journey</h2>
    </div>
    <a href="{{ path('destination_recommendations') }}" class="btn-primary ripple-btn" style="padding: 8px 16px; font-size: 0.85rem; border-radius: 8px; text-decoration: none;">See All Recommendations</a>
  </div>
  <div class="grid-3 stagger">
    {# Destination #}
    <div class="card interactive">
      <a href="{{ path('destinations', {'q': ariaDestination.name}) }}" style="text-decoration:none; color:inherit;">
        <img src="{{ ariaDestination.imageUrl|default('/images/view1.jpg') }}" style="width:100%; height:200px; object-fit:cover; border-radius:var(--border-radius-sm) var(--border-radius-sm) 0 0;" alt="{{ ariaDestination.name }}">
        <div class="card-body">
          <div class="badge badge-primary" style="margin-bottom:8px;">Perfect Destination</div>
          <h3 style="font-family: var(--font-display); font-size:1.2rem;">{{ ariaDestination.name }}</h3>
          <p class="text-muted" style="font-size:0.9rem;">{{ ariaDestination.country }}</p>
        </div>
      </a>
    </div>
    {# Accommodation #}
    {% if ariaAccommodation %}
    <div class="card interactive">
      <a href="{{ path('accommodation_details', {id: ariaAccommodation.id}) }}" style="text-decoration:none; color:inherit;">
        <img src="{{ ariaAccommodation.imagePath ? asset(ariaAccommodation.imagePath) : '/images/view1.jpg' }}" style="width:100%; height:200px; object-fit:cover; border-radius:var(--border-radius-sm) var(--border-radius-sm) 0 0;" alt="{{ ariaAccommodation.name }}">
        <div class="card-body">
          <div class="badge badge-primary" style="margin-bottom:8px; background:var(--accent-teal);">Perfect Stay</div>
          <h3 style="font-family: var(--font-display); font-size:1.2rem;">{{ ariaAccommodation.name }}</h3>
          <p class="text-muted" style="font-size:0.9rem;">{{ ariaAccommodation.city }}</p>
        </div>
      </a>
    </div>
    {% endif %}
    {# Activity #}
    {% if ariaActivity %}
    <div class="card interactive">
      <a href="{{ path('activities', {'q': ariaActivity.name}) }}" style="text-decoration:none; color:inherit;">
        <img src="/images/view1.jpg" style="width:100%; height:200px; object-fit:cover; border-radius:var(--border-radius-sm) var(--border-radius-sm) 0 0;" alt="{{ ariaActivity.name }}">
        <div class="card-body">
          <div class="badge badge-primary" style="margin-bottom:8px; background:var(--accent-gold);">Perfect Activity</div>
          <h3 style="font-family: var(--font-display); font-size:1.2rem;">{{ ariaActivity.name }}</h3>
          <p class="text-muted" style="font-size:0.9rem;">{{ ariaActivity.category }}</p>
        </div>
      </a>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<!-- Virtual Experiences Section -->
<section class="section container" style="margin-top: 40px; margin-bottom: 40px;">
  <div class="section-label reveal"><span>Immersive Journeys</span></div>
  <h2 class="section-title reveal" style="font-family: var(--font-display); background: linear-gradient(135deg, #f59e0b, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Cultural & Architectural Wonders</h2>
  <p class="text-muted reveal" style="max-width: 800px; margin-bottom: 40px; font-size: 1.1rem; line-height: 1.6;">
    Dive into breathtaking virtual simulations of world heritage, iconic history, and modern culture. Explore stunning architectural designs, vibrant colors, and deeply curated museum details right from your browser.
  </p>
  
  <div class="grid-3 stagger">
    {# Card 1: Greece #}
    <div class="card interactive" style="background: linear-gradient(to bottom, #eff6ff, #dbeafe); border-color: #bfdbfe; overflow: hidden; padding: 0;">
      <div style="height: 160px; background: url('https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&q=80') center/cover;"></div>
      <div style="padding: 24px;">
        <h3 style="font-family: var(--font-display); color: #1e3a8a; font-size: 1.3rem; margin-bottom: 10px;">Greece & Pristine Beaches</h3>
        <p style="color: #3b82f6; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">
          Wander through dazzling white architecture against the backdrop of the cerulean Aegean Sea. Experience the warm sunlight and architectural marvels of the Greek coastline in full 3D simulation.
        </p>
        <button onclick="openVirtualExp('https://metasteps.com/viewer/6e411e77-9c32-41ad-992e-02801265280a')" class="btn-primary ripple-btn" style="width: 100%; text-align: center; border-radius: 8px;">Explore Greece</button>
      </div>
    </div>

    {# Card 2: Pop Stars #}
    <div class="card interactive" style="background: linear-gradient(to bottom, #fdf4ff, #fae8ff); border-color: #f5d0fe; overflow: hidden; padding: 0;">
      <div style="height: 160px; background: url('https://images.unsplash.com/photo-1493225457224-eda8e63a13ee?auto=format&fit=crop&q=80') center/cover;"></div>
      <div style="padding: 24px;">
        <h3 style="font-family: var(--font-display); color: #701a75; font-size: 1.3rem; margin-bottom: 10px;">Pop Culture Museum</h3>
        <p style="color: #d946ef; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">
          Step into a vibrant, neon-lit museum celebrating the history and impact of global pop stars. Immerse yourself in the dynamic colors, fashion, and legendary performances that shaped modern music.
        </p>
        <button onclick="openVirtualExp('https://web.atopia.space/?experienceId=68d3f6511229772ae57d195c')" class="btn-primary ripple-btn" style="width: 100%; text-align: center; border-radius: 8px; background: linear-gradient(135deg, #d946ef, #8b5cf6); border:none;">Enter Museum</button>
      </div>
    </div>

    {# Card 3: Ancient Egypt #}
    <div class="card interactive" style="background: linear-gradient(to bottom, #fffbeb, #fef3c7); border-color: #fde68a; overflow: hidden; padding: 0;">
      <div style="height: 160px; background: url('https://images.unsplash.com/photo-1539650116574-8efeb43e2b08?auto=format&fit=crop&q=80') center/cover;"></div>
      <div style="padding: 24px;">
        <h3 style="font-family: var(--font-display); color: #78350f; font-size: 1.3rem; margin-bottom: 10px;">Ancient Egypt History</h3>
        <p style="color: #d97706; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">
          Walk through the monumental temples and golden tombs of the Pharaohs. Witness the grandeur of ancient Egyptian architecture, hieroglyphics, and timeless artifacts up close.
        </p>
        <button onclick="openVirtualExp('https://web.atopia.space/?experienceId=67b62ad171c3d4984f7462d9')" class="btn-primary ripple-btn" style="width: 100%; text-align: center; border-radius: 8px; background: linear-gradient(135deg, #d97706, #b45309); border:none;">Unearth History</button>
      </div>
    </div>
  </div>
</section>

<!-- Virtual Experience Overlay -->
<div id="virtual-exp-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; z-index:999999; background:#000;">
  <button onclick="closeVirtualExp()" style="position:absolute; top:20px; left:20px; z-index:1000; background:rgba(0,0,0,0.7); color:white; border:2px solid rgba(255,255,255,0.3); border-radius:12px; padding:10px 20px; font-weight:bold; cursor:pointer; font-family:var(--font-display); backdrop-filter:blur(10px); transition:all 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'; this.style.borderColor='white';" onmouseout="this.style.background='rgba(0,0,0,0.7)'; this.style.borderColor='rgba(255,255,255,0.3)';">
    ← Back to TripX
  </button>
  <iframe id="virtual-exp-iframe" src="" style="width:100%; height:100%; border:none;" allow="xr-spatial-tracking; autoplay; camera; microphone; vr; fullscreen"></iframe>
</div>

<script>
  function openVirtualExp(url) {
    document.getElementById('virtual-exp-iframe').src = url;
    document.getElementById('virtual-exp-overlay').style.display = 'block';
    document.body.style.overflow = 'hidden';
  }
  function closeVirtualExp() {
    document.getElementById('virtual-exp-iframe').src = '';
    document.getElementById('virtual-exp-overlay').style.display = 'none';
    document.body.style.overflow = 'auto';
  }
</script>

<!-- Trending Section -->
<section class="section container">
  <div class="section-label"><span>Trending Destinations</span></div>
  <h2 class="section-title">Popular This Week</h2>
  <div class="trending-scroll stagger">
    {% for dest in ['Bali', 'Paris', 'Tokyo', 'Switzerland', 'New York'] %}
    <div class="trending-item ripple-btn">
      <img src="/images/destinations/{{ dest }}.jfif" class="trending-bg" alt="{{ dest }}">
      <div class="trending-overlay"></div>
      <div class="trending-info">
        <div class="trending-name">{{ dest }}</div>
        <div class="ai-badge">98% Match</div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- Futuristic Offers Section -->
