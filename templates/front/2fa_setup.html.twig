{% extends 'base.html.twig' %}

{% block title %}Secure Your Account — TripX 2FA{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Montserrat:wght@400;600;700;800&display=swap');

  .tfa-page {
    min-height: 100vh;
    background: #060c18;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    position: relative;
    overflow: hidden;
  }

  /* Ambient orbs */
  .tfa-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: orbFloat 8s ease-in-out infinite;
    pointer-events: none;
  }
  .tfa-orb--1 { width: 400px; height: 400px; background: rgba(0,166,237,0.12); top: -80px; right: -80px; animation-delay: 0s; }
  .tfa-orb--2 { width: 300px; height: 300px; background: rgba(114,9,183,0.1); bottom: -60px; left: -40px; animation-delay: 3s; }
  .tfa-orb--3 { width: 200px; height: 200px; background: rgba(0,200,150,0.08); top: 50%; left: 50%; animation-delay: 6s; }
  @keyframes orbFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.05); }
  }

  .tfa-card {
    position: relative;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 28px;
    padding: 48px 44px;
    max-width: 560px;
    width: 100%;
    backdrop-filter: blur(24px);
    box-shadow: 0 32px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.06);
    animation: cardIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(40px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .tfa-header {
    text-align: center;
    margin-bottom: 36px;
  }
  .tfa-shield {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #00a6ed, #7209b7);
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center;
    font-size: 32px;
    margin: 0 auto 20px;
    box-shadow: 0 0 40px rgba(0,166,237,0.3);
    animation: shieldPulse 3s ease-in-out infinite;
  }
  @keyframes shieldPulse {
    0%, 100% { box-shadow: 0 0 30px rgba(0,166,237,0.3); }
    50% { box-shadow: 0 0 60px rgba(0,166,237,0.5); }
  }
  .tfa-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 26px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
  }
  .tfa-subtitle {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
  }

  /* Steps indicator */
  .tfa-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 36px;
  }
  .tfa-step {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.4);
    font-family: 'Space Mono', monospace;
    transition: all 0.3s;
  }
  .tfa-step.active {
    background: linear-gradient(135deg, #00a6ed, #7209b7);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 0 20px rgba(0,166,237,0.4);
  }
  .tfa-step.done {
    background: #00c896;
    border-color: transparent;
    color: #fff;
  }
  .tfa-step-line {
    width: 48px; height: 1px;
    background: rgba(255,255,255,0.08);
  }

  /* QR section */
  .tfa-qr-wrap {
    background: rgba(255,255,255,0.96);
    border-radius: 20px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 28px;
    width: fit-content;
    box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 0 0 6px rgba(0,166,237,0.12);
    animation: qrReveal 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.3s both;
  }
  @keyframes qrReveal {
    from { opacity: 0; transform: scale(0.8) rotate(-4deg); }
    to { opacity: 1; transform: scale(1) rotate(0deg); }
  }
  .tfa-qr-wrap img {
    width: 220px;
    height: 220px;
    display: block;
    border-radius: 8px;
  }

  /* Manual code */
  .tfa-manual-label {
    text-align: center;
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }
  .tfa-secret-box {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    cursor: pointer;
    transition: border-color 0.2s;
    position: relative;
  }
  .tfa-secret-box:hover { border-color: rgba(0,166,237,0.4); }
  .tfa-secret-text {
    font-family: 'Space Mono', monospace;
    font-size: 16px;
    color: #00a6ed;
    letter-spacing: 4px;
    word-break: break-all;
    flex: 1;
    font-weight: 700;
  }
  .tfa-copy-btn {
    flex-shrink: 0;
    background: rgba(0,166,237,0.12);
    border: 1px solid rgba(0,166,237,0.2);
    color: #00a6ed;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .tfa-copy-btn:hover { background: rgba(0,166,237,0.25); }
  .tfa-copy-btn.copied { color: #00c896; border-color: rgba(0,200,150,0.3); background: rgba(0,200,150,0.1); }
  .tfa-copied-toast {
    position: absolute;
    top: -36px;
    left: 50%;
    transform: translateX(-50%);
    background: #00c896;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 99px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    white-space: nowrap;
  }
  .tfa-copied-toast.show { opacity: 1; }

  /* Code input */
  .tfa-input-label {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
    display: block;
  }
  .tfa-code-input {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 18px 24px;
    font-family: 'Space Mono', monospace;
    font-size: 28px;
    color: #fff;
    text-align: center;
    letter-spacing: 12px;
    transition: all 0.3s;
    outline: none;
    box-sizing: border-box;
    margin-bottom: 20px;
  }
  .tfa-code-input:focus {
    border-color: rgba(0,166,237,0.5);
    background: rgba(0,166,237,0.06);
    box-shadow: 0 0 0 3px rgba(0,166,237,0.12);
  }
  .tfa-code-input.error {
    border-color: rgba(255,77,109,0.5);
    background: rgba(255,77,109,0.06);
    box-shadow: 0 0 0 3px rgba(255,77,109,0.12);
    animation: shake 0.4s ease;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
  }

  /* Buttons */
  .tfa-btn-row { display: flex; gap: 12px; }
  .tfa-btn-primary {
    flex: 1;
    background: linear-gradient(135deg, #00a6ed, #7209b7);
    border: none;
    border-radius: 14px;
    padding: 16px;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Montserrat', sans-serif;
  }
  .tfa-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,166,237,0.35); }
  .tfa-btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .tfa-btn-cancel {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 16px 24px;
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    font-family: 'Montserrat', sans-serif;
    transition: all 0.2s;
  }
  .tfa-btn-cancel:hover { color: #fff; border-color: rgba(255,255,255,0.2); }

  /* Error message */
  .tfa-error {
    display: none;
    background: rgba(255,77,109,0.1);
    border: 1px solid rgba(255,77,109,0.25);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 13px;
    color: #ff4d6d;
    margin-bottom: 16px;
    text-align: center;
  }
  .tfa-error.show { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  /* Tips */
  .tfa-tips {
    margin-top: 28px;
    padding: 16px 20px;
    background: rgba(0,166,237,0.05);
    border: 1px solid rgba(0,166,237,0.12);
    border-radius: 12px;
  }
  .tfa-tip { display: flex; gap: 10px; font-size: 12px; color: rgba(255,255,255,0.45); margin-bottom: 6px; line-height: 1.5; }
  .tfa-tip:last-child { margin-bottom: 0; }

  /* spinner */
  .tfa-spinner {
    width: 18px; height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    display: none;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Success overlay */
  .tfa-success-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.85);
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
    opacity: 0; visibility: hidden;
    transition: 0.4s;
  }
  .tfa-success-overlay.show { opacity: 1; visibility: visible; }
  .tfa-success-box {
    background: #0b1220;
    border: 1px solid rgba(0,200,150,0.3);
    border-radius: 24px;
    padding: 48px;
    text-align: center;
    transform: scale(0.8);
    transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .tfa-success-overlay.show .tfa-success-box { transform: scale(1); }
  .tfa-success-icon { font-size: 64px; margin-bottom: 16px; display: block; animation: bounceIn 0.6s 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }
  @keyframes bounceIn { from { transform: scale(0); } to { transform: scale(1); } }
  .tfa-success-title { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 24px; color: #fff; margin-bottom: 8px; }
  .tfa-success-sub { font-size: 14px; color: rgba(255,255,255,0.5); }
</style>

<div class="tfa-page">
  <div class="tfa-orb tfa-orb--1"></div>
  <div class="tfa-orb tfa-orb--2"></div>
  <div class="tfa-orb tfa-orb--3"></div>

  <div class="tfa-card">
    <div class="tfa-header">
      <div class="tfa-shield">🛡️</div>
      <div class="tfa-title">Two-Factor Authentication</div>
      <div class="tfa-subtitle">Protect your account with an OTP authenticator app.<br>This adds a critical extra layer of security.</div>
    </div>

    <div class="tfa-steps">
      <div class="tfa-step done" id="step1">1</div>
      <div class="tfa-step-line"></div>
      <div class="tfa-step active" id="step2">2</div>
      <div class="tfa-step-line"></div>
      <div class="tfa-step" id="step3">3</div>
    </div>

    {# Step 1 — QR Code #}
    <div id="panel-qr">
      <p style="text-align:center; font-size:13px; color:rgba(255,255,255,0.5); margin-bottom:20px;">
        Scan this QR code with <strong style="color:#fff">Google Authenticator</strong> or <strong style="color:#fff">Authy</strong>
      </p>

      <div style="text-align:center;">
        <div class="tfa-qr-wrap">
          <img src="{{ qrCode }}" alt="2FA QR Code">
        </div>
      </div>

      <div class="tfa-manual-label">Or enter manually in your app</div>

      <div class="tfa-secret-box" id="secretBox">
        <div class="tfa-secret-text">{{ secret }}</div>
        <button class="tfa-copy-btn" id="copyBtn" type="button">Copy</button>
        <div class="tfa-copied-toast" id="copiedToast">✓ Copied!</div>
      </div>

      <label class="tfa-input-label">Enter the 6-digit code from your app to confirm</label>
      <div class="tfa-error" id="tfa-error">❌ Invalid code. Please wait for a new code and try again.</div>
      <input
        type="text"
        id="tfa_code"
        class="tfa-code-input"
        placeholder="000000"
        maxlength="6"
        inputmode="numeric"
        autocomplete="one-time-code"
        autofocus
      >

      <div class="tfa-btn-row">
        <button id="enable2faBtn" class="tfa-btn-primary">
          <div class="tfa-spinner" id="btn-spinner"></div>
          <span id="btn-text">🔒 Enable 2FA</span>
        </button>
        <a href="{{ path('users') }}" class="tfa-btn-cancel">Cancel</a>
      </div>

      <div class="tfa-tips">
        <div class="tfa-tip"><span>📱</span> Download Google Authenticator or Authy on your phone first.</div>
        <div class="tfa-tip"><span>📸</span> Scan the QR code — a new 6-digit code refreshes every 30 seconds.</div>
        <div class="tfa-tip"><span>💾</span> Save your manual key in a safe place in case you lose your phone.</div>
      </div>
    </div>
  </div>
</div>

{# Success overlay #}
<div class="tfa-success-overlay" id="successOverlay">
  <div class="tfa-success-box">
    <span class="tfa-success-icon">🔐</span>
    <div class="tfa-success-title">2FA Enabled!</div>
    <div class="tfa-success-sub">Your account is now ultra-secure. Redirecting...</div>
  </div>
</div>

<script>
  // Copy secret to clipboard
  document.getElementById('copyBtn').addEventListener('click', function() {
    const secret = '{{ secret }}';
    navigator.clipboard.writeText(secret).then(() => {
      const btn = document.getElementById('copyBtn');
      const toast = document.getElementById('copiedToast');
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      toast.classList.add('show');
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.classList.remove('copied');
        toast.classList.remove('show');
      }, 2000);
    });
  });

  // Auto-format input — only allow digits
  const codeInput = document.getElementById('tfa_code');
  codeInput.addEventListener('input', function () {
    this.value = this.value.replace(/[^0-9]/g, '').substring(0, 6);
    if (this.classList.contains('error')) {
      this.classList.remove('error');
      document.getElementById('tfa-error').classList.remove('show');
    }
  });
  // Submit on 6 digits typed
  codeInput.addEventListener('input', function() {
    if (this.value.length === 6) {
      document.getElementById('enable2faBtn').focus();
    }
  });

  // Enable 2FA
  document.getElementById('enable2faBtn').addEventListener('click', async function () {
    const code = document.getElementById('tfa_code').value.trim();
    if (code.length !== 6) {
      codeInput.classList.add('error');
      document.getElementById('tfa-error').textContent = '❌ Please enter the full 6-digit code.';
      document.getElementById('tfa-error').classList.add('show');
      return;
    }

    const spinner = document.getElementById('btn-spinner');
    const btnText = document.getElementById('btn-text');
    spinner.style.display = 'block';
    btnText.textContent = 'Verifying...';
    this.disabled = true;

    try {
      const response = await fetch('{{ path('profile_2fa_enable') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'code=' + encodeURIComponent(code)
      });

      const data = await response.json();

      if (data.success) {
        document.getElementById('successOverlay').classList.add('show');
        setTimeout(() => { window.location.href = '{{ path('users') }}'; }, 2200);
      } else {
        codeInput.classList.add('error');
        document.getElementById('tfa-error').textContent = '❌ Invalid code. Wait for the code to refresh and try again.';
        document.getElementById('tfa-error').classList.add('show');
        spinner.style.display = 'none';
        btnText.textContent = '🔒 Enable 2FA';
        this.disabled = false;
        codeInput.value = '';
        codeInput.focus();
      }
    } catch (e) {
      spinner.style.display = 'none';
      btnText.textContent = '🔒 Enable 2FA';
      this.disabled = false;
      document.getElementById('tfa-error').textContent = '❌ Network error. Please try again.';
      document.getElementById('tfa-error').classList.add('show');
    }
  });

  // Allow pressing Enter
  codeInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') document.getElementById('enable2faBtn').click();
  });
</script>
{% endblock %}