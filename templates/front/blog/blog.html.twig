const _tsMapStatus = document.getElementById('ts-map-status');
const _tsMapCloseBtn = document.getElementById('ts-map-close');
const _tsDestinationGeocodeUrl = '{{ path('travel_story_destination_geocode') }}';
const _storyFilterPresets = {
  normal: { brightness: 100, contrast: 100, saturation: 100, warmth: 0, fade: 0, sepia: 0, grayscale: 0 },
  vivid: { brightness: 106, contrast: 116, saturation: 135, warmth: 4, fade: 0, sepia: 0, grayscale: 0 },
  golden: { brightness: 104, contrast: 108, saturation: 122, warmth: 16, fade: 8, sepia: 16, grayscale: 0 },
  noir: { brightness: 96, contrast: 138, saturation: 0, warmth: -2, fade: 0, sepia: 0, grayscale: 82 },
  cool: { brightness: 102, contrast: 112, saturation: 112, warmth: -14, fade: 4, sepia: 0, grayscale: 0 },
};

function lerpNumber(a, b, t) {
  return a + (b - a) * t;
}

function getCameraFilterFromPreset(name) {
  const p = _storyFilterPresets[name] || _storyFilterPresets.normal;
  const brightness = p.brightness;
  const contrast = p.contrast;
  const saturation = p.saturation;
  const sepia = p.sepia || 0;
  const grayscale = p.grayscale || 0;
  const warmth = p.warmth || 0;
  const fade = p.fade || 0;

  return {
    css: `brightness(${brightness / 100}) contrast(${contrast / 100}) saturate(${Math.max(0, saturation) / 100}) sepia(${sepia}%) grayscale(${grayscale}%) hue-rotate(${warmth * 1.2}deg)`,
    fade: Math.max(0, Math.min(55, fade)) / 100,
  };
}

function setStoryCameraMessage(msg = '', isError = false) {
  const box = document.getElementById('story-camera-msg');
  if (!box) return;
  if (!msg) {
    box.textContent = '';
    box.classList.remove('visible');
    return;
  }
  box.textContent = msg;
  box.style.background = isError ? 'rgba(153, 27, 27, .72)' : 'rgba(0,0,0,.58)';
  box.classList.add('visible');
}

function setActiveCameraFilterChip() {
  document.querySelectorAll('#story-camera-filters .story-camera-fchip').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.camFilter === _storyCameraActiveFilter);
  });
}

function applyCameraPreviewFilter() {
  const video = document.getElementById('story-camera-video');
  if (!video) return;
  video.style.filter = getCameraFilterFromPreset(_storyCameraActiveFilter).css;
  video.style.transform = `scaleX(-1) scale(${_storyCameraZoom})`;
}

function cycleStoryCameraFilter(direction = 1) {
  const order = ['normal', 'vivid', 'golden', 'noir', 'cool'];
  const idx = Math.max(0, order.indexOf(_storyCameraActiveFilter));
  const next = (idx + (direction >= 0 ? 1 : -1) + order.length) % order.length;
  _storyCameraActiveFilter = order[next];
  setActiveCameraFilterChip();
  applyCameraPreviewFilter();
}

function getGestureProfile() {
  return _storyGestureProfiles[_storyGestureSensitivity] || _storyGestureProfiles.medium;
}

function setActiveGestureSensitivityButtons() {
  document.querySelectorAll('#story-camera-gesture-tune .story-camera-tune-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.gestureSense === _storyGestureSensitivity);
  });
}

function loadGestureSensitivity() {
  try {
    const saved = window.localStorage.getItem(_storyGestureSensitivityStorageKey);
    if (saved && _storyGestureProfiles[saved]) {
      _storyGestureSensitivity = saved;
    }
  } catch (_) {}

  setActiveGestureSensitivityButtons();
}

function setGestureSensitivity(level) {
  if (!_storyGestureProfiles[level]) return;
  _storyGestureSensitivity = level;
  setActiveGestureSensitivityButtons();
  try {
    window.localStorage.setItem(_storyGestureSensitivityStorageKey, level);
  } catch (_) {}
}

function showStoryGestureGuideIfNeeded() {
  const el = document.getElementById('story-camera-gesture-guide');
  if (!el) return;
  let seen = false;
  try {
    seen = window.localStorage.getItem(_storyGestureGuideStorageKey) === '1';
  } catch (_) {}
  el.classList.toggle('open', !seen);
}

function hideStoryGestureGuide(saveSeen = true) {
  const el = document.getElementById('story-camera-gesture-guide');
  if (el) el.classList.remove('open');
  if (!saveSeen) return;
  try {
    window.localStorage.setItem(_storyGestureGuideStorageKey, '1');
  } catch (_) {}
}

function applyUpwardFilterClear() {
  _storyCameraActiveFilter = 'normal';
  setActiveCameraFilterChip();
  setStoryCameraMessage('Filter removed');
  setTimeout(() => {
    if (document.getElementById('story-camera-modal')?.classList.contains('open')) {
      setStoryCameraMessage('');
    }
  }, 800);
}

function beginStoryGestureCalibration() {
  _storyCalibrationActive = true;
  _storyCalibrationReady = false;
  _storyCalibrationStableMs = 0;
  _storyCalibrationLastTs = 0;
  _storyCalibrationCenter = null;
  _storyCalibrationSize = 0;
  _storyGestureHint = 'Hold your hand still to calibrate';
}

function drawStoryGestureAssist(landmarks = null, center = null, handSize = 0, hint = '', pointer = null, pointerOverCapture = false, captureTarget = null) {
  const canvas = document.getElementById('story-camera-gesture-canvas');
  if (!canvas) return;

  const rect = canvas.getBoundingClientRect();
  const width = Math.max(1, Math.floor(rect.width));
  const height = Math.max(1, Math.floor(rect.height));
  if (canvas.width !== width || canvas.height !== height) {
    canvas.width = width;
    canvas.height = height;
  }

  const ctx = canvas.getContext('2d');
  if (!ctx) return;
  ctx.clearRect(0, 0, width, height);

  const guideX = width * 0.2;
  const guideY = height * 0.18;
  const guideW = width * 0.6;
  const guideH = height * 0.64;

  ctx.save();
  ctx.strokeStyle = 'rgba(255,255,255,.7)';
  ctx.lineWidth = 2;
  ctx.setLineDash([8, 6]);
  ctx.strokeRect(guideX, guideY, guideW, guideH);
  ctx.setLineDash([]);

  ctx.fillStyle = 'rgba(255,255,255,.16)';
  ctx.fillRect(guideX, guideY + guideH * 0.45, guideW, 1);
  ctx.fillRect(guideX + guideW * 0.5, guideY, 1, guideH);

  ctx.fillStyle = 'rgba(255,255,255,.8)';
  ctx.font = '600 12px Montserrat, sans-serif';
  ctx.fillText('LEFT = NEXT', guideX + 10, guideY + guideH - 14);
  ctx.fillText('RIGHT = PREV', guideX + guideW - 110, guideY + guideH - 14);
  ctx.fillText('UP = REMOVE', guideX + guideW * 0.5 - 38, guideY + 16);

  if (landmarks && landmarks.length) {
    const connections = [
      [0,1],[1,2],[2,3],[3,4],
      [0,5],[5,6],[6,7],[7,8],
      [5,9],[9,10],[10,11],[11,12],
      [9,13],[13,14],[14,15],[15,16],
      [13,17],[17,18],[18,19],[19,20],
      [0,17]
    ];

    ctx.strokeStyle = 'rgba(56, 189, 248, .95)';
    ctx.lineWidth = 2;
    connections.forEach(([a, b]) => {
      const p1 = landmarks[a];
      const p2 = landmarks[b];
      if (!p1 || !p2) return;
      const x1 = (1 - p1.x) * width;
      const y1 = p1.y * height;
      const x2 = (1 - p2.x) * width;
      const y2 = p2.y * height;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    });

    landmarks.forEach((p, i) => {
      const x = (1 - p.x) * width;
      const y = p.y * height;
      ctx.beginPath();
      ctx.fillStyle = i === 4 || i === 8 ? 'rgba(251, 113, 133, .98)' : 'rgba(255,255,255,.95)';
      ctx.arc(x, y, i === 4 || i === 8 ? 4 : 3, 0, Math.PI * 2);
      ctx.fill();
    });
  }

  if (pointer) {
    ctx.beginPath();
    ctx.strokeStyle = pointerOverCapture ? 'rgba(34,197,94,.95)' : 'rgba(56,189,248,.95)';
    ctx.fillStyle = pointerOverCapture ? 'rgba(34,197,94,.24)' : 'rgba(56,189,248,.2)';
    ctx.lineWidth = 2;
    ctx.arc(pointer.x, pointer.y, pointerOverCapture ? 14 : 11, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255,255,255,.95)';
    ctx.lineWidth = 1.5;
    ctx.moveTo(pointer.x - 8, pointer.y);
    ctx.lineTo(pointer.x + 8, pointer.y);
    ctx.moveTo(pointer.x, pointer.y - 8);
    ctx.lineTo(pointer.x, pointer.y + 8);
    ctx.stroke();
  }

  if (captureTarget) {
    ctx.beginPath();
    ctx.lineWidth = 2;
    ctx.strokeStyle = pointerOverCapture ? 'rgba(34,197,94,.96)' : 'rgba(255,255,255,.72)';
    ctx.fillStyle = pointerOverCapture ? 'rgba(34,197,94,.18)' : 'rgba(255,255,255,.08)';
    ctx.arc(captureTarget.x, captureTarget.y, captureTarget.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255,255,255,.8)';
    ctx.arc(captureTarget.x, captureTarget.y, Math.max(8, captureTarget.radius - 12), 0, Math.PI * 2);
    ctx.stroke();
  }

  const centerOk = !!center && center.x >= 0.2 && center.x <= 0.8 && center.y >= 0.18 && center.y <= 0.82;
  const scaleLabel = handSize < 0.09 ? 'Move closer' : handSize > 0.36 ? 'Move farther' : 'Scale OK';
  const scaleColor = handSize < 0.09 || handSize > 0.36 ? 'rgba(251, 146, 60, .95)' : 'rgba(74, 222, 128, .95)';

  ctx.fillStyle = 'rgba(2,6,23,.62)';
  ctx.fillRect(10, height - 62, width - 20, 50);
  ctx.fillStyle = centerOk ? 'rgba(74, 222, 128, .95)' : 'rgba(251, 146, 60, .95)';
  ctx.font = '700 12px Montserrat, sans-serif';
  ctx.fillText(centerOk ? 'Position OK' : 'Center your hand in the frame', 20, height - 40);
  ctx.fillStyle = scaleColor;
  ctx.fillText(scaleLabel, 20, height - 23);
  ctx.fillStyle = 'rgba(226,232,240,.96)';
  ctx.fillText(hint || _storyGestureHint || 'Ready', 150, height - 23);

  if (_storyCalibrationActive || !_storyCalibrationReady) {
    const p = Math.max(0, Math.min(1, _storyCalibrationStableMs / _storyCalibrationTargetMs));
    const barW = width * 0.56;
    const barH = 8;
    const barX = (width - barW) / 2;
    const barY = guideY + guideH + 12;
    ctx.fillStyle = 'rgba(15,23,42,.66)';
    ctx.fillRect(barX, barY, barW, barH);
    ctx.fillStyle = 'rgba(56,189,248,.95)';
    ctx.fillRect(barX, barY, barW * p, barH);
    ctx.strokeStyle = 'rgba(255,255,255,.5)';
    ctx.lineWidth = 1;
    ctx.strokeRect(barX, barY, barW, barH);
    ctx.fillStyle = 'rgba(255,255,255,.9)';
    ctx.font = '700 11px Montserrat, sans-serif';
    ctx.fillText('Calibrating hand stability...', barX + 4, barY - 6);
  }
  ctx.restore();
}

function getStoryPointerFromHand(navHand) {
  const canvas = document.getElementById('story-camera-gesture-canvas');
  if (!canvas || !navHand || !navHand[8]) return null;
  const rect = canvas.getBoundingClientRect();
  const width = Math.max(1, Math.floor(rect.width));
  const height = Math.max(1, Math.floor(rect.height));
  return {
    x: (1 - navHand[8].x) * width,
    y: navHand[8].y * height,
  };
}

function getStoryCaptureTargetOnCanvas() {
  const captureBtn = document.getElementById('story-camera-capture');
  const canvas = document.getElementById('story-camera-gesture-canvas');
  if (!captureBtn || !canvas) return null;

  const btnRect = captureBtn.getBoundingClientRect();
  const canvasRect = canvas.getBoundingClientRect();
  const width = Math.max(1, Math.floor(canvasRect.width));
  const height = Math.max(1, Math.floor(canvasRect.height));

  // The physical shutter is in the footer (outside canvas). Clamp target into
  // the visible gesture canvas near the bottom so pointer mode is reachable.
  const rawX = btnRect.left + (btnRect.width / 2) - canvasRect.left;
  const rawY = btnRect.top + (btnRect.height / 2) - canvasRect.top;

  const x = Math.max(32, Math.min(width - 32, rawX));
  const y = Math.max(40, Math.min(height - 24, rawY));
  const radius = 44;

  return { x, y, radius };
}

function isStoryPointerOverCapture(pointer, captureTarget = null) {
  const captureBtn = document.getElementById('story-camera-capture');
  const canvas = document.getElementById('story-camera-gesture-canvas');
  if (!captureBtn || !canvas || !pointer) return false;

  const target = captureTarget || getStoryCaptureTargetOnCanvas();
  if (!target) return false;
  const dist = Math.hypot(pointer.x - target.x, pointer.y - target.y);
  return dist <= target.radius;
}

async function ensureStoryHandTrackingReady() {
  if (_storyHandLandmarker || _storyHandModelLoading) return !!_storyHandLandmarker;
  _storyHandModelLoading = true;
  setStoryCameraMessage('Loading hand gestures model...');

  try {
    const tasksVision = await import('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/+esm');
    const { FilesetResolver, HandLandmarker } = tasksVision;

    _storyMpVision = await FilesetResolver.forVisionTasks(
      'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm'
    );

    _storyHandLandmarker = await HandLandmarker.createFromOptions(_storyMpVision, {
      baseOptions: {
        modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',
      },
      runningMode: 'VIDEO',
      numHands: 2,
      minHandDetectionConfidence: 0.6,
      minHandPresenceConfidence: 0.5,
      minTrackingConfidence: 0.5,
    });

    setStoryCameraMessage('');
    return true;
  } catch (err) {
    console.error(err);
    setStoryCameraMessage('Could not load hand model. Camera still works without gestures.', true);
    return false;
  } finally {
    _storyHandModelLoading = false;
  }
}

function stopStoryGestureLoop() {
  if (_storyGestureLoopId !== null) {
    cancelAnimationFrame(_storyGestureLoopId);
    _storyGestureLoopId = null;
  }
  _storyCameraLastCenter = null;
  _storyCameraLastCenterTs = 0;
  _storyCameraLastPinch = null;
  _storyCameraPinchActive = false;
  _storyCameraPinchStartDistance = null;
  _storyCameraPinchStartZoom = 1;
  _storyGestureLockUntil = 0;
  _storyPointerClickPinched = false;
  _storyPointerClickCooldownUntil = 0;
  _storyPointerOverSince = 0;
  _storyPointerPressActive = false;
  _storyLastVideoTime = -1;
  _storyCameraSmoothedCenter = null;
  _storyCameraSmoothedPinch = null;
  _storyGestureAccumX = 0;
  _storyGestureAccumY = 0;
  _storyGestureAccumTs = 0;
  _storyGestureHint = 'Place your hand inside the frame';
  _storyCalibrationActive = false;
  _storyCalibrationReady = false;
  _storyCalibrationStableMs = 0;
  _storyCalibrationLastTs = 0;
  _storyCalibrationCenter = null;
  _storyCalibrationSize = 0;
  drawStoryGestureAssist(null, null, 0, _storyGestureHint);
  applyCameraPreviewFilter();
}

function processStoryHandGestures(landmarks, now) {
  const profile = getGestureProfile();
  if (!Array.isArray(landmarks) || !landmarks.length) return;

  const sorted = [...landmarks].sort((a, b) => {
    const as = Math.hypot(a[0].x - a[9].x, a[0].y - a[9].y);
    const bs = Math.hypot(b[0].x - b[9].x, b[0].y - b[9].y);
    return bs - as;
  });

  const navHand = sorted[0];
  if (!navHand || !navHand.length) return;
  const pinchHand = sorted[1] && sorted[1].length ? sorted[1] : navHand;

  const centerXRaw = (navHand[0].x + navHand[9].x + navHand[12].x) / 3;
  const centerYRaw = (navHand[0].y + navHand[9].y + navHand[12].y) / 3;
  if (!_storyCameraSmoothedCenter) {
    _storyCameraSmoothedCenter = { x: centerXRaw, y: centerYRaw };
  } else {
    _storyCameraSmoothedCenter.x = lerpNumber(_storyCameraSmoothedCenter.x, centerXRaw, 0.33);
    _storyCameraSmoothedCenter.y = lerpNumber(_storyCameraSmoothedCenter.y, centerYRaw, 0.33);
  }

  const centerX = _storyCameraSmoothedCenter.x;
  const centerY = _storyCameraSmoothedCenter.y;
  const center = { x: centerX, y: centerY };

  let dx = 0;
  let dy = 0;
  let dt = 0;
  if (_storyCameraLastCenter && _storyCameraLastCenterTs) {
    dt = Math.max(1, now - _storyCameraLastCenterTs);
    dx = center.x - _storyCameraLastCenter.x;
    dy = center.y - _storyCameraLastCenter.y;
  }

  const handSize = Math.max(0.08, Math.hypot(pinchHand[0].x - pinchHand[9].x, pinchHand[0].y - pinchHand[9].y));
  const pointer = getStoryPointerFromHand(navHand);
  const captureTarget = getStoryCaptureTargetOnCanvas();
  const pointerOverCapture = isStoryPointerOverCapture(pointer, captureTarget);
  const insideGuide = centerX >= 0.2 && centerX <= 0.8 && centerY >= 0.18 && centerY <= 0.82;
  const goodScale = handSize >= 0.09 && handSize <= 0.36;

  if (!insideGuide || !goodScale) {
    _storyCameraLastCenter = center;
    _storyCameraLastCenterTs = now;
    _storyCameraPinchActive = false;
    _storyCameraLastPinch = null;
    _storyCameraPinchStartDistance = null;
    _storyCameraPinchStartZoom = _storyCameraZoom;
    _storyPointerClickPinched = false;
    _storyGestureAccumX = 0;
    _storyGestureAccumY = 0;
    _storyGestureAccumTs = now;
    _storyCalibrationStableMs = 0;
    _storyCalibrationLastTs = now;
    _storyCalibrationCenter = center;
    _storyCalibrationSize = handSize;
    _storyGestureHint = !insideGuide ? 'Move hand inside the guide frame' : (handSize < 0.09 ? 'Move your hand closer' : 'Move your hand farther');
    drawStoryGestureAssist(navHand, center, handSize, _storyGestureHint, pointer, pointerOverCapture, captureTarget);
    applyCameraPreviewFilter();
    return;
  }

  if (!_storyCalibrationReady) {
    if (!_storyCalibrationActive) {
      beginStoryGestureCalibration();
    }

    const frameDt = _storyCalibrationLastTs ? Math.max(0, now - _storyCalibrationLastTs) : 0;
    _storyCalibrationLastTs = now;

    if (!_storyCalibrationCenter) {
      _storyCalibrationCenter = center;
      _storyCalibrationSize = handSize;
      _storyCalibrationStableMs = 0;
    }

    const motionFromAnchor = Math.hypot(center.x - _storyCalibrationCenter.x, center.y - _storyCalibrationCenter.y);
    const sizeShift = Math.abs(handSize - _storyCalibrationSize);
    const stablePose = motionFromAnchor < 0.03 && sizeShift < 0.03;

    if (stablePose) {
      _storyCalibrationStableMs = Math.min(_storyCalibrationTargetMs, _storyCalibrationStableMs + frameDt);
      _storyGestureHint = `Hold steady: ${Math.ceil((_storyCalibrationTargetMs - _storyCalibrationStableMs) / 1000)}s`;
    } else {
      _storyCalibrationStableMs = Math.max(0, _storyCalibrationStableMs - frameDt * 0.7);
      _storyCalibrationCenter = center;
      _storyCalibrationSize = handSize;
      _storyGestureHint = 'Keep hand still for calibration';
    }

    if (_storyCalibrationStableMs >= _storyCalibrationTargetMs) {
      _storyCalibrationReady = true;
      _storyCalibrationActive = false;
      _storyGestureHint = 'Calibration complete';
      _storyGestureLockUntil = now + 260;
      setStoryCameraMessage('Calibration complete');
      setTimeout(() => {
        if (document.getElementById('story-camera-modal')?.classList.contains('open')) {
          setStoryCameraMessage('');
        }
      }, 700);
    }

    _storyCameraLastCenter = center;
    _storyCameraLastCenterTs = now;
    drawStoryGestureAssist(navHand, center, handSize, _storyGestureHint, pointer, pointerOverCapture, captureTarget);
    applyCameraPreviewFilter();
    return;
  }

  const navHandSize = Math.max(0.08, Math.hypot(navHand[0].x - navHand[9].x, navHand[0].y - navHand[9].y));
  const navClickPinch = Math.hypot(navHand[4].x - navHand[8].x, navHand[4].y - navHand[8].y) / navHandSize;
  const pointerPinchStart = Math.min(profile.pinchStart + 0.04, 0.34);
  const pointerPinchRelease = Math.max(profile.pinchRelease + 0.03, 0.44);
  const canPointerClick = pointerOverCapture && now > _storyPointerClickCooldownUntil && !_storyCameraCaptureBusy;
  const pointerDwellMs = 420;

  if (pointerOverCapture) {
    if (!_storyPointerOverSince) _storyPointerOverSince = now;
  } else {
    _storyPointerOverSince = 0;
    _storyPointerPressActive = false;
  }

  if (canPointerClick && !_storyPointerClickPinched && navClickPinch <= pointerPinchStart) {
    _storyPointerClickPinched = true;
    _storyPointerPressActive = true;
    _storyGestureHint = 'Press detected';
    _storyPointerClickCooldownUntil = now + 900;
    captureStoryFromCamera();
  } else if (_storyPointerClickPinched && navClickPinch >= pointerPinchRelease) {
    _storyPointerClickPinched = false;
    _storyPointerPressActive = false;
  } else if (!pointerOverCapture && navClickPinch >= pointerPinchRelease) {
    _storyPointerClickPinched = false;
    _storyPointerPressActive = false;
  } else if (canPointerClick && !_storyPointerClickPinched && _storyPointerOverSince && (now - _storyPointerOverSince) >= pointerDwellMs) {
    _storyPointerPressActive = true;
    _storyGestureHint = 'Pointer click';
    _storyPointerClickCooldownUntil = now + 900;
    _storyPointerOverSince = now;
    captureStoryFromCamera();
  } else if (pointerOverCapture && !_storyPointerClickPinched && now > _storyPointerClickCooldownUntil) {
    _storyGestureHint = 'Press with pinch or hold pointer to click';
  }

  const pinchDistanceRaw = Math.hypot(pinchHand[4].x - pinchHand[8].x, pinchHand[4].y - pinchHand[8].y) / handSize;
  if (_storyCameraSmoothedPinch === null) {
    _storyCameraSmoothedPinch = pinchDistanceRaw;
  } else {
    _storyCameraSmoothedPinch = lerpNumber(_storyCameraSmoothedPinch, pinchDistanceRaw, 0.38);
  }
  const pinchDistance = _storyCameraSmoothedPinch;

  const lateralSpeed = dt > 0 ? Math.abs(dx) / dt : 0;
  const verticalSpeed = dt > 0 ? Math.abs(dy) / dt : 0;
  const motionCalm = lateralSpeed < 0.00042 && verticalSpeed < 0.00042;

  const pinchStartGate = Math.min(profile.pinchRelease - 0.02, profile.pinchStart + 0.08);
  const pinchReleaseGate = Math.max(profile.pinchRelease + 0.06, profile.pinchStart + 0.1);
  const pointerClickMode = pointerOverCapture || _storyPointerClickPinched;

  if (!pointerClickMode && !_storyCameraPinchActive && pinchDistance <= pinchStartGate && motionCalm && now > _storyGestureLockUntil) {
    _storyCameraPinchActive = true;
    _storyCameraLastPinch = pinchDistance;
    _storyCameraPinchStartDistance = Math.max(0.001, pinchDistance);
    _storyCameraPinchStartZoom = _storyCameraZoom;
    _storyGestureLockUntil = now + 180;
  } else if (_storyCameraPinchActive && pinchDistance >= pinchReleaseGate) {
    _storyCameraPinchActive = false;
    _storyCameraLastPinch = null;
    _storyCameraPinchStartDistance = null;
    _storyCameraPinchStartZoom = _storyCameraZoom;
    _storyGestureLockUntil = now + 180;
  }

  if (!pointerClickMode && _storyCameraPinchActive && _storyCameraPinchStartDistance !== null) {
    const ratio = pinchDistance / Math.max(0.001, _storyCameraPinchStartDistance);
    const targetZoom = Math.max(0.8, Math.min(2.8, _storyCameraPinchStartZoom * ratio));
    _storyCameraZoom = lerpNumber(_storyCameraZoom, targetZoom, 0.42);
    if (ratio > 1.01) {
      _storyGestureHint = 'Pinch out: zoom in';
    } else if (ratio < 0.99) {
      _storyGestureHint = 'Pinch in: zoom out';
    }
    _storyCameraLastPinch = pinchDistance;
  }

  if (_storyCameraLastCenter && _storyCameraLastCenterTs) {
    const canNavigate = !_storyCameraPinchActive && now > _storyGestureLockUntil;

    if (!_storyGestureAccumTs || now - _storyGestureAccumTs > 420) {
      _storyGestureAccumX = 0;
      _storyGestureAccumY = 0;
      _storyGestureAccumTs = now;
    }

    _storyGestureAccumX += dx;
    _storyGestureAccumY += dy;

    if (canNavigate && Math.abs(_storyGestureAccumX) > profile.swipeDistance && Math.abs(_storyGestureAccumY) < profile.swipeMaxDy && dt < profile.swipeWindowMs && now > _storyCameraSwipeCooldownUntil) {
      cycleStoryCameraFilter(_storyGestureAccumX < 0 ? 1 : -1);
      _storyCameraSwipeCooldownUntil = now + profile.swipeCooldownMs;
      _storyGestureLockUntil = now + 240;
      _storyGestureAccumX = 0;
      _storyGestureAccumY = 0;
      _storyGestureAccumTs = now;
      _storyGestureHint = 'Swipe detected';
    }

    if (canNavigate && _storyGestureAccumY < -profile.upDistance && Math.abs(_storyGestureAccumX) < profile.upMaxDx && Math.abs(_storyGestureAccumY) > Math.abs(_storyGestureAccumX) * 1.8 && dt < profile.upWindowMs && now > _storyCameraUpCooldownUntil) {
      applyUpwardFilterClear();
      _storyCameraUpCooldownUntil = now + profile.upCooldownMs;
      _storyGestureLockUntil = now + 260;
      _storyGestureAccumX = 0;
      _storyGestureAccumY = 0;
      _storyGestureAccumTs = now;
      _storyGestureHint = 'Up gesture detected';
    }
  }

  _storyCameraLastCenter = center;
  _storyCameraLastCenterTs = now;
  if (!_storyCameraPinchActive && _storyGestureHint === 'Place your hand inside the frame') {
    _storyGestureHint = 'Ready for swipe, up, or pinch';
  }
  drawStoryGestureAssist(navHand, center, handSize, _storyGestureHint, pointer, pointerOverCapture, captureTarget);
  applyCameraPreviewFilter();
}

function startStoryGestureLoop() {
  if (_storyGestureLoopId !== null) return;

  const video = document.getElementById('story-camera-video');
  if (!video || !_storyHandLandmarker) return;

  const loop = () => {
    const modalOpen = document.getElementById('story-camera-modal')?.classList.contains('open');
    if (!modalOpen || !_storyHandLandmarker) {
      stopStoryGestureLoop();
      return;
    }

    const ready = video.readyState >= 2;
    if (ready && video.currentTime !== _storyLastVideoTime) {
      _storyLastVideoTime = video.currentTime;
      const now = performance.now();
      const result = _storyHandLandmarker.detectForVideo(video, now);

      if (result && result.landmarks && result.landmarks.length) {
        processStoryHandGestures(result.landmarks, now);
      } else {
        _storyCameraLastCenter = null;
        _storyCameraLastCenterTs = 0;
        _storyCameraLastPinch = null;
        _storyCameraPinchActive = false;
        _storyCameraPinchStartDistance = null;
        _storyCameraPinchStartZoom = _storyCameraZoom;
        _storyPointerClickPinched = false;
        _storyGestureLockUntil = 0;
        _storyPointerOverSince = 0;
        _storyPointerPressActive = false;
        _storyCameraSmoothedCenter = null;
        _storyCameraSmoothedPinch = null;
        _storyGestureAccumX = 0;
        _storyGestureAccumY = 0;
        _storyGestureAccumTs = 0;
        _storyPointerClickCooldownUntil = 0;
        if (!_storyCalibrationReady) {
          _storyCalibrationActive = true;
          _storyCalibrationStableMs = 0;
          _storyCalibrationLastTs = 0;
          _storyCalibrationCenter = null;
          _storyCalibrationSize = 0;
        }
        _storyGestureHint = 'Show your hand inside the frame';
        drawStoryGestureAssist(null, null, 0, _storyGestureHint);
        applyCameraPreviewFilter();
      }
    }

    _storyGestureLoopId = requestAnimationFrame(loop);
  };

  _storyGestureLoopId = requestAnimationFrame(loop);
}

async function stopStoryCameraStream() {
  if (!_storyCameraStream) return;
  _storyCameraStream.getTracks().forEach(track => track.stop());
  _storyCameraStream = null;
}

async function startStoryCameraStream() {
  const video = document.getElementById('story-camera-video');
  if (!video) return false;

  setStoryCameraMessage('Opening camera...');
  await stopStoryCameraStream();

  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: { ideal: _storyCameraFacingMode },
        width: { ideal: 1080 },
        height: { ideal: 1920 },
      },
      audio: false,
    });

    _storyCameraStream = stream;
    video.srcObject = stream;
    _storyCameraZoom = 1;
    _storyCameraLastCenter = null;
    _storyCameraLastCenterTs = 0;
    _storyCameraLastPinch = null;
    _storyCameraPinchActive = false;
    _storyCameraPinchStartDistance = null;
    _storyCameraPinchStartZoom = 1;
    _storyPointerClickPinched = false;
    _storyPointerClickCooldownUntil = 0;
    _storyPointerOverSince = 0;
    _storyPointerPressActive = false;
    _storyGestureLockUntil = 0;
    _storyCameraSmoothedCenter = null;
    _storyCameraSmoothedPinch = null;
    _storyGestureAccumX = 0;
    _storyGestureAccumY = 0;
    _storyGestureAccumTs = 0;
    beginStoryGestureCalibration();
    _storyLastVideoTime = -1;
    setStoryCameraMessage('');
    drawStoryGestureAssist(null, null, 0, _storyGestureHint);
    applyCameraPreviewFilter();

    const modelOk = await ensureStoryHandTrackingReady();
    if (modelOk) {
      startStoryGestureLoop();
    }
    return true;
  } catch (err) {
    console.error(err);
    setStoryCameraMessage('Camera access denied or unavailable. Check browser permissions.', true);
    return false;
  }
}

