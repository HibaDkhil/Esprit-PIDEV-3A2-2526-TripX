{% extends 'base.html.twig' %}

{% block title %}Travelgram — TripX Community{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Montserrat:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/blog.css') }}">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">
  <style>
    .ts-destination { color: #6b7280; font-size: .9rem; margin: 4px 0 10px; }
    .ts-country-tag {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      border-radius: 999px;
      font-size: .82rem;
      font-weight: 600;
      background: #e0ecff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
      cursor: pointer;
    }
    .ts-destination-text {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .ts-destination-flag {
      width: 18px;
      height: 12px;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid rgba(0,0,0,.15);
      box-shadow: 0 1px 2px rgba(0,0,0,.08);
      flex: 0 0 auto;
    }
    .ts-meta { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
    .ts-tag {
      display: inline-block; padding: 3px 10px; border-radius: 20px;
      font-size: .78rem; font-weight: 600;
      background: #f3f4f6; color: #374151;
    }
    .ts-rating {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .ts-rating-stars {
      letter-spacing: .05em;
      color: #f59e0b;
      line-height: 1;
    }
    .ts-rating-value {
      color: #4b5563;
      font-weight: 700;
      font-size: .72rem;
    }
    .b-travel_story { background: linear-gradient(135deg,#2563eb,#38bdf8); color:#fff; }
    .ts-card { border-left: 3px solid #3b82f6; }
    #feed-container.loading { opacity: .45; pointer-events: none; transition: opacity .15s; }
    .feed-spinner { display: none; text-align: center; padding: 40px 0; font-size: 1.1rem; color: #9ca3af; }
    .feed-spinner.visible { display: block; }

    .moderation-placeholder-card {
      border-left: 3px solid #ef4444;
      background: #fef2f2;
      border-color: #fecaca;
    }
    .moderation-placeholder-head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }
    .moderation-placeholder-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: #fee2e2;
      color: #b91c1c;
      font-size: 1rem;
    }
    .moderation-placeholder-title {
      margin: 6px 0 8px;
      font-size: 1.05rem;
      color: #991b1b;
      font-weight: 800;
    }
    .moderation-placeholder-message {
      margin: 0;
      color: #7f1d1d;
      font-size: .94rem;
      line-height: 1.6;
    }
    .moderation-placeholder-reason {
      margin: 12px 0 0;
      color: #7f1d1d;
      font-size: .88rem;
      background: rgba(254, 226, 226, .85);
      border: 1px solid #fecaca;
      border-radius: 10px;
      padding: 10px 12px;
    }
    .moderation-placeholder-actions {
      margin-top: 14px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .moderation-link-btn {
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .ig-story-modal { position: fixed; inset: 0; background: rgba(0,0,0,.92); z-index: 10020; display: none; align-items: center; justify-content: center; }
    .ig-story-modal.open { display: flex; }
    .ig-story-frame { width: min(420px, 92vw); height: min(760px, 88vh); border-radius: 18px; overflow: hidden; background: #111; position: relative; box-shadow: 0 24px 60px rgba(0,0,0,.45); }
    .ig-story-bars { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; gap: 6px; z-index: 2; }
    .ig-story-bar { flex: 1; height: 3px; background: rgba(255,255,255,.28); border-radius: 99px; overflow: hidden; }
    .ig-story-bar > span { display:block; width:0; height:100%; background:#fff; }
    .ig-story-head { position: absolute; left: 12px; right: 12px; top: 22px; z-index: 2; display:flex; align-items:center; justify-content:space-between; }
    .ig-story-author { display:flex; align-items:center; gap:10px; color:#fff; }
    .ig-story-author .av { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#f59e0b,#ef4444); font-size:.82rem; font-weight:700; }
    .ig-story-author .nm { font-weight:700; font-size:.92rem; }
    .ig-story-author .tm { font-size:.78rem; color:rgba(255,255,255,.75); }
    .ig-story-close { border:0; background:transparent; color:#fff; font-size:1.55rem; cursor:pointer; line-height:1; }
    .ig-story-image { width:100%; height:100%; object-fit:cover; }
    .ig-story-caption { position:absolute; left:14px; right:14px; bottom:14px; z-index:2; color:#fff; background:rgba(0,0,0,.35); padding:10px 12px; border-radius:12px; font-size:.92rem; }
    .ig-story-removed-panel {
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 24px;
      z-index: 6;
      background: rgba(17, 24, 39, 0.96);
      border: 1px solid rgba(239, 68, 68, 0.45);
      border-radius: 14px;
      padding: 14px;
      color: #f3f4f6;
      display: none;
      flex-direction: column;
      gap: 10px;
      box-shadow: 0 18px 35px rgba(0, 0, 0, 0.35);
    }
    .ig-story-removed-panel h4 {
      margin: 0;
      font-size: .98rem;
      font-weight: 800;
      color: #fecaca;
    }
    .ig-story-removed-panel p {
      margin: 0;
      font-size: .86rem;
      line-height: 1.45;
      color: #e5e7eb;
    }
    .ig-story-removed-reason {
      background: rgba(127, 29, 29, 0.35);
      border: 1px solid rgba(252, 165, 165, 0.35);
      border-radius: 10px;
      padding: 9px 10px;
    }
    .ig-story-removed-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .ig-story-removed-btn {
      border: 0;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: .82rem;
      font-weight: 700;
      cursor: pointer;
    }
    .ig-story-removed-btn.primary {
      background: #ef4444;
      color: #fff;
    }
    .ig-story-removed-btn.secondary {
      background: rgba(255, 255, 255, 0.12);
      color: #f9fafb;
    }
    .ig-story-hit { position:absolute; top:0; bottom:0; width:42%; z-index:3; cursor:pointer; }
    .ig-story-hit.left { left:0; }
    .ig-story-hit.right { right:0; }
    .ig-story-seen-trigger { position:absolute; left:14px; bottom:14px; z-index:4; border:0; background:rgba(0,0,0,.45); color:#fff; border-radius:999px; font-size:.82rem; font-weight:600; padding:7px 12px; display:none; align-items:center; gap:7px; cursor:pointer; }
    .ig-story-seen-trigger .eye { font-size:1rem; line-height:1; }
    .ig-story-viewers-sheet { position:absolute; left:0; right:0; bottom:0; z-index:8; background:#0c0c0c; color:#fff; border-top-left-radius:16px; border-top-right-radius:16px; transform:translateY(105%); transition:transform .22s ease; max-height:62%; display:flex; flex-direction:column; }
    .ig-story-viewers-sheet.open { transform:translateY(0); }
    .ig-story-viewers-handle { width:42px; height:4px; border-radius:99px; background:rgba(255,255,255,.3); margin:10px auto 8px; }
    .ig-story-viewers-head { display:flex; align-items:center; justify-content:space-between; padding:2px 14px 10px; font-weight:700; }
    .ig-story-viewers-close { border:0; background:transparent; color:#fff; font-size:1.25rem; cursor:pointer; line-height:1; }
    .ig-story-viewers-list { overflow:auto; padding:0 8px 12px; }
    .ig-story-viewer-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 8px; border-radius:10px; }
    .ig-story-viewer-row:hover { background:rgba(255,255,255,.06); }
    .ig-story-viewer-meta { display:flex; align-items:center; gap:10px; }
    .ig-story-viewer-av { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#f59e0b,#ef4444); font-size:.82rem; font-weight:700; }
    .ig-story-viewer-name { font-weight:600; font-size:.9rem; }
    .ig-story-viewer-time { font-size:.75rem; color:rgba(255,255,255,.68); }
    .ig-story-viewers-empty { color:rgba(255,255,255,.66); font-size:.86rem; text-align:center; padding:16px 8px 20px; }
    .story-ring.js-story-open.is-seen { background: #9ca3af; }
    .story-ring.js-story-open.is-unseen { background: linear-gradient(135deg,#f59e0b,#ef4444); }

    .stories-head-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
    }
    .live-head-btn {
      border: 0;
      border-radius: 999px;
      padding: 7px 12px;
      color: #fff;
      font-weight: 800;
      font-size: .74rem;
      cursor: pointer;
      background: linear-gradient(135deg,#fb7185,#ef4444);
      box-shadow: 0 8px 20px rgba(239,68,68,.28);
      white-space: nowrap;
    }
    .live-head-btn:disabled { opacity: .65; cursor: not-allowed; box-shadow: none; }

    .story-bbl.live-story-bbl .story-lbl {
      color: #be123c;
      font-weight: 700;
    }
    .story-ring.live-story-ring {
      position: relative;
      background: linear-gradient(140deg,#ef4444 0%, #f43f5e 42%, #fb7185 100%);
      box-shadow:
        0 0 0 2px rgba(244,63,94,.24),
        0 0 0 6px rgba(251,113,133,.14),
        0 0 18px rgba(244,63,94,.48);
      animation: liveStoryPulse 1.8s ease-in-out infinite;
    }
    .story-ring.live-story-ring .story-inner {
      color: #fff;
      background: radial-gradient(circle at 30% 24%, #334155 0%, #0f172a 100%);
      border: 2px solid rgba(255,255,255,.72);
    }
    .live-story-badge {
      position: absolute;
      top: -9px;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 999px;
      padding: 2px 6px;
      font-size: .56rem;
      letter-spacing: .06em;
      font-weight: 900;
      color: #fff;
      background: linear-gradient(135deg,#e11d48,#f43f5e);
      box-shadow: 0 4px 12px rgba(225,29,72,.42);
      pointer-events: none;
    }

    .live-strip {
      margin-top: 12px;
      border: 1px solid #fee2e2;
      border-radius: 14px;
      background: linear-gradient(120deg, #fff1f2 0%, #ffffff 45%, #fff7ed 100%);
      box-shadow: 0 10px 26px rgba(190, 24, 93, .08);
      overflow: hidden;
    }
    .live-strip-head {
      padding: 11px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #ffe4e6;
      gap: 10px;
    }
    .live-strip-head h3 {
      margin: 0;
      font-size: .95rem;
      font-weight: 800;
      color: #831843;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .live-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 0 0 rgba(239,68,68,.55);
      animation: liveDotPulse 1.4s infinite;
    }
    .live-start-btn {
      border: 0;
      border-radius: 999px;
      padding: 7px 12px;
      color: #fff;
      font-weight: 800;
      font-size: .76rem;
      cursor: pointer;
      background: linear-gradient(135deg,#fb7185,#ef4444);
      box-shadow: 0 8px 20px rgba(239,68,68,.28);
    }
    .live-start-btn:disabled { opacity: .65; cursor: not-allowed; box-shadow: none; }
    .live-strip-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 10px;
      padding: 10px;
    }
    .live-card {
      border: 1px solid #fecdd3;
      border-radius: 12px;
      padding: 10px;
      background: #fff;
      box-shadow: 0 8px 16px rgba(15,23,42,.07);
      display: grid;
      gap: 8px;
    }
    .live-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .live-host { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .live-host-av {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg,#f43f5e,#fb7185);
      color: #fff;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      font-size: .8rem;
    }
    .live-host-name {
      font-size: .82rem;
      font-weight: 700;
      color: #0f172a;
      max-width: 100%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .live-pill {
      border-radius: 999px;
      padding: 3px 7px;
      font-size: .66rem;
      font-weight: 800;
      color: #fff;
      background: linear-gradient(135deg,#e11d48,#ef4444);
      letter-spacing: .04em;
    }
    .live-card-title {
      font-size: .78rem;
      color: #334155;
      min-height: 34px;
      line-height: 1.35;
    }
    .live-card-meta {
      display: flex;
      gap: 8px;
      font-size: .72rem;
      color: #64748b;
      font-weight: 700;
      flex-wrap: wrap;
    }
    .live-join-btn {
      border: 1px solid #fda4af;
      border-radius: 10px;
      background: #fff1f2;
      color: #be123c;
      font-weight: 800;
      font-size: .74rem;
      cursor: pointer;
      padding: 7px 9px;
    }
    .live-empty {
      grid-column: 1 / -1;
      text-align: center;
      color: #94a3b8;
      font-size: .82rem;
      padding: 8px 4px;
    }
    @keyframes liveStoryPulse {
      0% {
        box-shadow:
          0 0 0 2px rgba(244,63,94,.2),
          0 0 0 6px rgba(251,113,133,.12),
          0 0 12px rgba(244,63,94,.32);
      }
      55% {
        box-shadow:
          0 0 0 2px rgba(244,63,94,.3),
          0 0 0 8px rgba(251,113,133,.2),
          0 0 20px rgba(244,63,94,.52);
      }
      100% {
        box-shadow:
          0 0 0 2px rgba(244,63,94,.2),
          0 0 0 6px rgba(251,113,133,.12),
          0 0 12px rgba(244,63,94,.32);
      }
    }

    .live-modal {
      position: fixed;
      inset: 0;
      z-index: 10220;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 12px;
      background: rgba(6, 10, 24, .78);
      backdrop-filter: blur(4px);
    }
    .live-modal.open { display: flex; }
    .live-dialog {
      width: min(1080px, 96vw);
      height: min(760px, 92vh);
      border-radius: 18px;
      overflow: hidden;
      background: #0f172a;
      border: 1px solid rgba(255,255,255,.18);
      box-shadow: 0 24px 62px rgba(0,0,0,.44);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
    }
    .live-stage {
      position: relative;
      background: radial-gradient(circle at 22% 20%, #1e293b 0%, #0f172a 55%, #020617 100%);
      overflow: hidden;
    }
    .live-video-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.05rem;
      font-weight: 700;
      background: radial-gradient(circle at 50% 40%, rgba(248,113,113,.24), rgba(15,23,42,.2) 48%, rgba(2,6,23,.9) 100%);
    }
    .live-video-placeholder .inner {
      text-align: center;
      background: rgba(2,6,23,.42);
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 14px;
      padding: 14px 16px;
      backdrop-filter: blur(4px);
    }
    .live-local-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
      transform: scaleX(-1);
    }
    .live-head-overlay {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }
    .live-head-main {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      color: #fff;
      background: rgba(2,6,23,.36);
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 12px;
      padding: 8px 9px;
    }
    .live-head-main .av {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg,#f43f5e,#fb7185);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: .82rem;
      flex: 0 0 auto;
    }
    .live-head-main .nm {
      font-size: .84rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 210px;
    }
    .live-head-main .meta {
      font-size: .72rem;
      color: rgba(255,255,255,.82);
      margin-top: 2px;
    }
    .live-close-btn {
      border: 0;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(2,6,23,.46);
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      border: 1px solid rgba(255,255,255,.18);
    }
    .live-reaction-burst {
      position: absolute;
      right: 16px;
      bottom: 74px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      pointer-events: none;
      z-index: 4;
    }
    .live-reaction-burst span {
      font-size: 1.2rem;
      animation: liveHeartFloat 1.35s ease forwards;
      filter: drop-shadow(0 3px 6px rgba(0,0,0,.35));
    }
    .live-side {
      background: #ffffff;
      border-left: 1px solid #e2e8f0;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .live-side-head {
      padding: 11px 12px;
      border-bottom: 1px solid #e2e8f0;
      background: linear-gradient(90deg, #fff1f2, #fff7ed);
    }
    .live-side-head h4 {
      margin: 0;
      font-size: .86rem;
      color: #881337;
      font-weight: 800;
    }
    .live-side-head p {
      margin: 4px 0 0;
      font-size: .74rem;
      color: #64748b;
      font-weight: 600;
    }
    .live-comments {
      flex: 1;
      min-height: 0;
      overflow: auto;
      padding: 10px;
      display: grid;
      gap: 7px;
      background: #f8fafc;
    }
    .live-c-row {
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #fff;
      padding: 7px 8px;
      font-size: .76rem;
      color: #334155;
      line-height: 1.35;
    }
    .live-c-row strong {
      color: #0f172a;
      font-size: .73rem;
      margin-right: 4px;
    }
    .live-comment-form {
      border-top: 1px solid #e2e8f0;
      padding: 9px;
      display: grid;
      gap: 8px;
      background: #fff;
    }
    .live-rxn-row {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .live-filter-controls {
      display: grid;
      gap: 8px;
      padding: 8px;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      background: #f8fafc;
    }
    .live-filter-presets {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .live-filter-chip {
      border: 1px solid #cbd5e1;
      background: #fff;
      border-radius: 999px;
      font-size: .7rem;
      font-weight: 700;
      color: #334155;
      padding: 4px 8px;
      cursor: pointer;
    }
    .live-filter-chip.active {
      border-color: #fb7185;
      color: #be123c;
      background: #fff1f2;
    }
    .live-filter-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .live-filter-item {
      display: grid;
      gap: 4px;
      color: #475569;
      font-size: .7rem;
      font-weight: 700;
    }
    .live-filter-item input[type="range"] {
      width: 100%;
    }
    .live-filter-reset {
      justify-self: end;
      border: 1px solid #fecdd3;
      background: #fff1f2;
      color: #be123c;
      border-radius: 999px;
      font-size: .72rem;
      font-weight: 700;
      padding: 4px 10px;
      cursor: pointer;
    }
    .live-rxn-btn {
      border: 1px solid #fecdd3;
      border-radius: 999px;
      background: #fff1f2;
      color: #be123c;
      font-size: .73rem;
      font-weight: 700;
      padding: 5px 8px;
      cursor: pointer;
    }
    .live-input-row { display: flex; gap: 6px; }
    .live-input-row input {
      flex: 1;
      border: 1px solid #cbd5e1;
      border-radius: 9px;
      padding: 8px 9px;
      font-size: .78rem;
    }
    .live-input-row input:focus {
      outline: none;
      border-color: #f43f5e;
      box-shadow: 0 0 0 3px rgba(244,63,94,.15);
