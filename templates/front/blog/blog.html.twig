{% extends 'base.html.twig' %}

{% block title %}Travelgram — TripX Community{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Montserrat:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/blog.css') }}">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">
  <style>
    .ts-destination { color: #6b7280; font-size: .9rem; margin: 4px 0 10px; }
    .ts-country-tag {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      border-radius: 999px;
      font-size: .82rem;
      font-weight: 600;
      background: #e0ecff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
      cursor: pointer;
    }
    .ts-destination-text {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .ts-destination-flag {
      width: 18px;
      height: 12px;
      object-fit: cover;
      border-radius: 2px;
      border: 1px solid rgba(0,0,0,.15);
      box-shadow: 0 1px 2px rgba(0,0,0,.08);
      flex: 0 0 auto;
    }
    .ts-meta { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
    .ts-tag {
      display: inline-block; padding: 3px 10px; border-radius: 20px;
      font-size: .78rem; font-weight: 600;
      background: #f3f4f6; color: #374151;
    }
    .ts-rating {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .ts-rating-stars {
      letter-spacing: .05em;
      color: #f59e0b;
      line-height: 1;
    }
    .ts-rating-value {
      color: #4b5563;
      font-weight: 700;
      font-size: .72rem;
    }
    .b-travel_story { background: linear-gradient(135deg,#2563eb,#38bdf8); color:#fff; }
    .ts-card { border-left: 3px solid #3b82f6; }
    #feed-container.loading { opacity: .45; pointer-events: none; transition: opacity .15s; }
    .feed-spinner { display: none; text-align: center; padding: 40px 0; font-size: 1.1rem; color: #9ca3af; }
    .feed-spinner.visible { display: block; }

    .ig-story-modal { position: fixed; inset: 0; background: rgba(0,0,0,.92); z-index: 10020; display: none; align-items: center; justify-content: center; }
    .ig-story-modal.open { display: flex; }
    .ig-story-frame { width: min(420px, 92vw); height: min(760px, 88vh); border-radius: 18px; overflow: hidden; background: #111; position: relative; box-shadow: 0 24px 60px rgba(0,0,0,.45); }
    .ig-story-bars { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; gap: 6px; z-index: 2; }
    .ig-story-bar { flex: 1; height: 3px; background: rgba(255,255,255,.28); border-radius: 99px; overflow: hidden; }
    .ig-story-bar > span { display:block; width:0; height:100%; background:#fff; }
    .ig-story-head { position: absolute; left: 12px; right: 12px; top: 22px; z-index: 2; display:flex; align-items:center; justify-content:space-between; }
    .ig-story-author { display:flex; align-items:center; gap:10px; color:#fff; }
    .ig-story-author .av { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#f59e0b,#ef4444); font-size:.82rem; font-weight:700; }
    .ig-story-author .nm { font-weight:700; font-size:.92rem; }
    .ig-story-author .tm { font-size:.78rem; color:rgba(255,255,255,.75); }
    .ig-story-close { border:0; background:transparent; color:#fff; font-size:1.55rem; cursor:pointer; line-height:1; }
    .ig-story-image { width:100%; height:100%; object-fit:cover; }
    .ig-story-caption { position:absolute; left:14px; right:14px; bottom:14px; z-index:2; color:#fff; background:rgba(0,0,0,.35); padding:10px 12px; border-radius:12px; font-size:.92rem; }
    .ig-story-hit { position:absolute; top:0; bottom:0; width:42%; z-index:3; cursor:pointer; }
    .ig-story-hit.left { left:0; }
    .ig-story-hit.right { right:0; }
    .ig-story-seen-trigger { position:absolute; left:14px; bottom:14px; z-index:4; border:0; background:rgba(0,0,0,.45); color:#fff; border-radius:999px; font-size:.82rem; font-weight:600; padding:7px 12px; display:none; align-items:center; gap:7px; cursor:pointer; }
    .ig-story-seen-trigger .eye { font-size:1rem; line-height:1; }
    .ig-story-viewers-sheet { position:absolute; left:0; right:0; bottom:0; z-index:8; background:#0c0c0c; color:#fff; border-top-left-radius:16px; border-top-right-radius:16px; transform:translateY(105%); transition:transform .22s ease; max-height:62%; display:flex; flex-direction:column; }
    .ig-story-viewers-sheet.open { transform:translateY(0); }
    .ig-story-viewers-handle { width:42px; height:4px; border-radius:99px; background:rgba(255,255,255,.3); margin:10px auto 8px; }
    .ig-story-viewers-head { display:flex; align-items:center; justify-content:space-between; padding:2px 14px 10px; font-weight:700; }
    .ig-story-viewers-close { border:0; background:transparent; color:#fff; font-size:1.25rem; cursor:pointer; line-height:1; }
    .ig-story-viewers-list { overflow:auto; padding:0 8px 12px; }
    .ig-story-viewer-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 8px; border-radius:10px; }
    .ig-story-viewer-row:hover { background:rgba(255,255,255,.06); }
    .ig-story-viewer-meta { display:flex; align-items:center; gap:10px; }
    .ig-story-viewer-av { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#f59e0b,#ef4444); font-size:.82rem; font-weight:700; }
    .ig-story-viewer-name { font-weight:600; font-size:.9rem; }
    .ig-story-viewer-time { font-size:.75rem; color:rgba(255,255,255,.68); }
    .ig-story-viewers-empty { color:rgba(255,255,255,.66); font-size:.86rem; text-align:center; padding:16px 8px 20px; }
    .story-ring.js-story-open.is-seen { background: #9ca3af; }
    .story-ring.js-story-open.is-unseen { background: linear-gradient(135deg,#f59e0b,#ef4444); }

    .ts-map-modal {
      position: fixed;
      inset: 0;
      z-index: 10050;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,.55);
      backdrop-filter: blur(2px);
      padding: 14px;
    }
    .ts-map-modal.open { display: flex; }
    .ts-map-dialog {
      width: min(760px, 96vw);
      max-height: 90vh;
      background: #fff;
      border-radius: 16px;
      border: 1px solid #dbeafe;
      box-shadow: 0 24px 60px rgba(0,0,0,.3);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .ts-map-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid #e5e7eb;
      background: linear-gradient(90deg, #eef2ff, #eff6ff);
    }
    .ts-map-title {
      font-size: .95rem;
      font-weight: 700;
      color: #1f2937;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ts-map-close {
      border: 0;
      background: transparent;
      color: #374151;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
    }
    .ts-map-status {
      margin: 0;
      padding: 8px 14px;
      font-size: .82rem;
      color: #475569;
      border-bottom: 1px solid #e5e7eb;
      background: #f8fafc;
    }
    .ts-map-status.error {
      color: #b91c1c;
      background: #fef2f2;
    }
    .ts-map-canvas {
      width: 100%;
      min-height: 360px;
      height: min(58vh, 500px);
    }
    .sug-name-link,
    .profile-name-link,
    .pc-name {
      color: inherit;
      text-decoration: none;
      font-weight: 700;
      border-radius: 4px;
      transition: color .15s ease, text-decoration-color .15s ease, background-color .15s ease;
    }
    .sug-name-link:hover,
    .sug-name-link:focus-visible,
    .profile-name-link:hover,
    .profile-name-link:focus-visible,
    .pc-name:hover,
    .pc-name:focus-visible {
      color: #2563eb;
      text-decoration: underline;
      text-decoration-color: #2563eb;
      cursor: pointer;
      outline: none;
    }

    .story-editor-modal {
      position: fixed;
      inset: 0;
      z-index: 10100;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(8, 12, 24, .72);
      backdrop-filter: blur(6px);
      padding: 14px;
    }
    .story-editor-modal.open { display: flex; }
    .story-source-sheet {
      position: fixed;
      inset: 0;
      z-index: 10110;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(8, 12, 24, .62);
      backdrop-filter: blur(6px);
      padding: 14px;
    }
    .story-source-sheet.open { display: flex; }
    .story-source-card {
      width: min(480px, 96vw);
      border-radius: 18px;
      background: #fff;
      border: 1px solid #dbeafe;
      box-shadow: 0 18px 48px rgba(0, 0, 0, .28);
      overflow: hidden;
      animation: sourceUp .22s ease;
    }
    .story-source-head {
      padding: 14px;
      border-bottom: 1px solid #e2e8f0;
      background: linear-gradient(90deg, #eff6ff, #ecfeff);
    }
    .story-source-title {
      margin: 0;
      font-size: .95rem;
      color: #0f172a;
      font-weight: 800;
      letter-spacing: .02em;
    }
    .story-source-sub {
      margin: 4px 0 0;
      color: #64748b;
      font-size: .8rem;
    }
    .story-source-actions {
      display: grid;
      gap: 10px;
      padding: 12px;
    }
    .story-source-btn {
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      background: #fff;
      padding: 11px 12px;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      transition: .15s ease;
    }
    .story-source-btn:hover,
    .story-source-btn:focus-visible {
      border-color: #60a5fa;
      box-shadow: 0 6px 16px rgba(37, 99, 235, .16);
      outline: none;
    }
    .story-source-btn strong {
      display: block;
      font-size: .86rem;
      color: #0f172a;
    }
    .story-source-btn span {
      display: block;
      margin-top: 2px;
      font-size: .76rem;
      color: #64748b;
    }
    .story-source-btn .ico {
      font-size: 1.2rem;
      line-height: 1;
    }
    .story-source-cancel {
      border: 0;
      background: #f1f5f9;
      color: #334155;
      font-weight: 700;
      font-size: .82rem;
      border-radius: 11px;
      padding: 10px 12px;
      cursor: pointer;
      margin: 0 12px 12px;
      width: calc(100% - 24px);
    }

    .story-camera-modal {
      position: fixed;
      inset: 0;
      z-index: 10120;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(3, 7, 18, .88);
      backdrop-filter: blur(4px);
      padding: 12px;
    }
    .story-camera-modal.open { display: flex; }
    .story-camera-card {
      width: min(460px, 96vw);
      height: min(820px, 92vh);
      border-radius: 24px;
      overflow: hidden;
      background: #05070f;
      border: 1px solid rgba(255,255,255,.14);
      box-shadow: 0 28px 70px rgba(0, 0, 0, .5);
      position: relative;
      display: flex;
      flex-direction: column;
    }
    .story-camera-head {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 14px 8px;
      color: #fff;
      background: linear-gradient(to bottom, rgba(0,0,0,.6), rgba(0,0,0,0));
    }
    .story-camera-title {
      margin: 0;
      font-size: .88rem;
      font-weight: 700;
      letter-spacing: .03em;
      text-transform: uppercase;
    }
    .story-camera-x {
      border: 0;
      background: transparent;
      color: #fff;
      font-size: 1.55rem;
      line-height: 1;
      cursor: pointer;
    }
    .story-camera-stage {
      position: relative;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      overflow: hidden;
    }
    .story-camera-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
      transition: filter .16s ease;
      filter: none;
    }
    .story-camera-gesture-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
      pointer-events: none;
    }
    .story-camera-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      border: 2px solid rgba(255,255,255,.16);
      border-radius: 0;
      box-shadow: inset 0 0 120px rgba(0, 0, 0, .22);
    }
    .story-camera-foot {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 4;
      background: linear-gradient(to top, rgba(0,0,0,.72), rgba(0,0,0,0));
      padding: 10px 12px 16px;
      display: grid;
      gap: 10px;
    }
    .story-camera-filters {
      display: flex;
      gap: 8px;
      overflow: auto;
      padding-bottom: 2px;
      scrollbar-width: thin;
    }
    .story-camera-gesture-tune {
      display: flex;
      align-items: center;
      gap: 7px;
      overflow: auto;
      padding-bottom: 2px;
    }
    .story-camera-gesture-tune .lbl {
      color: rgba(255,255,255,.82);
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      flex: 0 0 auto;
    }
    .story-camera-tune-btn {
      flex: 0 0 auto;
      border: 1px solid rgba(255,255,255,.3);
      background: rgba(15, 23, 42, .42);
      color: #fff;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: .68rem;
      font-weight: 700;
      cursor: pointer;
    }
    .story-camera-tune-btn.active {
      background: rgba(59, 130, 246, .85);
      border-color: transparent;
      box-shadow: 0 6px 14px rgba(37, 99, 235, .35);
    }
    .story-camera-fchip {
      flex: 0 0 auto;
      border: 1px solid rgba(255,255,255,.35);
      background: rgba(15, 23, 42, .56);
      color: #fff;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: .72rem;
      font-weight: 700;
      cursor: pointer;
      backdrop-filter: blur(4px);
    }
    .story-camera-fchip.active {
      background: linear-gradient(135deg, #fb7185, #f97316);
      border-color: transparent;
      box-shadow: 0 8px 20px rgba(249, 115, 22, .3);
    }
    .story-camera-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .story-camera-side {
      border: 1px solid rgba(255,255,255,.35);
      background: rgba(15, 23, 42, .58);
      color: #fff;
      border-radius: 999px;
      font-size: .74rem;
      font-weight: 700;
      padding: 8px 11px;
      cursor: pointer;
      min-width: 86px;
      text-align: center;
    }
    .story-camera-capture {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      border: 3px solid #fff;
      background: radial-gradient(circle at 30% 30%, #f8fafc, #e2e8f0);
      box-shadow: 0 8px 24px rgba(255,255,255,.28);
      cursor: pointer;
      position: relative;
    }
    .story-camera-capture::after {
      content: '';
      position: absolute;
      inset: 7px;
      border-radius: 50%;
      border: 2px solid rgba(15, 23, 42, .26);
    }
    .story-camera-msg {
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 106px;
      z-index: 6;
      border-radius: 10px;
      background: rgba(0,0,0,.58);
      color: #fff;
      font-size: .78rem;
      font-weight: 600;
      padding: 8px 10px;
      text-align: center;
      display: none;
    }
    .story-camera-msg.visible { display: block; }
    .story-camera-gesture-guide {
      position: absolute;
      left: 12px;
      right: 12px;
      top: 52px;
      z-index: 7;
      border-radius: 12px;
      background: rgba(2, 6, 23, .64);
      border: 1px solid rgba(255,255,255,.2);
      color: #fff;
      padding: 10px 11px;
      font-size: .74rem;
      line-height: 1.35;
      backdrop-filter: blur(6px);
      display: none;
    }
    .story-camera-gesture-guide.open { display: block; }
    .story-camera-gesture-guide h4 {
      margin: 0 0 6px;
      font-size: .76rem;
      letter-spacing: .02em;
    }
    .story-camera-gesture-guide p { margin: 3px 0; }
    .story-camera-gesture-guide button {
      margin-top: 7px;
      border: 0;
      border-radius: 999px;
      padding: 5px 10px;
      background: rgba(255,255,255,.15);
      color: #fff;
      font-weight: 700;
      font-size: .7rem;
      cursor: pointer;
    }

    body.story-camera-open { overflow: hidden; }

    @keyframes sourceUp {
      from { transform: translateY(10px) scale(.985); opacity: .4; }
      to { transform: translateY(0); opacity: 1; }
    }
    .story-editor-card {
      width: min(1020px, 96vw);
      max-height: 92vh;
      background: radial-gradient(circle at top left, #ffffff 0%, #f8fafc 48%, #f1f5f9 100%);
      border: 1px solid #dbeafe;
      border-radius: 18px;
      box-shadow: 0 26px 72px rgba(0, 0, 0, .3);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .story-editor-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 14px;
      border-bottom: 1px solid #e2e8f0;
      background: linear-gradient(90deg, #eff6ff, #ecfeff);
    }
    .story-editor-title {
      margin: 0;
      font-size: .98rem;
      font-weight: 700;
      color: #0f172a;
      letter-spacing: .02em;
    }
    .story-editor-close {
      border: 0;
      background: transparent;
      color: #334155;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
    }
    .story-editor-body {
      display: grid;
      grid-template-columns: minmax(320px, 1fr) 310px;
      gap: 0;
      min-height: 520px;
      max-height: calc(92vh - 58px);
    }
    .story-editor-stage {
      background: linear-gradient(145deg, #111827 0%, #1e293b 100%);
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }
    .story-editor-stage img {
      max-width: 100%;
      display: block;
    }
    .story-editor-panel {
      background: #ffffff;
      border-left: 1px solid #e2e8f0;
      padding: 14px;
      overflow: auto;
    }
    .story-editor-group + .story-editor-group { margin-top: 14px; }
    .story-editor-label {
      display: block;
      font-size: .8rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 7px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .story-filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .story-filter-btn {
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: .75rem;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
      transition: .16s ease;
    }
    .story-filter-btn:hover,
    .story-filter-btn:focus-visible {
      border-color: #60a5fa;
      color: #1d4ed8;
      outline: none;
    }
    .story-filter-btn.active {
      background: linear-gradient(135deg, #2563eb, #0ea5e9);
      border-color: transparent;
      color: #fff;
      box-shadow: 0 8px 18px rgba(37, 99, 235, .28);
    }
    .story-adjust-row + .story-adjust-row { margin-top: 8px; }
    .story-adjust-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: .76rem;
      color: #475569;
      margin-bottom: 4px;
      font-weight: 600;
    }
    .story-slider {
      width: 100%;
      accent-color: #2563eb;
    }
    .story-editor-tools {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .story-tool-btn {
      border: 1px solid #cbd5e1;
      background: #fff;
      border-radius: 10px;
      padding: 7px 10px;
      font-size: .78rem;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
    }
    .story-tool-btn:hover,
    .story-tool-btn:focus-visible {
      border-color: #60a5fa;
      color: #1d4ed8;
      outline: none;
    }
    .story-editor-caption {
      width: 100%;
      min-height: 74px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 9px 10px;
      resize: vertical;
      font-family: inherit;
      font-size: .86rem;
      color: #1e293b;
      background: #fff;
    }
    .story-editor-caption:focus {
      outline: none;
      border-color: #60a5fa;
      box-shadow: 0 0 0 3px rgba(96, 165, 250, .2);
    }
    .story-editor-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }
    .story-editor-btn {
      border: 0;
      border-radius: 10px;
      padding: 9px 12px;
      font-size: .82rem;
      font-weight: 700;
      cursor: pointer;
      flex: 1;
    }
    .story-editor-btn.secondary {
      background: #e2e8f0;
      color: #334155;
    }
    .story-editor-btn.primary {
      background: linear-gradient(135deg, #f97316, #ef4444);
      color: #fff;
      box-shadow: 0 10px 20px rgba(239, 68, 68, .26);
    }
    .story-editor-btn:disabled {
      opacity: .55;
      cursor: not-allowed;
      box-shadow: none;
    }
    body.story-editor-open { overflow: hidden; }

    @media (max-width: 940px) {
      .story-editor-body {
        grid-template-columns: 1fr;
      }
      .story-editor-panel {
        border-left: 0;
        border-top: 1px solid #e2e8f0;
      }
      .story-editor-stage {
        min-height: 360px;
      }
    }
  </style>
{% endblock %}

{% block body %}
{% set typeFilter    = typeFilter    is defined ? typeFilter    : 'all' %}
{% set search        = search        is defined ? search        : '' %}
{% set authorMap     = authorMap     is defined ? authorMap     : {} %}
{% set savedPostIds  = savedPostIds  is defined ? savedPostIds  : [] %}
{% set currentUserId = currentUserId is defined ? currentUserId : null %}
{% set reactionSummary = reactionSummary is defined ? reactionSummary : {} %}
{% set feed = feed is defined ? feed : [] %}
{% set userReactions = userReactions is defined ? userReactions : {} %}
{% set ownerPostCount = ownerPostCount is defined ? ownerPostCount : 0 %}
{% set ownerStoryCount = ownerStoryCount is defined ? ownerStoryCount : 0 %}
{% set ownerFollowersCount = ownerFollowersCount is defined ? ownerFollowersCount : 0 %}
{% set ownerFollowingCount = ownerFollowingCount is defined ? ownerFollowingCount : 0 %}
{% set ownerTotalContentCount = ownerPostCount + ownerStoryCount %}
{% set storiesByUser  = storiesByUser  is defined ? storiesByUser  : [] %}
{% set followingLookup = followingLookup is defined ? followingLookup : {} %}

{% set me = app.user %}

<div class="tg-shell">

  <aside class="tg-left">
    <div class="profile-card">
      {% if me %}
        <div class="profile-avatar">{{ me.firstName|first|upper }}</div>
        <a href="{{ path('blog_user_profile', {id: me.id}) }}" class="profile-name profile-name-link">{{ me.firstName }} {{ me.lastName }}</a>
        <div class="profile-handle">@user{{ me.id }}</div>
      {% else %}
        <div class="profile-avatar">?</div>
        <div class="profile-name">Traveller</div>
        <div class="profile-handle">@guest</div>
      {% endif %}
      <div class="profile-stats">
        <div class="pstat"><span class="pstat-num">{{ ownerTotalContentCount }}</span><span class="pstat-lbl">Posts</span></div>
        <div class="pstat"><span class="pstat-num">{{ ownerFollowersCount }}</span><span class="pstat-lbl">Followers</span></div>
        <div class="pstat"><span class="pstat-num">{{ ownerFollowingCount }}</span><span class="pstat-lbl">Following</span></div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <a href="{{ path('blog', {type:'all'}) }}" class="snav-item {% if typeFilter == 'all' %}active{% endif %}"
         data-filter-type="all" onclick="return feedFilter(event, 'all')">
        <span class="snav-icon">🏠</span> All
      </a>
      <a href="{{ path('blog', {type:'my_posts'}) }}" class="snav-item {% if typeFilter == 'my_posts' %}active{% endif %}"
        data-filter-type="my_posts" onclick="return feedFilter(event, 'my_posts')">
        <span class="snav-icon">📝</span> My Posts
      </a>
      <a href="{{ path('blog', {type:'my_travel_story'}) }}" class="snav-item {% if typeFilter == 'my_travel_story' %}active{% endif %}"
         data-filter-type="my_travel_story" onclick="return feedFilter(event, 'my_travel_story')">
        <span class="snav-icon">🧳</span> My Travel Stories
      </a>
      <a href="{{ path('blog_saved') }}" class="snav-item">
        <span class="snav-icon">🔖</span> Saved Posts
      </a>
     
    </nav>
  </aside>

  <main class="tg-center">
    {# ── Search bar (AJAX-driven) ──────────────────────── #}
    <div class="feed-topbar">
      <div class="search-wrap">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input type="text" id="feed-search" value="{{ search }}" placeholder="Search posts or stories…">
      </div>

      <button type="button" class="search-btn" id="feed-search-btn">Search</button>

      <div class="feed-topbar-actions">
        <a href="{{ path('post_create') }}" class="create-btn">+ Create new post</a>
        <a href="{{ path('travel_story_new') }}" class="create-btn">+ Create Travel Story</a>
      </div>
    </div>

    {# ── Type pills (AJAX-driven) ──────────────────────── #}
    <div class="type-pills" id="type-pills">
      <a href="#" class="tpill {% if typeFilter == 'all' %}active{% endif %}"
        data-type="all" onclick="return feedFilter(event, 'all')">All</a>
      <a href="#" class="tpill {% if typeFilter == 'posts' %}active{% endif %}"
        data-type="posts" onclick="return feedFilter(event, 'posts')">Posts</a>
      <a href="#" class="tpill {% if typeFilter == 'travel_story' %}active{% endif %}"
         data-type="travel_story" onclick="return feedFilter(event, 'travel_story')">🧳 Travel Stories</a>
    </div>

    {# ── Stories row ───────────────────────────────────── #}
    <div class="stories-card">
      <div class="stories-head">
        <h3>Stories</h3>
        <a href="#" class="watch-all" onclick="return openFirstStory(event)">Watch all</a>
      </div>
      <div class="stories-row">
        <div class="story-bbl" title="Add a story">
          <button type="button" class="story-ring add-ring" id="story-add-btn" aria-label="Add story">
            <div class="story-inner add-in">+</div>
          </button>
          <span class="story-lbl">Add</span>
        </div>
        {% for s in storiesByUser %}
          <div class="story-bbl">
            <button type="button" class="story-ring js-story-open {% if s.hasUnseen %}is-unseen{% else %}is-seen{% endif %}"
                    data-user-id="{{ s.userId }}"
                    data-user-name="{{ s.userName|e('html_attr') }}"
                    data-has-unseen="{{ s.hasUnseen ? '1' : '0' }}"
                    data-stories="{{ s.stories|json_encode|e('html_attr') }}"
                    aria-label="Open story of {{ s.userName }}">
              <div class="story-inner">{{ s.userName|first|upper }}</div>
            </button>
            <span class="story-lbl">{{ s.userName|split(' ')|first }}</span>
          </div>
        {% else %}
          <span class="story-lbl" style="color:#9ca3af;">No stories yet</span>
        {% endfor %}
      </div>
    </div>

    <form id="story-upload-form" enctype="multipart/form-data" style="display:none;">
      <input type="file" id="story-image-input" name="story_image" accept="image/*">
      <input type="hidden" id="story-caption-input" name="caption" value="">
    </form>

    <div class="story-source-sheet" id="story-source-sheet" aria-hidden="true">
      <div class="story-source-card" role="dialog" aria-modal="true" aria-labelledby="story-source-title">
        <div class="story-source-head">
          <h3 class="story-source-title" id="story-source-title">Create Story</h3>
          <p class="story-source-sub">Instagram style: choose camera or pick from your gallery.</p>
        </div>
        <div class="story-source-actions">
          <button type="button" class="story-source-btn" id="story-source-camera">
            <div>
              <strong>Use camera</strong>
              <span>Live preview filters before capture</span>
            </div>
            <span class="ico">📷</span>
          </button>
          <button type="button" class="story-source-btn" id="story-source-gallery">
            <div>
              <strong>Choose from gallery</strong>
              <span>Upload then edit with filters & crop</span>
            </div>
            <span class="ico">🖼️</span>
          </button>
        </div>
        <button type="button" class="story-source-cancel" id="story-source-cancel">Cancel</button>
      </div>
    </div>

    <div class="story-camera-modal" id="story-camera-modal" aria-hidden="true">
      <div class="story-camera-card" role="dialog" aria-modal="true" aria-labelledby="story-camera-title">
        <div class="story-camera-head">
          <h3 class="story-camera-title" id="story-camera-title">Story camera</h3>
          <button type="button" class="story-camera-x" id="story-camera-close" aria-label="Close camera">&times;</button>
        </div>
        <div class="story-camera-stage">
          <video id="story-camera-video" class="story-camera-video" autoplay playsinline muted></video>
          <canvas id="story-camera-gesture-canvas" class="story-camera-gesture-canvas"></canvas>
          <div class="story-camera-overlay"></div>
          <div class="story-camera-gesture-guide" id="story-camera-gesture-guide">
            <h4>Hand controls</h4>
            <p>Move hand left: next filter</p>
            <p>Move hand right: previous filter</p>
            <p>Move hand up: remove filter</p>
            <p>Pinch in/out: zoom preview</p>
            <button type="button" id="story-camera-gesture-guide-close">Got it</button>
          </div>
          <div class="story-camera-msg" id="story-camera-msg"></div>
        </div>
        <div class="story-camera-foot">
          <div class="story-camera-filters" id="story-camera-filters">
            <button type="button" class="story-camera-fchip active" data-cam-filter="normal">Normal</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="vivid">Vivid</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="golden">Golden</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="noir">Noir</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="cool">Cool</button>
          </div>
          <div class="story-camera-gesture-tune" id="story-camera-gesture-tune" aria-label="Gesture sensitivity">
            <span class="lbl">Gesture sensitivity</span>
            <button type="button" class="story-camera-tune-btn" data-gesture-sense="low">Low</button>
            <button type="button" class="story-camera-tune-btn active" data-gesture-sense="medium">Medium</button>
            <button type="button" class="story-camera-tune-btn" data-gesture-sense="high">High</button>
          </div>
          <div class="story-camera-controls">
            <button type="button" class="story-camera-side" id="story-camera-switch">Switch</button>
            <button type="button" class="story-camera-capture" id="story-camera-capture" aria-label="Capture photo"></button>
            <button type="button" class="story-camera-side" id="story-camera-retake">Retake</button>
          </div>
        </div>
      </div>
    </div>

    <div class="story-editor-modal" id="story-editor-modal" aria-hidden="true">
      <div class="story-editor-card" role="dialog" aria-modal="true" aria-labelledby="story-editor-title">
        <div class="story-editor-head">
          <h3 class="story-editor-title" id="story-editor-title">Create story</h3>
          <button type="button" class="story-editor-close" id="story-editor-close" aria-label="Close editor">&times;</button>
        </div>
        <div class="story-editor-body">
          <div class="story-editor-stage">
            <img id="story-editor-preview" src="" alt="Story preview">
          </div>
          <div class="story-editor-panel">
            <div class="story-editor-group">
              <label class="story-editor-label">Instagram style filters</label>
              <div class="story-filter-row" id="story-filter-row">
                <button type="button" class="story-filter-btn active" data-filter="normal">Normal</button>
                <button type="button" class="story-filter-btn" data-filter="vivid">Vivid</button>
                <button type="button" class="story-filter-btn" data-filter="golden">Golden</button>
                <button type="button" class="story-filter-btn" data-filter="noir">Noir</button>
                <button type="button" class="story-filter-btn" data-filter="cool">Cool</button>
              </div>
            </div>

            <div class="story-editor-group">
              <label class="story-editor-label">Adjustments</label>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Brightness</span><span id="adj-brightness-val">100</span></div>
                <input type="range" class="story-slider" id="adj-brightness" min="60" max="160" value="100">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Contrast</span><span id="adj-contrast-val">100</span></div>
                <input type="range" class="story-slider" id="adj-contrast" min="60" max="170" value="100">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Saturation</span><span id="adj-saturation-val">100</span></div>
                <input type="range" class="story-slider" id="adj-saturation" min="0" max="180" value="100">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Warmth</span><span id="adj-warmth-val">0</span></div>
                <input type="range" class="story-slider" id="adj-warmth" min="-30" max="30" value="0">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Fade</span><span id="adj-fade-val">0</span></div>
                <input type="range" class="story-slider" id="adj-fade" min="0" max="45" value="0">
              </div>
            </div>

            <div class="story-editor-group">
              <label class="story-editor-label">Tools</label>
              <div class="story-editor-tools">
                <button type="button" class="story-tool-btn" id="story-rotate-left">Rotate left</button>
                <button type="button" class="story-tool-btn" id="story-rotate-right">Rotate right</button>
                <button type="button" class="story-tool-btn" id="story-reset">Reset</button>
              </div>
            </div>

            <div class="story-editor-group">
              <label for="story-editor-caption" class="story-editor-label">Caption</label>
              <textarea id="story-editor-caption" class="story-editor-caption" placeholder="Write a caption..."></textarea>
            </div>

            <div class="story-editor-actions">
              <button type="button" class="story-editor-btn secondary" id="story-editor-cancel">Cancel</button>
              <button type="button" class="story-editor-btn primary" id="story-editor-publish">Share story</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="ig-story-modal" id="ig-story-modal" aria-hidden="true">
      <div class="ig-story-frame">
        <div class="ig-story-bars" id="ig-story-bars"></div>
        <div class="ig-story-head">
          <div class="ig-story-author">
            <div class="av" id="ig-story-author-av">U</div>
            <div>
              <div class="nm" id="ig-story-author-name">User</div>
              <div class="tm" id="ig-story-time">now</div>
            </div>
          </div>
          <button class="ig-story-close" type="button" id="ig-story-close" aria-label="Close">&times;</button>
        </div>
        <img id="ig-story-image" class="ig-story-image" src="" alt="Story">
        <div class="ig-story-caption" id="ig-story-caption" style="display:none;"></div>
        <button class="ig-story-seen-trigger" id="ig-story-seen-trigger" type="button" style="display:none;">
          <span class="eye">&#128065;</span>
          <span id="ig-story-seen-count">Seen by 0</span>
        </button>
        <div class="ig-story-viewers-sheet" id="ig-story-viewers-sheet" aria-hidden="true">
          <div class="ig-story-viewers-handle"></div>
          <div class="ig-story-viewers-head">
            <span id="ig-story-viewers-title">Seen by</span>
            <button class="ig-story-viewers-close" id="ig-story-viewers-close" type="button" aria-label="Close viewers">&times;</button>
          </div>
          <div class="ig-story-viewers-list" id="ig-story-viewers-list"></div>
        </div>
        <button class="ig-story-hit left" type="button" id="ig-story-prev" aria-label="Previous"></button>
        <button class="ig-story-hit right" type="button" id="ig-story-next" aria-label="Next"></button>
      </div>
    </div>

    <div class="ts-map-modal" id="ts-map-modal" aria-hidden="true">
      <div class="ts-map-dialog" role="dialog" aria-modal="true" aria-labelledby="ts-map-title">
        <div class="ts-map-head">
          <div class="ts-map-title" id="ts-map-title">Destination map</div>
          <button type="button" class="ts-map-close" id="ts-map-close" aria-label="Close map">&times;</button>
        </div>
        <p class="ts-map-status" id="ts-map-status">Click a destination tag to load its map.</p>
        <div class="ts-map-canvas" id="ts-map-canvas"></div>
      </div>
    </div>

    {# ── Feed container (replaced by AJAX) ─────────────── #}
    <div class="feed-spinner" id="feed-spinner">Loading…</div>
    <div id="feed-container">
      {% include 'front/blog/_feed_items.html.twig' with {
        feed: feed,
        authorMap: authorMap,
        reactionSummary: reactionSummary,
        userReactions: userReactions,
        storyReactionSummary: storyReactionSummary,
        storyUserReactions: storyUserReactions,
        storyComments: storyComments,
        savedPostIds: savedPostIds,
        currentUserId: currentUserId,
      } %}
    </div>
  </main>

  <aside class="tg-right">
    <div class="rcard">
      <h4>Requests <span class="rpill">2</span></h4>
      <p class="placeholder-text">(placeholder)</p>
    </div>

    <div class="rcard">
      <h4>Suggestions for you</h4>
      {% set sugColors = [
        'linear-gradient(135deg,#f59e0b,#ef4444)',
        'linear-gradient(135deg,#10b981,#3b82f6)',
        'linear-gradient(135deg,#a855f7,#ec4899)'
      ] %}
      {% set seen = [] %}
      {% for item in feed %}
        {% set uid = item.entity.userId %}
        {% if uid not in seen and seen|length < 3 %}
          {% set seen = seen|merge([uid]) %}
          {% set sName = authorMap[uid] ?? 'User #' ~ uid %}
          {% set isFollowingSug = followingLookup[uid] is defined and followingLookup[uid] %}
          <div class="sug-row">
            <div class="sug-av" style="background:{{ sugColors[loop.index0 % 3] }};">
              {{ sName|first|upper }}
            </div>
            <div>
              <div class="sug-name">
                <a class="sug-name-link" href="{{ path('blog_user_profile', {id: uid}) }}">{{ sName }}</a>
              </div>
              <div class="sug-handle">@user{{ uid }}</div>
            </div>
            {% if app.user %}
              <button
                class="flw-btn {{ isFollowingSug ? 'following' : '' }}"
                data-follow-url="{{ path('follow_toggle', {id: uid}) }}"
                data-csrf-token="{{ csrf_token('follow_' ~ uid) }}"
                onclick="toggleSuggestionFollow(this)">
                {{ isFollowingSug ? 'Following' : 'Follow' }}
              </button>
            {% else %}
              <a class="flw-btn" href="{{ path('app_login') }}">Follow</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <p class="placeholder-text">(placeholder)</p>
      {% endfor %}
    </div>
  </aside>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>

