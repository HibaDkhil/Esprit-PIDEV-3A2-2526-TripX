async function captureStoryFromCamera() {
  if (_storyCameraCaptureBusy) return;
  const video = document.getElementById('story-camera-video');
  if (!video || !video.videoWidth || !video.videoHeight) {
    setStoryCameraMessage('Camera is not ready yet', true);
    return;
  }

  _storyCameraCaptureBusy = true;
  const captureBtn = document.getElementById('story-camera-capture');
  if (captureBtn) captureBtn.disabled = true;

  try {
    const sw = video.videoWidth;
    const sh = video.videoHeight;
    const targetRatio = 9 / 16;
    let sx = 0;
    let sy = 0;
    let sWidth = sw;
    let sHeight = sh;

    if (sw / sh > targetRatio) {
      sWidth = Math.floor(sh * targetRatio);
      sx = Math.floor((sw - sWidth) / 2);
    } else {
      sHeight = Math.floor(sw / targetRatio);
      sy = Math.floor((sh - sHeight) / 2);
    }

    const canvas = document.createElement('canvas');
    canvas.width = 1080;
    canvas.height = 1920;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas unavailable');

    ctx.save();
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    const camFilter = getCameraFilterFromPreset(_storyCameraActiveFilter);
    ctx.filter = camFilter.css;
    ctx.drawImage(video, sx, sy, sWidth, sHeight, 0, 0, canvas.width, canvas.height);
    ctx.filter = 'none';
    ctx.restore();

    if (camFilter.fade > 0) {
      ctx.fillStyle = `rgba(255,255,255,${camFilter.fade})`;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
    if (!blob) throw new Error('Capture failed');

    await closeStoryCameraModal();
    openStoryEditor(blob);
  } catch (err) {
    console.error(err);
    setStoryCameraMessage('Could not capture photo. Try again.', true);
  } finally {
    _storyCameraCaptureBusy = false;
    if (captureBtn) captureBtn.disabled = false;
  }
}

function normalizeCountryKey(value) {
  return (value || '')
    .toString()
    .trim()
    .toLowerCase()
    .replace(/\s+/g, ' ');
}

function extractCandidateCountry(raw) {
  const value = (raw || '').trim();
  if (!value) return '';

  if (value.includes(',')) {
    const parts = value.split(',').map(p => p.trim()).filter(Boolean);
    if (parts.length) return parts[parts.length - 1];
  }

  return value;
}

async function getCountryFlagsMap() {
  if (_countryFlagsMap) return _countryFlagsMap;
  if (_countryFlagsPromise) return _countryFlagsPromise;

  _countryFlagsPromise = fetch('https://restcountries.com/v3.1/all?fields=name,altSpellings,cca2,cca3,flags')
    .then(r => {
      if (!r.ok) throw new Error('flags fetch failed');
      return r.json();
    })
    .then(rows => {
      const map = new Map();

      rows.forEach(country => {
        if (!country || !country.name || !country.name.common || !country.flags) return;
        const flagUrl = country.flags.svg || country.flags.png;
        if (!flagUrl) return;

        const keys = [
          country.name.common,
          country.name.official,
          country.cca2,
          country.cca3,
          ...(Array.isArray(country.altSpellings) ? country.altSpellings : [])
        ].filter(Boolean);

        keys.forEach(k => {
          map.set(normalizeCountryKey(k), flagUrl);
        });
      });

      _countryFlagsMap = map;
      return map;
    })
    .catch(() => {
      _countryFlagsMap = new Map();
      return _countryFlagsMap;
    })
    .finally(() => {
      _countryFlagsPromise = null;
    });

  return _countryFlagsPromise;
}

async function hydrateDestinationFlags(root = document) {
  const nodes = root.querySelectorAll('.ts-destination');
  if (!nodes.length) return;

  const flagsMap = await getCountryFlagsMap();
  if (!flagsMap.size) return;

  nodes.forEach(node => {
    if (node.dataset.flagHydrated === '1') return;

    const textNode = node.querySelector('.ts-destination-text') || node;
    const destinationText = (textNode.textContent || '').trim();
    const candidate = extractCandidateCountry(destinationText);
    const flagUrl = flagsMap.get(normalizeCountryKey(candidate));
    if (!flagUrl) return;

    const img = document.createElement('img');
    img.className = 'ts-destination-flag';
    img.alt = `${candidate} flag`;
    img.src = flagUrl;
    img.loading = 'lazy';

    textNode.textContent = '';
    textNode.appendChild(img);
    textNode.appendChild(document.createTextNode(candidate));
    node.dataset.flagHydrated = '1';
  });
}

function feedFilter(e, type) {
  if (e) e.preventDefault();
  _currentType = type;
  loadFeed();
  document.querySelectorAll('#type-pills .tpill').forEach(el => {
    el.classList.toggle('active', el.dataset.type === type);
  });
  document.querySelectorAll('.sidebar-nav .snav-item[data-filter-type]').forEach(el => {
    el.classList.toggle('active', el.dataset.filterType === type);
  });
  return false;
}

function loadFeed() {
  if (_ajaxCtrl) _ajaxCtrl.abort();
  _ajaxCtrl = new AbortController();

  const params = new URLSearchParams();
  if (_currentSearch) params.set('q', _currentSearch);
  if (_currentType)   params.set('type', _currentType);

  const container = document.getElementById('feed-container');
  const spinner   = document.getElementById('feed-spinner');
  container.classList.add('loading');
  spinner.classList.add('visible');

  const newUrl = '{{ path('blog') }}' + (params.toString() ? '?' + params : '');
  history.replaceState(null, '', newUrl);

  fetch('{{ path('blog_filter') }}?' + params.toString(), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    signal: _ajaxCtrl.signal,
  })
    .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
    .then(html => {
      container.innerHTML = html;
      container.classList.remove('loading');
      spinner.classList.remove('visible');
      hydrateUserNames();
      hydrateDestinationFlags(container);
    })
    .catch(err => {
      if (err.name === 'AbortError') return;
      console.error('Feed load error', err);
      container.classList.remove('loading');
      spinner.classList.remove('visible');
    });
}

document.getElementById('feed-search-btn').addEventListener('click', () => {
  _currentSearch = document.getElementById('feed-search').value.trim();
  loadFeed();
});
document.getElementById('feed-search').addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();
    _currentSearch = e.target.value.trim();
    loadFeed();
  }
});

