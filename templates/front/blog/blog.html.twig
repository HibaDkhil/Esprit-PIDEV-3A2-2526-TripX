{% set savedPostIds  = savedPostIds  is defined ? savedPostIds  : [] %}
{% set currentUserId = currentUserId is defined ? currentUserId : null %}
{% set reactionSummary = reactionSummary is defined ? reactionSummary : {} %}
{% set feed = feed is defined ? feed : [] %}
{% set userReactions = userReactions is defined ? userReactions : {} %}
{% set ownerPostCount = ownerPostCount is defined ? ownerPostCount : 0 %}
{% set ownerStoryCount = ownerStoryCount is defined ? ownerStoryCount : 0 %}
{% set ownerFollowersCount = ownerFollowersCount is defined ? ownerFollowersCount : 0 %}
{% set ownerFollowingCount = ownerFollowingCount is defined ? ownerFollowingCount : 0 %}
{% set ownerTotalContentCount = ownerPostCount + ownerStoryCount %}
{% set storiesByUser  = storiesByUser  is defined ? storiesByUser  : [] %}
{% set followingLookup = followingLookup is defined ? followingLookup : {} %}

{% set me = app.user %}

<div class="tg-shell">

  <aside class="tg-left">
    <div class="profile-card">
      {% if me %}
        <div class="profile-avatar">{{ me.firstName|first|upper }}</div>
        <a href="{{ path('blog_user_profile', {id: me.id}) }}" class="profile-name profile-name-link">{{ me.firstName }} {{ me.lastName }}</a>
        <div class="profile-handle">@user{{ me.id }}</div>
      {% else %}
        <div class="profile-avatar">?</div>
        <div class="profile-name">Traveller</div>
        <div class="profile-handle">@guest</div>
      {% endif %}
      <div class="profile-stats">
        <div class="pstat"><span class="pstat-num">{{ ownerTotalContentCount }}</span><span class="pstat-lbl">Posts</span></div>
        <div class="pstat"><span class="pstat-num">{{ ownerFollowersCount }}</span><span class="pstat-lbl">Followers</span></div>
        <div class="pstat"><span class="pstat-num">{{ ownerFollowingCount }}</span><span class="pstat-lbl">Following</span></div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <a href="{{ path('blog', {type:'all'}) }}" class="snav-item {% if typeFilter == 'all' %}active{% endif %}"
         data-filter-type="all" onclick="return feedFilter(event, 'all')">
        <span class="snav-icon">🏠</span> All
      </a>
      <a href="{{ path('blog', {type:'my_posts'}) }}" class="snav-item {% if typeFilter == 'my_posts' %}active{% endif %}"
        data-filter-type="my_posts" onclick="return feedFilter(event, 'my_posts')">
        <span class="snav-icon">📝</span> My Posts
      </a>
      <a href="{{ path('blog', {type:'my_travel_story'}) }}" class="snav-item {% if typeFilter == 'my_travel_story' %}active{% endif %}"
         data-filter-type="my_travel_story" onclick="return feedFilter(event, 'my_travel_story')">
        <span class="snav-icon">🧳</span> My Travel Stories
      </a>
      <a href="{{ path('blog_saved') }}" class="snav-item">
        <span class="snav-icon">🔖</span> Saved Posts
      </a>
     
    </nav>
  </aside>

  <main class="tg-center">
    {# ── Search bar (AJAX-driven) ──────────────────────── #}
    <div class="feed-topbar">
      <div class="search-wrap">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input type="text" id="feed-search" value="{{ search }}" placeholder="Search posts or stories…">
      </div>

      <button type="button" class="search-btn" id="feed-search-btn">Search</button>

      <div class="feed-topbar-actions">
        <a href="{{ path('post_create') }}" class="create-btn">+ Create new post</a>
        <a href="{{ path('travel_story_new') }}" class="create-btn">+ Create Travel Story</a>
      </div>
    </div>

    {# ── Type pills (AJAX-driven) ──────────────────────── #}
    <div class="type-pills" id="type-pills">
      <a href="#" class="tpill {% if typeFilter == 'all' %}active{% endif %}"
        data-type="all" onclick="return feedFilter(event, 'all')">All</a>
      <a href="#" class="tpill {% if typeFilter == 'posts' %}active{% endif %}"
        data-type="posts" onclick="return feedFilter(event, 'posts')">Posts</a>
      <a href="#" class="tpill {% if typeFilter == 'travel_story' %}active{% endif %}"
         data-type="travel_story" onclick="return feedFilter(event, 'travel_story')">🧳 Travel Stories</a>
    </div>

    {# ── Stories row ───────────────────────────────────── #}
    <div class="stories-card">
      <div class="stories-head">
        <h3>Stories</h3>
        <div class="stories-head-actions">
          <button type="button" class="live-head-btn" id="live-start-btn">Go Live</button>
          <a href="#" class="watch-all" onclick="return openFirstStory(event)">Watch all</a>
        </div>
      </div>
      <div class="stories-row" id="stories-row">
        <div class="story-bbl" title="Add a story">
          <button type="button" class="story-ring add-ring" id="story-add-btn" aria-label="Add story">
            <div class="story-inner add-in">+</div>
          </button>
          <span class="story-lbl">Add</span>
        </div>
        {% for s in storiesByUser %}
          <div class="story-bbl">
            <button type="button" class="story-ring js-story-open {% if s.hasUnseen %}is-unseen{% else %}is-seen{% endif %}"
                    data-user-id="{{ s.userId }}"
                    data-user-name="{{ s.userName|e('html_attr') }}"
                    data-has-unseen="{{ s.hasUnseen ? '1' : '0' }}"
                    data-stories="{{ s.stories|json_encode|e('html_attr') }}"
                    aria-label="Open story of {{ s.userName }}">
              <div class="story-inner">{{ s.userName|first|upper }}</div>
            </button>
            <span class="story-lbl">{{ s.userName|split(' ')|first }}</span>
          </div>
        {% else %}
          <span class="story-lbl" style="color:#9ca3af;">No stories yet</span>
        {% endfor %}
      </div>
    </div>

    <form id="story-upload-form" enctype="multipart/form-data" style="display:none;">
      <input type="file" id="story-image-input" name="story_image" accept="image/*">
      <input type="hidden" id="story-caption-input" name="caption" value="">
    </form>

    <div class="story-source-sheet" id="story-source-sheet" aria-hidden="true">
      <div class="story-source-card" role="dialog" aria-modal="true" aria-labelledby="story-source-title">
        <div class="story-source-head">
          <h3 class="story-source-title" id="story-source-title">Create Story</h3>
          <p class="story-source-sub">Instagram style: choose camera or pick from your gallery.</p>
        </div>
        <div class="story-source-actions">
          <button type="button" class="story-source-btn" id="story-source-camera">
            <div>
              <strong>Use camera</strong>
              <span>Live preview filters before capture</span>
            </div>
            <span class="ico">📷</span>
          </button>
          <button type="button" class="story-source-btn" id="story-source-gallery">
            <div>
              <strong>Choose from gallery</strong>
              <span>Upload then edit with filters & crop</span>
            </div>
            <span class="ico">🖼️</span>
          </button>
        </div>
        <button type="button" class="story-source-cancel" id="story-source-cancel">Cancel</button>
      </div>
    </div>

    <div class="story-camera-modal" id="story-camera-modal" aria-hidden="true">
      <div class="story-camera-card" role="dialog" aria-modal="true" aria-labelledby="story-camera-title">
        <div class="story-camera-head">
          <h3 class="story-camera-title" id="story-camera-title">Story camera</h3>
          <button type="button" class="story-camera-x" id="story-camera-close" aria-label="Close camera">&times;</button>
        </div>
        <div class="story-camera-stage">
          <video id="story-camera-video" class="story-camera-video" autoplay playsinline muted></video>
          <canvas id="story-camera-gesture-canvas" class="story-camera-gesture-canvas"></canvas>
          <div class="story-camera-overlay"></div>
          <div class="story-camera-gesture-guide" id="story-camera-gesture-guide">
            <h4>Hand controls</h4>
            <p>Move hand left: next filter</p>
            <p>Move hand right: previous filter</p>
            <p>Move hand up: remove filter</p>
            <p>Raise index finger: capture photo</p>
            <p>Pinch in/out: zoom preview</p>
            <button type="button" id="story-camera-gesture-guide-close">Got it</button>
          </div>
          <div class="story-camera-msg" id="story-camera-msg"></div>
        </div>
        <div class="story-camera-foot">
          <div class="story-camera-filters" id="story-camera-filters">
            <button type="button" class="story-camera-fchip active" data-cam-filter="normal">Normal</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="vivid">Vivid</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="golden">Golden</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="noir">Noir</button>
            <button type="button" class="story-camera-fchip" data-cam-filter="cool">Cool</button>
          </div>
          <div class="story-camera-gesture-tune" id="story-camera-gesture-tune" aria-label="Gesture sensitivity">
            <span class="lbl">Gesture sensitivity</span>
            <button type="button" class="story-camera-tune-btn" data-gesture-sense="low">Low</button>
            <button type="button" class="story-camera-tune-btn active" data-gesture-sense="medium">Medium</button>
            <button type="button" class="story-camera-tune-btn" data-gesture-sense="high">High</button>
          </div>
          <div class="story-camera-controls">
            <button type="button" class="story-camera-side" id="story-camera-switch">Switch</button>
            <button type="button" class="story-camera-capture" id="story-camera-capture" aria-label="Capture photo"></button>
            <button type="button" class="story-camera-side" id="story-camera-retake">Retake</button>
          </div>
        </div>
      </div>
    </div>

    <div class="story-editor-modal" id="story-editor-modal" aria-hidden="true">
      <div class="story-editor-card" role="dialog" aria-modal="true" aria-labelledby="story-editor-title">
        <div class="story-editor-head">
          <h3 class="story-editor-title" id="story-editor-title">Create story</h3>
          <button type="button" class="story-editor-close" id="story-editor-close" aria-label="Close editor">&times;</button>
        </div>
        <div class="story-editor-body">
          <div class="story-editor-stage">
            <img id="story-editor-preview" src="" alt="Story preview">
          </div>
          <div class="story-editor-panel">
            <div class="story-editor-group">
              <label class="story-editor-label">Instagram style filters</label>
              <div class="story-filter-row" id="story-filter-row">
                <button type="button" class="story-filter-btn active" data-filter="normal">Normal</button>
                <button type="button" class="story-filter-btn" data-filter="vivid">Vivid</button>
                <button type="button" class="story-filter-btn" data-filter="golden">Golden</button>
                <button type="button" class="story-filter-btn" data-filter="noir">Noir</button>
                <button type="button" class="story-filter-btn" data-filter="cool">Cool</button>
              </div>
            </div>

            <div class="story-editor-group">
              <label class="story-editor-label">Adjustments</label>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Brightness</span><span id="adj-brightness-val">100</span></div>
                <input type="range" class="story-slider" id="adj-brightness" min="60" max="160" value="100">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Contrast</span><span id="adj-contrast-val">100</span></div>
                <input type="range" class="story-slider" id="adj-contrast" min="60" max="170" value="100">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Saturation</span><span id="adj-saturation-val">100</span></div>
                <input type="range" class="story-slider" id="adj-saturation" min="0" max="180" value="100">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Warmth</span><span id="adj-warmth-val">0</span></div>
                <input type="range" class="story-slider" id="adj-warmth" min="-30" max="30" value="0">
              </div>
              <div class="story-adjust-row">
                <div class="story-adjust-head"><span>Fade</span><span id="adj-fade-val">0</span></div>
                <input type="range" class="story-slider" id="adj-fade" min="0" max="45" value="0">
              </div>
            </div>

            <div class="story-editor-group">
              <label class="story-editor-label">Tools</label>
              <div class="story-editor-tools">
                <button type="button" class="story-tool-btn" id="story-rotate-left">Rotate left</button>
                <button type="button" class="story-tool-btn" id="story-rotate-right">Rotate right</button>
                <button type="button" class="story-tool-btn" id="story-reset">Reset</button>
              </div>
            </div>

            <div class="story-editor-group">
              <label for="story-editor-caption" class="story-editor-label">Caption</label>
              <textarea id="story-editor-caption" class="story-editor-caption" placeholder="Write a caption..."></textarea>
            </div>

            <div class="story-editor-actions">
              <button type="button" class="story-editor-btn secondary" id="story-editor-cancel">Cancel</button>
              <button type="button" class="story-editor-btn primary" id="story-editor-publish">Share story</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="ig-story-modal" id="ig-story-modal" aria-hidden="true">
      <div class="ig-story-frame">
        <div class="ig-story-bars" id="ig-story-bars"></div>
        <div class="ig-story-head">
          <div class="ig-story-author">
            <div class="av" id="ig-story-author-av">U</div>
            <div>
              <div class="nm" id="ig-story-author-name">User</div>
              <div class="tm" id="ig-story-time">now</div>
            </div>
          </div>
          <button class="ig-story-close" type="button" id="ig-story-close" aria-label="Close">&times;</button>
        </div>
        <img id="ig-story-image" class="ig-story-image" src="" alt="Story">
        <div class="ig-story-removed-panel" id="ig-story-removed-panel" style="display:none;">
          <h4>Story removed by admin</h4>
          <p>This story was removed because it violated our community guidelines.</p>
          <p class="ig-story-removed-reason" id="ig-story-removed-reason" style="display:none;"></p>
          <div class="ig-story-removed-actions">
            <button type="button" class="ig-story-removed-btn primary" id="ig-story-removed-ok">OK</button>
            <button type="button" class="ig-story-removed-btn secondary" id="ig-story-removed-reason-btn">View reason / Learn more</button>
          </div>
        </div>
        <div class="ig-story-caption" id="ig-story-caption" style="display:none;"></div>
        <button class="ig-story-seen-trigger" id="ig-story-seen-trigger" type="button" style="display:none;">
          <span class="eye">&#128065;</span>
          <span id="ig-story-seen-count">Seen by 0</span>
        </button>
        <div class="ig-story-viewers-sheet" id="ig-story-viewers-sheet" aria-hidden="true">
          <div class="ig-story-viewers-handle"></div>
          <div class="ig-story-viewers-head">
            <span id="ig-story-viewers-title">Seen by</span>
            <button class="ig-story-viewers-close" id="ig-story-viewers-close" type="button" aria-label="Close viewers">&times;</button>
          </div>
          <div class="ig-story-viewers-list" id="ig-story-viewers-list"></div>
        </div>
        <button class="ig-story-hit left" type="button" id="ig-story-prev" aria-label="Previous"></button>
        <button class="ig-story-hit right" type="button" id="ig-story-next" aria-label="Next"></button>
      </div>
    </div>

    <div class="live-modal" id="live-modal" aria-hidden="true">
      <div class="live-dialog" role="dialog" aria-modal="true" aria-labelledby="live-title-label">
        <div class="live-stage">
          <video id="live-local-video" class="live-local-video" autoplay playsinline muted></video>
          <div class="live-video-placeholder" id="live-video-placeholder">
            <div class="inner">
              <div id="live-title-label">Live stream</div>
              <div style="margin-top:4px;font-size:.78rem;opacity:.85;" id="live-stage-sub">Waiting for host video</div>
            </div>
          </div>
          <div class="live-head-overlay">
            <div class="live-head-main">
              <div class="av" id="live-host-av">U</div>
              <div>
                <div class="nm" id="live-host-name">Host</div>
                <div class="meta" id="live-meta-line">0 watching · 0 reactions</div>
              </div>
              <span class="live-pill">LIVE</span>
            </div>
            <button type="button" class="live-close-btn" id="live-close-btn" aria-label="Close live">&times;</button>
          </div>
          <div class="live-reaction-burst" id="live-reaction-burst"></div>
        </div>
        <aside class="live-side">
          <div class="live-side-head">
            <h4>Live chat</h4>
            <p id="live-status-line">Connected</p>
          </div>
          <div class="live-comments" id="live-comments"></div>
          <form class="live-comment-form" id="live-comment-form">
            <div class="live-rxn-row" id="live-rxn-row">
              <button type="button" class="live-rxn-btn" data-live-rxn="like">👍 Like</button>
              <button type="button" class="live-rxn-btn" data-live-rxn="love">❤️ Love</button>
              <button type="button" class="live-rxn-btn" data-live-rxn="fire">🔥 Fire</button>
              <button type="button" class="live-rxn-btn" data-live-rxn="wow">😮 Wow</button>
              <button type="button" class="live-rxn-btn" data-live-rxn="clap">👏 Clap</button>
            </div>
            <div class="live-filter-controls" id="live-filter-controls" style="display:none;">
              <div class="live-filter-presets" id="live-filter-presets">
                <button type="button" class="live-filter-chip active" data-live-filter-preset="normal">Normal</button>
                <button type="button" class="live-filter-chip" data-live-filter-preset="cinematic">Cinematic</button>
                <button type="button" class="live-filter-chip" data-live-filter-preset="vivid">Vivid</button>
                <button type="button" class="live-filter-chip" data-live-filter-preset="warm">Warm</button>
                <button type="button" class="live-filter-chip" data-live-filter-preset="noir">Noir</button>
              </div>
              <div class="live-filter-grid">
                <label class="live-filter-item">Brightness
                  <input id="live-filter-brightness" type="range" min="-100" max="100" step="1" value="0">
                </label>
                <label class="live-filter-item">Contrast
                  <input id="live-filter-contrast" type="range" min="20" max="200" step="1" value="100">
                </label>
                <label class="live-filter-item">Saturation
                  <input id="live-filter-saturation" type="range" min="0" max="200" step="1" value="100">
                </label>
                <label class="live-filter-item">Blur
                  <input id="live-filter-blur" type="range" min="0" max="6" step="0.1" value="0">
                </label>
              </div>
              <button type="button" class="live-filter-reset" id="live-filter-reset">Reset filters</button>
            </div>
            <div class="live-input-row">
              <input type="text" id="live-comment-input" maxlength="800" placeholder="Add a comment...">
              <button type="submit">Send</button>
            </div>
            <div class="live-actions">
              <button type="button" class="end" id="live-end-btn" style="display:none;">End Live</button>
              <button type="button" class="leave" id="live-leave-btn">Leave</button>
            </div>
          </form>
        </aside>
      </div>
    </div>

    <div class="live-edit-modal" id="live-edit-modal" aria-hidden="true">
      <div class="live-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="live-edit-title">
        <div class="live-edit-head">
          <h4 id="live-edit-title">Edit Live Replay Before Saving</h4>
          <button type="button" class="live-edit-close" id="live-edit-close" aria-label="Close">&times;</button>
        </div>
        <video id="live-edit-preview" class="live-edit-preview" controls playsinline></video>
        <div class="live-edit-controls">
          <div class="live-edit-row">
            <label for="live-edit-start">Trim start</label>
            <input id="live-edit-start" type="range" min="0" max="0" step="0.1" value="0">
          </div>
          <div class="live-edit-row">
            <label for="live-edit-end">Trim end</label>
            <input id="live-edit-end" type="range" min="0" max="0" step="0.1" value="0">
          </div>
          <div class="live-edit-row">
            <label for="live-edit-brightness">Brightness</label>
            <input id="live-edit-brightness" type="range" min="-100" max="100" step="1" value="0">
          </div>
          <div class="live-edit-row">
            <label for="live-edit-contrast">Contrast</label>
            <input id="live-edit-contrast" type="range" min="0" max="200" step="1" value="100">
          </div>
          <div class="live-edit-row">
            <label for="live-edit-saturation">Saturation</label>
            <input id="live-edit-saturation" type="range" min="0" max="200" step="1" value="100">
          </div>
          <div class="live-edit-row">
            <label for="live-edit-blur">Blur</label>
            <input id="live-edit-blur" type="range" min="0" max="10" step="1" value="0">
          </div>
          <div class="live-edit-row">
            <button type="button" class="cancel" id="live-edit-reset-filters" style="width:max-content;">Reset filters</button>
          </div>
          <div class="live-edit-row">
            <label>Presets</label>
            <div class="live-edit-presets" id="live-edit-presets">
              <button type="button" class="live-edit-preset active" data-live-preset="normal">Normal</button>
              <button type="button" class="live-edit-preset" data-live-preset="cinematic">Cinematic</button>
              <button type="button" class="live-edit-preset" data-live-preset="vivid">Vivid</button>
              <button type="button" class="live-edit-preset" data-live-preset="warm">Warm</button>
              <button type="button" class="live-edit-preset" data-live-preset="noir">Noir</button>
            </div>
          </div>
          <div class="live-edit-time" id="live-edit-time">0:00 - 0:00</div>
          <div class="live-edit-progress" id="live-edit-progress"><div class="live-edit-progress-bar" id="live-edit-progress-bar"></div></div>
          <div class="live-edit-status" id="live-edit-status"></div>
        </div>
        <div class="live-edit-actions">
          <button type="button" class="cancel" id="live-edit-cancel">Cancel Save</button>
          <button type="button" class="save" id="live-edit-save">Save Edited Replay</button>
        </div>
      </div>
    </div>

    <div class="ts-map-modal" id="ts-map-modal" aria-hidden="true">
      <div class="ts-map-dialog" role="dialog" aria-modal="true" aria-labelledby="ts-map-title">
        <div class="ts-map-head">
          <div class="ts-map-title" id="ts-map-title">Destination map</div>
          <button type="button" class="ts-map-close" id="ts-map-close" aria-label="Close map">&times;</button>
        </div>
        <p class="ts-map-status" id="ts-map-status">Click a destination tag to load its map.</p>
        <div class="ts-map-canvas" id="ts-map-canvas"></div>
      </div>
    </div>

    {# ── Feed container (replaced by AJAX) ─────────────── #}
    <div class="feed-spinner" id="feed-spinner">Loading…</div>
    <div id="feed-container">
      {% include 'front/blog/_feed_items.html.twig' with {
        feed: feed,
        authorMap: authorMap,
        reactionSummary: reactionSummary,
        userReactions: userReactions,
        storyReactionSummary: storyReactionSummary,
        storyUserReactions: storyUserReactions,
        storyComments: storyComments,
        savedPostIds: savedPostIds,
        currentUserId: currentUserId,
      } %}
    </div>
  </main>

  <aside class="tg-right">
    <div class="rcard">
      <h4>Requests <span class="rpill">2</span></h4>
      <p class="placeholder-text">(placeholder)</p>
    </div>

    <div class="rcard">
      <h4>Suggestions for you</h4>
      {% set sugColors = [
        'linear-gradient(135deg,#f59e0b,#ef4444)',
        'linear-gradient(135deg,#10b981,#3b82f6)',
        'linear-gradient(135deg,#a855f7,#ec4899)'
      ] %}
      {% set seen = [] %}
      {% for item in feed %}
        {% set uid = item.entity.userId %}
        {% if uid not in seen and seen|length < 3 %}
          {% set seen = seen|merge([uid]) %}
          {% set sName = authorMap[uid] ?? 'User #' ~ uid %}
          {% set isFollowingSug = followingLookup[uid] is defined and followingLookup[uid] %}
          <div class="sug-row">
            <div class="sug-av" style="background:{{ sugColors[loop.index0 % 3] }};">
              {{ sName|first|upper }}
            </div>
            <div>
              <div class="sug-name">
                <a class="sug-name-link" href="{{ path('blog_user_profile', {id: uid}) }}">{{ sName }}</a>
              </div>
              <div class="sug-handle">@user{{ uid }}</div>
            </div>
            {% if app.user %}
              <button
                class="flw-btn {{ isFollowingSug ? 'following' : '' }}"
                data-follow-url="{{ path('follow_toggle', {id: uid}) }}"
                data-csrf-token="{{ csrf_token('follow_' ~ uid) }}"
                onclick="toggleSuggestionFollow(this)">
                {{ isFollowingSug ? 'Following' : 'Follow' }}
              </button>
            {% else %}
              <a class="flw-btn" href="{{ path('app_login') }}">Follow</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <p class="placeholder-text">(placeholder)</p>
      {% endfor %}
    </div>
  </aside>

</div>

