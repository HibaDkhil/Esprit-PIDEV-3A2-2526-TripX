    storiesRow.addEventListener('click', async event => {
      const btn = event.target.closest('[data-live-open-id]');
      if (!btn) return;
      const sid = Number(btn.dataset.liveOpenId || 0);
      if (!sid) return;
      const host = btn.dataset.liveHost === '1';
      await openLiveModal(sid, host);
    });
  }
  if (liveCloseBtn) {
    liveCloseBtn.addEventListener('click', () => closeLiveModal(true));
  }
  if (liveLeaveBtn) {
    liveLeaveBtn.addEventListener('click', () => closeLiveModal(true));
  }
  if (liveEndBtn) {
    liveEndBtn.addEventListener('click', endLiveSession);
  }
  if (liveCommentForm) {
    liveCommentForm.addEventListener('submit', submitLiveComment);
  }
  document.querySelectorAll('#live-rxn-row [data-live-rxn]').forEach(btn => {
    btn.addEventListener('click', () => {
      sendLiveReaction(btn.dataset.liveRxn || '');
    });
  });
  if (liveModal) {
    liveModal.addEventListener('click', event => {
      if (event.target === liveModal) {
        closeLiveModal(true);
      }
    });
  }

  if (sourceGalleryBtn) {
    sourceGalleryBtn.addEventListener('click', () => {
      closeStorySourceSheet();
      fileInput?.click();
    });
  }
  if (sourceCameraBtn) {
    sourceCameraBtn.addEventListener('click', () => {
      openStoryCameraModal();
    });
  }
  if (sourceCancelBtn) {
    sourceCancelBtn.addEventListener('click', closeStorySourceSheet);
  }
  if (sourceSheet) {
    sourceSheet.addEventListener('click', (event) => {
      if (event.target === sourceSheet) closeStorySourceSheet();
    });
  }

  if (storyCameraClose) {
    storyCameraClose.addEventListener('click', closeStoryCameraModal);
  }
  if (storyCameraSwitch) {
    storyCameraSwitch.addEventListener('click', switchStoryCameraFacing);
  }
  if (storyCameraRetake) {
    storyCameraRetake.addEventListener('click', () => {
      startStoryCameraStream();
    });
  }
  if (storyCameraCapture) {
    storyCameraCapture.addEventListener('click', captureStoryFromCamera);
  }
  document.getElementById('story-camera-gesture-guide-close')?.addEventListener('click', () => {
    hideStoryGestureGuide(true);
  });
  if (storyCameraModal) {
    storyCameraModal.addEventListener('click', event => {
      if (event.target === storyCameraModal) {
        closeStoryCameraModal();
      }
    });
  }

  document.querySelectorAll('#story-camera-filters .story-camera-fchip').forEach(btn => {
    btn.addEventListener('click', () => {
      _storyCameraActiveFilter = btn.dataset.camFilter || 'normal';
      setActiveCameraFilterChip();
      applyCameraPreviewFilter();
    });
  });

  document.querySelectorAll('#story-camera-gesture-tune .story-camera-tune-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setGestureSensitivity(btn.dataset.gestureSense || 'medium');
    });
  });

  if (storyEditorClose) {
    storyEditorClose.addEventListener('click', closeStoryEditor);
  }
  if (storyEditorCancel) {
    storyEditorCancel.addEventListener('click', closeStoryEditor);
  }
  if (storyEditorPublish) {
    storyEditorPublish.addEventListener('click', uploadStoryFromEditor);
  }
  if (storyEditorModal) {
    storyEditorModal.addEventListener('click', event => {
      if (event.target === storyEditorModal) {
        closeStoryEditor();
      }
    });
  }

  document.querySelectorAll('#story-filter-row .story-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      _storyActivePreset = btn.dataset.filter || 'normal';
      setActiveStoryFilterButton();
      applyStoryPreviewFilter();
    });
  });

  [
    ['adj-brightness', 'brightness', 'adj-brightness-val'],
    ['adj-contrast', 'contrast', 'adj-contrast-val'],
    ['adj-saturation', 'saturation', 'adj-saturation-val'],
    ['adj-warmth', 'warmth', 'adj-warmth-val'],
    ['adj-fade', 'fade', 'adj-fade-val'],
  ].forEach(([id, key, valueId]) => {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener('input', () => {
      _storyAdjustments[key] = Number(input.value);
      setStoryAdjustmentLabel(valueId, _storyAdjustments[key]);
      applyStoryPreviewFilter();
    });
  });

  document.getElementById('story-rotate-left')?.addEventListener('click', () => {
    if (_storyCropper) _storyCropper.rotate(-90);
    applyStoryPreviewFilter();
  });
  document.getElementById('story-rotate-right')?.addEventListener('click', () => {
    if (_storyCropper) _storyCropper.rotate(90);
    applyStoryPreviewFilter();
  });
  document.getElementById('story-reset')?.addEventListener('click', () => {
    if (_storyCropper) _storyCropper.reset();
    _storyActivePreset = 'normal';
    resetStoryAdjustments();
    setActiveStoryFilterButton();
    applyStoryPreviewFilter();
  });

  document.querySelectorAll('.js-story-open').forEach(btn => {
    btn.addEventListener('click', () => {
      const raw = btn.dataset.stories || '[]';
      const stories = JSON.parse(raw);
      openStoryViewer(stories, btn.dataset.userName || 'User', btn);
    });
  });
});

function openFirstStory(e) {
  if (e) e.preventDefault();
  const first = document.querySelector('.js-story-open.is-unseen') || document.querySelector('.js-story-open');
  if (!first) return false;
  const stories = JSON.parse(first.dataset.stories || '[]');
  openStoryViewer(stories, first.dataset.userName || 'User', first);
  return false;
}

function openStoryViewer(stories, userName, sourceButton = null) {
  if (!Array.isArray(stories) || !stories.length) return;
  _activeStoryList = stories;
  _activeStoryIndex = 0;
  _activeStoryButton = sourceButton;
  _activeStoryOwnerId = sourceButton ? Number(sourceButton.dataset.userId || 0) : null;
  const modal = document.getElementById('ig-story-modal');
  if (!modal) return;
  document.getElementById('ig-story-author-name').textContent = userName;
  document.getElementById('ig-story-author-av').textContent = (userName || 'U').charAt(0).toUpperCase();
  modal.classList.add('open');
  renderStoryAt(_activeStoryIndex);

  document.getElementById('ig-story-close').onclick = closeStoryViewer;
  document.getElementById('ig-story-prev').onclick = () => moveStory(-1);
  document.getElementById('ig-story-next').onclick = () => moveStory(1);
  document.getElementById('ig-story-removed-ok').onclick = dismissRemovedStory;
  document.getElementById('ig-story-removed-reason-btn').onclick = toggleRemovedStoryReason;
}

function closeStoryViewer() {
  clearTimeout(_storyTimer);
  _storyTimer = null;
  closeStoryViewersSheet();
  _activeStoryButton = null;
  _activeStoryOwnerId = null;
  const modal = document.getElementById('ig-story-modal');
  if (modal) modal.classList.remove('open');
}

function isCurrentUsersStory() {
  return _currentUserId !== null && Number(_activeStoryOwnerId) === Number(_currentUserId);
}

function escapeHtml(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function closeStoryViewersSheet() {
  const sheet = document.getElementById('ig-story-viewers-sheet');
  if (sheet) {
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
  }
}

function openStoryViewersSheet() {
  const story = _activeStoryList[_activeStoryIndex];
  if (!story || !story.id || !isCurrentUsersStory()) return;

  fetchStoryViewers(story.id)
    .then(data => {
      const sheet = document.getElementById('ig-story-viewers-sheet');
      const title = document.getElementById('ig-story-viewers-title');
      if (!sheet || !title) return;

      renderStoryViewersList(data.viewers);
      title.textContent = `Seen by ${data.count}`;
      sheet.classList.add('open');
      sheet.setAttribute('aria-hidden', 'false');
    })
    .catch(() => {});
}

function renderStoryViewersList(viewers) {
  const list = document.getElementById('ig-story-viewers-list');
  if (!list) return;

  if (!Array.isArray(viewers) || viewers.length === 0) {
    list.innerHTML = '<div class="ig-story-viewers-empty">No views yet</div>';
    return;
  }

  list.innerHTML = viewers.map(v => {
    const nm = escapeHtml(v.name || 'User');
    const av = nm.charAt(0).toUpperCase() || 'U';
    const when = v.seenAt ? timeAgo(v.seenAt) : '';
    return `<div class="ig-story-viewer-row">
      <div class="ig-story-viewer-meta">
        <div class="ig-story-viewer-av">${av}</div>
        <div class="ig-story-viewer-name">${nm}</div>
      </div>
      <div class="ig-story-viewer-time">${escapeHtml(when)}</div>
    </div>`;
  }).join('');
}

async function fetchStoryViewers(storyId) {
  if (_storyViewersCache[storyId]) return _storyViewersCache[storyId];

  const url = _storyViewersUrlPattern.replace('/0/viewers', `/${storyId}/viewers`);
  const res = await fetch(url, {
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  });

  if (!res.ok) {
    throw new Error('Could not load viewers');
  }

  const json = await res.json();
  if (!json.ok) {
    throw new Error(json.message || 'Could not load viewers');
  }

  _storyViewersCache[storyId] = {
    count: Number(json.count || 0),
    viewers: Array.isArray(json.viewers) ? json.viewers : []
  };

  return _storyViewersCache[storyId];
}

async function updateSeenTriggerForStory(story) {
  const trigger = document.getElementById('ig-story-seen-trigger');
  const countEl = document.getElementById('ig-story-seen-count');
  if (!trigger || !countEl) return;

  if (!isCurrentUsersStory() || !story || !story.id) {
    trigger.style.display = 'none';
    closeStoryViewersSheet();
    return;
  }

  trigger.style.display = 'inline-flex';
  countEl.textContent = 'Seen by ...';

  try {
    const data = await fetchStoryViewers(story.id);
    countEl.textContent = `Seen by ${data.count}`;

    trigger.onclick = () => {
      openStoryViewersSheet();
    };
  } catch (_) {
    countEl.textContent = 'Seen by 0';
    trigger.onclick = null;
  }
}

function updateActiveStoryRingState() {
  if (!_activeStoryButton) return;
  const hasUnseen = _activeStoryList.some(story => !story.isSeenByMe && !story.removedByAdmin);
  _activeStoryButton.classList.toggle('is-unseen', hasUnseen);
  _activeStoryButton.classList.toggle('is-seen', !hasUnseen);
  _activeStoryButton.dataset.hasUnseen = hasUnseen ? '1' : '0';
}

function markStorySeen(storyId) {
  const parsedId = Number(storyId);
  if (!Number.isInteger(parsedId) || parsedId <= 0) return;

  const url = _storySeenUrlPattern.replace('/0/seen', `/${parsedId}/seen`);
  fetch(url, {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  }).catch(() => {});

  if (_activeStoryList[_activeStoryIndex]) {
    _activeStoryList[_activeStoryIndex].isSeenByMe = true;
    updateActiveStoryRingState();
  }
}

function toggleRemovedStoryReason() {
  const reasonEl = document.getElementById('ig-story-removed-reason');
  const btn = document.getElementById('ig-story-removed-reason-btn');
  if (!reasonEl || !btn) return;

  const isHidden = reasonEl.style.display === 'none' || reasonEl.style.display === '';
  reasonEl.style.display = isHidden ? 'block' : 'none';
  btn.textContent = isHidden ? 'Hide reason' : 'View reason / Learn more';
}

async function dismissRemovedStory() {
  const story = _activeStoryList[_activeStoryIndex];
  if (!story || !story.removedByAdmin || !story.id) {
    return;
  }

  const okBtn = document.getElementById('ig-story-removed-ok');
  if (okBtn) okBtn.disabled = true;

  try {
    const url = _storyDismissRemovedUrlPattern.replace('/0/dismiss-removed', `/${story.id}/dismiss-removed`);
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });

    const json = await res.json();
    if (!res.ok || !json.ok) {
      throw new Error(json.message || 'Could not remove moderated story');
    }

    const removedStoryId = Number(story.id);
    _activeStoryList.splice(_activeStoryIndex, 1);

    if (_activeStoryButton) {
      let buttonStories = [];
      try {
        buttonStories = JSON.parse(_activeStoryButton.dataset.stories || '[]');
      } catch (_) {
        buttonStories = [];
      }

      const filteredStories = buttonStories.filter(item => Number(item.id) !== removedStoryId);
      _activeStoryButton.dataset.stories = JSON.stringify(filteredStories);

      const hasUnseen = filteredStories.some(item => !item.isSeenByMe && !item.removedByAdmin);
      _activeStoryButton.classList.toggle('is-unseen', hasUnseen);
      _activeStoryButton.classList.toggle('is-seen', !hasUnseen);
      _activeStoryButton.dataset.hasUnseen = hasUnseen ? '1' : '0';

      if (!filteredStories.length) {
        _activeStoryButton.closest('.story-bbl')?.remove();
        closeStoryViewer();
        return;
      }
    }

    if (!_activeStoryList.length) {
      closeStoryViewer();
      return;
    }

    if (_activeStoryIndex >= _activeStoryList.length) {
      _activeStoryIndex = _activeStoryList.length - 1;
    }

    renderStoryAt(_activeStoryIndex);
  } catch (err) {
    if (typeof showToast === 'function') {
      showToast(err.message || 'Could not remove moderated story');
    }
    if (okBtn) okBtn.disabled = false;
  }
}

function moveStory(delta) {
  const next = _activeStoryIndex + delta;
  if (next < 0) { closeStoryViewer(); return; }
  if (next >= _activeStoryList.length) { closeStoryViewer(); return; }
  _activeStoryIndex = next;
  renderStoryAt(_activeStoryIndex);
}

function renderStoryAt(index) {
  clearTimeout(_storyTimer);
  const story = _activeStoryList[index];
  if (!story) return;

  const img = document.getElementById('ig-story-image');
  const cap = document.getElementById('ig-story-caption');
  const tm  = document.getElementById('ig-story-time');
  const bars = document.getElementById('ig-story-bars');
  const removedPanel = document.getElementById('ig-story-removed-panel');
  const removedReason = document.getElementById('ig-story-removed-reason');
  const removedReasonBtn = document.getElementById('ig-story-removed-reason-btn');
  const seenTrigger = document.getElementById('ig-story-seen-trigger');
  const isRemoved = Boolean(story.removedByAdmin);

  if (isRemoved) {
    img.style.display = 'none';
    img.src = '';
    cap.style.display = 'none';
    tm.textContent = story.removedAt ? `removed ${timeAgo(story.removedAt)}` : 'removed';
    closeStoryViewersSheet();
    if (seenTrigger) seenTrigger.style.display = 'none';

    if (removedPanel) {
      removedPanel.style.display = 'flex';
    }
    if (removedReason) {
      removedReason.textContent = story.removalReason || 'This story was removed because it violated our community guidelines.';
      removedReason.style.display = 'none';
    }
    if (removedReasonBtn) {
      removedReasonBtn.textContent = 'View reason / Learn more';
    }
  } else {
    img.style.display = '';
    img.src = story.imageUrl || '';
    cap.textContent = story.caption || '';
    cap.style.display = story.caption ? '' : 'none';
    tm.textContent = story.createdAt ? timeAgo(story.createdAt) : 'now';
    if (removedPanel) {
      removedPanel.style.display = 'none';
    }

    markStorySeen(story.id);
    updateSeenTriggerForStory(story);
  }

  bars.innerHTML = '';
  _activeStoryList.forEach((_, i) => {
    const bar = document.createElement('div');
    bar.className = 'ig-story-bar';
    const fill = document.createElement('span');
    if (i < index) fill.style.width = '100%';
    if (i === index && isRemoved) {
      fill.style.width = '100%';
    }
    if (i === index && !isRemoved) {
      fill.style.transition = `width ${_storyDurationMs}ms linear`;
      setTimeout(() => { fill.style.width = '100%'; }, 20);
    }
    bar.appendChild(fill);
    bars.appendChild(bar);
  });

  if (!isRemoved) {
    _storyTimer = setTimeout(() => {
      moveStory(1);
    }, _storyDurationMs + 50);
  }
}

function timeAgo(dateString) {
  const d = new Date(dateString);
  const sec = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
  if (sec < 60) return sec + 's';
  const min = Math.floor(sec / 60);
  if (min < 60) return min + 'm';
  const hr = Math.floor(min / 60);
  if (hr < 24) return hr + 'h';
  const day = Math.floor(hr / 24);
  return day + 'd';
}

function toggleC(id, btn) {
  const box = document.getElementById(id); if (!box) return;
  const isOpen = box.classList.toggle('open');
  const card = btn.closest('article'); if (!card) return;
  card.querySelectorAll('.vcbtn').forEach(b => { const m = b.textContent.match(/\((\d+)\)/); const n = m ? m[1] : 0; b.textContent = isOpen ? `Hide comments (${n})` : `View comments (${n})`; });
}

function toggleEditForm(id) {
  const form = document.getElementById(id); if (!form) return;
  form.classList.toggle('open');
  if (form.classList.contains('open')) { const ta = form.querySelector('textarea'); if (ta) { ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); } }
}

function toggleReplyForm(id) {
  const form = document.getElementById(id); if (!form) return;
  form.classList.toggle('open');
  if (form.classList.contains('open')) form.querySelector('textarea')?.focus();
}

function toggleReplies(id, btn) {
  const wrap = document.getElementById(id); if (!wrap) return;
  const isOpen = wrap.style.display !== 'none';
  wrap.style.display = isOpen ? 'none' : 'block';
  const arrow = btn.querySelector('span'); if (arrow) arrow.textContent = isOpen ? '▸' : '▾';
}

document.addEventListener('click', async event => {
  const dismissBtn = event.target.closest('[data-dismiss-moderation-card]');
  if (dismissBtn) {
    const card = dismissBtn.closest('.moderation-placeholder-card');
    const dismissUrl = dismissBtn.getAttribute('data-dismiss-url') || '';
    const dismissToken = dismissBtn.getAttribute('data-dismiss-token') || '';

    if (!card) {
      return;
    }

    if (!dismissUrl || !dismissToken) {
      card.remove();
      return;
    }

    dismissBtn.disabled = true;

    try {
      const body = new FormData();
      body.append('_token', dismissToken);

      const res = await fetch(dismissUrl, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body,
      });

      const json = await res.json();
      if (!res.ok || !json.ok) {
        throw new Error(json.message || 'Could not remove moderated story');
      }

      card.remove();
    } catch (err) {
      if (typeof showToast === 'function') {
        showToast(err.message || 'Could not remove moderated story');
      }
      dismissBtn.disabled = false;
    }

    return;
  }

  const reasonBtn = event.target.closest('[data-toggle-reason]');
  if (!reasonBtn) return;

  const storyId = reasonBtn.getAttribute('data-toggle-reason');
  if (!storyId) return;

  const reasonEl = document.querySelector(`[data-reason-for-story="${storyId}"]`);
  if (!reasonEl) return;

  const isHidden = reasonEl.style.display === 'none' || reasonEl.style.display === '';
  reasonEl.style.display = isHidden ? 'block' : 'none';
  reasonBtn.textContent = isHidden ? 'Hide reason' : 'View reason';
});

document.getElementById('ig-story-viewers-close')?.addEventListener('click', closeStoryViewersSheet);

document.addEventListener('keydown', event => {
  if (event.key !== 'Escape') return;
  const sourceSheet = document.getElementById('story-source-sheet');
  if (sourceSheet && sourceSheet.classList.contains('open')) {
    closeStorySourceSheet();
    return;
  }
  const cameraModal = document.getElementById('story-camera-modal');
  if (cameraModal && cameraModal.classList.contains('open')) {
    closeStoryCameraModal();
    return;
  }
  const modal = document.getElementById('story-editor-modal');
  if (modal && modal.classList.contains('open')) {
    closeStoryEditor();
  }
});

const _storyFrameEl = document.getElementById('ig-story-frame') || document.querySelector('.ig-story-frame');
if (_storyFrameEl) {
  _storyFrameEl.addEventListener('touchstart', ev => {
    if (!ev.touches || !ev.touches.length) return;
    _storyTouchStartY = ev.touches[0].clientY;
  }, { passive: true });

  _storyFrameEl.addEventListener('touchend', ev => {
    if (_storyTouchStartY === null || !ev.changedTouches || !ev.changedTouches.length) {
      _storyTouchStartY = null;
      return;
    }

    const endY = ev.changedTouches[0].clientY;
    const deltaY = _storyTouchStartY - endY;
    _storyTouchStartY = null;

    if (deltaY > 70 && isCurrentUsersStory()) {
      openStoryViewersSheet();
    }
  }, { passive: true });
}
</script>
{% endblock %}
