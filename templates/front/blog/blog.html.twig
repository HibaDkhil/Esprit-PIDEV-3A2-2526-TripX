function beginStoryGestureCalibration() {
  _storyCalibrationActive = true;
  _storyCalibrationReady = false;
  _storyCalibrationStableMs = 0;
  _storyCalibrationLastTs = 0;
  _storyCalibrationCenter = null;
  _storyCalibrationSize = 0;
  _storyGestureHint = 'Hold your hand still to calibrate';
}

function drawStoryGestureAssist(landmarks = null, center = null, handSize = 0, hint = '', pointer = null) {
  const canvas = document.getElementById('story-camera-gesture-canvas');
  if (!canvas) return;

  const rect = canvas.getBoundingClientRect();
  const width = Math.max(1, Math.floor(rect.width));
  const height = Math.max(1, Math.floor(rect.height));
  if (canvas.width !== width || canvas.height !== height) {
    canvas.width = width;
    canvas.height = height;
  }

  const ctx = canvas.getContext('2d');
  if (!ctx) return;
  ctx.clearRect(0, 0, width, height);

  const guideX = width * 0.2;
  const guideY = height * 0.18;
  const guideW = width * 0.6;
  const guideH = height * 0.64;

  ctx.save();
  ctx.strokeStyle = 'rgba(255,255,255,.7)';
  ctx.lineWidth = 2;
  ctx.setLineDash([8, 6]);
  ctx.strokeRect(guideX, guideY, guideW, guideH);
  ctx.setLineDash([]);

  ctx.fillStyle = 'rgba(255,255,255,.16)';
  ctx.fillRect(guideX, guideY + guideH * 0.45, guideW, 1);
  ctx.fillRect(guideX + guideW * 0.5, guideY, 1, guideH);

  ctx.fillStyle = 'rgba(255,255,255,.8)';
  ctx.font = '600 12px Montserrat, sans-serif';
  ctx.fillText('LEFT = NEXT', guideX + 10, guideY + guideH - 14);
  ctx.fillText('RIGHT = PREV', guideX + guideW - 110, guideY + guideH - 14);
  ctx.fillText('UP = REMOVE', guideX + guideW * 0.5 - 38, guideY + 16);
  ctx.fillText('INDEX UP = CAPTURE', guideX + guideW * 0.5 - 62, guideY + 32);

  if (landmarks && landmarks.length) {
    const connections = [
      [0,1],[1,2],[2,3],[3,4],
      [0,5],[5,6],[6,7],[7,8],
      [5,9],[9,10],[10,11],[11,12],
      [9,13],[13,14],[14,15],[15,16],
      [13,17],[17,18],[18,19],[19,20],
      [0,17]
    ];

    ctx.strokeStyle = 'rgba(56, 189, 248, .95)';
    ctx.lineWidth = 2;
    connections.forEach(([a, b]) => {
      const p1 = landmarks[a];
      const p2 = landmarks[b];
      if (!p1 || !p2) return;
      const x1 = (1 - p1.x) * width;
      const y1 = p1.y * height;
      const x2 = (1 - p2.x) * width;
      const y2 = p2.y * height;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    });

    landmarks.forEach((p, i) => {
      const x = (1 - p.x) * width;
      const y = p.y * height;
      ctx.beginPath();
      ctx.fillStyle = i === 4 || i === 8 ? 'rgba(251, 113, 133, .98)' : 'rgba(255,255,255,.95)';
      ctx.arc(x, y, i === 4 || i === 8 ? 4 : 3, 0, Math.PI * 2);
      ctx.fill();
    });
  }

  if (pointer) {
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(56,189,248,.95)';
    ctx.fillStyle = 'rgba(56,189,248,.2)';
    ctx.lineWidth = 2;
    ctx.arc(pointer.x, pointer.y, 11, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255,255,255,.95)';
    ctx.lineWidth = 1.5;
    ctx.moveTo(pointer.x - 8, pointer.y);
    ctx.lineTo(pointer.x + 8, pointer.y);
    ctx.moveTo(pointer.x, pointer.y - 8);
    ctx.lineTo(pointer.x, pointer.y + 8);
    ctx.stroke();
  }

  const centerOk = !!center && center.x >= 0.2 && center.x <= 0.8 && center.y >= 0.18 && center.y <= 0.82;
  const scaleLabel = handSize < 0.09 ? 'Move closer' : handSize > 0.36 ? 'Move farther' : 'Scale OK';
  const scaleColor = handSize < 0.09 || handSize > 0.36 ? 'rgba(251, 146, 60, .95)' : 'rgba(74, 222, 128, .95)';

  ctx.fillStyle = 'rgba(2,6,23,.62)';
  ctx.fillRect(10, height - 62, width - 20, 50);
  ctx.fillStyle = centerOk ? 'rgba(74, 222, 128, .95)' : 'rgba(251, 146, 60, .95)';
  ctx.font = '700 12px Montserrat, sans-serif';
  ctx.fillText(centerOk ? 'Position OK' : 'Center your hand in the frame', 20, height - 40);
  ctx.fillStyle = scaleColor;
  ctx.fillText(scaleLabel, 20, height - 23);
  ctx.fillStyle = 'rgba(226,232,240,.96)';
  ctx.fillText(hint || _storyGestureHint || 'Ready', 150, height - 23);

  if (_storyCalibrationActive || !_storyCalibrationReady) {
    const p = Math.max(0, Math.min(1, _storyCalibrationStableMs / _storyCalibrationTargetMs));
    const barW = width * 0.56;
    const barH = 8;
    const barX = (width - barW) / 2;
    const barY = guideY + guideH + 12;
    ctx.fillStyle = 'rgba(15,23,42,.66)';
    ctx.fillRect(barX, barY, barW, barH);
    ctx.fillStyle = 'rgba(56,189,248,.95)';
    ctx.fillRect(barX, barY, barW * p, barH);
    ctx.strokeStyle = 'rgba(255,255,255,.5)';
    ctx.lineWidth = 1;
    ctx.strokeRect(barX, barY, barW, barH);
    ctx.fillStyle = 'rgba(255,255,255,.9)';
    ctx.font = '700 11px Montserrat, sans-serif';
    ctx.fillText('Calibrating hand stability...', barX + 4, barY - 6);
  }
  ctx.restore();
}

function getStoryPointerFromHand(navHand) {
  const canvas = document.getElementById('story-camera-gesture-canvas');
  if (!canvas || !navHand || !navHand[8]) return null;
  const rect = canvas.getBoundingClientRect();
  const width = Math.max(1, Math.floor(rect.width));
  const height = Math.max(1, Math.floor(rect.height));
  return {
    x: (1 - navHand[8].x) * width,
    y: navHand[8].y * height,
  };
}

function isStoryIndexFingerUp(hand) {
  if (!hand || !hand[5] || !hand[6] || !hand[8]) return false;

  const indexTip = hand[8].y;
  const indexPip = hand[6].y;
  const indexMcp = hand[5].y;
  const indexExtended = indexTip < indexPip - 0.025 && indexPip < indexMcp - 0.005;
  if (!indexExtended) return false;

  const foldedCount = [
    hand[12] && hand[10] ? hand[12].y > hand[10].y : false,
    hand[16] && hand[14] ? hand[16].y > hand[14].y : false,
    hand[20] && hand[18] ? hand[20].y > hand[18].y : false,
  ].filter(Boolean).length;

  return foldedCount >= 2;
}

async function ensureStoryHandTrackingReady() {
  if (_storyHandLandmarker || _storyHandModelLoading) return !!_storyHandLandmarker;
  _storyHandModelLoading = true;
  setStoryCameraMessage('Loading hand gestures model...');

  try {
    const tasksVision = await import('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/+esm');
    const { FilesetResolver, HandLandmarker } = tasksVision;

    _storyMpVision = await FilesetResolver.forVisionTasks(
      'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm'
    );

    _storyHandLandmarker = await HandLandmarker.createFromOptions(_storyMpVision, {
      baseOptions: {
        modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',
      },
      runningMode: 'VIDEO',
      numHands: 2,
      minHandDetectionConfidence: 0.6,
      minHandPresenceConfidence: 0.5,
      minTrackingConfidence: 0.5,
    });

    setStoryCameraMessage('');
    return true;
  } catch (err) {
    console.error(err);
    setStoryCameraMessage('Could not load hand model. Camera still works without gestures.', true);
    return false;
  } finally {
    _storyHandModelLoading = false;
  }
}

function stopStoryGestureLoop() {
  if (_storyGestureLoopId !== null) {
    cancelAnimationFrame(_storyGestureLoopId);
    _storyGestureLoopId = null;
  }
  _storyCameraLastCenter = null;
  _storyCameraLastCenterTs = 0;
  _storyCameraLastPinch = null;
  _storyCameraPinchActive = false;
  _storyCameraPinchStartDistance = null;
  _storyCameraPinchStartZoom = 1;
  _storyGestureLockUntil = 0;
  _storyPointerUpSince = 0;
  _storyPointerUpCooldownUntil = 0;
  _storyLastVideoTime = -1;
  _storyCameraSmoothedCenter = null;
  _storyCameraSmoothedPinch = null;
  _storyGestureAccumX = 0;
  _storyGestureAccumY = 0;
  _storyGestureAccumTs = 0;
  _storyGestureHint = 'Place your hand inside the frame';
  _storyCalibrationActive = false;
  _storyCalibrationReady = false;
  _storyCalibrationStableMs = 0;
  _storyCalibrationLastTs = 0;
  _storyCalibrationCenter = null;
  _storyCalibrationSize = 0;
  drawStoryGestureAssist(null, null, 0, _storyGestureHint);
  applyCameraPreviewFilter();
}

function processStoryHandGestures(landmarks, now) {
  const profile = getGestureProfile();
  if (!Array.isArray(landmarks) || !landmarks.length) return;

  const sorted = [...landmarks].sort((a, b) => {
    const as = Math.hypot(a[0].x - a[9].x, a[0].y - a[9].y);
    const bs = Math.hypot(b[0].x - b[9].x, b[0].y - b[9].y);
    return bs - as;
  });

  const navHand = sorted[0];
  if (!navHand || !navHand.length) return;
  const pinchHand = sorted[1] && sorted[1].length ? sorted[1] : navHand;

  const centerXRaw = (navHand[0].x + navHand[9].x + navHand[12].x) / 3;
  const centerYRaw = (navHand[0].y + navHand[9].y + navHand[12].y) / 3;
  if (!_storyCameraSmoothedCenter) {
    _storyCameraSmoothedCenter = { x: centerXRaw, y: centerYRaw };
  } else {
    _storyCameraSmoothedCenter.x = lerpNumber(_storyCameraSmoothedCenter.x, centerXRaw, 0.33);
    _storyCameraSmoothedCenter.y = lerpNumber(_storyCameraSmoothedCenter.y, centerYRaw, 0.33);
  }

  const centerX = _storyCameraSmoothedCenter.x;
  const centerY = _storyCameraSmoothedCenter.y;
  const center = { x: centerX, y: centerY };

  let dx = 0;
  let dy = 0;
  let dt = 0;
  if (_storyCameraLastCenter && _storyCameraLastCenterTs) {
    dt = Math.max(1, now - _storyCameraLastCenterTs);
    dx = center.x - _storyCameraLastCenter.x;
    dy = center.y - _storyCameraLastCenter.y;
  }

  const handSize = Math.max(0.08, Math.hypot(pinchHand[0].x - pinchHand[9].x, pinchHand[0].y - pinchHand[9].y));
  const pointer = getStoryPointerFromHand(navHand);
  const insideGuide = centerX >= 0.2 && centerX <= 0.8 && centerY >= 0.18 && centerY <= 0.82;
  const goodScale = handSize >= 0.09 && handSize <= 0.36;

  if (!insideGuide || !goodScale) {
    _storyCameraLastCenter = center;
    _storyCameraLastCenterTs = now;
    _storyCameraPinchActive = false;
    _storyCameraLastPinch = null;
    _storyCameraPinchStartDistance = null;
    _storyCameraPinchStartZoom = _storyCameraZoom;
    _storyPointerUpSince = 0;
    _storyGestureAccumX = 0;
    _storyGestureAccumY = 0;
    _storyGestureAccumTs = now;
    _storyCalibrationStableMs = 0;
    _storyCalibrationLastTs = now;
    _storyCalibrationCenter = center;
    _storyCalibrationSize = handSize;
    _storyGestureHint = !insideGuide ? 'Move hand inside the guide frame' : (handSize < 0.09 ? 'Move your hand closer' : 'Move your hand farther');
    drawStoryGestureAssist(navHand, center, handSize, _storyGestureHint, pointer);
    applyCameraPreviewFilter();
    return;
  }

  if (!_storyCalibrationReady) {
    if (!_storyCalibrationActive) {
      beginStoryGestureCalibration();
    }

    const frameDt = _storyCalibrationLastTs ? Math.max(0, now - _storyCalibrationLastTs) : 0;
    _storyCalibrationLastTs = now;

    if (!_storyCalibrationCenter) {
      _storyCalibrationCenter = center;
      _storyCalibrationSize = handSize;
      _storyCalibrationStableMs = 0;
    }

    const motionFromAnchor = Math.hypot(center.x - _storyCalibrationCenter.x, center.y - _storyCalibrationCenter.y);
    const sizeShift = Math.abs(handSize - _storyCalibrationSize);
    const stablePose = motionFromAnchor < 0.03 && sizeShift < 0.03;

    if (stablePose) {
      _storyCalibrationStableMs = Math.min(_storyCalibrationTargetMs, _storyCalibrationStableMs + frameDt);
      _storyGestureHint = `Hold steady: ${Math.ceil((_storyCalibrationTargetMs - _storyCalibrationStableMs) / 1000)}s`;
    } else {
      _storyCalibrationStableMs = Math.max(0, _storyCalibrationStableMs - frameDt * 0.7);
      _storyCalibrationCenter = center;
      _storyCalibrationSize = handSize;
      _storyGestureHint = 'Keep hand still for calibration';
    }

    if (_storyCalibrationStableMs >= _storyCalibrationTargetMs) {
      _storyCalibrationReady = true;
      _storyCalibrationActive = false;
      _storyGestureHint = 'Calibration complete';
      _storyGestureLockUntil = now + 260;
      setStoryCameraMessage('Calibration complete');
      setTimeout(() => {
        if (document.getElementById('story-camera-modal')?.classList.contains('open')) {
          setStoryCameraMessage('');
        }
      }, 700);
    }

    _storyCameraLastCenter = center;
    _storyCameraLastCenterTs = now;
    drawStoryGestureAssist(navHand, center, handSize, _storyGestureHint, pointer);
    applyCameraPreviewFilter();
    return;
  }

  const pointerUpHoldMs = 220;
  const pointerUpCooldownMs = 1100;
  const pointerUp = isStoryIndexFingerUp(navHand);

  if (pointerUp && now > _storyPointerUpCooldownUntil && !_storyCameraCaptureBusy) {
    if (!_storyPointerUpSince) _storyPointerUpSince = now;
    const elapsed = now - _storyPointerUpSince;
    if (elapsed >= pointerUpHoldMs) {
      _storyPointerUpCooldownUntil = now + pointerUpCooldownMs;
      _storyPointerUpSince = 0;
      _storyGestureLockUntil = now + 260;
      _storyGestureHint = 'Index up detected';
      captureStoryFromCamera();
    } else {
      _storyGestureHint = 'Hold index finger up to capture';
    }
  } else if (!pointerUp) {
    _storyPointerUpSince = 0;
  }

  const pinchDistanceRaw = Math.hypot(pinchHand[4].x - pinchHand[8].x, pinchHand[4].y - pinchHand[8].y) / handSize;
  if (_storyCameraSmoothedPinch === null) {
    _storyCameraSmoothedPinch = pinchDistanceRaw;
  } else {
    _storyCameraSmoothedPinch = lerpNumber(_storyCameraSmoothedPinch, pinchDistanceRaw, 0.38);
  }
  const pinchDistance = _storyCameraSmoothedPinch;

  const lateralSpeed = dt > 0 ? Math.abs(dx) / dt : 0;
  const verticalSpeed = dt > 0 ? Math.abs(dy) / dt : 0;
  const motionCalm = lateralSpeed < 0.00042 && verticalSpeed < 0.00042;

  const pinchStartGate = Math.min(profile.pinchRelease - 0.02, profile.pinchStart + 0.08);
  const pinchReleaseGate = Math.max(profile.pinchRelease + 0.06, profile.pinchStart + 0.1);
  const pointerUpMode = pointerUp || _storyPointerUpSince > 0;

  if (!pointerUpMode && !_storyCameraPinchActive && pinchDistance <= pinchStartGate && motionCalm && now > _storyGestureLockUntil) {
    _storyCameraPinchActive = true;
    _storyCameraLastPinch = pinchDistance;
    _storyCameraPinchStartDistance = Math.max(0.001, pinchDistance);
    _storyCameraPinchStartZoom = _storyCameraZoom;
    _storyGestureLockUntil = now + 180;
  } else if (_storyCameraPinchActive && pinchDistance >= pinchReleaseGate) {
    _storyCameraPinchActive = false;
    _storyCameraLastPinch = null;
    _storyCameraPinchStartDistance = null;
    _storyCameraPinchStartZoom = _storyCameraZoom;
    _storyGestureLockUntil = now + 180;
  }

  if (!pointerUpMode && _storyCameraPinchActive && _storyCameraPinchStartDistance !== null) {
    const ratio = pinchDistance / Math.max(0.001, _storyCameraPinchStartDistance);
    const targetZoom = Math.max(0.8, Math.min(2.8, _storyCameraPinchStartZoom * ratio));
    _storyCameraZoom = lerpNumber(_storyCameraZoom, targetZoom, 0.42);
    if (ratio > 1.01) {
      _storyGestureHint = 'Pinch out: zoom in';
    } else if (ratio < 0.99) {
      _storyGestureHint = 'Pinch in: zoom out';
    }
    _storyCameraLastPinch = pinchDistance;
  }

  if (_storyCameraLastCenter && _storyCameraLastCenterTs) {
    const canNavigate = !_storyCameraPinchActive && now > _storyGestureLockUntil;

    if (!_storyGestureAccumTs || now - _storyGestureAccumTs > 420) {
      _storyGestureAccumX = 0;
      _storyGestureAccumY = 0;
      _storyGestureAccumTs = now;
    }

    _storyGestureAccumX += dx;
    _storyGestureAccumY += dy;

    if (canNavigate && Math.abs(_storyGestureAccumX) > profile.swipeDistance && Math.abs(_storyGestureAccumY) < profile.swipeMaxDy && dt < profile.swipeWindowMs && now > _storyCameraSwipeCooldownUntil) {
      cycleStoryCameraFilter(_storyGestureAccumX < 0 ? 1 : -1);
      _storyCameraSwipeCooldownUntil = now + profile.swipeCooldownMs;
      _storyGestureLockUntil = now + 240;
      _storyGestureAccumX = 0;
      _storyGestureAccumY = 0;
      _storyGestureAccumTs = now;
      _storyGestureHint = 'Swipe detected';
    }

    if (canNavigate && _storyGestureAccumY < -profile.upDistance && Math.abs(_storyGestureAccumX) < profile.upMaxDx && Math.abs(_storyGestureAccumY) > Math.abs(_storyGestureAccumX) * 1.8 && dt < profile.upWindowMs && now > _storyCameraUpCooldownUntil) {
      applyUpwardFilterClear();
      _storyCameraUpCooldownUntil = now + profile.upCooldownMs;
      _storyGestureLockUntil = now + 260;
      _storyGestureAccumX = 0;
      _storyGestureAccumY = 0;
      _storyGestureAccumTs = now;
      _storyGestureHint = 'Up gesture detected';
    }
  }

  _storyCameraLastCenter = center;
  _storyCameraLastCenterTs = now;
  if (!_storyCameraPinchActive && _storyGestureHint === 'Place your hand inside the frame') {
    _storyGestureHint = 'Ready for swipe, up, pinch, or index-up capture';
  }
  drawStoryGestureAssist(navHand, center, handSize, _storyGestureHint, pointer);
  applyCameraPreviewFilter();
}

function startStoryGestureLoop() {
  if (_storyGestureLoopId !== null) return;

  const video = document.getElementById('story-camera-video');
  if (!video || !_storyHandLandmarker) return;

  const loop = () => {
    const modalOpen = document.getElementById('story-camera-modal')?.classList.contains('open');
    if (!modalOpen || !_storyHandLandmarker) {
      stopStoryGestureLoop();
      return;
    }

    const ready = video.readyState >= 2;
    if (ready && video.currentTime !== _storyLastVideoTime) {
      _storyLastVideoTime = video.currentTime;
      const now = performance.now();
      const result = _storyHandLandmarker.detectForVideo(video, now);

      if (result && result.landmarks && result.landmarks.length) {
        processStoryHandGestures(result.landmarks, now);
      } else {
        _storyCameraLastCenter = null;
        _storyCameraLastCenterTs = 0;
        _storyCameraLastPinch = null;
        _storyCameraPinchActive = false;
        _storyCameraPinchStartDistance = null;
        _storyCameraPinchStartZoom = _storyCameraZoom;
        _storyPointerUpSince = 0;
        _storyGestureLockUntil = 0;
        _storyCameraSmoothedCenter = null;
        _storyCameraSmoothedPinch = null;
        _storyGestureAccumX = 0;
        _storyGestureAccumY = 0;
        _storyGestureAccumTs = 0;
        _storyPointerUpCooldownUntil = 0;
        if (!_storyCalibrationReady) {
          _storyCalibrationActive = true;
          _storyCalibrationStableMs = 0;
          _storyCalibrationLastTs = 0;
          _storyCalibrationCenter = null;
          _storyCalibrationSize = 0;
        }
        _storyGestureHint = 'Show your hand inside the frame';
        drawStoryGestureAssist(null, null, 0, _storyGestureHint);
        applyCameraPreviewFilter();
      }
    }

    _storyGestureLoopId = requestAnimationFrame(loop);
  };

  _storyGestureLoopId = requestAnimationFrame(loop);
}

async function stopStoryCameraStream() {
  if (!_storyCameraStream) return;
  _storyCameraStream.getTracks().forEach(track => track.stop());
  _storyCameraStream = null;
}

async function startStoryCameraStream() {
  const video = document.getElementById('story-camera-video');
  if (!video) return false;

  setStoryCameraMessage('Opening camera...');
  await stopStoryCameraStream();

  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: { ideal: _storyCameraFacingMode },
        width: { ideal: 1080 },
        height: { ideal: 1920 },
      },
      audio: false,
    });

    _storyCameraStream = stream;
    video.srcObject = stream;
    _storyCameraZoom = 1;
    _storyCameraLastCenter = null;
    _storyCameraLastCenterTs = 0;
    _storyCameraLastPinch = null;
    _storyCameraPinchActive = false;
    _storyCameraPinchStartDistance = null;
    _storyCameraPinchStartZoom = 1;
    _storyPointerUpSince = 0;
    _storyPointerUpCooldownUntil = 0;
    _storyGestureLockUntil = 0;
    _storyCameraSmoothedCenter = null;
    _storyCameraSmoothedPinch = null;
    _storyGestureAccumX = 0;
    _storyGestureAccumY = 0;
    _storyGestureAccumTs = 0;
    beginStoryGestureCalibration();
    _storyLastVideoTime = -1;
    setStoryCameraMessage('');
    drawStoryGestureAssist(null, null, 0, _storyGestureHint);
    applyCameraPreviewFilter();

    const modelOk = await ensureStoryHandTrackingReady();
    if (modelOk) {
      startStoryGestureLoop();
    }
    return true;
  } catch (err) {
    console.error(err);
    setStoryCameraMessage('Camera access denied or unavailable. Check browser permissions.', true);
    return false;
  }
}

function openStorySourceSheet() {
  const modal = document.getElementById('story-source-sheet');
  if (!modal) return;
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('story-editor-open');
}

function closeStorySourceSheet() {
  const modal = document.getElementById('story-source-sheet');
  if (!modal) return;
  modal.classList.remove('open');
  modal.setAttribute('aria-hidden', 'true');
  if (!document.getElementById('story-editor-modal')?.classList.contains('open') && !document.getElementById('story-camera-modal')?.classList.contains('open')) {
    document.body.classList.remove('story-editor-open');
  }
}

async function openStoryCameraModal() {
  const modal = document.getElementById('story-camera-modal');
  if (!modal) return;

  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    showToast('Camera is not supported by this browser');
    return;
  }

  closeStorySourceSheet();
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('story-camera-open');
  document.body.classList.add('story-editor-open');
  _storyCameraActiveFilter = 'normal';
  setActiveCameraFilterChip();
  applyCameraPreviewFilter();
  showStoryGestureGuideIfNeeded();
  await startStoryCameraStream();
}

async function closeStoryCameraModal() {
  const modal = document.getElementById('story-camera-modal');
  const video = document.getElementById('story-camera-video');
  if (modal) {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }
  stopStoryGestureLoop();
  await stopStoryCameraStream();
  if (video) {
    video.pause();
    video.srcObject = null;
  }
  setStoryCameraMessage('');
  hideStoryGestureGuide(false);
  document.body.classList.remove('story-camera-open');
  if (!document.getElementById('story-editor-modal')?.classList.contains('open') && !document.getElementById('story-source-sheet')?.classList.contains('open')) {
    document.body.classList.remove('story-editor-open');
  }
}

async function switchStoryCameraFacing() {
  _storyCameraFacingMode = _storyCameraFacingMode === 'user' ? 'environment' : 'user';
  await startStoryCameraStream();
}

async function captureStoryFromCamera() {
  if (_storyCameraCaptureBusy) return;
  const video = document.getElementById('story-camera-video');
  if (!video || !video.videoWidth || !video.videoHeight) {
    setStoryCameraMessage('Camera is not ready yet', true);
    return;
  }

  _storyCameraCaptureBusy = true;
  const captureBtn = document.getElementById('story-camera-capture');
  if (captureBtn) captureBtn.disabled = true;

  try {
    const sw = video.videoWidth;
    const sh = video.videoHeight;
    const targetRatio = 9 / 16;
    let sx = 0;
    let sy = 0;
    let sWidth = sw;
    let sHeight = sh;

    if (sw / sh > targetRatio) {
      sWidth = Math.floor(sh * targetRatio);
      sx = Math.floor((sw - sWidth) / 2);
    } else {
      sHeight = Math.floor(sw / targetRatio);
      sy = Math.floor((sh - sHeight) / 2);
    }

    const canvas = document.createElement('canvas');
    canvas.width = 1080;
    canvas.height = 1920;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas unavailable');

    ctx.save();
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    const camFilter = getCameraFilterFromPreset(_storyCameraActiveFilter);
    ctx.filter = camFilter.css;
    ctx.drawImage(video, sx, sy, sWidth, sHeight, 0, 0, canvas.width, canvas.height);
    ctx.filter = 'none';
    ctx.restore();

    if (camFilter.fade > 0) {
      ctx.fillStyle = `rgba(255,255,255,${camFilter.fade})`;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
    if (!blob) throw new Error('Capture failed');

    await closeStoryCameraModal();
    openStoryEditor(blob);
  } catch (err) {
    console.error(err);
    setStoryCameraMessage('Could not capture photo. Try again.', true);
  } finally {
    _storyCameraCaptureBusy = false;
    if (captureBtn) captureBtn.disabled = false;
  }
}

function normalizeCountryKey(value) {
  return (value || '')
    .toString()
    .trim()
    .toLowerCase()
    .replace(/\s+/g, ' ');
}

function extractCandidateCountry(raw) {
  const value = (raw || '').trim();
  if (!value) return '';

  if (value.includes(',')) {
    const parts = value.split(',').map(p => p.trim()).filter(Boolean);
    if (parts.length) return parts[parts.length - 1];
  }

  return value;
}

async function getCountryFlagsMap() {
  if (_countryFlagsMap) return _countryFlagsMap;
  if (_countryFlagsPromise) return _countryFlagsPromise;

  _countryFlagsPromise = fetch('https://restcountries.com/v3.1/all?fields=name,altSpellings,cca2,cca3,flags')
    .then(r => {
      if (!r.ok) throw new Error('flags fetch failed');
      return r.json();
    })
    .then(rows => {
      const map = new Map();

      rows.forEach(country => {
        if (!country || !country.name || !country.name.common || !country.flags) return;
        const flagUrl = country.flags.svg || country.flags.png;
        if (!flagUrl) return;

        const keys = [
          country.name.common,
          country.name.official,
          country.cca2,
          country.cca3,
          ...(Array.isArray(country.altSpellings) ? country.altSpellings : [])
        ].filter(Boolean);

        keys.forEach(k => {
          map.set(normalizeCountryKey(k), flagUrl);
        });
      });

      _countryFlagsMap = map;
      return map;
    })
    .catch(() => {
      _countryFlagsMap = new Map();
      return _countryFlagsMap;
    })
    .finally(() => {
      _countryFlagsPromise = null;
    });

  return _countryFlagsPromise;
}

async function hydrateDestinationFlags(root = document) {
  const nodes = root.querySelectorAll('.ts-destination');
  if (!nodes.length) return;

  const flagsMap = await getCountryFlagsMap();
  if (!flagsMap.size) return;

  nodes.forEach(node => {
    if (node.dataset.flagHydrated === '1') return;

    const textNode = node.querySelector('.ts-destination-text') || node;
    const destinationText = (textNode.textContent || '').trim();
    const candidate = extractCandidateCountry(destinationText);
    const flagUrl = flagsMap.get(normalizeCountryKey(candidate));
    if (!flagUrl) return;

    const img = document.createElement('img');
    img.className = 'ts-destination-flag';
    img.alt = `${candidate} flag`;
    img.src = flagUrl;
    img.loading = 'lazy';

    textNode.textContent = '';
    textNode.appendChild(img);
    textNode.appendChild(document.createTextNode(candidate));
    node.dataset.flagHydrated = '1';
  });
}

function feedFilter(e, type) {
  if (e) e.preventDefault();
  _currentType = type;
  loadFeed();
  document.querySelectorAll('#type-pills .tpill').forEach(el => {
    el.classList.toggle('active', el.dataset.type === type);
  });
  document.querySelectorAll('.sidebar-nav .snav-item[data-filter-type]').forEach(el => {
    el.classList.toggle('active', el.dataset.filterType === type);
  });
  return false;
}

function loadFeed() {
  if (_ajaxCtrl) _ajaxCtrl.abort();
  _ajaxCtrl = new AbortController();

  const params = new URLSearchParams();
  if (_currentSearch) params.set('q', _currentSearch);
  if (_currentType)   params.set('type', _currentType);

  const container = document.getElementById('feed-container');
  const spinner   = document.getElementById('feed-spinner');
  container.classList.add('loading');
  spinner.classList.add('visible');

  const newUrl = '{{ path('blog') }}' + (params.toString() ? '?' + params : '');
  history.replaceState(null, '', newUrl);

  fetch('{{ path('blog_filter') }}?' + params.toString(), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    signal: _ajaxCtrl.signal,
  })
    .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
    .then(html => {
      container.innerHTML = html;
      container.classList.remove('loading');
      spinner.classList.remove('visible');
      hydrateUserNames();
      hydrateDestinationFlags(container);
    })
    .catch(err => {
      if (err.name === 'AbortError') return;
      console.error('Feed load error', err);
      container.classList.remove('loading');
      spinner.classList.remove('visible');
    });
}

document.getElementById('feed-search-btn').addEventListener('click', () => {
  _currentSearch = document.getElementById('feed-search').value.trim();
  loadFeed();
});
document.getElementById('feed-search').addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();
    _currentSearch = e.target.value.trim();
    loadFeed();
  }
});

/* ═══════════════════════════════════════════════════════════
   Reactions, comments, share, etc.
   ═══════════════════════════════════════════════════════════ */
const RXN_ICONS  = {like:'👍',love:'❤️',haha:'😂',wow:'😮',sad:'😢',angry:'😡'};
const RXN_LABELS = {like:'Like',love:'Love',haha:'Haha',wow:'Wow',sad:'Sad',angry:'Angry'};

async function sendReaction(targetId, type, targetType) {
  const url = targetType === 'post'
    ? `/post/${targetId}/react/${type}`
    : targetType === 'travel_story'
      ? `/travel-story/${targetId}/react/${type}`
      : `/comment/${targetId}/react/${type}`;
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    if (!res.ok) return;
    const data = await res.json();
    if (targetType === 'post') {
      updatePostReaction(targetId, data.userReaction, data.counts);
    } else if (targetType === 'travel_story') {
      updateStoryReaction(targetId, data.userReaction, data.counts);
    } else {
      updateCommentReaction(targetId, data.userReaction, data.counts);
    }
  } catch(e) { console.error('Reaction error:', e); }
}

function quickReact(targetId, currentReaction, targetType) {
  sendReaction(targetId, currentReaction || 'like', targetType);
}

function updatePostReaction(pid, userReaction, counts) {
  const btn = document.getElementById(`rxnbtn-${pid}`);
  const iconEl = document.getElementById(`rxnicon-${pid}`);
  const lblEl = document.getElementById(`rxnlbl-${pid}`);
  const totalEl = document.getElementById(`rxntotal-${pid}`);
  if (!btn) return;

  btn.className = btn.className.replace(/reacted-\w+/g, '').trim();
  if (userReaction) {
    btn.classList.add(`reacted-${userReaction}`);
    iconEl.textContent = RXN_ICONS[userReaction] || '👍';
    lblEl.textContent  = RXN_LABELS[userReaction] || 'Like';
    btn.dataset.reaction = userReaction;
    btn.setAttribute('onclick', `quickReact(${pid}, '${userReaction}', 'post')`);
  } else {
    iconEl.textContent = '👍';
    lblEl.textContent  = 'Like';
    btn.dataset.reaction = '';
    btn.setAttribute('onclick', `quickReact(${pid}, '', 'post')`);
  }

  Object.keys(RXN_ICONS).forEach(t => {
    const opt = document.getElementById(`rxnopt-${pid}-${t}`);
    if (opt) opt.classList.toggle('active-emoji', t === userReaction);
  });

  const total = Object.values(counts).reduce((a, b) => a + b, 0);
  if (total > 0) { totalEl.textContent = total; totalEl.style.display = ''; }
  else { totalEl.style.display = 'none'; }

  const tally = btn.closest('article')?.querySelector('.rxn-tally');
  if (tally) {
    tally.innerHTML = '';
    Object.entries(counts).forEach(([t, n]) => {
      if (n > 0) { const s = document.createElement('span'); s.textContent = `${RXN_ICONS[t]} ${n}`; tally.appendChild(s); }
    });
  }
}

function updateCommentReaction(cid, userReaction, counts) {
  const btn = document.getElementById(`crxnbtn-${cid}`);
  const tally = document.getElementById(`crxntally-${cid}`);
  if (!btn) return;
  if (userReaction) {
    btn.classList.add('c-reacted');
    btn.innerHTML = `${RXN_ICONS[userReaction]} ${RXN_LABELS[userReaction]}`;
    btn.setAttribute('onclick', `quickReact(${cid}, '${userReaction}', 'comment')`);
  } else {
    btn.classList.remove('c-reacted');
    btn.innerHTML = '👍 Like';
    btn.setAttribute('onclick', `quickReact(${cid}, '', 'comment')`);
  }
  if (tally) {
    const total = Object.values(counts).reduce((a, b) => a + b, 0);
    tally.innerHTML = total > 0
      ? Object.entries(counts).filter(([,n]) => n > 0).map(([t, n]) => `${RXN_ICONS[t]}${n}`).join(' ')
      : '';
  }
}

function updateStoryReaction(sid, userReaction, counts) {
  const btn = document.getElementById(`ts-rxnbtn-${sid}`);
  const iconEl = document.getElementById(`ts-rxnicon-${sid}`);
  const lblEl = document.getElementById(`ts-rxnlbl-${sid}`);
  const totalEl = document.getElementById(`ts-rxntotal-${sid}`);
  if (!btn) return;

  btn.className = btn.className.replace(/reacted-\w+/g, '').trim();
  if (userReaction) {
    btn.classList.add(`reacted-${userReaction}`);
    iconEl.textContent = RXN_ICONS[userReaction] || '👍';
    lblEl.textContent = RXN_LABELS[userReaction] || 'Like';
    btn.dataset.reaction = userReaction;
    btn.setAttribute('onclick', `quickReact(${sid}, '${userReaction}', 'travel_story')`);
  } else {
    iconEl.textContent = '👍';
    lblEl.textContent = 'Like';
    btn.dataset.reaction = '';
    btn.setAttribute('onclick', `quickReact(${sid}, '', 'travel_story')`);
  }

  Object.keys(RXN_ICONS).forEach(t => {
    const opt = document.getElementById(`ts-rxnopt-${sid}-${t}`);
    if (opt) opt.classList.toggle('active-emoji', t === userReaction);
  });

  const total = Object.values(counts).reduce((a, b) => a + b, 0);
  if (total > 0) { totalEl.textContent = total; totalEl.style.display = ''; }
  else { totalEl.style.display = 'none'; }

  const tally = btn.closest('article')?.querySelector('.rxn-tally');
  if (tally) {
    tally.innerHTML = '';
    Object.entries(counts).forEach(([t, n]) => {
      if (n > 0) { const s = document.createElement('span'); s.textContent = `${RXN_ICONS[t]} ${n}`; tally.appendChild(s); }
    });
  }
}

async function sharePost(title, url) {
  if (navigator.share) { try { await navigator.share({ title, url }); return; } catch(e) { return; } }
  try { await navigator.clipboard.writeText(url); showToast('🔗 Link copied to clipboard!'); }
  catch(e) { prompt('Copy this link:', url); }
}

function showToast(msg) {
  let t = document.getElementById('share-toast');
  if (!t) {
    t = document.createElement('div'); t.id = 'share-toast';
    t.style.cssText = `position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);background:#111;color:#fff;padding:12px 22px;border-radius:50px;font-size:14px;font-weight:700;z-index:9999;opacity:0;transition:opacity .25s,transform .25s;white-space:nowrap;box-shadow:0 8px 24px rgba(0,0,0,.25);`;
    document.body.appendChild(t);
  }
  t.textContent = msg; t.style.opacity = '1'; t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(-50%) translateY(20px)'; }, 2800);
}

function buildLiveIdUrl(pattern, id) {
  return pattern.replace('/0/', `/${id}/`);
}

function buildLiveReactionUrl(id, type) {
  return _liveReactUrlPattern.replace('/0/react/like', `/${id}/react/${encodeURIComponent(type)}`);
}

function applyLivePreviewFilter() {
  const video = document.getElementById('live-local-video');
  if (!video) return;
  const b = Number(_livePreviewFilter.brightness || 0);
  const c = Number(_livePreviewFilter.contrast || 100);
  const s = Number(_livePreviewFilter.saturation || 100);
  const blur = Number(_livePreviewFilter.blur || 0);
  video.style.filter = `brightness(${1 + (b / 100)}) contrast(${c / 100}) saturate(${s / 100}) blur(${blur}px)`;
}

function sanitizeLiveFilterPayload(filter) {
  const input = filter && typeof filter === 'object' ? filter : {};
  return {
    brightness: Math.max(-100, Math.min(100, Number(input.brightness || 0))),
    contrast: Math.max(20, Math.min(200, Number(input.contrast || 100))),
    saturation: Math.max(0, Math.min(200, Number(input.saturation || 100))),
    blur: Math.max(0, Math.min(6, Number(input.blur || 0))),
  };
}

async function publishLiveFilterRealtime() {
  if (!_liveActiveIsHost) return;
  if (!_liveKitRoom || !_liveKitRoom.localParticipant) return;

  const msg = JSON.stringify({
    t: 'live_filter',
    f: sanitizeLiveFilterPayload(_livePreviewFilter),
    u: Number(_currentUserId || 0),
    s: Number(_liveActiveSessionId || 0),
    ts: Date.now(),
  });

  try {
    const bytes = typeof TextEncoder !== 'undefined'
      ? new TextEncoder().encode(msg)
      : Uint8Array.from(msg.split('').map(ch => ch.charCodeAt(0)));
    await _liveKitRoom.localParticipant.publishData(bytes, { reliable: true });
  } catch (_) {}
}

function setLivePreviewPreset(name = 'normal') {
  const preset = String(name || 'normal').toLowerCase();
  if (preset === 'cinematic') {
    _livePreviewFilter = { brightness: -8, contrast: 126, saturation: 88, blur: 1 };
  } else if (preset === 'vivid') {
    _livePreviewFilter = { brightness: 4, contrast: 115, saturation: 138, blur: 0 };
  } else if (preset === 'warm') {
    _livePreviewFilter = { brightness: 7, contrast: 105, saturation: 118, blur: 0 };
  } else if (preset === 'noir') {
    _livePreviewFilter = { brightness: -4, contrast: 145, saturation: 0, blur: 0 };
  } else {
    _livePreviewFilter = { brightness: 0, contrast: 100, saturation: 100, blur: 0 };
  }

  const b = document.getElementById('live-filter-brightness');
  const c = document.getElementById('live-filter-contrast');
  const s = document.getElementById('live-filter-saturation');
  const blur = document.getElementById('live-filter-blur');
  if (b) b.value = String(_livePreviewFilter.brightness);
  if (c) c.value = String(_livePreviewFilter.contrast);
  if (s) s.value = String(_livePreviewFilter.saturation);
  if (blur) blur.value = String(_livePreviewFilter.blur);

  const wrap = document.getElementById('live-filter-presets');
  if (wrap) {
    wrap.querySelectorAll('[data-live-filter-preset]').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.liveFilterPreset === preset);
    });
  }

  applyLivePreviewFilter();
  publishLiveFilterRealtime();
}

function syncLivePreviewFilterFromInputs() {
  const b = document.getElementById('live-filter-brightness');
  const c = document.getElementById('live-filter-contrast');
  const s = document.getElementById('live-filter-saturation');
  const blur = document.getElementById('live-filter-blur');
  _livePreviewFilter = {
    brightness: Number(b ? b.value : 0),
    contrast: Number(c ? c.value : 100),
    saturation: Number(s ? s.value : 100),
    blur: Number(blur ? blur.value : 0),
  };
  _livePreviewFilter = sanitizeLiveFilterPayload(_livePreviewFilter);
  applyLivePreviewFilter();
  publishLiveFilterRealtime();
}

function bindLiveFilterControls() {
  const presetsWrap = document.getElementById('live-filter-presets');
  const resetBtn = document.getElementById('live-filter-reset');
  const b = document.getElementById('live-filter-brightness');
  const c = document.getElementById('live-filter-contrast');
  const s = document.getElementById('live-filter-saturation');
  const blur = document.getElementById('live-filter-blur');

  if (presetsWrap) {
    presetsWrap.querySelectorAll('[data-live-filter-preset]').forEach((btn) => {
      btn.onclick = () => setLivePreviewPreset(btn.dataset.liveFilterPreset || 'normal');
    });
  }
  if (resetBtn) resetBtn.onclick = () => setLivePreviewPreset('normal');

  [b, c, s, blur].forEach((el) => {
    if (!el) return;
    el.oninput = () => {
      const wrap = document.getElementById('live-filter-presets');
      if (wrap) {
        wrap.querySelectorAll('[data-live-filter-preset]').forEach((btn) => btn.classList.remove('active'));
      }
      syncLivePreviewFilterFromInputs();
    };
  });

  setLivePreviewPreset('normal');
}

async function fetchLiveSessions() {
  try {
    const res = await fetch(_liveListUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (!res.ok) throw new Error('live list failed');
    const json = await res.json();
    if (!json.ok) return;
    _liveSessions = Array.isArray(json.sessions) ? json.sessions : [];
    renderLiveStrip();
  } catch (_) {}
}

function renderLiveStrip() {
  const storiesRow = document.getElementById('stories-row');
  const startBtn = document.getElementById('live-start-btn');
  if (!storiesRow || !startBtn) return;

  storiesRow.querySelectorAll('.live-story-bbl').forEach(node => node.remove());

  if (_currentUserId === null) {
    startBtn.textContent = 'Login to go live';
  } else {
    const mine = _liveSessions.find(s => s && s.isHost && s.status === 'live');
    startBtn.textContent = mine ? 'Resume Live' : 'Go Live';
    startBtn.dataset.liveResumeId = mine ? String(mine.id) : '';
  }

  if (!_liveSessions.length) {
    return;
  }

  const cards = _liveSessions.map(s => {
    const host = s.host && s.host.name ? s.host.name : 'Host';
    const av = host.charAt(0).toUpperCase() || 'U';
    const cta = s.isHost ? 'Resume' : 'Join live';
    return `<div class="story-bbl live-story-bbl" title="${escapeHtml(host)} is live">
      <button type="button" class="story-ring live-story-ring" data-live-open-id="${Number(s.id)}" data-live-host="${s.isHost ? '1' : '0'}" aria-label="${cta} ${escapeHtml(host)} live">
        <span class="live-story-badge">LIVE</span>
        <div class="story-inner">${escapeHtml(av)}</div>
      </button>
      <span class="story-lbl">${escapeHtml(host.split(' ')[0] || host)}</span>
    </div>`;
  });

  storiesRow.insertAdjacentHTML('afterbegin', cards.join(''));
}

async function startLiveSession() {
  if (_currentUserId === null) {
    window.location.href = _liveLoginUrl;
    return;
  }

  const resumeId = Number(document.getElementById('live-start-btn')?.dataset.liveResumeId || 0);
  if (resumeId > 0) {
    await openLiveModal(resumeId, true);
    return;
  }

  const titleInput = window.prompt('Live title', `${_liveCurrentUserName || 'My'} live session`) || '';
  const form = new FormData();
  form.append('title', titleInput);
  form.append('_hp', '');
  form.append('_recaptcha_token', await window.tripxGetRecaptchaToken('live_start'));

  try {
    const res = await fetch(_liveStartUrl, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: form,
    });
    const json = await res.json();
    if (!res.ok || !json.ok || !json.session || !json.session.id) throw new Error(json.message || 'Could not start live');
    await fetchLiveSessions();
    await openLiveModal(Number(json.session.id), true);
  } catch (e) {
    showToast(e.message || 'Could not start live');
  }
}

async function openLiveModal(sessionId, isHost = false) {
  if (_currentUserId === null) {
    window.location.href = _liveLoginUrl;
    return;
  }

  const modal = document.getElementById('live-modal');
  if (!modal) return;

  _liveActiveSessionId = Number(sessionId || 0);
  _liveActiveIsHost = !!isHost;
  _liveReactionCountsSeen = null;
  _liveReactionBurstSuppress = {};

  if (!_liveActiveSessionId) return;

  if (!_liveActiveIsHost) {
    try {
      await fetch(buildLiveIdUrl(_liveJoinUrlPattern, _liveActiveSessionId), {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      });
    } catch (_) {}
  }

  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('story-editor-open');

  const endBtn = document.getElementById('live-end-btn');
  const leaveBtn = document.getElementById('live-leave-btn');
  const stageSub = document.getElementById('live-stage-sub');
  const comments = document.getElementById('live-comments');
  const filterControls = document.getElementById('live-filter-controls');

  if (comments) comments.innerHTML = '<div class="live-empty">Loading live comments...</div>';
  if (endBtn) endBtn.style.display = _liveActiveIsHost ? '' : 'none';
  if (leaveBtn) leaveBtn.textContent = _liveActiveIsHost ? 'Close' : 'Leave';
  if (stageSub) stageSub.textContent = _liveActiveIsHost ? 'You are live' : 'Watching live stream';
  if (filterControls) filterControls.style.display = _liveActiveIsHost ? 'grid' : 'none';
  setLivePreviewPreset('normal');

  await toggleLocalLivePreview(_liveActiveIsHost);
  await connectLiveTransport();
  await fetchLiveState();

  if (_liveStatePollTimer) clearInterval(_liveStatePollTimer);
  _liveStatePollTimer = setInterval(fetchLiveState, 3000);
}

async function closeLiveModal(shouldLeave = true) {
  const modal = document.getElementById('live-modal');
  if (modal) {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }

  if (shouldLeave && _liveActiveSessionId && !_liveActiveIsHost) {
    try {
      await fetch(buildLiveIdUrl(_liveLeaveUrlPattern, _liveActiveSessionId), {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      });
    } catch (_) {}
  }

  if (_liveStatePollTimer) {
    clearInterval(_liveStatePollTimer);
    _liveStatePollTimer = null;
  }

  await disconnectLiveTransport();
  await toggleLocalLivePreview(false);
  _liveReactionCountsSeen = null;
  _liveReactionBurstSuppress = {};
  _liveActiveSessionId = null;
  _liveActiveIsHost = false;
  const filterControls = document.getElementById('live-filter-controls');
  if (filterControls) filterControls.style.display = 'none';

  if (!document.getElementById('story-editor-modal')?.classList.contains('open') && !document.getElementById('story-source-sheet')?.classList.contains('open') && !document.getElementById('story-camera-modal')?.classList.contains('open') && !document.getElementById('live-edit-modal')?.classList.contains('open')) {
    document.body.classList.remove('story-editor-open');
  }
}

async function toggleLocalLivePreview(show) {
  const video = document.getElementById('live-local-video');
  const placeholder = document.getElementById('live-video-placeholder');
  const stageSub = document.getElementById('live-stage-sub');
  if (!video || !placeholder) return;

  const showWatcherPlaceholder = _liveActiveIsHost;

  if (!show) {
    await stopLiveRecordingCapture();
    if (_liveLocalStream) {
      _liveLocalStream.getTracks().forEach(track => track.stop());
      _liveLocalStream = null;
    }
    video.srcObject = null;
    video.style.transform = '';
    video.style.filter = '';
    video.style.display = 'none';
    placeholder.style.display = showWatcherPlaceholder ? '' : 'none';
    return;
  }

  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    if (stageSub && _liveActiveIsHost) stageSub.textContent = 'Camera preview is not supported in this browser';
    placeholder.style.display = showWatcherPlaceholder ? '' : 'none';
    return;
  }

  try {
    try {
      _liveLocalStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
      if (stageSub && _liveActiveIsHost) stageSub.textContent = 'You are live';
    } catch (_) {
      // Fallback for browsers/users that deny microphone but allow camera.
      _liveLocalStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
      if (stageSub && _liveActiveIsHost) stageSub.textContent = 'Live video on (microphone blocked)';
    }

    video.srcObject = _liveLocalStream;
    video.muted = true;
    video.playsInline = true;
    video.style.transform = 'scaleX(-1)';
    applyLivePreviewFilter();
    try {
      await video.play();
    } catch (_) {}
    video.style.display = 'block';
    placeholder.style.display = 'none';
    await startLiveRecordingCapture(_liveLocalStream);
  } catch (_) {
    if (stageSub && _liveActiveIsHost) stageSub.textContent = 'Allow camera access to show live preview';
    placeholder.style.display = showWatcherPlaceholder ? '' : 'none';
  }
}

async function startLiveRecordingCapture(stream) {
  if (!_liveActiveIsHost) return;
  if (!_liveActiveSessionId) return;
  if (!stream) return;
  if (typeof window.MediaRecorder === 'undefined') return;
  if (_liveRecorder && _liveRecorder.state === 'recording') return;

  const buildCompositeStream = () => {
    const video = document.getElementById('live-local-video');
    if (!video || typeof document.createElement !== 'function') return null;

    const width = 1280;
    const height = 720;
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;

    const streamOut = typeof canvas.captureStream === 'function' ? canvas.captureStream(24) : null;
    if (!streamOut) return null;

    _liveCompositeCanvas = canvas;
    _liveCompositeCtx = ctx;
    _liveCompositeStream = streamOut;

    // Keep host microphone in replay.
    try {
      const tracks = stream.getAudioTracks ? stream.getAudioTracks() : [];
      tracks.forEach((track) => {
        try { streamOut.addTrack(track); } catch (_) {}
      });
    } catch (_) {}

    const drawFrame = () => {
      if (!_liveCompositeCtx || !_liveCompositeCanvas) return;

      const c = _liveCompositeCanvas;
      const g = _liveCompositeCtx;
      const w = c.width;
      const h = c.height;
      const panelW = Math.floor(w * 0.30);
      const stageW = w - panelW;
      const now = Date.now();

      g.fillStyle = '#0b1220';
      g.fillRect(0, 0, w, h);

      // Stage area (left): actual live video.
      g.fillStyle = '#000';
      g.fillRect(0, 0, stageW, h);
      try {
        if (video.readyState >= 2) {
          const b = Number(_livePreviewFilter.brightness || 0);
          const cVal = Number(_livePreviewFilter.contrast || 100);
          const sVal = Number(_livePreviewFilter.saturation || 100);
          const blurVal = Number(_livePreviewFilter.blur || 0);
          g.filter = `brightness(${1 + (b / 100)}) contrast(${cVal / 100}) saturate(${sVal / 100}) blur(${blurVal}px)`;
          g.drawImage(video, 0, 0, stageW, h);
          g.filter = 'none';
        }
      } catch (_) {}

      // Header overlays.
      const titleEl = document.getElementById('live-title-label');
      const hostEl = document.getElementById('live-host-name');
      const metaEl = document.getElementById('live-meta-line');
      const title = titleEl ? String(titleEl.textContent || '') : 'Live session';
      const host = hostEl ? String(hostEl.textContent || '') : 'Host';
      const meta = metaEl ? String(metaEl.textContent || '') : '';

      g.fillStyle = 'rgba(0,0,0,0.42)';
      g.fillRect(0, 0, stageW, 84);
      g.fillStyle = '#ffffff';
      g.font = '700 26px Montserrat, sans-serif';
      g.fillText(title.slice(0, 48), 20, 34);
      g.font = '600 18px Montserrat, sans-serif';
      g.fillText(host.slice(0, 32), 20, 58);
      g.font = '500 16px Montserrat, sans-serif';
      g.fillStyle = '#cbd5e1';
      g.fillText(meta.slice(0, 52), 20, 78);

      // Reactions floating on stage.
      _liveRecorderFxBursts = _liveRecorderFxBursts.filter((b) => now - b.startedAt < 1600);
      _liveRecorderFxBursts.forEach((b) => {
        const age = now - b.startedAt;
        const t = Math.max(0, Math.min(1, age / 1600));
        const x = b.x * stageW;
        const y = h - 120 - t * 220;
        g.globalAlpha = 1 - t;
        g.font = '700 54px "Segoe UI Emoji", "Apple Color Emoji", sans-serif';
        g.fillStyle = '#ffffff';
        g.fillText(b.emoji, x, y);
        g.globalAlpha = 1;
      });

      // Chat/comments panel (right).
      g.fillStyle = '#0f172a';
      g.fillRect(stageW, 0, panelW, h);
      g.fillStyle = '#ffffff';
      g.font = '700 24px Montserrat, sans-serif';
      g.fillText('Live chat', stageW + 16, 34);

      const comments = Array.from(document.querySelectorAll('#live-comments .live-c-row'))
        .map((el) => String(el.textContent || '').trim())
        .filter(Boolean)
        .slice(-16);

      let y = 68;
      g.font = '500 15px Montserrat, sans-serif';
      comments.forEach((line) => {
        if (y > h - 20) return;
        const maxChars = 42;
        const text = line.length > maxChars ? `${line.slice(0, maxChars - 1)}…` : line;
        g.fillStyle = '#e2e8f0';
        g.fillText(text, stageW + 14, y);
        y += 24;
      });
    };

    drawFrame();
    _liveCompositeAnimTimer = setInterval(drawFrame, 1000 / 24);
    return streamOut;
  };

  const composite = buildCompositeStream();
  const recordStream = composite || stream;

  try {
    _liveRecordingChunks = [];
    _liveRecordingBlob = null;
    _liveRecorder = new MediaRecorder(recordStream, { mimeType: 'video/webm;codecs=vp8,opus' });
  } catch (_) {
    try {
      _liveRecorder = new MediaRecorder(recordStream);
    } catch (_) {
      _liveRecorder = null;
      return;
    }
  }

  _liveRecorder.ondataavailable = (event) => {
    if (!event || !event.data || event.data.size <= 0) return;
    _liveRecordingChunks.push(event.data);
  };

  _liveRecorder.start(1000);
}

async function stopLiveRecordingCapture() {
  if (!_liveRecorder) return _liveRecordingBlob;
  if (_liveRecorder.state === 'inactive') return _liveRecordingBlob;

  await new Promise(resolve => {
    const recorder = _liveRecorder;
    recorder.onstop = () => {
      _liveRecordingBlob = _liveRecordingChunks.length
        ? new Blob(_liveRecordingChunks, { type: _liveRecordingChunks[0].type || 'video/webm' })
        : null;
      _liveRecorder = null;
      _liveRecordingChunks = [];

      if (_liveCompositeAnimTimer) {
        clearInterval(_liveCompositeAnimTimer);
        _liveCompositeAnimTimer = null;
      }
      _liveCompositeStream = null;
      _liveCompositeCanvas = null;
      _liveCompositeCtx = null;
      _liveRecorderFxBursts = [];

      resolve();
    };
    try {
      if (typeof recorder.requestData === 'function') {
        try { recorder.requestData(); } catch (_) {}
      }
      recorder.stop();
    } catch (_) {
      _liveRecorder = null;
      _liveRecordingChunks = [];
      resolve();
    }
  });

  return _liveRecordingBlob;
}

async function uploadLiveRecording(sessionId, blob) {
  if (!sessionId || !blob) return;
  const ext = blob.type && blob.type.includes('mp4') ? 'mp4' : 'webm';
  const uploadId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
  const chunkSize = 1024 * 1024;
  const totalChunks = Math.max(1, Math.ceil(blob.size / chunkSize));

  for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex += 1) {
    const start = chunkIndex * chunkSize;
    const end = Math.min(blob.size, start + chunkSize);
    const chunkBlob = blob.slice(start, end, blob.type || 'video/webm');
    const form = new FormData();
    form.append('recordingChunk', chunkBlob, `live-${sessionId}-${chunkIndex}.${ext}`);
    form.append('uploadId', uploadId);
    form.append('chunkIndex', String(chunkIndex));
    form.append('totalChunks', String(totalChunks));
    form.append('ext', ext);

    const res = await fetch(buildLiveIdUrl(_liveRecordingUploadUrlPattern, sessionId), {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: form,
    });
    const json = await res.json();
    if (!res.ok || !json.ok) {
      throw new Error(json.message || 'Could not upload live recording');
    }
  }
}

function formatLiveSeconds(total) {
  const s = Math.max(0, Math.floor(Number(total) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = s % 60;
  if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
  return `${m}:${String(sec).padStart(2, '0')}`;
}

function closeLiveEditModal(resultBlob = null) {
  const modal = document.getElementById('live-edit-modal');
  const preview = document.getElementById('live-edit-preview');
  const status = document.getElementById('live-edit-status');

  if (modal) {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }
  if (preview) {
    try { preview.pause(); } catch (_) {}
    preview.removeAttribute('src');
    preview.load();
  }
  if (status) status.textContent = '';

  if (_liveEditObjectUrl) {
    URL.revokeObjectURL(_liveEditObjectUrl);
    _liveEditObjectUrl = null;
  }

  const resolve = _liveEditResolve;
  _liveEditResolve = null;
  if (typeof resolve === 'function') {
    resolve(resultBlob);
  }

  if (!document.getElementById('story-editor-modal')?.classList.contains('open') && !document.getElementById('story-source-sheet')?.classList.contains('open') && !document.getElementById('story-camera-modal')?.classList.contains('open') && !document.getElementById('live-modal')?.classList.contains('open')) {
    document.body.classList.remove('story-editor-open');
  }
}

async function trimRecordedBlob(blob, startSec, endSec) {
  const start = Math.max(0, Number(startSec) || 0);
  const end = Math.max(start, Number(endSec) || 0);
  if (end - start < 0.2) return blob;

  const srcUrl = URL.createObjectURL(blob);
  const video = document.createElement('video');
  video.src = srcUrl;
  video.preload = 'auto';

  await new Promise((resolve, reject) => {
    video.onloadedmetadata = () => resolve();
    video.onerror = () => reject(new Error('Could not decode recording for trimming'));
  });

  if (Math.abs(start) < 0.1 && Math.abs((video.duration || 0) - end) < 0.2) {
    URL.revokeObjectURL(srcUrl);
    return blob;
  }

  if (typeof video.captureStream !== 'function') {
    URL.revokeObjectURL(srcUrl);
    return blob;
  }

  const stream = video.captureStream(30);
  let recorder;
  try {
    recorder = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp8,opus' });
  } catch (_) {
    try {
      recorder = new MediaRecorder(stream);
    } catch (_) {
      URL.revokeObjectURL(srcUrl);
      return blob;
    }
  }

  const chunks = [];
  recorder.ondataavailable = (event) => {
    if (event && event.data && event.data.size > 0) chunks.push(event.data);
  };

  const edited = await new Promise((resolve) => {
    let done = false;
    const stopNow = () => {
      if (done) return;
      done = true;
      try { video.pause(); } catch (_) {}
      try {
        if (typeof recorder.requestData === 'function') recorder.requestData();
      } catch (_) {}
      try { recorder.stop(); } catch (_) { resolve(blob); }
    };

    recorder.onstop = () => {
      if (!chunks.length) {
        resolve(blob);
        return;
      }
      resolve(new Blob(chunks, { type: chunks[0].type || 'video/webm' }));
    };

    video.addEventListener('timeupdate', () => {
      if (video.currentTime >= end - 0.02) stopNow();
    });

    recorder.start(250);
    video.currentTime = start;
    video.onseeked = async () => {
      try {
        await video.play();
      } catch (_) {
        stopNow();
      }
    };

    setTimeout(() => stopNow(), Math.max(1200, Math.ceil((end - start) * 1000) + 1200));
  });

  try {
    stream.getTracks().forEach((t) => t.stop());
  } catch (_) {}
  URL.revokeObjectURL(srcUrl);
  return edited;
}

async function processLiveReplayInBrowser(blob, options, onStatus, onProgress) {
  const start = Math.max(0, Number(options?.start ?? 0));
  const endInput = Number(options?.end ?? 0);
  const brightness = Math.max(-100, Math.min(100, Number(options?.brightness ?? 0)));
  const contrast = Math.max(0, Number(options?.contrast ?? 100));
  const saturation = Math.max(0, Number(options?.saturation ?? 100));
  const blur = Math.max(0, Number(options?.blur ?? 0));

  const srcUrl = URL.createObjectURL(blob);
  const video = document.createElement('video');
  video.src = srcUrl;
  video.preload = 'auto';
  video.muted = false;
  video.playsInline = true;

  await new Promise((resolve, reject) => {
    video.onloadedmetadata = () => resolve();
    video.onerror = () => reject(new Error('Could not decode recording for browser processing'));
  });

  const duration = Math.max(0, Number(video.duration || 0));
  const end = endInput > 0 ? Math.min(duration || endInput, endInput) : duration;
  const safeEnd = Math.max(start, end);

  if (safeEnd - start < 0.2) {
    URL.revokeObjectURL(srcUrl);
    return blob;
  }

  if (typeof document.createElement !== 'function') {
    URL.revokeObjectURL(srcUrl);
    return blob;
  }

  const width = Math.max(2, Number(video.videoWidth || 1280));
  const height = Math.max(2, Number(video.videoHeight || 720));
  const canvas = document.createElement('canvas');
  canvas.width = width;
  canvas.height = height;
  const ctx = canvas.getContext('2d');
  if (!ctx || typeof canvas.captureStream !== 'function') {
    URL.revokeObjectURL(srcUrl);
    return blob;
  }

  const filterCss = `brightness(${1 + (brightness / 100)}) contrast(${contrast / 100}) saturate(${saturation / 100}) blur(${blur}px)`;
  const outStream = canvas.captureStream(30);

  try {
    if (typeof video.captureStream === 'function') {
      const sourceStream = video.captureStream();
      sourceStream.getAudioTracks().forEach((track) => {
        try { outStream.addTrack(track); } catch (_) {}
      });
    }
  } catch (_) {}

  let recorder;
  try {
    recorder = new MediaRecorder(outStream, { mimeType: 'video/webm;codecs=vp8,opus' });
  } catch (_) {
    try {
      recorder = new MediaRecorder(outStream);
    } catch (_) {
      URL.revokeObjectURL(srcUrl);
      return blob;
    }
  }

  const chunks = [];
  recorder.ondataavailable = (event) => {
    if (event && event.data && event.data.size > 0) chunks.push(event.data);
  };

  if (typeof onStatus === 'function') onStatus('Applying edits in browser...');

  const output = await new Promise((resolve) => {
    let raf = 0;
    let finished = false;
    const total = Math.max(0.001, safeEnd - start);

    const finish = () => {
      if (finished) return;
      finished = true;
      if (raf) cancelAnimationFrame(raf);
      try { video.pause(); } catch (_) {}
      try {
        if (typeof recorder.requestData === 'function') recorder.requestData();
      } catch (_) {}
      try {
        if (recorder.state !== 'inactive') recorder.stop();
      } catch (_) {
        resolve(blob);
      }
    };

    const draw = () => {
      if (finished) return;
      try {
        ctx.filter = filterCss;
        ctx.drawImage(video, 0, 0, width, height);
        ctx.filter = 'none';
      } catch (_) {}

      const ratio = Math.max(0, Math.min(1, (Number(video.currentTime || 0) - start) / total));
      if (typeof onProgress === 'function') onProgress(ratio);

      if (Number(video.currentTime || 0) >= safeEnd - 0.03) {
        finish();
        return;
      }
      raf = requestAnimationFrame(draw);
    };

    recorder.onstop = () => {
      if (!chunks.length) {
        resolve(blob);
        return;
      }
      if (typeof onProgress === 'function') onProgress(1);
      if (typeof onStatus === 'function') onStatus('Edited replay ready.');
      resolve(new Blob(chunks, { type: chunks[0].type || 'video/webm' }));
    };

    video.addEventListener('ended', finish);
    video.addEventListener('timeupdate', () => {
      if (Number(video.currentTime || 0) >= safeEnd - 0.03) finish();
    });

    recorder.start(250);
    video.currentTime = start;
    video.onseeked = async () => {
      try {
        await video.play();
        draw();
      } catch (_) {
        finish();
      }
    };

    setTimeout(() => finish(), Math.max(1500, Math.ceil(total * 1000) + 2000));
  });

  try {
    outStream.getTracks().forEach((t) => t.stop());
  } catch (_) {}
  URL.revokeObjectURL(srcUrl);
  return output;
}

async function loadLiveFfmpegWasm() {
  if (_liveFfmpeg) return _liveFfmpeg;
  if (_liveFfmpegLoadPromise) return _liveFfmpegLoadPromise;

  _liveFfmpegLoadPromise = (async () => {
    const ff = window.FFmpeg;
    if (!ff || typeof ff.createFFmpeg !== 'function') {
      throw new Error('FFmpeg.wasm runtime unavailable');
    }

    const corePath = 'https://unpkg.com/@ffmpeg/core@0.11.0/dist/ffmpeg-core.js';
    const engine = ff.createFFmpeg({ log: false, corePath });
    await engine.load();
    _liveFfmpeg = engine;
    return engine;
  })();

  return _liveFfmpegLoadPromise;
}

async function processLiveReplayWithFfmpeg(blob, options, onStatus, onProgress) {
  const start = Math.max(0, Number(options?.start ?? 0));
  const end = Math.max(start, Number(options?.end ?? 0));
  const brightness = Number(options?.brightness ?? 0);
  const contrast = Number(options?.contrast ?? 100);
  const saturation = Number(options?.saturation ?? 100);
  const blur = Number(options?.blur ?? 0);

  const noTrim = Math.abs(start) < 0.1 && (!Number.isFinite(end) || end <= 0);
  const noFx = brightness === 0 && contrast === 100 && saturation === 100 && blur === 0;
  if (noTrim && noFx) return blob;

  try {
    if (typeof onStatus === 'function') onStatus('Loading FFmpeg.wasm...');
    const engine = await loadLiveFfmpegWasm();
    const ff = window.FFmpeg;
    const inputName = `live-input-${Date.now()}.webm`;
    const outputName = `live-output-${Date.now()}.webm`;
    engine.FS('writeFile', inputName, await ff.fetchFile(blob));

    const vf = [];
    if (brightness !== 0 || contrast !== 100 || saturation !== 100) {
      const b = Math.max(-1, Math.min(1, brightness / 100));
      const c = Math.max(0, contrast / 100);
      const s = Math.max(0, saturation / 100);
      vf.push(`eq=brightness=${b.toFixed(3)}:contrast=${c.toFixed(3)}:saturation=${s.toFixed(3)}`);
    }
    if (blur > 0) {
      vf.push(`gblur=sigma=${Math.max(0.1, blur / 2).toFixed(2)}`);
    }

    const args = [];
    if (start > 0) {
      args.push('-ss', `${start.toFixed(2)}`);
    }
    if (end > 0) {
      args.push('-to', `${end.toFixed(2)}`);
    }
    args.push('-i', inputName);
    if (vf.length) {
      args.push('-vf', vf.join(','));
    }
    args.push('-c:v', 'libvpx-vp9', '-b:v', '1200k', '-c:a', 'libopus', '-b:a', '96k', outputName);

    if (typeof engine.setProgress === 'function') {
      engine.setProgress(({ ratio }) => {
        if (typeof onProgress === 'function') {
          onProgress(Number.isFinite(ratio) ? Math.max(0, Math.min(1, ratio)) : 0);
        }
      });
    }

    if (typeof onStatus === 'function') onStatus('Applying trim and filters with FFmpeg...');
    await engine.run(...args);

    if (typeof engine.setProgress === 'function') {
      engine.setProgress(() => {});
    }

    const data = engine.FS('readFile', outputName);
    try { engine.FS('unlink', inputName); } catch (_) {}
    try { engine.FS('unlink', outputName); } catch (_) {}

    if (typeof onStatus === 'function') onStatus('Edited replay ready.');
    if (typeof onProgress === 'function') onProgress(1);
    return new Blob([data.buffer], { type: 'video/webm' });
  } catch (_) {
    // Fallback if FFmpeg fails in browser/runtime: still apply trim + visual edits.
    return processLiveReplayInBrowser(blob, { start, end, brightness, contrast, saturation, blur }, onStatus, onProgress);
  }
}

async function openLiveRecordingEditor(blob) {
  const modal = document.getElementById('live-edit-modal');
  const preview = document.getElementById('live-edit-preview');
  const startInput = document.getElementById('live-edit-start');
  const endInput = document.getElementById('live-edit-end');
  const brightnessInput = document.getElementById('live-edit-brightness');
  const contrastInput = document.getElementById('live-edit-contrast');
  const saturationInput = document.getElementById('live-edit-saturation');
  const blurInput = document.getElementById('live-edit-blur');
  const resetFiltersBtn = document.getElementById('live-edit-reset-filters');
  const presetsWrap = document.getElementById('live-edit-presets');
  const progressWrap = document.getElementById('live-edit-progress');
  const progressBar = document.getElementById('live-edit-progress-bar');
  const timeLabel = document.getElementById('live-edit-time');
  const status = document.getElementById('live-edit-status');
  const saveBtn = document.getElementById('live-edit-save');
  const cancelBtn = document.getElementById('live-edit-cancel');
  const closeBtn = document.getElementById('live-edit-close');

  if (!modal || !preview || !startInput || !endInput || !brightnessInput || !contrastInput || !saturationInput || !blurInput || !timeLabel || !status || !saveBtn || !cancelBtn) {
    return blob;
  }

  if (_liveEditObjectUrl) {
    URL.revokeObjectURL(_liveEditObjectUrl);
    _liveEditObjectUrl = null;
  }

  _liveEditObjectUrl = URL.createObjectURL(blob);
  preview.src = _liveEditObjectUrl;

  await new Promise((resolve) => {
    preview.onloadedmetadata = () => resolve();
    preview.onerror = () => resolve();
  });

  const duration = Math.max(0, Number(preview.duration || 0));
  startInput.min = '0';
  startInput.max = String(duration || 0);
  startInput.step = '0.1';
  startInput.value = '0';

  endInput.min = '0';
  endInput.max = String(duration || 0);
  endInput.step = '0.1';
  endInput.value = String(duration || 0);
  brightnessInput.value = '0';
  contrastInput.value = '100';
  saturationInput.value = '100';
  blurInput.value = '0';

  const syncLabel = () => {
    const s = Math.max(0, Number(startInput.value || 0));
    const e = Math.max(s, Number(endInput.value || 0));
    if (Number(endInput.value || 0) < s) endInput.value = String(s);
    timeLabel.textContent = `${formatLiveSeconds(s)} - ${formatLiveSeconds(e)} (duration ${formatLiveSeconds(e - s)})`;
  };

  startInput.oninput = () => {
    const s = Number(startInput.value || 0);
    if (Number(endInput.value || 0) < s) endInput.value = String(s);
    syncLabel();
    preview.currentTime = s;
  };
  endInput.oninput = () => {
    const e = Number(endInput.value || 0);
    if (Number(startInput.value || 0) > e) startInput.value = String(e);
    syncLabel();
  };

  const updatePreviewFilter = () => {
    const b = Math.max(-100, Math.min(100, Number(brightnessInput.value || 0)));
    const c = Math.max(0, Number(contrastInput.value || 100));
    const s = Math.max(0, Number(saturationInput.value || 100));
    const blur = Math.max(0, Number(blurInput.value || 0));
    preview.style.filter = `brightness(${1 + (b / 100)}) contrast(${c / 100}) saturate(${s / 100}) blur(${blur}px)`;
  };

  const setPreset = (name) => {
    const preset = String(name || 'normal').toLowerCase();
    if (preset === 'cinematic') {
      brightnessInput.value = '-8';
      contrastInput.value = '126';
      saturationInput.value = '88';
      blurInput.value = '1';
    } else if (preset === 'vivid') {
      brightnessInput.value = '4';
      contrastInput.value = '115';
      saturationInput.value = '138';
      blurInput.value = '0';
    } else if (preset === 'warm') {
      brightnessInput.value = '7';
      contrastInput.value = '105';
      saturationInput.value = '118';
      blurInput.value = '0';
    } else if (preset === 'noir') {
      brightnessInput.value = '-4';
      contrastInput.value = '145';
      saturationInput.value = '0';
      blurInput.value = '0';
    } else {
      brightnessInput.value = '0';
      contrastInput.value = '100';
      saturationInput.value = '100';
      blurInput.value = '0';
    }
    updatePreviewFilter();
    if (presetsWrap) {
      presetsWrap.querySelectorAll('[data-live-preset]').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.livePreset === preset);
      });
    }
  };

  if (presetsWrap) {
    presetsWrap.querySelectorAll('[data-live-preset]').forEach((btn) => {
      btn.onclick = () => setPreset(btn.dataset.livePreset || 'normal');
    });
  }

  brightnessInput.oninput = updatePreviewFilter;
  contrastInput.oninput = updatePreviewFilter;
  saturationInput.oninput = updatePreviewFilter;
  blurInput.oninput = updatePreviewFilter;
  if (resetFiltersBtn) {
    resetFiltersBtn.onclick = () => {
      setPreset('normal');
    };
  }
  setPreset('normal');
  syncLabel();

  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('story-editor-open');

  return await new Promise((resolve) => {
    _liveEditResolve = resolve;

    const cancel = () => closeLiveEditModal(null);
    const save = async () => {
      saveBtn.disabled = true;
      cancelBtn.disabled = true;
      if (closeBtn) closeBtn.disabled = true;
      status.textContent = 'Preparing FFmpeg edit...';
      if (progressWrap) progressWrap.classList.add('visible');
      if (progressBar) progressBar.style.width = '0%';
      try {
        const s = Number(startInput.value || 0);
        const e = Number(endInput.value || 0);
        const edited = await processLiveReplayWithFfmpeg(blob, {
          start: s,
          end: e,
          brightness: Number(brightnessInput.value || 0),
          contrast: Number(contrastInput.value || 100),
          saturation: Number(saturationInput.value || 100),
          blur: Number(blurInput.value || 0),
        }, (msg) => {
          status.textContent = msg;
        }, (ratio) => {
          if (progressBar) {
            const pct = Math.max(0, Math.min(100, Math.round((Number(ratio) || 0) * 100)));
            progressBar.style.width = `${pct}%`;
          }
        });
        closeLiveEditModal(edited);
      } catch (_) {
        closeLiveEditModal(blob);
      } finally {
        if (progressWrap) progressWrap.classList.remove('visible');
        if (progressBar) progressBar.style.width = '0%';
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        if (closeBtn) closeBtn.disabled = false;
      }
    };

    saveBtn.onclick = save;
    cancelBtn.onclick = cancel;
    if (closeBtn) closeBtn.onclick = cancel;
    modal.onclick = (event) => {
      if (event.target === modal) cancel();
    };
  });
}

async function ensureLiveKitClientLoaded() {
  if (_liveKitLib) return _liveKitLib;
  if (_liveKitLoadPromise) return _liveKitLoadPromise;

  _liveKitLoadPromise = new Promise((resolve, reject) => {
    const existing = document.querySelector('script[data-livekit-client="1"]');
    if (existing) {
      existing.addEventListener('load', () => {
        _liveKitLib = window.LivekitClient || null;
        if (_liveKitLib) resolve(_liveKitLib);
        else reject(new Error('LiveKit client failed to initialize'));
      }, { once: true });
      existing.addEventListener('error', () => reject(new Error('Failed to load LiveKit client')), { once: true });
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/livekit-client@2.15.8/dist/livekit-client.umd.min.js';
    script.async = true;
    script.dataset.livekitClient = '1';
    script.addEventListener('load', () => {
      _liveKitLib = window.LivekitClient || null;
      if (_liveKitLib) resolve(_liveKitLib);
      else reject(new Error('LiveKit client failed to initialize'));
    }, { once: true });
    script.addEventListener('error', () => reject(new Error('Failed to load LiveKit client')), { once: true });
    document.head.appendChild(script);
  });

  return _liveKitLoadPromise;
}

async function connectLiveTransport() {
  if (!_liveActiveSessionId) return;

  const stageSub = document.getElementById('live-stage-sub');
  const video = document.getElementById('live-local-video');
  const placeholder = document.getElementById('live-video-placeholder');
  const status = document.getElementById('live-status-line');

  const attachTrackToStage = async (track) => {
    if (!video || !track) return false;
    if (track.kind !== 'video') return false;
    track.attach(video);
    // Keep autoplay reliable across browsers for watcher mode.
    video.muted = true;
    video.playsInline = true;
    video.style.transform = _liveActiveIsHost ? 'scaleX(-1)' : 'none';
    applyLivePreviewFilter();
    video.style.display = 'block';
    try {
      await video.play();
    } catch (_) {
      // Retry once with strict autoplay-safe flags.
      video.muted = true;
      video.autoplay = true;
      try {
        await video.play();
      } catch (_) {}
    }
    if (placeholder) placeholder.style.display = 'none';
    if (stageSub && !_liveActiveIsHost) stageSub.textContent = 'Watching live stream';
    return true;
  };

  try {
    await disconnectLiveTransport();
    const LK = await ensureLiveKitClientLoaded();

    const tokenRes = await fetch(buildLiveIdUrl(_liveTokenUrlPattern, _liveActiveSessionId), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const tokenJson = await tokenRes.json();
    if (!tokenRes.ok || !tokenJson.ok || !tokenJson.token || !tokenJson.wsUrl) {
      throw new Error(tokenJson.message || 'Live transport token unavailable');
    }

    const room = new LK.Room({ adaptiveStream: true, dynacast: true });
    _liveKitRoom = room;

    room.on(LK.RoomEvent.DataReceived, (payload) => {
      let raw = '';
      try {
        if (typeof payload === 'string') {
          raw = payload;
        } else if (typeof TextDecoder !== 'undefined') {
          raw = new TextDecoder().decode(payload);
        } else {
          raw = Array.from(payload || []).map(v => String.fromCharCode(v)).join('');
        }
      } catch (_) {
        return;
      }

      if (!raw) return;

      let msg = null;
      try {
        msg = JSON.parse(raw);
      } catch (_) {
        return;
      }

      if (!msg || Number(msg.s || 0) !== Number(_liveActiveSessionId || 0)) return;

      if (msg.t === 'live_rxn') {
        const type = String(msg.r || '');
        if (!_liveReactionEmoji[type]) return;

        const fromUserId = Number(msg.u || 0);
        if (_currentUserId !== null && fromUserId === Number(_currentUserId)) return;

        _liveReactionBurstSuppress[type] = Number(_liveReactionBurstSuppress[type] || 0) + 1;
        showLiveReactionBurst(type);
        return;
      }

      if (msg.t === 'live_filter') {
        if (_liveActiveIsHost) return;
        _livePreviewFilter = sanitizeLiveFilterPayload(msg.f);
        applyLivePreviewFilter();
      }
    });

    room.on(LK.RoomEvent.ParticipantConnected, () => {
      if (_liveActiveIsHost) {
        publishLiveFilterRealtime();
      }
    });

    room.on(LK.RoomEvent.TrackSubscribed, async (track) => {
      await attachTrackToStage(track);
    });

    room.on(LK.RoomEvent.TrackUnsubscribed, (track) => {
      if (typeof track.detach === 'function') track.detach();
      if (!_liveActiveIsHost && video) {
        video.srcObject = null;
        video.style.display = 'none';
      }
    });

    room.on(LK.RoomEvent.Disconnected, () => {
      if (!_liveActiveIsHost && placeholder) placeholder.style.display = 'none';
      if (status) status.textContent = 'Disconnected';
    });

    await room.connect(tokenJson.wsUrl, tokenJson.token);
    if (status) status.textContent = 'Connected';

    if (_liveActiveIsHost) {
      if (_liveLocalStream) {
        const camTrack = _liveLocalStream.getVideoTracks ? _liveLocalStream.getVideoTracks()[0] : null;
        const micTrack = _liveLocalStream.getAudioTracks ? _liveLocalStream.getAudioTracks()[0] : null;
        if (camTrack) {
          try {
            await room.localParticipant.publishTrack(camTrack, { source: LK.Track.Source.Camera });
          } catch (_) {}
        }
        if (micTrack) {
          try {
            await room.localParticipant.publishTrack(micTrack, { source: LK.Track.Source.Microphone });
          } catch (_) {}
        }
      }
      if (video && _liveLocalStream) {
        video.srcObject = _liveLocalStream;
        video.style.transform = 'scaleX(-1)';
        applyLivePreviewFilter();
        video.style.display = 'block';
        try {
          await video.play();
        } catch (_) {}
      }
      if (placeholder) placeholder.style.display = 'none';
      publishLiveFilterRealtime();
    } else {
      const participants = Array.from(room.remoteParticipants.values());
      const first = participants[0];
      let attached = false;
      if (first) {
        for (const pub of first.trackPublications.values()) {
          if (attached || !pub.track || pub.track.kind !== LK.Track.Kind.Video) continue;
          attached = await attachTrackToStage(pub.track);
          if (attached) break;
        }
      }
      if (!attached) {
        for (const p of participants) {
          for (const pub of p.trackPublications.values()) {
            if (attached || !pub.track || pub.track.kind !== LK.Track.Kind.Video) continue;
            attached = await attachTrackToStage(pub.track);
            if (attached) break;
          }
          if (attached) break;
        }
      }
      if (!attached) {
        if (placeholder) placeholder.style.display = '';
        if (stageSub) stageSub.textContent = 'Waiting for host video...';
        if (video) {
          video.style.filter = 'none';
          video.style.display = 'none';
        }
      }
    }
  } catch (err) {
    const errMsg = err && err.message ? String(err.message) : 'Video transport unavailable';
    if (status) status.textContent = `Video transport unavailable: ${errMsg}`;
    if (_liveActiveIsHost) {
      if (stageSub) stageSub.textContent = 'Live without transport (configure LiveKit)';
      if (placeholder) placeholder.style.display = '';
    } else {
      if (stageSub) stageSub.textContent = 'Host video unavailable';
      if (placeholder) placeholder.style.display = '';
      if (video) {
        video.srcObject = null;
        video.style.display = 'none';
        video.style.transform = '';
        video.style.filter = '';
      }
    }
  }
}

async function disconnectLiveTransport() {
  if (!_liveKitRoom) return;
  try {
    _liveKitRoom.disconnect();
  } catch (_) {}
  _liveKitRoom = null;
}

async function fetchLiveState() {
  if (!_liveActiveSessionId) return;

  try {
    const res = await fetch(buildLiveIdUrl(_liveStateUrlPattern, _liveActiveSessionId), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const json = await res.json();
    if (!res.ok || !json.ok || !json.session) {
      await closeLiveModal(false);
      await fetchLiveSessions();
      return;
    }

    const s = json.session;
    renderLiveStateHeader(s);
    syncLiveReactionBursts(s);
    renderLiveComments(Array.isArray(json.comments) ? json.comments : []);

    if (!_liveActiveIsHost && s.status !== 'live') {
      showToast('Live has ended');
      await closeLiveModal(false);
      await fetchLiveSessions();
    }
  } catch (_) {}
}

function renderLiveStateHeader(session) {
  const hostName = session.host && session.host.name ? session.host.name : 'Host';
  const av = hostName.charAt(0).toUpperCase() || 'U';
  const title = session.title || `${hostName} is live`;
  const viewers = Number(session.viewerCount || 0);
  const reactions = Number(session.totalReactions || 0);

  const hostAv = document.getElementById('live-host-av');
  const hostNm = document.getElementById('live-host-name');
  const meta = document.getElementById('live-meta-line');
  const titleLabel = document.getElementById('live-title-label');
  const statusLine = document.getElementById('live-status-line');
  const stageSub = document.getElementById('live-stage-sub');

  if (hostAv) hostAv.textContent = av;
  if (hostNm) hostNm.textContent = hostName;
  if (meta) meta.textContent = `${viewers} watching · ${reactions} reactions`;
  if (titleLabel) titleLabel.textContent = title;
  if (statusLine) statusLine.textContent = session.status === 'live' ? 'Connected' : 'Session ended';
  if (stageSub && !_liveActiveIsHost) stageSub.textContent = session.status === 'live' ? 'Watching live stream' : 'Live ended';
}

function syncLiveReactionBursts(session) {
  const currentCounts = session && session.reactionCounts && typeof session.reactionCounts === 'object'
    ? session.reactionCounts
    : {};

  if (!_liveReactionCountsSeen) {
    _liveReactionCountsSeen = { ...currentCounts };
    return;
  }

  Object.keys(_liveReactionEmoji).forEach(type => {
    const prev = Number(_liveReactionCountsSeen[type] || 0);
    const next = Number(currentCounts[type] || 0);
    let delta = Math.max(0, next - prev);

    const suppress = Number(_liveReactionBurstSuppress[type] || 0);
    if (suppress > 0) {
      const used = Math.min(suppress, delta);
      delta -= used;
      _liveReactionBurstSuppress[type] = suppress - used;
    }

    for (let i = 0; i < delta; i += 1) {
      showLiveReactionBurst(type);
    }
  });

  _liveReactionCountsSeen = { ...currentCounts };
}

function renderLiveComments(comments) {
  const box = document.getElementById('live-comments');
  if (!box) return;

  if (!comments.length) {
    box.innerHTML = '<div class="live-empty">No comments yet. Start the conversation.</div>';
    return;
  }

  box.innerHTML = comments.map(c => {
    const nm = c.user && c.user.name ? c.user.name : 'User';
    return `<div class="live-c-row"><strong>${escapeHtml(nm)}:</strong> ${escapeHtml(c.message || '')}</div>`;
  }).join('');

  box.scrollTop = box.scrollHeight;
}

async function submitLiveComment(event) {
  event.preventDefault();
  if (!_liveActiveSessionId) return;

  const input = document.getElementById('live-comment-input');
  if (!input) return;
  const message = input.value.trim();
  if (!message) return;

  const form = new FormData();
  form.append('message', message);
  form.append('_hp', '');
  form.append('_recaptcha_token', await window.tripxGetRecaptchaToken('live_comment'));

  try {
    const res = await fetch(buildLiveIdUrl(_liveCommentUrlPattern, _liveActiveSessionId), {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: form,
    });
    const json = await res.json();
    if (!res.ok || !json.ok) throw new Error(json.message || 'Could not send comment');
    input.value = '';
    await fetchLiveState();
  } catch (e) {
    showToast(e.message || 'Could not send comment');
  }
}

function showLiveReactionBurst(type) {
  const box = document.getElementById('live-reaction-burst');
  if (!box) return;
  const emoji = _liveReactionEmoji[type] || '❤️';

  _liveRecorderFxBursts.push({
    emoji,
    startedAt: Date.now(),
    x: 0.18 + Math.random() * 0.56,
  });

  const el = document.createElement('span');
  el.textContent = emoji;
  box.appendChild(el);
  setTimeout(() => el.remove(), 1400);
}

async function publishLiveReactionRealtime(type) {
  if (!_liveKitRoom || !_liveKitRoom.localParticipant) return;
  if (!_liveReactionEmoji[type]) return;

  const msg = JSON.stringify({
    t: 'live_rxn',
    r: type,
    u: Number(_currentUserId || 0),
    s: Number(_liveActiveSessionId || 0),
    ts: Date.now(),
  });

  try {
    const bytes = typeof TextEncoder !== 'undefined'
      ? new TextEncoder().encode(msg)
      : Uint8Array.from(msg.split('').map(ch => ch.charCodeAt(0)));
    await _liveKitRoom.localParticipant.publishData(bytes, { reliable: false });
  } catch (_) {}
}

async function sendLiveReaction(type) {
  if (!_liveActiveSessionId || !type) return;
  try {
    const res = await fetch(buildLiveReactionUrl(_liveActiveSessionId, type), {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const json = await res.json();
    if (!res.ok || !json.ok) throw new Error(json.message || 'Could not react');
    showLiveReactionBurst(type);

    // Keep polling baseline in sync with backend counts so local sender doesn't re-burst on next poll.
    if (json.counts && typeof json.counts === 'object') {
      if (!_liveReactionCountsSeen || typeof _liveReactionCountsSeen !== 'object') {
        _liveReactionCountsSeen = {};
      }
      Object.keys(json.counts).forEach((k) => {
        const key = String(k || '').trim().toLowerCase();
        if (!key) return;
        _liveReactionCountsSeen[key] = Number(json.counts[k] || 0);
      });
    }

    await publishLiveReactionRealtime(type);
    await fetchLiveState();
  } catch (_) {}
}

async function endLiveSession() {
  if (!_liveActiveSessionId || !_liveActiveIsHost) return;

  const sessionId = Number(_liveActiveSessionId || 0);
  const endBtn = document.getElementById('live-end-btn');
  let saveToProfile = window.confirm('Store this live on your profile in the Lives section?\nPress OK to save, Cancel to end without saving.');

  if (endBtn) endBtn.disabled = true;

  const form = new FormData();
  form.append('saveToProfile', saveToProfile ? '1' : '0');

  try {
    const res = await fetch(buildLiveIdUrl(_liveEndUrlPattern, sessionId), {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: form,
    });
    const json = await res.json();
    if (!res.ok || !json.ok) throw new Error(json.message || 'Could not end live');

    // End the live immediately for everyone before running optional edit/upload flow.
    await closeLiveModal(false);
    await fetchLiveSessions();

    let recordingBlob = _liveRecordingBlob;
    if (!recordingBlob) {
      recordingBlob = await stopLiveRecordingCapture();
    }

    if (recordingBlob) {
      try {
        if (saveToProfile) {
          const editedBlob = await openLiveRecordingEditor(recordingBlob);
          if (editedBlob) {
            await uploadLiveRecording(sessionId, editedBlob);
            showToast('Live replay saved to your profile');
          }
        } else {
          await uploadLiveRecording(sessionId, recordingBlob);
          showToast('Live recording archived for admin');
        }
      } catch (uploadErr) {
        showToast(uploadErr.message || 'Live ended, but recording upload failed');
      }
    } else {
      showToast('Live ended, but no recording data was captured.');
    }
  } catch (e) {
    showToast(e.message || 'Could not end live');
  } finally {
    if (endBtn) endBtn.disabled = false;
  }
}

function setStoryAdjustmentLabel(id, value) {
  const el = document.getElementById(id);
  if (el) el.textContent = String(value);
}

function resetStoryAdjustments() {
  _storyAdjustments.brightness = 100;
  _storyAdjustments.contrast = 100;
  _storyAdjustments.saturation = 100;
  _storyAdjustments.warmth = 0;
  _storyAdjustments.fade = 0;

  const controls = [
    ['adj-brightness', 'brightness', 100],
    ['adj-contrast', 'contrast', 100],
    ['adj-saturation', 'saturation', 100],
    ['adj-warmth', 'warmth', 0],
    ['adj-fade', 'fade', 0],
  ];

  controls.forEach(([id, key, fallback]) => {
    const el = document.getElementById(id);
    if (el) el.value = String(_storyAdjustments[key] ?? fallback);
  });

  setStoryAdjustmentLabel('adj-brightness-val', _storyAdjustments.brightness);
  setStoryAdjustmentLabel('adj-contrast-val', _storyAdjustments.contrast);
  setStoryAdjustmentLabel('adj-saturation-val', _storyAdjustments.saturation);
  setStoryAdjustmentLabel('adj-warmth-val', _storyAdjustments.warmth);
  setStoryAdjustmentLabel('adj-fade-val', _storyAdjustments.fade);
}

function getStoryFilterString() {
  const preset = _storyFilterPresets[_storyActivePreset] || _storyFilterPresets.normal;
  const brightness = Math.max(40, (preset.brightness + (_storyAdjustments.brightness - 100))) / 100;
  const contrast = Math.max(40, (preset.contrast + (_storyAdjustments.contrast - 100))) / 100;
  const saturation = Math.max(0, (preset.saturation + (_storyAdjustments.saturation - 100))) / 100;
  const warmth = (preset.warmth + _storyAdjustments.warmth) * 1.2;
  const fade = Math.max(0, Math.min(55, preset.fade + _storyAdjustments.fade));
  const sepia = Math.max(0, Math.min(100, preset.sepia));
  const grayscale = Math.max(0, Math.min(100, preset.grayscale));

  return {
    css: `brightness(${brightness}) contrast(${contrast}) saturate(${saturation}) sepia(${sepia}%) grayscale(${grayscale}%) hue-rotate(${warmth}deg)`,
    fade: fade / 100,
  };
}

function applyStoryPreviewFilter() {
  const wraps = document.querySelectorAll('#story-editor-modal .cropper-canvas img, #story-editor-modal .cropper-view-box img');
  if (!wraps.length) return;
  const f = getStoryFilterString();
  wraps.forEach(img => {
    img.style.filter = f.css;
  });
}

function setActiveStoryFilterButton() {
  document.querySelectorAll('#story-filter-row .story-filter-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.filter === _storyActivePreset);
  });
}

function destroyStoryCropper() {
  if (_storyCropper) {
    _storyCropper.destroy();
    _storyCropper = null;
  }
}

function fitStoryCropperToFrame() {
  if (!_storyCropper) return;

  _storyCropper.reset();

  const container = _storyCropper.getContainerData();
  if (!container || !container.width || !container.height) return;

  const frameRatio = 9 / 16;
  let boxWidth = container.width;
  let boxHeight = boxWidth / frameRatio;
  if (boxHeight > container.height) {
    boxHeight = container.height;
    boxWidth = boxHeight * frameRatio;
  }

  const boxLeft = (container.width - boxWidth) / 2;
  const boxTop = (container.height - boxHeight) / 2;
  _storyCropper.setCropBoxData({
    left: boxLeft,
    top: boxTop,
    width: boxWidth,
    height: boxHeight,
  });
}

function closeStoryEditor() {
  const modal = document.getElementById('story-editor-modal');
  if (modal) {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }
  document.body.classList.remove('story-editor-open');
  document.body.classList.remove('story-camera-open');
  destroyStoryCropper();
  if (_storyObjectUrl) {
    URL.revokeObjectURL(_storyObjectUrl);
    _storyObjectUrl = null;
  }
}

function openStoryEditor(file) {
  const modal = document.getElementById('story-editor-modal');
  const preview = document.getElementById('story-editor-preview');
  if (!modal || !preview || !file) return;

  destroyStoryCropper();
  if (_storyObjectUrl) URL.revokeObjectURL(_storyObjectUrl);
  _storyObjectUrl = URL.createObjectURL(file);

  _storyActivePreset = 'normal';
  resetStoryAdjustments();
  setActiveStoryFilterButton();
  const cap = document.getElementById('story-editor-caption');
  if (cap) cap.value = '';

  preview.onload = () => {
    if (typeof window.Cropper === 'undefined') {
      showToast('Image editor library is unavailable');
      return;
    }

    _storyCropper = new Cropper(preview, {
      viewMode: 1,
      dragMode: 'move',
      aspectRatio: 9 / 16,
      autoCropArea: 1,
      background: false,
      responsive: true,
      guides: false,
      movable: true,
      zoomable: true,
      cropBoxResizable: true,
      cropBoxMovable: true,
      ready() {
        // Wait one frame so Cropper computes final container dimensions.
        requestAnimationFrame(() => fitStoryCropperToFrame());
        applyStoryPreviewFilter();
      },
      cropend() {
        applyStoryPreviewFilter();
      }
    });
  };

  preview.src = _storyObjectUrl;
  modal.classList.add('open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.classList.add('story-editor-open');
}

function makeStoryCanvasWithEffects() {
  if (!_storyCropper) return null;
  const cropped = _storyCropper.getCroppedCanvas({
    width: 1080,
    height: 1920,
    imageSmoothingEnabled: true,
    imageSmoothingQuality: 'high'
  });
  if (!cropped) return null;

  const out = document.createElement('canvas');
  out.width = cropped.width;
  out.height = cropped.height;
  const ctx = out.getContext('2d');
  if (!ctx) return null;

  const effects = getStoryFilterString();
  ctx.filter = effects.css;
  ctx.drawImage(cropped, 0, 0);
  ctx.filter = 'none';

  if (effects.fade > 0) {
    ctx.fillStyle = `rgba(255,255,255,${effects.fade})`;
    ctx.fillRect(0, 0, out.width, out.height);
  }

  return out;
}

async function uploadStoryFromEditor() {
  if (_storyUploadBusy) return;
  const publishBtn = document.getElementById('story-editor-publish');
  const fileInput = document.getElementById('story-image-input');
  const captionInput = document.getElementById('story-caption-input');
  const cap = document.getElementById('story-editor-caption');
  if (!publishBtn || !cap || !fileInput || !captionInput) return;

  const canvas = makeStoryCanvasWithEffects();
  if (!canvas) {
    showToast('Could not process image');
    return;
  }

  _storyUploadBusy = true;
  publishBtn.disabled = true;
  publishBtn.textContent = 'Sharing...';

  const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
  if (!blob) {
    _storyUploadBusy = false;
    publishBtn.disabled = false;
    publishBtn.textContent = 'Share story';
    showToast('Could not prepare image for upload');
    return;
  }

  const form = new FormData();
  form.append('story_image', blob, `story-${Date.now()}.jpg`);
  captionInput.value = (cap.value || '').trim();
  form.append('caption', captionInput.value);
  form.append('_hp', '');
  form.append('_recaptcha_token', await window.tripxGetRecaptchaToken('story_create'));

  try {
    const res = await fetch('{{ path('story_create') }}', {
      method: 'POST',
      body: form,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const json = await res.json();
    if (!res.ok || !json.ok) throw new Error(json.message || 'Upload failed');
    closeStoryEditor();
    showToast('Story uploaded');
    window.location.reload();
  } catch (e) {
    console.error(e);
    showToast('Could not upload story');
  } finally {
    _storyUploadBusy = false;
    publishBtn.disabled = false;
    publishBtn.textContent = 'Share story';
    fileInput.value = '';
  }
}

function setTsMapStatus(message, isError = false) {
  if (!_tsMapStatus) return;
  _tsMapStatus.textContent = message;
  _tsMapStatus.classList.toggle('error', !!isError);
}

function ensureTsMap() {
  if (_tsMap || !_tsMapCanvas || typeof window.L === 'undefined') return _tsMap;

  _tsMap = L.map(_tsMapCanvas, {
    zoomControl: true,
    scrollWheelZoom: false,
  }).setView([20, 0], 2);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution: '&copy; OpenStreetMap contributors',
  }).addTo(_tsMap);

  return _tsMap;
}

function closeTsMapModal() {
  if (!_tsMapModal) return;
  _tsMapModal.classList.remove('open');
  _tsMapModal.setAttribute('aria-hidden', 'true');
}

function openTsMapModal() {
  if (!_tsMapModal) return;
  _tsMapModal.classList.add('open');
  _tsMapModal.setAttribute('aria-hidden', 'false');

  const map = ensureTsMap();
  if (map) {
    window.setTimeout(() => map.invalidateSize(), 80);
  }
}

function updateTsMap(lat, lon, label) {
  const map = ensureTsMap();
  if (!map) return;

  const point = [lat, lon];
  if (_tsMapMarker) {
    _tsMapMarker.setLatLng(point);
  } else {
    _tsMapMarker = L.marker(point).addTo(map);
  }

  _tsMapMarker.bindPopup(label).openPopup();
  map.setView(point, 6, { animate: true });
}

async function showDestinationOnMap(destination) {
  const q = (destination || '').trim();
  if (!q) return;

  openTsMapModal();
  if (_tsMapTitle) _tsMapTitle.textContent = `Destination map: ${q}`;

  if (typeof window.L === 'undefined') {
    setTsMapStatus('Map library is unavailable. Please refresh the page and try again.', true);
    return;
  }

  setTsMapStatus('Looking up destination on map...');

  if (_tsMapGeocodeCtrl) {
    _tsMapGeocodeCtrl.abort();
  }
  _tsMapGeocodeCtrl = new AbortController();

  try {
    const res = await fetch(`${_tsDestinationGeocodeUrl}?q=${encodeURIComponent(q)}`, {
      method: 'GET',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      signal: _tsMapGeocodeCtrl.signal,
    });

    const data = await res.json();
    if (!res.ok || !data.ok) {
      throw new Error(data.message || 'Could not find this destination on map.');
    }

    updateTsMap(Number(data.lat), Number(data.lon), data.displayName || q);
    setTsMapStatus(`Showing: ${data.displayName || q}`);
  } catch (err) {
    if (err && err.name === 'AbortError') return;
    setTsMapStatus((err && err.message) || 'Could not load destination map.', true);
  }
}

async function toggleSuggestionFollow(button) {
  if (!button || button.disabled) return;

  const url = button.dataset.followUrl;
  const token = button.dataset.csrfToken;
  if (!url || !token) return;

  button.disabled = true;

  try {
    const formData = new FormData();
    formData.append('_token', token);

    const res = await fetch(url, {
      method: 'POST',
      body: formData,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });

    const json = await res.json();
    if (!res.ok || json.error) {
      throw new Error(json.error || 'Could not update follow status');
    }

    const isFollowing = !!json.following;
    button.textContent = isFollowing ? 'Following' : 'Follow';
    button.classList.toggle('following', isFollowing);
  } catch (err) {
    showToast(err.message || 'Could not update follow status');
  } finally {
    button.disabled = false;
  }
}

function hydrateUserNames() {
  const els = document.querySelectorAll('[data-uname],[data-uavatar]');
  const ids = [...new Set([...els].map(el => el.dataset.uname || el.dataset.uavatar).filter(Boolean))];
  if (!ids.length) return;
  fetch('/blog/user-names?ids=' + ids.join(','))
    .then(r => r.ok ? r.json() : {})
    .then(names => {
      document.querySelectorAll('[data-uname]').forEach(el => { const n = names[el.dataset.uname]; if (n) el.textContent = n; });
      document.querySelectorAll('[data-uavatar]').forEach(el => { const n = names[el.dataset.uavatar]; if (n) el.textContent = n.charAt(0).toUpperCase(); });
    }).catch(() => {});
}

