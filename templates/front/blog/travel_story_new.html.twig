</div>

<script>
const fileInput = document.querySelector('input[type="file"][multiple]');
const previewGrid = document.getElementById('preview-grid');
const uploadZone = document.getElementById('upload-zone');
const startDateInput = document.getElementById('{{ form.startDate.vars.id }}');
const endDateInput = document.getElementById('{{ form.endDate.vars.id }}');
const destinationInput = document.getElementById('{{ form.destination.vars.id }}');
const titleInput = document.getElementById('{{ form.title.vars.id }}');
const summaryInput = document.getElementById('{{ form.summary.vars.id }}');
const tipsInput = document.getElementById('{{ form.tips.vars.id }}');
const countryPicker = document.getElementById('country-picker');
const countryPickerBtn = document.getElementById('country-picker-btn');
const countryPickerLabel = document.getElementById('country-picker-label');
const countryPickerPanel = document.getElementById('country-picker-panel');
const countrySearch = document.getElementById('country-search');
const countryOptions = document.getElementById('country-options');
const currencyInput = document.getElementById('{{ form.currency.vars.id }}');
const currencyPicker = document.getElementById('currency-picker');
const currencyPickerBtn = document.getElementById('currency-picker-btn');
const currencyPickerLabel = document.getElementById('currency-picker-label');
const currencyPickerPanel = document.getElementById('currency-picker-panel');
const currencySearch = document.getElementById('currency-search');
const currencyOptions = document.getElementById('currency-options');
const overallRatingInput = document.getElementById('{{ form.overallRating.vars.id }}');
const ratingPicker = document.getElementById('rating-picker');
const ratingValue = document.getElementById('rating-value');
const aiTools = document.getElementById('ai-tools');
const aiToolsBtn = document.getElementById('ai-tools-btn');
const aiToolsMenu = document.getElementById('ai-tools-menu');
const aiToolsStatus = document.getElementById('ai-tools-status');
const aiAssistUrl = '{{ path('travel_story_ai_assist') }}';
let selectedFiles = [];

function setupAiTools() {
    if (!aiTools || !aiToolsBtn || !aiToolsMenu || !aiToolsStatus || !titleInput || !destinationInput || !summaryInput || !tipsInput) {
        return;
    }

    const setStatus = (message, isError = false) => {
        aiToolsStatus.textContent = message || '';
        aiToolsStatus.style.color = isError ? '#b91c1c' : 'var(--text-muted)';
    };

    const closeMenu = () => {
        aiTools.classList.remove('open');
    };

    aiToolsBtn.addEventListener('click', () => {
        aiTools.classList.toggle('open');
    });

    document.addEventListener('click', (event) => {
        if (!aiTools.contains(event.target)) {
            closeMenu();
        }
    });

    aiToolsMenu.addEventListener('click', async (event) => {
        const actionButton = event.target.closest('[data-ai-action]');
        if (!actionButton) {
            return;
        }

        closeMenu();

        const mode = actionButton.getAttribute('data-ai-action');
        if (mode === 'summary' && (!titleInput.value.trim() || !destinationInput.value.trim())) {
            setStatus('Please set title and destination first.', true);
            return;
        }

        aiToolsBtn.disabled = true;
        setStatus('Working...');

        try {
            const response = await fetch(aiAssistUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    mode,
                    title: titleInput.value,
                    destination: destinationInput.value,
                    summary: summaryInput.value,
                    tips: tipsInput.value
                })
            });

            const data = await response.json();
            if (!response.ok || !data.ok) {
                throw new Error(data.message || 'AI request failed.');
            }

            if (data.mode === 'spelling') {
                const before = {
                    title: titleInput.value,
                    summary: summaryInput.value,
                    tips: tipsInput.value,
                };

                if (typeof data.title === 'string') titleInput.value = data.title;
                if (typeof data.summary === 'string') summaryInput.value = data.summary;
                if (typeof data.tips === 'string') tipsInput.value = data.tips;

                let changedCount = 0;
                if (titleInput.value !== before.title) changedCount++;
                if (summaryInput.value !== before.summary) changedCount++;
                if (tipsInput.value !== before.tips) changedCount++;

                if (changedCount > 0) {
                    setStatus(`Spelling corrected. Updated ${changedCount} field${changedCount > 1 ? 's' : ''}.`);
                } else {
                    setStatus('Checked spelling. No changes were needed.');
                }
                return;
            }

            if (data.mode === 'summary' && typeof data.summary === 'string') {
                summaryInput.value = data.summary;
                setStatus('Summary generated.');
                return;
            }

            throw new Error('Unexpected AI response.');
        } catch (error) {
            setStatus(error.message || 'Could not process AI action.', true);
        } finally {
            aiToolsBtn.disabled = false;
        }
    });
}

function setupRatingPicker() {
    if (!overallRatingInput || !ratingPicker || !ratingValue) {
        return;
    }

    const stars = Array.from(ratingPicker.querySelectorAll('[data-rating-value]'));
    if (!stars.length) {
        return;
    }

    const parseRating = (value) => {
        const n = Number(value);
        return Number.isFinite(n) && n >= 1 && n <= 5 ? Math.floor(n) : 0;
    };

    let selected = parseRating(overallRatingInput.value);
    let hover = 0;

    const paint = () => {
        const active = hover || selected;
        stars.forEach(star => {
            const value = Number(star.dataset.ratingValue);
            star.classList.toggle('active', value <= active);
            star.setAttribute('aria-checked', String(value === selected));
        });
        ratingValue.textContent = `${selected || 0}/5`;
    };

    const setSelected = (value) => {
        selected = value;
        overallRatingInput.value = selected ? String(selected) : '';
        paint();
    };

    stars.forEach(star => {
        const value = Number(star.dataset.ratingValue);

        star.addEventListener('mouseenter', () => {
            hover = value;
            paint();
        });

        star.addEventListener('click', () => {
            hover = 0;
            setSelected(value);
        });

        star.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                hover = 0;
                setSelected(value);
            }
        });
    });

    ratingPicker.addEventListener('mouseleave', () => {
        hover = 0;
        paint();
    });

    paint();
}

function setupCountryDropdown() {
    if (!destinationInput || !countryPicker || !countryPickerBtn || !countryPickerLabel || !countryPickerPanel || !countrySearch || !countryOptions) {
        return;
    }

    const selectedDestination = (destinationInput.value || '').trim();
    let countriesCache = [];

    const closePanel = () => {
        countryPicker.classList.remove('open');
        countryPickerBtn.setAttribute('aria-expanded', 'false');
    };

    const openPanel = () => {
        countryPicker.classList.add('open');
        countryPickerBtn.setAttribute('aria-expanded', 'true');
        countrySearch.focus();
    };

    const setButtonLabel = (country) => {
        if (!country) {
            countryPickerLabel.textContent = 'Select a country';
            return;
        }

        if (country.flagUrl) {
            countryPickerLabel.innerHTML = `<img src="${country.flagUrl}" alt="${country.name} flag" loading="lazy"><span>${country.name}</span>`;
            return;
        }

        countryPickerLabel.innerHTML = `<span>${country.name}</span>`;
    };

    const selectCountry = (country) => {
        destinationInput.value = country.name;
        setButtonLabel(country);
        closePanel();
    };

    const renderOptions = (term = '') => {
        const q = term.trim().toLowerCase();
        const filtered = countriesCache.filter(country => country.name.toLowerCase().includes(q));

        if (!filtered.length) {
            countryOptions.innerHTML = '<div class="country-empty">No countries found</div>';
            return;
        }

        countryOptions.innerHTML = filtered.map(country => (
            `<button type="button" class="country-option" data-country="${country.name}" role="option">` +
            `<img src="${country.flagUrl}" alt="${country.name} flag" loading="lazy">` +
            `<span>${country.name}</span>` +
            `</button>`
        )).join('');
    };

    fetch('https://restcountries.com/v3.1/all?fields=name,flags')
        .then(response => {
            if (!response.ok) {
                throw new Error('Failed to fetch countries');
            }

            return response.json();
        })
        .then(countries => {
            const sortedCountries = countries
                .filter(c => c && c.name && c.name.common && c.flags && (c.flags.svg || c.flags.png))
                .sort((a, b) => a.name.common.localeCompare(b.name.common));

            countriesCache = sortedCountries.map(country => ({
                name: country.name.common,
                flagUrl: country.flags.svg || country.flags.png
            }));

            renderOptions();

            if (selectedDestination) {
                const matchingCountry = countriesCache.find(
                    country => country.name.toLowerCase() === selectedDestination.toLowerCase()
                );

                if (matchingCountry) {
                    destinationInput.value = matchingCountry.name;
                    setButtonLabel(matchingCountry);
                } else {
                    setButtonLabel({
                        name: selectedDestination,
                        flagUrl: ''
                    });
                }
            }
        })
        .catch(() => {
            countryPicker.style.display = 'none';
            destinationInput.style.display = 'block';
            destinationInput.classList.add('country-fallback-input');
            destinationInput.placeholder = 'Enter destination country';
        });

    countryPickerBtn.addEventListener('click', () => {
        if (countryPicker.classList.contains('open')) {
            closePanel();
            return;
        }

        openPanel();
    });

    countrySearch.addEventListener('input', () => {
        renderOptions(countrySearch.value);
    });

    countryOptions.addEventListener('click', (event) => {
        const button = event.target.closest('.country-option');
        if (!button) {
            return;
        }

        const name = button.getAttribute('data-country');
        const country = countriesCache.find(item => item.name === name);
        if (country) {
            selectCountry(country);
        }
    });

    document.addEventListener('click', (event) => {
        if (!countryPicker.contains(event.target)) {
            closePanel();
        }
    });

    destinationInput.addEventListener('invalid', () => {
        if (!destinationInput.value) {
            countryPickerBtn.focus();
        }
    });
}

function setupCurrencyDropdown() {
    if (!currencyInput || !currencyPicker || !currencyPickerBtn || !currencyPickerLabel || !currencyPickerPanel || !currencySearch || !currencyOptions) {
        return;
    }

    const selectedCode = (currencyInput.value || '').trim().toUpperCase();
    let currenciesCache = [];

    const closePanel = () => {
        currencyPicker.classList.remove('open');
        currencyPickerBtn.setAttribute('aria-expanded', 'false');
    };

    const openPanel = () => {
        currencyPicker.classList.add('open');
        currencyPickerBtn.setAttribute('aria-expanded', 'true');
        currencySearch.focus();
    };

    const formatLabel = (currency) => {
        const code = currency.code || '';
        const name = currency.name || '';
        const symbol = currency.symbol ? ` (${currency.symbol})` : '';
        return `${code}${name ? ' - ' + name : ''}${symbol}`;
    };

    const setButtonLabel = (currency) => {
        if (!currency) {
            currencyPickerLabel.textContent = 'Select currency';
            return;
        }

        currencyPickerLabel.textContent = formatLabel(currency);
    };

    const selectCurrency = (currency) => {
        currencyInput.value = currency.code;
        setButtonLabel(currency);
        closePanel();
    };

    const renderOptions = (term = '') => {
        const q = term.trim().toLowerCase();
        const filtered = currenciesCache.filter(item => {
            const symbol = (item.symbol || '').toLowerCase();
            return item.code.toLowerCase().includes(q)
                || item.name.toLowerCase().includes(q)
                || symbol.includes(q);
        });

        if (!filtered.length) {
            currencyOptions.innerHTML = '<div class="currency-empty">No currencies found</div>';
            return;
        }

        currencyOptions.innerHTML = filtered.map(item => (
            `<button type="button" class="currency-option" data-currency-code="${item.code}" role="option">` +
            `<span><span class="currency-option-code">${item.code}</span><span class="currency-option-name">${item.name}</span></span>` +
            `<span class="currency-option-symbol">${item.symbol || ''}</span>` +
            `</button>`
        )).join('');
    };

    fetch('https://restcountries.com/v3.1/all?fields=currencies')
        .then(response => {
            if (!response.ok) {
                throw new Error('Failed to fetch currencies');
            }

            return response.json();
        })
        .then(rows => {
            const byCode = new Map();

            rows.forEach(country => {
                if (!country || !country.currencies || typeof country.currencies !== 'object') {
                    return;
                }

                Object.entries(country.currencies).forEach(([code, data]) => {
                    if (!code || !data || typeof data !== 'object') {
                        return;
                    }

                    const normalizedCode = String(code).toUpperCase().trim();
                    if (!normalizedCode) {
                        return;
                    }

                    if (!byCode.has(normalizedCode)) {
                        byCode.set(normalizedCode, {
                            code: normalizedCode,
                            name: String(data.name || normalizedCode),
                            symbol: String(data.symbol || '')
                        });
                    }
                });
            });

            currenciesCache = Array.from(byCode.values()).sort((a, b) => a.code.localeCompare(b.code));
            renderOptions();

            if (selectedCode) {
                const existing = currenciesCache.find(item => item.code === selectedCode);
                if (existing) {
                    currencyInput.value = existing.code;
                    setButtonLabel(existing);
                } else {
                    setButtonLabel({ code: selectedCode, name: '', symbol: '' });
                }
            }
        })
        .catch(() => {
            currencyPicker.style.display = 'none';
            currencyInput.style.display = 'block';
            currencyInput.classList.add('currency-fallback-input');
            currencyInput.placeholder = 'Currency code (e.g. USD)';
        });

    currencyPickerBtn.addEventListener('click', () => {
        if (currencyPicker.classList.contains('open')) {
            closePanel();
            return;
        }

        openPanel();
    });

    currencySearch.addEventListener('input', () => {
        renderOptions(currencySearch.value);
    });

    currencyOptions.addEventListener('click', (event) => {
        const button = event.target.closest('.currency-option');
        if (!button) {
            return;
        }

        const code = (button.getAttribute('data-currency-code') || '').toUpperCase();
        const currency = currenciesCache.find(item => item.code === code);
        if (currency) {
            selectCurrency(currency);
        }
    });

    document.addEventListener('click', (event) => {
        if (!currencyPicker.contains(event.target)) {
            closePanel();
        }
    });

    currencyInput.addEventListener('invalid', () => {
        if (!currencyInput.value) {
            currencyPickerBtn.focus();
        }
    });
}

function syncFilesToInput() {
    const dt = new DataTransfer();
    selectedFiles.forEach(f => dt.items.add(f));
    fileInput.files = dt.files;
}

function renderPreviews() {
    previewGrid.innerHTML = '';
    selectedFiles.forEach((file, idx) => {
        const reader = new FileReader();
        reader.onload = e => {
            const item = document.createElement('div');
            item.className = 'preview-item';
            item.style.animationDelay = (idx * 0.06) + 's';
            item.innerHTML = `
                <img src="${e.target.result}" alt="${file.name}">
                <button type="button" class="preview-remove" onclick="removeFile(${idx})" title="Remove">✕</button>
            `;
            previewGrid.appendChild(item);
        };
        reader.readAsDataURL(file);
    });
}

function removeFile(idx) {
    selectedFiles.splice(idx, 1);
    syncFilesToInput();
    renderPreviews();
}

function addFiles(files) {
    const arr = Array.from(files);
    selectedFiles = [...selectedFiles, ...arr].slice(0, 5);
    syncFilesToInput();
    renderPreviews();
}

if (fileInput) {
    fileInput.addEventListener('change', () => {
        addFiles(fileInput.files);
    });
}

function handleDragOver(e) {
    e.preventDefault();
    uploadZone.classList.add('dragover');
}

function handleDragLeave(e) {
    uploadZone.classList.remove('dragover');
}

function handleDrop(e) {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    if (e.dataTransfer.files.length) addFiles(e.dataTransfer.files);
}

function toggleAdvancedFields(el) {
    const box = document.getElementById('advanced-fields');
    box.classList.toggle('open');
    el.textContent = box.classList.contains('open') ? 'Hide advanced fields' : 'Advanced fields';
}

function setupDateConstraints() {
    if (!startDateInput || !endDateInput) {
        return;
    }

    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    const todayStr = `${yyyy}-${mm}-${dd}`;

    startDateInput.max = todayStr;
    endDateInput.max = todayStr;

    const syncDateBounds = () => {
        if (startDateInput.value) {
            endDateInput.min = startDateInput.value;
            if (endDateInput.value && endDateInput.value < startDateInput.value) {
                endDateInput.value = startDateInput.value;
            }
        } else {
            endDateInput.removeAttribute('min');
        }

        if (endDateInput.value) {
            startDateInput.max = endDateInput.value < todayStr ? endDateInput.value : todayStr;
            if (startDateInput.value && startDateInput.value > endDateInput.value) {
                startDateInput.value = endDateInput.value;
            }
        } else {
            startDateInput.max = todayStr;
        }
    };

    startDateInput.addEventListener('change', syncDateBounds);
    endDateInput.addEventListener('change', syncDateBounds);
    syncDateBounds();
}

setupDateConstraints();
setupCountryDropdown();
setupCurrencyDropdown();
setupRatingPicker();
setupAiTools();
</script>
{% endblock %}