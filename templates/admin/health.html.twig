{% extends 'admin/admin_base.html.twig' %}

{% block title %}Transport Health Monitor — TripX Admin{% endblock %}

{% block page_styles %}
/* Use identical styles to the dashboard for consistency */
.sub-nav-tabs {
    display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap;
}
.sub-nav-link {
    padding: 10px 24px; text-decoration: none; border-radius: 10px; 
    font-size: 14px; font-weight: 600; transition: all 0.2s;
    border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-muted);
}
.sub-nav-link:hover { border-color: var(--accent-primary); color: var(--accent-primary); }

.health-card {
    background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; 
    overflow: hidden; box-shadow: var(--shadow-sm);
}
.dest-table { width: 100%; border-collapse: separate; border-spacing: 0; }
.dest-table th { background: rgba(0,166,237,0.05); text-align: left; padding: 16px 20px; font-size: 14px; font-weight: 700; color: var(--text-primary); }
.dest-table td { padding: 16px 20px; border-bottom: 1px solid var(--border-color); font-size: 14px; }

/* Status Badges */
.badge-status { padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
.badge-pass { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
.badge-warning { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); }
.badge-fail { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
{% endblock %}

{% block breadcrumbs %}
  <a href="{{ path('admin_dashboard') }}" class="crumb">Dashboard</a>
  <span class="sep">›</span>
  <a href="{{ path('admin_transport_index') }}" class="crumb">Transport</a>
  <span class="sep">›</span>
  <span class="crumb active">Health Monitor</span>
{% endblock %}

{% block content %}
<div class="reveal">
    {# Header Section #}
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:32px;">
        <div>
            <h1 class="display-sm" style="margin-bottom:4px">System Health Monitor</h1>
            <p class="text-muted" style="font-size:14px">Real-time status of the transport module infrastructure and external APIs.</p>
        </div>
        <a href="{{ path('admin_transport_index') }}" class="btn btn-secondary ripple-btn">← Back to Dashboard</a>
    </div>

    {# Results Card #}
    <div class="health-card">
        <table class="dest-table">
            <thead>
                <tr>
                    <th style="width: 30%">Service / Infrastructure</th>
                    <th style="text-align:center; width: 15%">Status</th>
                    <th>Message & Diagnostic Details</th>
                </tr>
            </thead>
            <tbody>
                {% for result in results %}
                <tr>
                    <td>
                        <div style="font-weight: 700; color: var(--text-primary);">{{ result.label }}</div>
                    </td>
                    <td style="text-align: center;">
                        {% if result.status == 'PASS' %}
                            <span class="badge-status badge-pass">✔ PASS</span>
                        {% elseif result.status == 'WARNING' %}
                            <span class="badge-status badge-warning">⚠ WARN</span>
                        {% else %}
                            <span class="badge-status badge-fail">✖ FAIL</span>
                        {% endif %}
                    </td>
                    <td>
                        <div style="font-size: 13px; color: var(--text-muted); line-height: 1.5;">
                            {{ result.message ?: 'System is operating within normal parameters.' }}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="3" style="text-align: center; padding: 40px; color: var(--text-muted);">
                        No health checks have been registered for this module.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div style="margin-top: 24px; padding: 20px; background: rgba(0,166,237,0.03); border: 1px solid var(--border-color); border-radius: 12px;">
        <h6 style="margin: 0 0 8px; font-size: 13px; color: var(--text-primary);">💡 Monitoring Tips</h6>
        <p style="margin: 0; font-size: 12px; color: var(--text-muted); line-height: 1.6;">
            The **ElevenLabs Status Check** validates connectivity to the Text-to-Speech engine. Failures here indicate that trip confirmation voice messages may fall back to browser-default speech.
        </p>
    </div>
</div>
{% endblock %}
