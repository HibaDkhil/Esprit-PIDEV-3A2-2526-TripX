                                    {% endif %}
                                    <form method="post"
                                          action="{{ path('admin_ig_story_delete', {id: igStory.id}) }}"
                                          onsubmit="return confirm('Delete this IG story permanently?');">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('admin_ig_story_delete_' ~ igStory.id) }}">
                                        <button type="submit" class="btn-del" title="Delete story" aria-label="Delete story">🗑</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
