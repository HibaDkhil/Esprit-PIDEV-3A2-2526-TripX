{% extends 'admin/admin_base.html.twig' %}
{% block title %}Blog Management — TripX Admin{% endblock %}

{% block breadcrumbs %}
  <span class="crumb active">Blog</span>
{% endblock %}

{% block content %}
<style>
/* Modern Admin Dashboard Styles */
:root {
    --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    --card-border: 1px solid rgba(226, 232, 240, 0.8);
}

.dashboard-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card-modern {
    background: #ffffff;
    border: var(--card-border);
    border-radius: 16px;
    padding: 24px 16px;
    text-align: center;
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stat-card-modern:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

.stat-card-modern .num {
    font-size: 36px;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 8px;
}

.stat-card-modern .lbl {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.02em;
}

/* Specific Card Colors */
.card-total-posts .num { color: #3b82f6; }
.card-pending .num { color: #f59e0b; }
.card-approved .num { color: #10b981; }
.card-travel-stories .num { color: #f43f5e; }
.card-stories .num { color: #14b8a6; }
.card-live .num { color: #e11d48; }
.card-comments .num { color: #8b5cf6; }
.card-reactions .num { color: #d946ef; }

.wide-stat-card {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.charts-row-modern {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
}

.chart-card-modern {
    background: #ffffff;
    border: var(--card-border);
    border-radius: 16px;
    padding: 24px;
    box-shadow: var(--card-shadow);
}

.chart-header {
    text-align: center;
    margin-bottom: 20px;
}

.chart-header h3 {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    color: #475569;
    letter-spacing: 0.05em;
    margin: 0;
}

.chart-body {
    height: 300px;
    position: relative;
}

@media (max-width: 1200px) {
    .charts-row-modern { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
    .charts-row-modern { grid-template-columns: 1fr; }
    .dashboard-stats-grid { grid-template-columns: repeat(2, 1fr); }
}

/* Original table styles kept below */
.blog-table       { width:100%; border-collapse:collapse; background:var(--bg-card);
                     border-radius:var(--border-radius-md); overflow:hidden;
                     border:1px solid var(--border-color); }
.table-scroll     { width:100%; overflow-x:auto; }
.table-scroll .blog-table { width:max-content; min-width:1180px; }
.stories-table    { table-layout:fixed; width:1520px; }
.stories-table th:nth-child(1), .stories-table td:nth-child(1) { width:56px; }
.stories-table th:nth-child(2), .stories-table td:nth-child(2) { width:90px; }
.stories-table th:nth-child(3), .stories-table td:nth-child(3) { width:220px; }
.stories-table th:nth-child(4), .stories-table td:nth-child(4) { width:160px; }
.stories-table th:nth-child(5), .stories-table td:nth-child(5) { width:150px; }
.stories-table th:nth-child(6), .stories-table td:nth-child(6) { width:170px; }
.stories-table th:nth-child(7), .stories-table td:nth-child(7) { width:95px; }
.stories-table th:nth-child(8), .stories-table td:nth-child(8) { width:125px; }
.stories-table th:nth-child(9), .stories-table td:nth-child(9) { width:135px; }
.stories-table th:nth-child(10), .stories-table td:nth-child(10) { width:95px; }
.stories-table th:nth-child(11), .stories-table td:nth-child(11) { width:95px; }
.stories-table th:nth-child(12), .stories-table td:nth-child(12) { width:120px; }
.stories-table th:nth-child(13), .stories-table td:nth-child(13) { width:240px; }
.story-destination-cell { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.blog-table th    { background:var(--bg-surface); padding:13px 16px; font-size:12px;
                     font-weight:700; text-transform:uppercase; letter-spacing:.5px;
                     color:var(--text-muted); text-align:left; border-bottom:1px solid var(--border-color); }
.blog-table td    { padding:14px 16px; font-size:14px; border-bottom:1px solid var(--border-color);
                     vertical-align:middle; }
.blog-table tr:last-child td { border-bottom:none; }
.blog-table tr:hover td      { background:var(--bg-surface); }

.badge            { display:inline-block; padding:3px 10px; border-radius:50px; font-size:11px; font-weight:700; }
.badge-pending    { background:#fef3c7; color:#92400e; }
.badge-approved   { background:#d1fae5; color:#065f46; }
.type-dot         { display:inline-block; padding:3px 8px; border-radius:50px; font-size:11px; font-weight:600; white-space:nowrap; }
.type-post        { background:#dbeafe; color:#1d4ed8; }
.type-travel-story { background:#fdf2f8; color:#be185d; }
.type-story       { background:#f0fdf4; color:#15803d; }
.type-live        { background:#fff1f2; color:#be123c; }
.type-comment     { background:#f5f3ff; color:#6d28d9; }
.type-live-comment { background:#fff7ed; color:#c2410c; }

.actions          { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
.btn-approve,
.btn-reject,
.btn-del,
.btn-view         { width:32px; height:32px; padding:0; display:inline-flex; align-items:center; justify-content:center;
                     border-radius:9px; font-size:14px; font-weight:800; line-height:1; cursor:pointer; text-decoration:none; }
.btn-approve      { background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; }
.btn-reject       { background:#fef3c7; color:#92400e; border:1px solid #fcd34d; }
.btn-del          { background:#fee2e2; color:#dc2626; border:1px solid #fca5a5; }
.btn-view         { background:#dbeafe; color:#1d4ed8; border:1px solid #93c5fd; }

.post-title-cell  { max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:700; }
.flash-success    { background:#d1fae5; color:#065f46; padding:12px 16px; border-radius:10px; margin-bottom:18px; }
.flash-info       { background:#dbeafe; color:#1e40af; padding:12px 16px; border-radius:10px; margin-bottom:18px; }
.empty-state      { text-align:center; padding:50px; color:var(--text-muted); }

/* Tabs */
.admin-tabs       { display:flex; gap:0; margin-bottom:24px; border-bottom:2px solid var(--border-color); }
.admin-tab        { padding:12px 24px; font-size:14px; font-weight:700; cursor:pointer; border:none;
                     background:none; color:var(--text-muted); position:relative; }
.admin-tab.active { color:var(--accent-primary); }
.admin-tab.active::after { content:''; position:absolute; bottom:-2px; left:0; right:0; height:2px;
                     background:var(--accent-primary); }
.admin-tab .tab-count { display:inline-block; margin-left:6px; padding:1px 8px; border-radius:50px;
                     font-size:11px; font-weight:700; background:#f3f4f6; color:#374151; }
.admin-tab.active .tab-count { background:var(--accent-primary); color:#fff; }
.tab-panel        { display:none; }
.tab-panel.active { display:block; }

.story-cover-thumb { width:48px; height:36px; object-fit:cover; border-radius:6px; }
.ig-story-thumb    { width:44px; height:44px; object-fit:cover; border-radius:10px; }
.live-thumb        { width:56px; height:38px; object-fit:cover; border-radius:8px; }
.star-rating      { color:#f59e0b; font-size:13px; }

.badge-mod-safe       { background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; }
.badge-mod-review     { background:#fef3c7; color:#92400e; border:1px solid #fcd34d; }
.badge-mod-spam       { background:#ede9fe; color:#5b21b6; border:1px solid #c4b5fd; }
.badge-mod-high-risk  { background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; }
.badge-mod-hidden     { background:#7f1d1d; color:#fee2e2; border:1px solid #b91c1c; }

.mod-badge-btn { border:none; cursor:pointer; }
.bulk-actions { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; align-items:center; }
.btn-bulk { padding:6px 12px; border-radius:50px; border:1px solid var(--border-color); background:var(--bg-surface); color:var(--text-primary); font-size:12px; font-weight:700; cursor:pointer; }

.mq-section { margin-bottom:16px; }
.mq-title { font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); margin:0 0 8px; }

.mod-modal-backdrop {
    position:fixed; inset:0; display:none; align-items:center; justify-content:center;
    background:rgba(15,23,42,.55); z-index:2000; padding:20px;
}
.mod-modal-backdrop.open { display:flex; }
.mod-modal {
    width:min(980px, 98vw); max-height:90vh; overflow:auto;
    background:var(--bg-card); border:1px solid var(--border-color); border-radius:14px;
    box-shadow:0 20px 50px rgba(0,0,0,.25);
}
.mod-head { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid var(--border-color); }
.mod-head h3 { margin:0; font-size:16px; }
.mod-close { border:none; background:transparent; font-size:22px; cursor:pointer; color:var(--text-muted); }
.mod-body { padding:16px; display:grid; gap:12px; }
.mod-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:10px; }
.mod-box { border:1px solid var(--border-color); border-radius:10px; padding:10px; background:var(--bg-surface); }
.mod-box h4 { margin:0 0 8px; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); }
.mod-line { display:flex; justify-content:space-between; font-size:13px; padding:2px 0; }
.mod-content { border:1px solid var(--border-color); border-radius:10px; padding:12px; line-height:1.55; white-space:pre-wrap; }
.hl-profanity { text-decoration:underline; text-decoration-color:#dc2626; text-decoration-thickness:2px; }
.hl-flag { background:#fef08a; color:#713f12; padding:0 2px; border-radius:4px; }
.mod-actions { display:flex; gap:8px; flex-wrap:wrap; }

</style>

{# ── Flash messages ── #}
{% for msg in app.flashes('success') %}<div class="flash-success">✅ {{ msg }}</div>{% endfor %}
{% for msg in app.flashes('info') %}<div class="flash-info">ℹ️ {{ msg }}</div>{% endfor %}

{# ── Modern Stats Section ── #}
<div class="dashboard-stats-grid">
    <div class="stat-card-modern card-total-posts">
        <div class="num">{{ stats.total }}</div>
        <div class="lbl">Total Posts</div>
    </div>
    <div class="stat-card-modern card-pending">
        <div class="num">{{ stats.pending }}</div>
        <div class="lbl">Pending Approval</div>
    </div>
    <div class="stat-card-modern card-approved">
        <div class="num">{{ stats.approved }}</div>
        <div class="lbl">Approved</div>
    </div>
    <div class="stat-card-modern card-travel-stories">
        <div class="num">{{ stats.stories }}</div>
        <div class="lbl">Travel Stories</div>
    </div>
    <div class="stat-card-modern card-stories">
        <div class="num">{{ stats.igStories ?? 0 }}</div>
        <div class="lbl">Stories</div>
    </div>
    <div class="stat-card-modern card-live">
        <div class="num">{{ stats.liveSessions ?? 0 }}</div>
        <div class="lbl">Live Sessions</div>
    </div>
    <div class="stat-card-modern card-comments">
        <div class="num">{{ stats.comments }}</div>
        <div class="lbl">Total Comments</div>
    </div>

    {# Wide Reaction Card #}
    <div class="stat-card-modern wide-stat-card card-reactions">
        <div class="num">{{ stats.reactions }}</div>
        <div class="lbl">Total Reactions</div>
    </div>
</div>

{# ── Modern Charts Section ── #}
<div class="charts-row-modern">
    <div class="chart-card-modern">
        <div class="chart-header">
            <h3>Content Overview</h3>
        </div>
        <div class="chart-body">
            {{ render_chart(contentMixChart) }}
        </div>
    </div>
    <div class="chart-card-modern">
        <div class="chart-header">
            <h3>Verification Stats</h3>
        </div>
        <div class="chart-body">
            {{ render_chart(verificationStatsChart) }}
        </div>
    </div>
    <div class="chart-card-modern">
        <div class="chart-header">
            <h3>Peak User Activity (24h)</h3>
        </div>
        <div class="chart-body">
            {{ render_chart(peakActivityChart) }}
        </div>
    </div>
</div>

{# ── Tabs ── #}
<div class="admin-tabs">
    <button class="admin-tab active" data-tab="moderation" onclick="switchTab('moderation', this)">
        🛡 Moderation Queue <span class="tab-count">{{ moderationQueue|length }}</span>
    </button>
    <button class="admin-tab" data-tab="posts" onclick="switchTab('posts', this)">
        📝 Posts <span class="tab-count">{{ (visiblePosts ?? posts)|length }}</span>
    </button>
    <button class="admin-tab" data-tab="stories" onclick="switchTab('stories', this)">
        🧳 Travel Stories <span class="tab-count">{{ stories|length }}</span>
    </button>
    <button class="admin-tab" data-tab="ig-stories" onclick="switchTab('ig-stories', this)">
        📸 Stories <span class="tab-count">{{ igStories|length }}</span>
    </button>
    <button class="admin-tab" data-tab="live" onclick="switchTab('live', this)">
        🔴 Lives <span class="tab-count">{{ liveSessions|length }}</span>
    </button>
</div>

{# ── Moderation Queue Tab ── #}
<div class="tab-panel active" id="tab-moderation">
    {% if moderationQueue is empty %}
        <div class="empty-state">
            <p style="font-size:42px;">🛡</p>
            <p>No flagged content in moderation queue.</p>
        </div>
    {% else %}
        {% for state, label in {'HIGH_RISK':'🚨 High Risk','REVIEW':'⚠️ Needs Review','SPAM':'🕷 Spam'} %}
            {% set rows = moderationQueue|filter(item => item.analysis.state == state) %}
            {% if rows is not empty %}
                <div class="mq-section">
                    <h3 class="mq-title">{{ label }} ({{ rows|length }})</h3>
                    <div class="table-scroll">
                        <table class="blog-table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Title/Snippet</th>
                                    <th>Author</th>
                                    <th>🛡 Moderation</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in rows %}
                                    {% set m = item.analysis %}
                                    {% set stateClass = {
                                        'SAFE': 'badge-mod-safe',
                                        'REVIEW': 'badge-mod-review',
                                        'SPAM': 'badge-mod-spam',
                                        'HIGH_RISK': 'badge-mod-high-risk',
                                        'AUTO_HIDDEN': 'badge-mod-hidden'
                                    }[m.state]|default('badge-mod-safe') %}
                                    {% set stateText = {
                                        'SAFE': '🟢 Safe',
                                        'REVIEW': '⚠️ Review',
                                        'SPAM': '🕷 Spam',
                                        'HIGH_RISK': '🚨 High Risk',
                                        'AUTO_HIDDEN': '⛔ Hidden'
                                    }[m.state]|default('🟢 Safe') %}
                                    <tr>
                                        <td><span class="type-dot type-{{ item.type|replace('_', '-') }}">{{ item.type|replace('_', ' ')|capitalize }}</span></td>
                                        <td class="post-title-cell" title="{{ item.title }}">{{ item.title }}</td>
                                        <td>
                                            {% set uid = 0 %}
                                            {% if item.type == 'live' %}{% set uid = item.entity.hostUser.userId|default(0) %}
                                            {% elseif item.type == 'live_comment' %}{% set uid = item.entity.user.userId|default(0) %}
                                            {% else %}{% set uid = item.entity.userId|default(0) %}
                                            {% endif %}
                                            {{ authorMap[uid] ?? 'User #' ~ uid }}
                                        </td>
                                        <td><span class="badge {{ stateClass }}">{{ stateText }}</span></td>
                                        <td style="font-size:13px; color:var(--text-muted);">
                                            {% if item.entity.createdAt is defined %}{{ item.entity.createdAt|date('d M Y') }}
                                            {% elseif item.entity.startedAt is defined %}{{ item.entity.startedAt|date('d M Y') }}
                                            {% else %}—{% endif %}
                                        </td>
                                        <td>
                                            <div class="actions">
                                                <button type="button" class="btn-view" data-open-moderation="1"
                                                        data-content-type="{{ item.type }}"
                                                        data-post-id="{{ item.id }}"
                                                        data-post-title="{{ item.title|e('html_attr') }}"
                                                        data-post-content="{{ item.content|e('html_attr') }}"
                                                        data-state="{{ m.state }}"
                                                        data-openai-hate="{{ m.openai.hate|default(0) }}"
                                                        data-openai-harassment="{{ m.openai.harassment|default(0) }}"
                                                        data-openai-self-harm="{{ m.openai.self_harm|default(0) }}"
                                                        data-openai-violence="{{ m.openai.violence|default(0) }}"
                                                        data-spam="{{ m.spam_probability|default(0) }}"
                                                        data-profanity-count="{{ m.profanity_count|default(0) }}"
                                                        data-profanity-words="{{ (m.profanity_words|default([])|join('||'))|e('html_attr') }}"
                                                        data-flagged-phrases="{{ (m.flagged_phrases|default([])|join('||'))|e('html_attr') }}"
                                                title="View moderation details" aria-label="View moderation details">👁</button>

                                                {% if item.type == 'post' %}
                                                    <form method="post" action="{{ path('admin_blog_approve', {id: item.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_' ~ item.id) }}">
                                                        <button type="submit" class="btn-approve" title="Approve post" aria-label="Approve post">✔</button>
                                                    </form>
                                                {% endif %}

                                                {% set delRoute = {
                                                    'post': 'admin_blog_delete',
                                                    'travel_story': 'admin_story_delete',
                                                    'story': 'admin_ig_story_delete',
                                                    'live': 'admin_live_delete',
                                                    'comment': 'admin_comment_delete',
                                                    'live_comment': 'admin_live_comment_delete'
                                                }[item.type] %}

                                                <form method="post"
                                                      action="{{ path(delRoute, {id: item.id}) }}"
                                                      onsubmit="return confirm('Delete this {{ item.type|replace('_', ' ') }} permanently?');">
                                                    <input type="hidden" name="_token"
                                                           value="{{ csrf_token(delRoute ~ '_' ~ item.id) }}">
                                                    <button type="submit" class="btn-del" title="Delete content" aria-label="Delete content">🗑</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}
</div>

{# ── Posts Tab ── #}
<div class="tab-panel" id="tab-posts">
    {% set postsForDisplay = visiblePosts ?? posts %}
    {% if postsForDisplay is empty %}
        <div class="empty-state">
            <p style="font-size:42px;">📭</p>
            <p>No posts yet.</p>
        </div>
    {% else %}
        <form method="post" action="{{ path('admin_blog_bulk_action') }}" id="bulk-posts-form">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_bulk_action') }}">
            <input type="hidden" name="_tab" value="posts">
            <input type="hidden" name="bulk_action" id="bulk-action-input" value="">
            <div class="bulk-actions">
                <label style="font-size:13px; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
                    <input type="checkbox" id="select-all-posts"> Select All
                </label>
                <button type="button" class="btn-bulk" data-bulk-action="approve">Approve Selected</button>
                <button type="button" class="btn-bulk" data-bulk-action="reject">Reject Selected</button>
                <button type="button" class="btn-bulk" data-bulk-action="delete">Delete Selected</button>
                <button type="button" class="btn-bulk" data-bulk-action="mark_safe">Mark as Safe</button>
            </div>
        </form>

        <div class="table-scroll">
            <table class="blog-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>#</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>🛡 Moderation</th>
                        <th>Comments</th>
                        <th>Reacts</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in postsForDisplay %}
                        {% set m = postModeration[post.id] ?? {
                            state: 'SAFE',
                            flaggedByAi: false,
                            openai: {hate: 0, harassment: 0, self_harm: 0, violence: 0},
                            spam_probability: 0,
                            profanity_count: 0,
                            profanity_words: [],
                            flagged_phrases: []
                        } %}
                        {% set cm = postCommentModeration[post.id] ?? {total: 0, flagged: 0, review: 0, spam: 0, high_risk: 0, auto_hidden: 0, top_terms: [], samples: []} %}
                        {% set stateClass = {
                            'SAFE': 'badge-mod-safe',
                            'REVIEW': 'badge-mod-review',
                            'SPAM': 'badge-mod-spam',
                            'HIGH_RISK': 'badge-mod-high-risk',
                            'AUTO_HIDDEN': 'badge-mod-hidden'
                        }[m.state]|default('badge-mod-safe') %}
                        {% set stateText = {
                            'SAFE': '🟢 Safe',
                            'REVIEW': '⚠️ Review',
                            'SPAM': '🕷 Spam',
                            'HIGH_RISK': '🚨 High Risk',
                            'AUTO_HIDDEN': '⛔ Hidden'
                        }[m.state]|default('🟢 Safe') %}
                        {% set titlePrefix = '' %}
                        {% if m.state == 'HIGH_RISK' %}{% set titlePrefix = titlePrefix ~ '🚨 ' %}{% endif %}
                        {% if m.state == 'REVIEW' %}{% set titlePrefix = titlePrefix ~ '⚠️ ' %}{% endif %}
                        {% if m.state == 'SPAM' %}{% set titlePrefix = titlePrefix ~ '🕷 ' %}{% endif %}
                        {% if m.flaggedByAi %}{% set titlePrefix = titlePrefix ~ '🧠 ' %}{% endif %}
                        <tr>
                            <td><input type="checkbox" class="post-check" name="post_ids[]" value="{{ post.id }}" form="bulk-posts-form"></td>
                            <td style="color:var(--text-muted); font-size:13px;">{{ post.id }}</td>
                            <td class="post-title-cell" title="{{ post.title }}">{{ titlePrefix }}{{ post.title }}</td>
                            <td>{{ authorMap[post.userId] ?? 'User #' ~ post.userId }}</td>
                            <td>
                                <span class="type-dot type-{{ post.type }}">{{ post.type }}</span>
                            </td>
                            <td>
                                {% if m.state == 'AUTO_HIDDEN' %}
                                    <span class="badge badge-mod-hidden">⛔ Auto-hidden (AI)</span>
                                {% elseif not post.isConfirmed and m.state != 'SAFE' %}
                                    <span class="badge badge-pending">⏳ Pending (AI flagged)</span>
                                {% elseif post.isConfirmed %}
                                    <span class="badge badge-approved">✅ Approved</span>
                                {% else %}
                                    <span class="badge badge-pending">⏳ Pending</span>
                                {% endif %}
                            </td>
                            <td>
                                <button
                                    type="button"
                                    class="badge mod-badge-btn {{ stateClass }}"
                                    title="OpenAI: hate={{ (m.openai.hate * 100)|round(0) }}%, harassment={{ (m.openai.harassment * 100)|round(0) }}%, self_harm={{ (m.openai.self_harm * 100)|round(0) }}%, violence={{ (m.openai.violence * 100)|round(0) }}%&#10;Spam (Akismet): probability={{ (m.spam_probability * 100)|round(0) }}%&#10;Profanity: count={{ m.profanity_count }}"
                                    data-open-moderation="1"
                                    data-post-id="{{ post.id }}"
                                    data-post-title="{{ post.title|e('html_attr') }}"
                                    data-post-content="{{ post.body|e('html_attr') }}"
                                    data-state="{{ m.state }}"
                                    data-openai-hate="{{ m.openai.hate }}"
                                    data-openai-harassment="{{ m.openai.harassment }}"
                                    data-openai-self-harm="{{ m.openai.self_harm }}"
                                    data-openai-violence="{{ m.openai.violence }}"
                                    data-spam="{{ m.spam_probability }}"
                                    data-profanity-count="{{ m.profanity_count }}"
                                    data-profanity-words="{{ (m.profanity_words|join('||'))|e('html_attr') }}"
                                    data-flagged-phrases="{{ (m.flagged_phrases|join('||'))|e('html_attr') }}"
                                    data-comments-total="{{ cm.total|default(0) }}"
                                    data-comments-flagged="{{ cm.flagged|default(0) }}"
                                    data-comments-review="{{ cm.review|default(0) }}"
                                    data-comments-spam="{{ cm.spam|default(0) }}"
                                    data-comments-high-risk="{{ cm.high_risk|default(0) }}"
                                    data-comments-auto-hidden="{{ cm.auto_hidden|default(0) }}"
                                    data-comments-top-terms="{{ (cm.top_terms|default([])|join('||'))|e('html_attr') }}"
                                    data-comments-samples="{{ (cm.samples|default([])|join('||'))|e('html_attr') }}"
                                >{{ stateText }}</button>
                            </td>
                            {% set commentRiskClass = 'badge-mod-review' %}
                            {% if (cm.high_risk|default(0) + cm.auto_hidden|default(0)) > 0 %}
                                {% set commentRiskClass = 'badge-mod-high-risk' %}
                            {% elseif (cm.spam|default(0)) > 0 %}
                                {% set commentRiskClass = 'badge-mod-spam' %}
                            {% endif %}
                            <td>
                                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                                    <span style="font-weight:700;">{{ postCommentCounts[post.id] ?? 0 }}</span>
                                    {% if (cm.flagged|default(0)) > 0 %}
                                        <span class="badge {{ commentRiskClass }}" title="{{ cm.flagged }} flagged out of {{ cm.total|default(0) }} comments">🚩 {{ cm.flagged }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td style="font-weight:700;">{{ postReactionCounts[post.id] ?? 0 }}</td>
                            <td style="font-size:13px; color:var(--text-muted);">
                                {% if post.createdAt %}{{ post.createdAt|date('d M Y') }}{% endif %}
                            </td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn-view" data-open-moderation="1"
                                            data-post-id="{{ post.id }}"
                                            data-post-title="{{ post.title|e('html_attr') }}"
                                            data-post-content="{{ post.body|e('html_attr') }}"
                                            data-state="{{ m.state }}"
                                            data-openai-hate="{{ m.openai.hate }}"
                                            data-openai-harassment="{{ m.openai.harassment }}"
                                            data-openai-self-harm="{{ m.openai.self_harm }}"
                                            data-openai-violence="{{ m.openai.violence }}"
                                            data-spam="{{ m.spam_probability }}"
                                            data-profanity-count="{{ m.profanity_count }}"
                                            data-profanity-words="{{ (m.profanity_words|join('||'))|e('html_attr') }}"
                                            data-flagged-phrases="{{ (m.flagged_phrases|join('||'))|e('html_attr') }}"
                                                data-comments-total="{{ cm.total|default(0) }}"
                                                data-comments-flagged="{{ cm.flagged|default(0) }}"
                                                data-comments-review="{{ cm.review|default(0) }}"
                                                data-comments-spam="{{ cm.spam|default(0) }}"
                                                data-comments-high-risk="{{ cm.high_risk|default(0) }}"
                                                data-comments-auto-hidden="{{ cm.auto_hidden|default(0) }}"
                                                data-comments-top-terms="{{ (cm.top_terms|default([])|join('||'))|e('html_attr') }}"
                                                data-comments-samples="{{ (cm.samples|default([])|join('||'))|e('html_attr') }}"
                                            title="View moderation details" aria-label="View moderation details">👁</button>

                                    <form method="post" action="{{ path('admin_blog_approve', {id: post.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_' ~ post.id) }}">
                                        <button type="submit" class="btn-approve" title="Approve post" aria-label="Approve post">✔</button>
                                    </form>

                                    <form method="post" action="{{ path('admin_blog_reject', {id: post.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_' ~ post.id) }}">
                                        <button type="submit" class="btn-reject" title="Reject post" aria-label="Reject post">✖</button>
                                    </form>

                                    <form method="post"
                                          action="{{ path('admin_blog_delete', {id: post.id}) }}"
                                          onsubmit="return confirm('Delete this post permanently?');">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('admin_blog_delete_' ~ post.id) }}">
                                             <button type="submit" class="btn-del" title="Delete post" aria-label="Delete post">🗑</button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# ── Travel Stories Tab ── #}
<div class="tab-panel" id="tab-stories">
    {% if stories is empty %}
        <div class="empty-state">
            <p style="font-size:42px;">🧳</p>
            <p>No travel stories yet.</p>
        </div>
    {% else %}
        <div class="table-scroll">
            <table class="blog-table stories-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cover</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Destination</th>
                        <th>Type / Style</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>🛡 Moderation</th>
                        <th>Comments</th>
                        <th>Reacts</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for story in stories %}
                        {% set m = storyModeration[story.id] ?? {state: 'SAFE'} %}
                        {% set cm = storyCommentModeration[story.id] ?? {total: 0, flagged: 0, review: 0, spam: 0, high_risk: 0, auto_hidden: 0, top_terms: [], samples: []} %}
                        {% set stateClass = {
                            'SAFE': 'badge-mod-safe',
                            'REVIEW': 'badge-mod-review',
                            'SPAM': 'badge-mod-spam',
                            'HIGH_RISK': 'badge-mod-high-risk',
                            'AUTO_HIDDEN': 'badge-mod-hidden'
                        }[m.state]|default('badge-mod-safe') %}
                        {% set stateText = {
                            'SAFE': '🟢 Safe',
                            'REVIEW': '⚠️ Review',
                            'SPAM': '🕷 Spam',
                            'HIGH_RISK': '🚨 High Risk',
                            'AUTO_HIDDEN': '⛔ Hidden'
                        }[m.state]|default('🟢 Safe') %}
                        <tr>
                            <td style="color:var(--text-muted); font-size:13px;">{{ story.id }}</td>
                            <td>
                                {% if story.coverImageUrl %}
                                    <img src="{{ story.coverImageUrl }}" alt="" class="story-cover-thumb">
                                {% else %}
                                    <span style="color:var(--text-muted); font-size:12px;">—</span>
                                {% endif %}
                            </td>
                            <td class="post-title-cell" title="{{ story.title }}">{{ story.title }}</td>
                            <td>{{ authorMap[story.userId] ?? 'User #' ~ story.userId }}</td>
                            <td class="story-destination-cell" title="{{ story.destination ?? '—' }}">{{ story.destination ?? '—' }}</td>
                            <td>
                                {% if story.travelType %}
                                    <span class="type-dot type-travel">{{ story.travelType }}</span>
                                {% endif %}
                                {% if story.travelStyle %}
                                    <span class="type-dot" style="background:#ede9fe;color:#5b21b6;">{{ story.travelStyle }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if story.overallRating %}
                                    <span class="star-rating">
                                        {% for i in 1..story.overallRating %}⭐{% endfor %}
                                    </span>
                                {% else %}
                                    <span style="color:var(--text-muted);">—</span>
                                {% endif %}
                            </td>
                            <td><span class="badge badge-approved">✅ Published</span></td>
                            {% set storyPreview = [story.summary ?? '', story.tips ?? '', story.destination ?? '']|join("\n")|trim %}
                            <td>
                                <button
                                    type="button"
                                    class="badge mod-badge-btn {{ stateClass }}"
                                    data-open-moderation="1"
                                    data-content-type="travel_story"
                                    data-post-id="{{ story.id }}"
                                    data-post-title="{{ story.title|default('Travel story')|e('html_attr') }}"
                                    data-post-content="{{ storyPreview|e('html_attr') }}"
                                    data-state="{{ m.state }}"
                                    data-openai-hate="{{ m.openai.hate|default(0) }}"
                                    data-openai-harassment="{{ m.openai.harassment|default(0) }}"
                                    data-openai-self-harm="{{ m.openai.self_harm|default(0) }}"
                                    data-openai-violence="{{ m.openai.violence|default(0) }}"
                                    data-spam="{{ m.spam_probability|default(0) }}"
                                    data-profanity-count="{{ m.profanity_count|default(0) }}"
                                    data-profanity-words="{{ (m.profanity_words|default([])|join('||'))|e('html_attr') }}"
                                    data-flagged-phrases="{{ (m.flagged_phrases|default([])|join('||'))|e('html_attr') }}"
                                    data-comments-total="{{ cm.total|default(0) }}"
                                    data-comments-flagged="{{ cm.flagged|default(0) }}"
                                    data-comments-review="{{ cm.review|default(0) }}"
                                    data-comments-spam="{{ cm.spam|default(0) }}"
                                    data-comments-high-risk="{{ cm.high_risk|default(0) }}"
                                    data-comments-auto-hidden="{{ cm.auto_hidden|default(0) }}"
                                    data-comments-top-terms="{{ (cm.top_terms|default([])|join('||'))|e('html_attr') }}"
                                    data-comments-samples="{{ (cm.samples|default([])|join('||'))|e('html_attr') }}"
                                >{{ stateText }}</button>
                            </td>
                            {% set commentRiskClass = 'badge-mod-review' %}
                            {% if (cm.high_risk|default(0) + cm.auto_hidden|default(0)) > 0 %}
                                {% set commentRiskClass = 'badge-mod-high-risk' %}
                            {% elseif (cm.spam|default(0)) > 0 %}
                                {% set commentRiskClass = 'badge-mod-spam' %}
                            {% endif %}
                            <td>
                                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                                    <span style="font-weight:700;">{{ storyCommentCounts[story.id] ?? 0 }}</span>
                                    {% if (cm.flagged|default(0)) > 0 %}
                                        <span class="badge {{ commentRiskClass }}" title="{{ cm.flagged }} flagged out of {{ cm.total|default(0) }} comments">🚩 {{ cm.flagged }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td style="font-weight:700;">{{ storyReactionCounts[story.id] ?? 0 }}</td>
                            <td style="font-size:13px; color:var(--text-muted);">
                                {% if story.createdAt %}{{ story.createdAt|date('d M Y') }}{% endif %}
                            </td>
                            <td>
                                <div class="actions">
                                    <a href="{{ path('admin_story_show', {id: story.id}) }}" class="btn-view" title="View travel story" aria-label="View travel story">👁</a>
                                    <form method="post"
                                          action="{{ path('admin_story_delete', {id: story.id}) }}"
                                          onsubmit="return confirm('Delete this travel story permanently?');">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('admin_story_delete_' ~ story.id) }}">
                                        <button type="submit" class="btn-del" title="Delete travel story" aria-label="Delete travel story">🗑</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<div class="mod-modal-backdrop" id="moderation-modal" aria-hidden="true">
    <div class="mod-modal" role="dialog" aria-modal="true" aria-labelledby="moderation-modal-title">
        <div class="mod-head">
            <h3 id="moderation-modal-title">🛡 Moderation Analysis</h3>
            <button type="button" class="mod-close" id="mod-close">×</button>
        </div>
        <div class="mod-body">
            <div class="mod-box">
                <strong>Content ID:</strong> <span id="mod-post-id">—</span>
                <div><strong>Type:</strong> <span id="mod-content-type">—</span></div>
                <div><strong>Title:</strong> <span id="mod-post-title">—</span></div>
            </div>

            <div class="mod-grid">
                <div class="mod-box">
                    <h4>OpenAI Moderation</h4>
                    <div class="mod-line"><span>Hate</span><span id="mod-hate">—</span></div>
                    <div class="mod-line"><span>Harassment</span><span id="mod-harassment">—</span></div>
                    <div class="mod-line"><span>Self-harm</span><span id="mod-self-harm">—</span></div>
                    <div class="mod-line"><span>Violence</span><span id="mod-violence">—</span></div>
                </div>
                <div class="mod-box">
                    <h4>Spam Detection</h4>
                    <div class="mod-line"><span>Probability</span><span id="mod-spam">—</span></div>
                    <div class="mod-line"><span>Status</span><span id="mod-spam-status">—</span></div>
                </div>
                <div class="mod-box">
                    <h4>Profanity</h4>
                    <div class="mod-line"><span>Detected words</span><span id="mod-profanity-count">—</span></div>
                    <div id="mod-profanity-list" style="font-size:12px; color:var(--text-muted);"></div>
                </div>
                <div class="mod-box">
                    <h4>Moderation State</h4>
                    <div class="mod-line"><span>Current state</span><span id="mod-state">—</span></div>
                </div>
                <div class="mod-box">
                    <h4>Comments Moderation</h4>
                    <div class="mod-line"><span>Total comments</span><span id="mod-comments-total">0</span></div>
                    <div class="mod-line"><span>Flagged comments</span><span id="mod-comments-flagged">0</span></div>
                    <div class="mod-line"><span>High Risk / Hidden</span><span id="mod-comments-high-risk">0 / 0</span></div>
                    <div class="mod-line"><span>Review / Spam</span><span id="mod-comments-review-spam">0 / 0</span></div>
                    <div id="mod-comments-top" style="font-size:12px; color:var(--text-muted); margin-top:6px;"></div>
                    <div id="mod-comments-samples" style="font-size:12px; color:var(--text-muted); margin-top:4px;"></div>
                </div>
            </div>

            <div>
                <h4 style="margin:0 0 8px;">Content Preview</h4>
                <div class="mod-content" id="mod-content-preview"></div>
            </div>

            <div class="mod-actions" id="mod-actions-wrap">
                <form method="post" id="mod-form-approve">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_action') }}">
                    <input type="hidden" name="_tab" value="moderation">
                    <button type="submit" class="btn-approve" title="Approve post" aria-label="Approve post">✔</button>
                </form>
                <form method="post" id="mod-form-reject">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_action') }}">
                    <input type="hidden" name="_tab" value="moderation">
                    <button type="submit" class="btn-reject" title="Reject post" aria-label="Reject post">✖</button>
                </form>
                <form method="post" id="mod-form-delete" onsubmit="return confirm('Delete this post permanently?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_action') }}">
                    <input type="hidden" name="_tab" value="moderation">
                    <button type="submit" class="btn-del" title="Delete post" aria-label="Delete post">🗑</button>
                </form>
                <form method="post" id="mod-form-safe">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_blog_bulk_action') }}">
                    <input type="hidden" name="_tab" value="moderation">
                    <input type="hidden" name="bulk_action" value="mark_safe">
                    <input type="hidden" name="post_ids[]" id="mod-mark-safe-id" value="">
                    <button type="submit" class="btn-bulk">Mark as Safe</button>
                </form>
            </div>
            <div id="mod-readonly-note" style="display:none; font-size:12px; color:var(--text-muted);">
                Analysis only for this content type. Use row actions in this tab for moderation/removal.
            </div>
        </div>
    </div>
</div>

{# ── IG Stories Tab ── #}
<div class="tab-panel" id="tab-ig-stories">
