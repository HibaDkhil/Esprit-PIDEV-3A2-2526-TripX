    {% else %}
        <div class="table-scroll">
            <table class="blog-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Preview</th>
                        <th>Title</th>
                        <th>Host</th>
                        <th>Status</th>
                        <th>🛡 Moderation</th>
                        <th>Comments</th>
                        <th>Reacts</th>
                        <th>Viewers</th>
                        <th>Started</th>
                        <th>Ended</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for live in liveSessions %}
                        {% set m = liveModeration[live.id] ?? {state: 'SAFE'} %}
                        {% set cm = liveCommentModeration[live.id] ?? {total: 0, flagged: 0, review: 0, spam: 0, high_risk: 0, auto_hidden: 0, top_terms: [], samples: []} %}
                        {% set stateClass = {
                            'SAFE': 'badge-mod-safe',
                            'REVIEW': 'badge-mod-review',
                            'SPAM': 'badge-mod-spam',
                            'HIGH_RISK': 'badge-mod-high-risk',
                            'AUTO_HIDDEN': 'badge-mod-hidden'
                        }[m.state]|default('badge-mod-safe') %}
                        {% set stateText = {
                            'SAFE': '🟢 Safe',
                            'REVIEW': '⚠️ Review',
                            'SPAM': '🕷 Spam',
                            'HIGH_RISK': '🚨 High Risk',
                            'AUTO_HIDDEN': '⛔ Hidden'
                        }[m.state]|default('🟢 Safe') %}
                        <tr>
                            <td style="color:var(--text-muted); font-size:13px;">{{ live.id }}</td>
                            <td>
                                {% if live.thumbnailUrl %}
                                    <img src="{{ live.thumbnailUrl }}" alt="" class="live-thumb">
                                {% elseif live.recordingUrl %}
                                    <a href="{{ live.recordingUrl }}" target="_blank" rel="noopener" class="btn-view">Recording</a>
                                {% else %}
                                    <span style="color:var(--text-muted); font-size:12px;">—</span>
                                {% endif %}
                            </td>
                            <td class="post-title-cell" title="{{ live.title ?? 'Untitled live' }}">{{ live.title ?? 'Untitled live' }}</td>
                            <td>{{ authorMap[live.hostUser.userId] ?? 'User #' ~ live.hostUser.userId }}</td>
                            <td>
                                {% if live.status == 'live' %}
                                    <span class="badge badge-approved">🔴 Live</span>
                                {% else %}
                                    <span class="badge badge-pending">⏹️ {{ live.status|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <button
                                    type="button"
                                    class="badge mod-badge-btn {{ stateClass }}"
                                    data-open-moderation="1"
                                    data-content-type="live"
                                    data-post-id="{{ live.id }}"
                                    data-post-title="{{ (live.title ?? 'Untitled live')|e('html_attr') }}"
                                    data-post-content="{{ ('Room: ' ~ (live.roomName ?? ''))|e('html_attr') }}"
                                    data-state="{{ m.state }}"
                                    data-openai-hate="{{ m.openai.hate|default(0) }}"
                                    data-openai-harassment="{{ m.openai.harassment|default(0) }}"
                                    data-openai-self-harm="{{ m.openai.self_harm|default(0) }}"
                                    data-openai-violence="{{ m.openai.violence|default(0) }}"
                                    data-spam="{{ m.spam_probability|default(0) }}"
                                    data-profanity-count="{{ m.profanity_count|default(0) }}"
                                    data-profanity-words="{{ (m.profanity_words|default([])|join('||'))|e('html_attr') }}"
                                    data-flagged-phrases="{{ (m.flagged_phrases|default([])|join('||'))|e('html_attr') }}"
                                    data-comments-total="{{ cm.total|default(0) }}"
                                    data-comments-flagged="{{ cm.flagged|default(0) }}"
                                    data-comments-review="{{ cm.review|default(0) }}"
                                    data-comments-spam="{{ cm.spam|default(0) }}"
                                    data-comments-high-risk="{{ cm.high_risk|default(0) }}"
                                    data-comments-auto-hidden="{{ cm.auto_hidden|default(0) }}"
                                    data-comments-top-terms="{{ (cm.top_terms|default([])|join('||'))|e('html_attr') }}"
                                    data-comments-samples="{{ (cm.samples|default([])|join('||'))|e('html_attr') }}"
                                >{{ stateText }}</button>
                            </td>
                            {% set commentRiskClass = 'badge-mod-review' %}
                            {% if (cm.high_risk|default(0) + cm.auto_hidden|default(0)) > 0 %}
                                {% set commentRiskClass = 'badge-mod-high-risk' %}
                            {% elseif (cm.spam|default(0)) > 0 %}
                                {% set commentRiskClass = 'badge-mod-spam' %}
                            {% endif %}
                            <td>
                                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                                    <span style="font-weight:700;">{{ liveCommentCounts[live.id] ?? 0 }}</span>
                                    {% if (cm.flagged|default(0)) > 0 %}
                                        <span class="badge {{ commentRiskClass }}" title="{{ cm.flagged }} flagged out of {{ cm.total|default(0) }} comments">🚩 {{ cm.flagged }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td style="font-weight:700;">{{ liveReactionCounts[live.id] ?? 0 }}</td>
                            <td style="font-weight:700;">
                                {{ liveActiveViewerCounts[live.id] ?? 0 }}
                                <span style="color:var(--text-muted); font-size:12px;">/ {{ liveViewerCounts[live.id] ?? 0 }}</span>
                            </td>
                            <td style="font-size:13px; color:var(--text-muted);">{{ live.startedAt ? live.startedAt|date('d M Y H:i') : '—' }}</td>
                            <td style="font-size:13px; color:var(--text-muted);">{{ live.endedAt ? live.endedAt|date('d M Y H:i') : '—' }}</td>
                            <td>
                                <div class="actions">
                                    {% if live.recordingUrl %}
                                        <a href="{{ live.recordingUrl }}" target="_blank" rel="noopener" class="btn-view" title="View live recording" aria-label="View live recording">👁</a>
                                    {% endif %}
                                    <form method="post"
                                          action="{{ path('admin_live_delete', {id: live.id}) }}"
                                          onsubmit="return confirm('Delete this live session permanently?');">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('admin_live_delete_' ~ live.id) }}">
                                        <button type="submit" class="btn-del" title="Delete live session" aria-label="Delete live session">🗑</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
function getCurrentTab() {
    const activePanel = document.querySelector('.tab-panel.active');
    return activePanel ? activePanel.id.replace('tab-', '') : 'posts';
}

function updateTabInUrl(tab) {
    const url = new URL(window.location.href);
    url.searchParams.set('tab', tab);
    window.history.replaceState(null, '', url.toString());
}

function switchTab(tab, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    btn.classList.add('active');
    updateTabInUrl(tab);
    
    // Resize charts in case they were hidden
    setTimeout(() => {
        window.dispatchEvent(new Event('resize'));
    }, 50);
}

document.addEventListener('DOMContentLoaded', () => {
    const url = new URL(window.location.href);
    const tab = url.searchParams.get('tab');
    const panel = tab ? document.getElementById('tab-' + tab) : null;
    const tabBtn = tab ? document.querySelector('.admin-tab[data-tab="' + tab + '"]') : null;

    if (panel && tabBtn) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
        panel.classList.add('active');
        tabBtn.classList.add('active');
    }

    if (!tab) {
        updateTabInUrl(getCurrentTab());
    }

    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', () => {
            let tabInput = form.querySelector('input[name="_tab"]');
            if (!tabInput) {
                tabInput = document.createElement('input');
                tabInput.type = 'hidden';
                tabInput.name = '_tab';
                form.appendChild(tabInput);
            }
            tabInput.value = getCurrentTab();
        });
    });

    const selectAllPosts = document.getElementById('select-all-posts');
    const bulkPostsForm = document.getElementById('bulk-posts-form');
    const bulkActionInput = document.getElementById('bulk-action-input');
    if (selectAllPosts) {
        selectAllPosts.addEventListener('change', () => {
            document.querySelectorAll('.post-check').forEach(box => {
                box.checked = selectAllPosts.checked;
            });
        });
    }

    document.querySelectorAll('[data-bulk-action]').forEach((btn) => {
        btn.addEventListener('click', () => {
            if (!bulkPostsForm || !bulkActionInput) return;
            bulkActionInput.value = String(btn.getAttribute('data-bulk-action') || '').trim();
            bulkPostsForm.requestSubmit();
        });
    });

    const modal = document.getElementById('moderation-modal');
    const modClose = document.getElementById('mod-close');
    const modPostId = document.getElementById('mod-post-id');
    const modContentType = document.getElementById('mod-content-type');
    const modPostTitle = document.getElementById('mod-post-title');
    const modState = document.getElementById('mod-state');
    const modHate = document.getElementById('mod-hate');
    const modHarassment = document.getElementById('mod-harassment');
    const modSelfHarm = document.getElementById('mod-self-harm');
    const modViolence = document.getElementById('mod-violence');
    const modSpam = document.getElementById('mod-spam');
    const modSpamStatus = document.getElementById('mod-spam-status');
    const modProfanityCount = document.getElementById('mod-profanity-count');
    const modProfanityList = document.getElementById('mod-profanity-list');
    const modPreview = document.getElementById('mod-content-preview');
    const modCommentsTotal = document.getElementById('mod-comments-total');
    const modCommentsFlagged = document.getElementById('mod-comments-flagged');
    const modCommentsHighRisk = document.getElementById('mod-comments-high-risk');
    const modCommentsReviewSpam = document.getElementById('mod-comments-review-spam');
    const modCommentsTop = document.getElementById('mod-comments-top');
    const modCommentsSamples = document.getElementById('mod-comments-samples');

    const modApprove = document.getElementById('mod-form-approve');
    const modReject = document.getElementById('mod-form-reject');
    const modDelete = document.getElementById('mod-form-delete');
    const modMarkSafeId = document.getElementById('mod-mark-safe-id');
    const modActionsWrap = document.getElementById('mod-actions-wrap');
    const modReadonlyNote = document.getElementById('mod-readonly-note');

    const esc = (v) => (v || '').replace(/[&<>"']/g, (m) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[m]));
    const pct = (n) => `${Math.round((Number(n || 0) * 100))}%`;
    const level = (n) => {
        const v = Number(n || 0);
        if (v >= 0.75) return 'high';
        if (v >= 0.45) return 'medium';
        if (v > 0.1) return 'low';
        return 'none';
    };

    const setActionTargets = (postId) => {
        modApprove.action = `{{ path('admin_blog_approve', {id: 0}) }}`.replace('/0/', `/${postId}/`);
        modReject.action = `{{ path('admin_blog_reject', {id: 0}) }}`.replace('/0/', `/${postId}/`);
        modDelete.action = `{{ path('admin_blog_delete', {id: 0}) }}`.replace('/0/', `/${postId}/`);
        modMarkSafeId.value = String(postId || '');
    };

    const highlightContent = (raw, profanityWords, flaggedPhrases) => {
        let html = esc(raw || '');
        (flaggedPhrases || []).filter(Boolean).sort((a,b) => b.length - a.length).forEach((phrase) => {
            const safe = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            html = html.replace(new RegExp(`(${safe})`, 'gi'), '<span class="hl-flag">$1</span>');
        });
        (profanityWords || []).filter(Boolean).sort((a,b) => b.length - a.length).forEach((word) => {
            const safe = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            html = html.replace(new RegExp(`\\b(${safe})\\b`, 'gi'), '<span class="hl-profanity">$1</span>');
        });
        return html;
    };

    document.querySelectorAll('[data-open-moderation="1"]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const postId = btn.dataset.postId || '';
            const title = btn.dataset.postTitle || '';
            const content = btn.dataset.postContent || '';
            const state = btn.dataset.state || 'SAFE';
            const contentType = btn.dataset.contentType || 'post';

            const hate = Number(btn.dataset.openaiHate || 0);
            const harassment = Number(btn.dataset.openaiHarassment || 0);
            const selfHarm = Number(btn.dataset.openaiSelfHarm || 0);
            const violence = Number(btn.dataset.openaiViolence || 0);
            const spam = Number(btn.dataset.spam || 0);
            const profanityCount = Number(btn.dataset.profanityCount || 0);
            const commentsTotal = Number(btn.dataset.commentsTotal || 0);
            const commentsFlagged = Number(btn.dataset.commentsFlagged || 0);
            const commentsReview = Number(btn.dataset.commentsReview || 0);
            const commentsSpam = Number(btn.dataset.commentsSpam || 0);
            const commentsHighRisk = Number(btn.dataset.commentsHighRisk || 0);
            const commentsAutoHidden = Number(btn.dataset.commentsAutoHidden || 0);

            const profanityWords = (btn.dataset.profanityWords || '').split('||').filter(Boolean);
            const flaggedPhrases = (btn.dataset.flaggedPhrases || '').split('||').filter(Boolean);
            const commentsTopTerms = (btn.dataset.commentsTopTerms || '').split('||').filter(Boolean);
            const commentsSamples = (btn.dataset.commentsSamples || '').split('||').filter(Boolean);

            modPostId.textContent = postId;
            modContentType.textContent = contentType.replace('_', ' ').toUpperCase();
            modPostTitle.textContent = title;
            modState.textContent = state;
            modHate.textContent = `${level(hate)} (${pct(hate)})`;
            modHarassment.textContent = `${level(harassment)} (${pct(harassment)})`;
            modSelfHarm.textContent = `${level(selfHarm)} (${pct(selfHarm)})`;
            modViolence.textContent = `${level(violence)} (${pct(violence)})`;
            modSpam.textContent = pct(spam);
            modSpamStatus.textContent = spam > 0.75 ? 'Likely spam' : (spam > 0.45 ? 'Suspicious' : 'Not spam');
            modProfanityCount.textContent = String(profanityCount);
            modProfanityList.textContent = profanityWords.length ? `Words: ${profanityWords.join(', ')}` : 'No explicit profanity detected.';
            modCommentsTotal.textContent = String(commentsTotal);
            modCommentsFlagged.textContent = String(commentsFlagged);
            modCommentsHighRisk.textContent = `${commentsHighRisk} / ${commentsAutoHidden}`;
            modCommentsReviewSpam.textContent = `${commentsReview} / ${commentsSpam}`;
            modCommentsTop.textContent = commentsTopTerms.length ? `Top terms in comments: ${commentsTopTerms.join(', ')}` : 'No notable flagged terms in comments.';
            modCommentsSamples.textContent = commentsSamples.length ? `Examples: ${commentsSamples.join(' | ')}` : 'No flagged comment samples.';
            modPreview.innerHTML = highlightContent(content, profanityWords, flaggedPhrases);

            if (contentType === 'post') {
                setActionTargets(postId);
                if (modActionsWrap) modActionsWrap.style.display = 'flex';
                if (modReadonlyNote) modReadonlyNote.style.display = 'none';
            } else {
                if (modActionsWrap) modActionsWrap.style.display = 'none';
                if (modReadonlyNote) modReadonlyNote.style.display = 'block';
            }
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
        });
    });

    const closeModal = () => {
        if (!modal) return;
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
    };

    if (modClose) modClose.addEventListener('click', closeModal);
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    }

    // --- Manually initialize Symfony UX Chart.js charts ---
    const chartElements = document.querySelectorAll('canvas[data-controller="symfony--ux-chartjs--chart"]');
    chartElements.forEach(canvas => {
        try {
            const viewValue = JSON.parse(canvas.getAttribute('data-symfony--ux-chartjs--chart-view-value'));
            if (viewValue) {
                new Chart(canvas, {
                    type: viewValue.type,
                    data: viewValue.data,
                    options: viewValue.options
                });
            }
        } catch (e) {
            console.error('Failed to initialize chart:', e);
        }
    });
});
</script>

{% endblock %}