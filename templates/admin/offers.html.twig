{% extends 'admin/admin_base.html.twig' %}
{% block title %}Manage Offers — TripX Admin{% endblock %}

{% block page_styles %}
  .dest-table { width:100%; border-collapse:separate; border-spacing:0; background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--border-radius-lg); overflow:hidden; }
  .dest-table th { background:rgba(0,166,237,0.05); text-align:left; padding:16px 20px; font-family:var(--font-display); font-size:14px; }
  .dest-table td { padding:16px 20px; border-bottom:1px solid var(--border-color); font-size:14px; }
  .dest-table tr:last-child td { border-bottom:none; }
  a, button { cursor: pointer !important; }

  .filter-bar { display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; padding:16px 20px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--border-radius-lg); margin-bottom:20px; }
  .filter-bar input, .filter-bar select { padding:9px 14px; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:13px; }
  .filter-bar input:focus, .filter-bar select:focus { outline:none; border-color:var(--accent-primary); }
  .filter-label { font-size:11px; font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); display:block; margin-bottom:5px; }
  .filter-bar select option {
      background: var(--bg-card);
      color: var(--text-primary);
    }



  .pagination { display:flex; justify-content:center; align-items:center; gap:6px; margin-top:24px; list-style:none; padding:0; }
  .pagination li a, .pagination li span { display:inline-flex; align-items:center; justify-content:center; min-width:36px; height:36px; padding:0 10px; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-card); color:var(--text-primary); font-size:13px; text-decoration:none; transition:all .2s; }
  .pagination li.active span { background:var(--accent-primary); border-color:var(--accent-primary); color:#fff; font-weight:700; }
  .pagination li a:hover { border-color:var(--accent-primary); color:var(--accent-primary); }
  .pagination li.disabled span { opacity:.35; cursor:not-allowed; }
{% endblock %}

{% block breadcrumbs %}
  <a href="{{ path('admin_dashboard') }}" class="crumb">Dashboard</a>
  <span class="sep">›</span>
  <span class="crumb active">Offers</span>
{% endblock %}

{% block content %}
<div class="reveal">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;">
    <div>
      <h1 class="display-sm" style="margin-bottom:4px">Offers & Discounts</h1>
      <p class="text-muted" style="font-size:14px">Manage promotional offers and discounts.</p>
    </div>
    <a href="{{ path('admin_offer_add') }}" class="btn btn-primary ripple-btn">+ Add New Offer</a>
  </div>

  {# Stats #}
  <div class="stats-tab-bar reveal" style="display:flex;gap:16px;margin-bottom:24px;padding:12px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--border-radius-lg);">
    <div style="flex:1;padding:12px 20px;border-right:1px solid var(--border-color);">
      <div class="text-muted" style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px;">Total Offers</div>
      <div style="font-family:var(--font-display);font-size:28px;font-weight:700;color:var(--accent-primary);">{{ stats.total }}</div>
    </div>
    <div style="flex:1;padding:12px 20px;">
      <div class="text-muted" style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px;">Currently Active</div>
      <div style="font-family:var(--font-display);font-size:28px;font-weight:700;color:#10b981;">{{ stats.active }}</div>
    </div>
  </div>

  {# Filters #}
  <form method="get" action="{{ path('admin_offers') }}">
    <div class="filter-bar reveal">
      <div>
        <span class="filter-label">Search</span>
        <input type="text" name="q" value="{{ currentQuery }}" placeholder="Offer title…" style="min-width:220px;">
      </div>
      <div>
        <span class="filter-label">Status</span>
        <select name="status">
          <option value="">All</option>
          <option value="active"   {% if currentStatus == 'active'   %}selected{% endif %}>Active</option>
          <option value="inactive" {% if currentStatus == 'inactive' %}selected{% endif %}>Inactive</option>
        </select>
      </div>
      <div>
        <span class="filter-label">Discount type</span>
        <select name="type">
          <option value="">Any</option>
          <option value="PERCENTAGE" {% if currentType == 'PERCENTAGE' %}selected{% endif %}>% Percentage</option>
          <option value="FIXED"      {% if currentType == 'FIXED'      %}selected{% endif %}>€ Fixed</option>
        </select>
      </div>
      <div style="display:flex;gap:8px;align-self:flex-end;">
        <button type="submit" class="btn btn-primary" style="padding:9px 20px;font-size:13px;">Filter</button>
        <a href="{{ path('admin_offers') }}" class="btn btn-secondary" style="padding:9px 16px;font-size:13px;">Reset</a>
      </div>
    </div>
  </form>

  {# Table #}
  <div style="padding:0;overflow:hidden;">
    <table class="dest-table">
      <thead>
        <tr>
          <th>ID</th><th>Title</th><th>Discount</th><th>Pack</th><th>Valid Period</th><th>Status</th><th style="text-align:right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for item in pagination %}
        <tr>
          <td style="font-family:var(--font-mono);font-size:12px;opacity:0.6">#{{ item.idOffer }}</td>
          <td style="font-weight:600">{{ item.title }}</td>
          <td>
            {% if item.discountType == 'PERCENTAGE' %}
              <span class="badge badge-teal">{{ item.discountValue }}%</span>
            {% else %}
              <span class="badge badge-indigo">€{{ item.discountValue }}</span>
            {% endif %}
          </td>
          <td style="font-family:var(--font-mono);font-size:12px;opacity:0.7">{{ item.packId ? '#' ~ item.packId : '—' }}</td>
          <td style="font-size:12px;">
            {{ item.startDate ? item.startDate|date('d M Y') : '—' }} → {{ item.endDate ? item.endDate|date('d M Y') : '—' }}
          </td>
          <td>
            {% if item.isActive %}
              <span style="padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(16,185,129,0.15);color:#10b981;">ACTIVE</span>
            {% else %}
              <span style="padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(239,68,68,0.15);color:#ef4444;">INACTIVE</span>
            {% endif %}
          </td>
          <td style="text-align:right">
            <div style="display:flex;gap:8px;justify-content:flex-end;align-items:center;">
              <a href="{{ path('admin_offer_toggle', {id: item.idOffer}) }}"
                 style="padding:6px 12px;border-radius:6px;border:1px solid;text-decoration:none;font-size:12px;font-weight:600;
                 {% if item.isActive %}color:#ef4444;border-color:#ef4444;{% else %}color:#10b981;border-color:#10b981;{% endif %}">
                {% if item.isActive %}Deactivate{% else %}Activate{% endif %}
              </a>
              <a href="{{ path('admin_offer_edit', {id: item.idOffer}) }}" class="btn btn-secondary btn-sm">Edit</a>
              <a href="{{ path('admin_offer_delete', {id: item.idOffer}) }}" class="btn btn-primary btn-sm"
                 onclick="return confirm('Delete this offer?')">Delete</a>
            </div>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted)">No offers found.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

{{ knp_pagination_render(pagination, 'pagination/sliding.html.twig') }}
</div>
{% endblock %}
