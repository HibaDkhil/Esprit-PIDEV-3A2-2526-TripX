        <h3 style="margin-bottom:8px; font-family:var(--font-display); font-size:20px; color:var(--text-main);">Confirm Action</h3>
        <p id="customConfirmMessage" style="color:var(--text-muted); margin-bottom:24px; font-size:14px;">Are you sure you want to proceed?</p>
        <div style="display:flex; justify-content:center; gap:12px;">
          <button id="customConfirmCancel" class="btn btn-secondary">Cancel</button>
          <a id="customConfirmOk" href="#" class="btn btn-primary" style="background:#ef4444; border-color:#ef4444;">Yes, confirm</a>
        </div>
