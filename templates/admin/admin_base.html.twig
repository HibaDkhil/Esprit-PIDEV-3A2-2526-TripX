               style="display: none; position: absolute; top: calc(100% + 10px); right: 0;
                      background: var(--bg-card); padding: 20px; border: 1px solid var(--border-color);
                      border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);
                      width: 280px; z-index: 9999;">
            <h4 style="margin-bottom: 12px; color: var(--text-primary); font-family: var(--font-display); font-size: 1.1rem;">🌟 The TripX Team</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px; line-height: 1.4;">
