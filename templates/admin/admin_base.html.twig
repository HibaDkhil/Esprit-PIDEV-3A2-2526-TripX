           style="background:var(--bg-card); padding:24px; border-radius:12px; width:400px;
                  max-width:90%; box-shadow:0 10px 30px rgba(0,0,0,0.3);
                  transform:translateY(20px); transition:transform 0.3s ease; text-align:center;">
