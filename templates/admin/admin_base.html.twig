    </header>

    <!-- PAGE CONTENT -->
    <main class="admin-main">
      {% for label, messages in app.flashes %}
        <div class="flash-container" style="position: fixed; top: 80px; left: 50%; transform: translateX(-50%); z-index: 9999; display: flex; flex-direction: column; gap: 10px;">
