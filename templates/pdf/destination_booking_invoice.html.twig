<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #1a1a2e; padding: 40px; line-height: 1.5; background: #fff; }

        /* Header */
        .header { display: table; width: 100%; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 3px solid #00a6ed; }
        .header-left { display: table-cell; vertical-align: middle; }
        .header-right { display: table-cell; vertical-align: middle; text-align: right; }
        .logo { font-size: 32px; font-weight: 900; color: #1a1a2e; letter-spacing: -1px; }
        .logo span { color: #00a6ed; }
        .logo-sub { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 3px; margin-top: 2px; }
        .invoice-badge { display: inline-block; background: #00a6ed; color: #fff; padding: 6px 18px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; }
        .invoice-number { font-size: 12px; color: #64748b; margin-top: 8px; }

        /* Info Grid */
        .info-grid { display: table; width: 100%; margin-bottom: 30px; }
        .info-col { display: table-cell; width: 50%; vertical-align: top; }
        .info-block { margin-bottom: 16px; }
        .info-label { font-size: 9px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 3px; }
        .info-value { font-size: 14px; font-weight: 600; color: #1a1a2e; }
        .info-value-sm { font-size: 12px; color: #475569; }

        /* Status */
        .status-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
        .status-confirmed { background: #dcfce7; color: #166534; }
        .status-pending { background: #fef9c3; color: #854d0e; }
        .status-cancelled { background: #fee2e2; color: #991b1b; }
        .payment-paid { background: #dcfce7; color: #166534; }
        .payment-unpaid { background: #fef3c7; color: #92400e; }

        /* Destination Card */
        .dest-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 24px; margin-bottom: 25px; }
        .dest-card-title { font-size: 10px; font-weight: 700; color: #00a6ed; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 14px; }
        .dest-name { font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 4px; }
        .dest-country { font-size: 13px; color: #64748b; margin-bottom: 12px; }
        .dest-meta { display: table; width: 100%; }
        .dest-meta-item { display: table-cell; vertical-align: top; text-align: center; padding: 8px 0; }
        .dest-meta-val { font-size: 16px; font-weight: 700; color: #1a1a2e; }
        .dest-meta-label { font-size: 9px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }

        /* Details Table */
        .details-table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
        .details-table th { text-align: left; font-size: 9px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1.5px; padding: 10px 16px; border-bottom: 2px solid #e2e8f0; }
        .details-table td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; font-size: 13px; color: #334155; }
        .details-table tr:last-child td { border-bottom: none; }

        /* Total Section */
        .total-section { background: #0f172a; color: #fff; border-radius: 10px; padding: 24px; margin-bottom: 30px; display: table; width: 100%; }
        .total-left { display: table-cell; vertical-align: middle; }
        .total-right { display: table-cell; vertical-align: middle; text-align: right; }
        .total-label { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: #94a3b8; }
        .total-amount { font-size: 36px; font-weight: 900; color: #00a6ed; margin-top: 4px; }
        .total-currency { font-size: 14px; color: #64748b; }

        /* Footer */
        .footer { text-align: center; padding-top: 20px; border-top: 1px solid #e2e8f0; margin-top: 20px; }
        .footer-text { font-size: 10px; color: #94a3b8; line-height: 1.8; }
        .footer-brand { font-size: 12px; font-weight: 700; color: #1a1a2e; margin-top: 8px; }

        /* Divider */
        .divider { border: none; border-top: 1px dashed #cbd5e1; margin: 20px 0; }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <div class="logo">Trip<span>X</span></div>
            <div class="logo-sub">Destination Booking Invoice</div>
        </div>
        <div class="header-right">
            <div class="invoice-badge">Invoice</div>
            <div class="invoice-number">INV-{{ booking.bookingReference }}</div>
        </div>
    </div>

    <!-- Booking & Customer Info -->
    <div class="info-grid">
        <div class="info-col">
            <div class="info-block">
                <div class="info-label">Booking Reference</div>
                <div class="info-value">#{{ booking.bookingReference }}</div>
            </div>
            <div class="info-block">
                <div class="info-label">Customer Email</div>
                <div class="info-value-sm">{{ booking.userEmail|default('N/A') }}</div>
            </div>
            <div class="info-block">
                <div class="info-label">Booked On</div>
                <div class="info-value-sm">{{ booking.createdAt|date('d M Y, H:i') }}</div>
            </div>
        </div>
        <div class="info-col" style="text-align: right;">
            <div class="info-block">
                <div class="info-label">Invoice Date</div>
                <div class="info-value">{{ "now"|date("d M Y") }}</div>
            </div>
            <div class="info-block">
                <div class="info-label">Booking Status</div>
                <div>
                    <span class="status-badge status-{{ booking.status }}">{{ booking.status|upper }}</span>
                </div>
            </div>
            <div class="info-block">
                <div class="info-label">Payment Status</div>
                <div>
                    <span class="status-badge payment-{{ booking.paymentStatus }}">{{ booking.paymentStatus|upper }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Destination Card -->
    <div class="dest-card">
        <div class="dest-card-title">Destination Details</div>
        <div class="dest-name">{{ destination.name|default('Unknown Destination') }}</div>
        <div class="dest-country">{{ destination.country|default('') }}{% if destination.continent is defined and destination.continent %}, {{ destination.continent }}{% endif %}</div>
        <div class="dest-meta">
            <div class="dest-meta-item">
                <div class="dest-meta-val">{{ destination.type|default('N/A')|capitalize }}</div>
                <div class="dest-meta-label">Type</div>
            </div>
            <div class="dest-meta-item">
                <div class="dest-meta-val">{{ destination.bestSeason|default('all_year')|replace({'_': ' '})|capitalize }}</div>
                <div class="dest-meta-label">Best Season</div>
            </div>
            <div class="dest-meta-item">
                <div class="dest-meta-val">{{ destination.averageRating|default(0)|number_format(1) }} ★</div>
                <div class="dest-meta-label">Rating</div>
            </div>
            <div class="dest-meta-item">
                <div class="dest-meta-val">€{{ destination.estimatedBudget|default(0)|number_format(0) }}</div>
                <div class="dest-meta-label">Est. Budget/Person</div>
            </div>
        </div>
    </div>

    <!-- Trip Details Table -->
    <table class="details-table">
        <thead>
            <tr>
                <th>Detail</th>
                <th>Information</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Travel Dates</strong></td>
                <td>{{ booking.startAt|date('d M Y') }} → {{ booking.endAt ? booking.endAt|date('d M Y') : 'Open-ended' }}</td>
            </tr>
            <tr>
                <td><strong>Duration</strong></td>
                <td>
                    {% if booking.endAt %}
                        {{ ((booking.endAt.timestamp - booking.startAt.timestamp) / 86400)|round(0, 'ceil') }} nights
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td><strong>Number of Guests</strong></td>
                <td>{{ booking.numGuests }} guest{{ booking.numGuests > 1 ? 's' : '' }}</td>
            </tr>
            <tr>
                <td><strong>Currency</strong></td>
                <td>{{ booking.currency|upper }}</td>
            </tr>
            {% if booking.notes %}
            <tr>
                <td><strong>Special Notes</strong></td>
                <td>{{ booking.notes }}</td>
            </tr>
            {% endif %}
        </tbody>
    </table>

    <!-- Total -->
    <div class="total-section">
        <div class="total-left">
            <div class="total-label">Grand Total</div>
            <div class="total-amount">€{{ booking.totalAmount|number_format(2) }}</div>
        </div>
        <div class="total-right">
            <div class="total-label">Booking ID</div>
            <div style="font-size: 20px; font-weight: 700; color: #fff; margin-top: 4px;">#{{ booking.bookingId }}</div>
            <div class="total-currency">{{ booking.currency|upper }}</div>
        </div>
    </div>

    <hr class="divider">

    <!-- Footer -->
    <div class="footer">
        <div class="footer-text">
            This invoice was generated automatically by TripX.<br>
            For questions about this booking, contact us at <strong>support@tripx.com</strong><br>
            Please present this document upon arrival at your destination.
        </div>
        <div class="footer-brand">TripX — Future of Travel</div>
        <div class="footer-text" style="margin-top: 6px;">
            Invoice Ref: INV-{{ booking.bookingReference }} · Generated: {{ "now"|date("d M Y H:i") }}
        </div>
    </div>
</body>
</html>
