# Copy this file to .env.local (or .env) and fill in real values.
# Never commit real secret values.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me

DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.0"
MAILER_DSN="smtp://user:pass@smtp.example.com:587"

GOOGLE_API_KEY=replace-with-key
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-client-secret

GEMINI_API_KEY=replace-with-key
GEMINI_MODEL=gemini-1.5-flash
RAGHED_GEMINI=replace-with-key

OPENWEATHER_API_KEY=replace-with-key
SERPAPI_API_KEY=replace-with-key
TRANSPORTAI=replace-with-key