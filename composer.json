{
    "name": "tripx/tripx",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "3.8.*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^2.19",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "5.0",
        "endroid/qr-code-bundle": "5.0",
        "friendsofsymfony/ckeditor-bundle": "^2.8",
        "google/apiclient": "2.15",
        "intervention/image": "^3.11",
        "knplabs/knp-paginator-bundle": "*",
        "knplabs/knp-time-bundle": "^2.5",
        "knpuniversity/oauth2-client-bundle": "*",
        "league/oauth2-google": "*",
        "league/oauth2-linkedin": "*",
        "liip/imagine-bundle": "^2.17",
        "liip/monitor-bundle": "^2.25",
        "phpoffice/phpspreadsheet": "^5.5",
        "php-ai/php-ml": "^0.10.0",
        "predis/predis": "*",
        "promphp/prometheus_client_php": "^2.15",
        "promphp/prometheus_push_gateway_php": "^1.1",
        "scheb/2fa-bundle": "7.0",
        "scheb/2fa-google-authenticator": "7.0",
        "snc/redis-bundle": "*",
        "symfony/asset": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/doctrine-bridge": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/expression-language": "6.4.*",
        "symfony/flex": "^2",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/google-mailer": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/mailer": "6.4.*",
        "symfony/messenger": "6.4.*",
        "symfony/mime": "6.4.*",
        "symfony/notifier": "6.4.*",
        "symfony/rate-limiter": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "require-dev": {
        "itsgoingd/clockwork": "^5.3",
        "symfony/maker-bundle": "^1.67"
    }
}
